	PROTECTED PROCEDURE ParteiKind
		LPARAMETERS toKind, tcBT
		IF VARTYPE(toKind) # "O"
		    = This.Pflicht(.F., "", tcBT, "FX-TECH-03")
		    RETURN .F.
		ENDIF
		IF toKind.lTechnischerFehler
		    = This.Meldung("FEHLER", "", tcBT, "FX-TECH-01", "Technischer Parteifehler: {1}", toKind.cLastError)
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE ParteiTextGleich
		LPARAMETERS tuLinks, tuRechts
		IF NOT This.IstText(tuLinks) OR NOT This.IstText(tuRechts)
			RETURN .F.
		ENDIF
		* AddText writes the original value without trimming or case folding.
		RETURN tuLinks == tuRechts
	ENDPROC

	PROTECTED PROCEDURE PayeeWieVerkaeufer
		LPARAMETERS toP
		LOCAL loV, lnP, lnV, loPK, loVK
		loV = This.oVerkaeufer
		IF VARTYPE(loV) # "O"
			RETURN .F.
		ENDIF
		IF This.ParteiTextGleich(toP.cName, loV.cName) OR ;
			This.ParteiTextGleich(toP.cRegisternummer, loV.cRegisternummer)
			RETURN .T.
		ENDIF
		* XPath equality matches any pair of local IDs; GlobalID is separate.
		FOR lnP = 1 TO toP.nKennungen
			loPK = toP.aKennungen[lnP]
			IF VARTYPE(loPK) # "O"
				LOOP
			ENDIF
			FOR lnV = 1 TO loV.nKennungen
				loVK = loV.aKennungen[lnV]
				IF VARTYPE(loVK) = "O"
					IF This.ParteiTextGleich(loPK.cWert, loVK.cWert)
						RETURN .T.
					ENDIF
				ENDIF
			ENDFOR
		ENDFOR
		RETURN .F.
	ENDPROC

	PROTECTED PROCEDURE Pflicht
		LPARAMETERS tlOk, tcPosition, tcBT, tcRegel
		IF NOT tlOk
			= This.Meldung("FEHLER", tcPosition, tcBT, tcRegel, "Pflichtangabe {1} fehlt oder hat einen falschen Typ.", tcBT)
		ENDIF
		RETURN tlOk
	ENDPROC

	PROTECTED PROCEDURE PositionAnfuegen
		LPARAMETERS toPosition
		LOCAL lnPosition
		IF NOT EMPTY(This.cEigenerCursor)
			IF NOT This.MeldungsCursorOeffnen()
				RETURN This.AddFehler(toPosition.cNummer, "", "FX-TECH-03", "Das Meldeziel der Position fehlt.")
			ENDIF
			= toPosition.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		lnPosition = This.nPositionsAnzahl + 1
		DIMENSION This.aPositionen[lnPosition]
		This.aPositionen[lnPosition] = toPosition
		This.nPositionsAnzahl = lnPosition
		RETURN toPosition
	ENDPROC

	PROTECTED PROCEDURE PositionFinden
		LPARAMETERS tcNummer
		LOCAL lnP, loP, lcNummer
		lcNummer = This.PositionsnummerNormal(tcNummer)
		IF EMPTY(lcNummer)
			RETURN 0
		ENDIF
		FOR lnP = 1 TO This.nPositionen
			loP = This.aPositionen[lnP]
			IF VARTYPE(loP) = "O"
				IF This.PositionsnummerNormal(loP.cNummer) == lcNummer
					RETURN lnP
				ENDIF
			ENDIF
		ENDFOR
		RETURN 0
	ENDPROC

	PROTECTED PROCEDURE Positionsliefermenge
		LPARAMETERS tuMenge, tuEinheit, tcBT, tcPflicht, tcCode, toCodes, tcPosition, tlEinheiten
		LOCAL llMenge
		llMenge = NOT ISNULL(tuMenge)
		= This.ProduktText(tuEinheit, tcBT + "-0", tcPosition, .T.)
		IF NOT llMenge AND NOT This.IstText(tuEinheit)
		    RETURN
		ENDIF
		IF llMenge AND This.cProfil # "EXTENDED"
		    = This.Pflicht(.F., tcPosition, tcBT, "FX-PROFIL-01")
		ENDIF
		= This.Pflicht(This.IstZahl(tuMenge), tcPosition, tcBT, "FX-TECH-03")
		IF This.IstZahl(tuMenge)
		    = This.StellenPruefen(tuMenge, 4, tcPosition, tcBT)
		ENDIF
		IF llMenge
		    = This.Pflicht(This.IstText(tuEinheit), tcPosition, tcBT + "-0", "FX-SCH-A-" + tcPflicht)
		ENDIF
		IF tlEinheiten
		    = This.PruefeCode(toCodes, tuEinheit, tcBT + "-0", "FX-SCH-A-" + tcCode, tcPosition)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE PositionsnummerNormal
		LPARAMETERS tuWert
		LOCAL lcWert
		lcWert = This.CodeNormal(tuWert)
		DO WHILE "  " $ lcWert
			lcWert = STRTRAN(lcWert, "  ", " ")
		ENDDO
		RETURN lcWert
	ENDPROC

	PROTECTED PROCEDURE PositionsparteiKennungen
		LPARAMETERS toP, toCodes, tcPosition, taBT, taRegeln
		LOCAL lnK, loK
		IF taRegeln[7] # "-"
		    = This.Pflicht(toP.nKennungen <= 1, tcPosition, taBT[2], taRegeln[7])
		ENDIF
		FOR lnK = 1 TO toP.nKennungen
		    loK = toP.aKennungen[lnK]
		    IF This.ProduktKind(loK, taBT[2], tcPosition)
		        = This.ProduktText(loK.cWert, taBT[2], tcPosition, .T.)
		        = This.ProduktText(loK.cSchema, taBT[2], tcPosition, .T.)
		        = This.Pflicht(This.IstText(loK.cWert) AND NOT This.IstText(loK.cSchema), tcPosition, taBT[2], "FX-TECH-03")
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO toP.nGlobaleKennungen
		    loK = toP.aGlobaleKennungen[lnK]
		    IF This.ProduktKind(loK, taBT[3], tcPosition)
		        = This.ProduktText(loK.cWert, taBT[3], tcPosition, .T.)
		        = This.ProduktText(loK.cSchema, taBT[4], tcPosition, .T.)
		        = This.Pflicht(This.IstText(loK.cWert), tcPosition, taBT[3], "FX-TECH-03")
		        = This.Pflicht(This.IstText(loK.cSchema), tcPosition, taBT[4], taRegeln[1])
		        = This.PruefeCode(toCodes, loK.cSchema, taBT[4], taRegeln[2], tcPosition)
		    ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE PositionsparteiKontakte
		LPARAMETERS toP, tcPosition, taBT
		LOCAL lnK, loK
		FOR lnK = 1 TO toP.nKontakte
		    loK = toP.aKontakte[lnK]
		    IF NOT This.ProduktKind(loK, taBT[11], tcPosition)
		        LOOP
		    ENDIF
		    = This.ProduktText(loK.cKontakt, taBT[12], tcPosition, .T.)
		    = This.ProduktText(loK.cAbteilung, taBT[13], tcPosition, .T.)
		    = This.ProduktText(loK.cTyp, taBT[14], tcPosition, .T.)
		    = This.ProduktText(loK.cTelefon, taBT[15], tcPosition, .T.)
		    = This.ProduktText(loK.cFax, taBT[16], tcPosition, .T.)
		    = This.ProduktText(loK.cEmail, taBT[17], tcPosition, .T.)
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE PositionsparteiTexte
		LPARAMETERS toP, tcPosition, taBT
		= This.ProduktText(toP.cName, taBT[5], tcPosition, .T.)
		= This.ProduktText(toP.cRolle, taBT[6], tcPosition, .T.)
		= This.ProduktText(toP.cBeschreibung, taBT[7], tcPosition, .T.)
		= This.ProduktText(toP.cRegisternummer, taBT[8], tcPosition, .T.)
		= This.ProduktText(toP.cRegisterSchema, taBT[9], tcPosition, .T.)
		= This.ProduktText(toP.cHandelsname, taBT[10], tcPosition, .T.)
		= This.ProduktText(toP.cKontakt, taBT[12], tcPosition, .T.)
		= This.ProduktText(toP.cAbteilung, taBT[13], tcPosition, .T.)
		= This.ProduktText(toP.cKontaktTyp, taBT[14], tcPosition, .T.)
		= This.ProduktText(toP.cTelefon, taBT[15], tcPosition, .T.)
		= This.ProduktText(toP.cFax, taBT[16], tcPosition, .T.)
		= This.ProduktText(toP.cEmail, taBT[17], tcPosition, .T.)
		= This.ProduktText(toP.cPlz, taBT[18], tcPosition, .T.)
		= This.ProduktText(toP.cStrasse, taBT[19], tcPosition, .T.)
		= This.ProduktText(toP.cStrasse2, taBT[20], tcPosition, .T.)
		= This.ProduktText(toP.cStrasse3, taBT[21], tcPosition, .T.)
		= This.ProduktText(toP.cOrt, taBT[22], tcPosition, .T.)
		= This.ProduktText(toP.cLand, taBT[23], tcPosition, .T.)
		= This.ProduktText(toP.cRegion, taBT[24], tcPosition, .T.)
		= This.ProduktText(toP.cElektronischeAdresse, taBT[25], tcPosition, .T.)
		= This.ProduktText(toP.cElektronischeAdresseSchema, taBT[26], tcPosition, .T.)
		= This.ProduktText(toP.cSteuernummer, taBT[27], tcPosition, .T.)
		= This.ProduktText(toP.cUstId, taBT[28], tcPosition, .T.)
	ENDPROC

	PROTECTED PROCEDURE PositionsRegel
		LPARAMETERS tcNummer
		IF VARTYPE(This.cProfil) = "C" AND This.cProfil == "EXTENDED"
			RETURN "BR-FXEXT-BR-" + tcNummer
		ENDIF
		RETURN "BR-" + tcNummer
	ENDPROC

	PROTECTED PROCEDURE Preisbasis
		LPARAMETERS tuWert, tcBT, tcPosition
		LOCAL lcRegel
		IF ISNULL(tuWert)
			RETURN .T.
		ENDIF
		lcRegel = IIF(This.cProfil == "XRECHNUNG-CII", "PEPPOL-EN16931-R121", "FX-TECH-03")
		IF NOT This.IstZahl(tuWert)
			RETURN This.Pflicht(.F., tcPosition, tcBT, "FX-TECH-03")
		ENDIF
		= This.StellenPruefen(tuWert, 4, tcPosition, tcBT)
		RETURN This.Pflicht(ROUND(tuWert, 4) > 0, tcPosition, tcBT, lcRegel)
	ENDPROC

	PROTECTED PROCEDURE PreiszusatzZahl
		LPARAMETERS tuWert, tcBT, tcPosition
		IF ISNULL(tuWert)
			RETURN .T.
		ENDIF
		IF This.cProfil # "EXTENDED"
			= This.Pflicht(.F., tcPosition, tcBT, "FX-PROFIL-01")
		ENDIF
		IF NOT This.IstZahl(tuWert)
			RETURN This.Pflicht(.F., tcPosition, tcBT, "FX-TECH-03")
		ENDIF
		= This.StellenPruefen(tuWert, 2, tcPosition, tcBT)
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE ProduktKind
		    LPARAMETERS toKind, tcBT, tcPosition
		    IF VARTYPE(toKind) # "O"
		        RETURN This.Pflicht(.F., tcPosition, tcBT, "FX-TECH-03")
		    ENDIF
		    IF toKind.lTechnischerFehler
		        = This.Meldung("FEHLER", tcPosition, tcBT, "FX-TECH-01", "Technischer Produktfehler: {1}", toKind.cLastError)
		    ENDIF
		    IF PEMSTATUS(toKind, "cAddFehler", 5)
		        IF NOT EMPTY(toKind.cAddFehler)
		            IF PEMSTATUS(toKind, "AddFehlerMelden", 5)
		                = toKind.AddFehlerMelden(tcPosition, tcBT)
		            ELSE
		                = This.Meldung("FEHLER", tcPosition, tcBT, "FX-TECH-03", "Abgewiesener Produkt-Add-Aufruf: {1}", toKind.cAddFehler)
		            ENDIF
		        ENDIF
		    ENDIF
		    RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE ProduktText
		    LPARAMETERS tuWert, tcBT, tcPosition, tlExtended
		    IF NOT INLIST(VARTYPE(tuWert), "C", "M")
		        RETURN This.Pflicht(.F., tcPosition, tcBT, "FX-TECH-03")
		    ENDIF
		    IF tlExtended AND This.cProfil # "EXTENDED" AND This.IstText(tuWert)
		        = This.Meldung("FEHLER", tcPosition, tcBT, "FX-PROFIL-01", ;
		            "Das Feld {1} ist im Profil {2} nicht zul{ae}ssig.", tcBT, This.cProfil)
		        RETURN .F.
		    ENDIF
		    RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE ProduktZahl
		    LPARAMETERS tuWert, tcBT, tcPosition
		    IF ISNULL(tuWert)
		        RETURN .T.
		    ENDIF
		    IF NOT This.IstZahl(tuWert)
		        RETURN This.Pflicht(.F., tcPosition, tcBT, "FX-TECH-03")
		    ENDIF
		    = This.StellenPruefen(tuWert, 4, tcPosition, tcBT)
		    RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE ProfilFeld
		LPARAMETERS tlGesetzt, tcBT
		IF tlGesetzt AND This.cProfil # "EXTENDED"
			= This.Meldung("FEHLER", "", tcBT, "FX-PROFIL-01", ;
				"Das Feld {1} ist im Profil {2} nicht zul{ae}ssig.", tcBT, This.cProfil)
			RETURN .F.
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE PruefeCode
		LPARAMETERS toCodes, tuWert, tcBT, tcRegel, tcPosition
		IF NOT This.IstText(tuWert)
			RETURN
		ENDIF
		* Gueltig normalisiert den Code selbst, auch bei direktem Aufruf.
		IF NOT toCodes.Gueltig(tcRegel, tuWert, This.cProfil)
			= This.Meldung(toCodes.Stufe(tcRegel, This.cProfil), tcPosition, tcBT, tcRegel, ;
				"Der Code {1} ist in der Codeliste f{ue}r {2} in diesem Profil nicht zul{ae}ssig.", ;
				This.CodeNormal(tuWert), tcBT)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE PruefeDatumswert
		LPARAMETERS tuWert, tcFormat, tcBT
		LOCAL lcRegel, lcFormat
		lcFormat = This.CodeNormal(tcFormat)
		IF NOT (lcFormat == "102" OR lcFormat == "205")
			= This.Meldung("FEHLER", "", tcBT, "FX-TECH-03", "Das Datumsformat {1} wird nicht unterst{ue}tzt.", lcFormat)
			RETURN .F.
		ENDIF
		IF This.DatumswertGueltig(tuWert, lcFormat)
			RETURN .T.
		ENDIF
		lcRegel = IIF(lcFormat == "205", "BR-FXEXT-CII-DT-097a", "CII-DT-097")
		= This.Meldung("FEHLER", "", tcBT, lcRegel, ;
			"{1}: Datumsformat {2} verlangt {3}.", tcBT, lcFormat, ;
			IIF(lcFormat == "205", "YYYYMMDDHHMM", "YYYYMMDD"))
		RETURN .F.
	ENDPROC

	PROTECTED PROCEDURE PruefeGesamtSoll
		LPARAMETERS tuSoll, tnGerechnet, tcBT, tcRegel
		LOCAL lcUrsache
		lcUrsache = "Rundung je Position statt je Steuersatz."
		IF tcRegel == "FX-SOLL-03"
		    lcUrsache = "Die Gesamtvorauszahlung passt nicht zur Summe der Einzelzahlungen."
		ENDIF
		IF tcRegel == "FX-SOLL-04"
		    lcUrsache = "Vorauszahlung, Rundungsbetrag oder Finanzkorrektur weicht ab."
		ENDIF
		IF ISNULL(tuSoll)
			RETURN .T.
		ENDIF
		IF NOT This.IstZahl(tuSoll)
			RETURN This.Meldung("FEHLER", "", tcBT, tcRegel, "Der Sollwert f{ue}r {1} muss eine Zahl oder NULL sein.", tcBT)
		ENDIF
		= This.StellenPruefen(tuSoll, 2, "", tcBT)
		IF This.IstZahl(tnGerechnet)
			IF ROUND(tuSoll - tnGerechnet, 2) # 0
				= This.Meldung("FEHLER", "", tcBT, tcRegel, ;
					"Sollwert {1}, gerechnet {2}. M{oe}gliche Ursache: {3}", ;
					This.RechenZahl(tuSoll), This.RechenZahl(tnGerechnet), lcUrsache)
			ENDIF
		ELSE
			= This.Meldung("FEHLER", "", tcBT, tcRegel, ;
				"Sollwert {1} ist nicht pr{ue}fbar, {2} wurde nicht gerechnet.", This.RechenZahl(tuSoll), tcBT)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE PruefeLieferdatum
		LPARAMETERS tuDatum, tcBT
		* BT-72 akzeptiert weiterhin NULL als fehlenden optionalen Termin (WP07).
		IF ISNULL(tuDatum) AND tcBT == "BT-72"
			RETURN .T.
		ENDIF
		IF NOT This.Pflicht(VARTYPE(tuDatum) = "D", "", tcBT, "FX-TECH-03")
			RETURN .F.
		ENDIF
		IF NOT EMPTY(tuDatum)
			RETURN This.PruefeDatumswert(DTOS(tuDatum), "102", tcBT)
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE PruefeRechenwert
		LPARAMETERS tnWert, tnErwartet, tnToleranz, tcBT, tcRegel, tcStufe
		IF This.IstZahl(tnWert) AND This.IstZahl(tnErwartet)
			IF ABS(ROUND(tnWert - tnErwartet, 2)) > ROUND(tnToleranz, 2)
				= This.Meldung(tcStufe, "", tcBT, tcRegel, "Rechenwert {1}, erwartet {2}.", ;
					This.RechenZahl(tnWert), This.RechenZahl(tnErwartet))
				RETURN .F.
			ENDIF
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE RechenergebnisseLeeren
		LOCAL lnPosition
		This.nSummePositionen = .NULL.
		This.nNachlassSumme = .NULL.
		This.nZuschlagSumme = .NULL.
		This.nNetto = .NULL.
		This.nSteuer = .NULL.
		This.nBrutto = .NULL.
		This.nZahlbetrag = .NULL.
		This.nVorauszahlungSumme = .NULL.
		This.nFinanzkorrekturSumme = .NULL.
		This.nGruppenAnzahl = 0
		DIMENSION This.aSteuergruppen[1]
		This.aSteuergruppen[1] = .NULL.
		FOR lnPosition = 1 TO This.nPositionen
			IF VARTYPE(This.aPositionen[lnPosition]) = "O" AND ;
				PEMSTATUS(This.aPositionen[lnPosition], "nNettobetrag", 5)
				This.aPositionen[lnPosition].nNettobetrag = .NULL.
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE RechenNumeric
		LPARAMETERS tnWert
		IF VARTYPE(tnWert) == "Y"
			RETURN MTON(tnWert)
		ENDIF
		RETURN tnWert
	ENDPROC

	PROTECTED PROCEDURE RechenRegel
		LPARAMETERS tcRegel
		IF This.cProfil == "EXTENDED"
			RETURN "BR-FXEXT-" + tcRegel
		ENDIF
		RETURN "BR-" + tcRegel
	ENDPROC

	PROTECTED PROCEDURE RechenZahl
		LPARAMETERS tnWert
		LOCAL lnStellen
		lnStellen = 2
		* Sollwerte mit ueberzaehligen Stellen im Befund nicht als scheinbar gleich ausgeben.
		DO WHILE lnStellen < 10 AND tnWert # ROUND(tnWert, lnStellen)
			lnStellen = lnStellen + 1
		ENDDO
		RETURN CHRTRAN(ALLTRIM(STR(tnWert, 40, lnStellen)), SET("POINT"), ".")
	ENDPROC

	PROTECTED PROCEDURE RechneBelegaenderungen
		LOCAL lnK, loK
		STORE .NULL. TO This.nNachlassSumme, This.nZuschlagSumme
		FOR lnK = 1 TO This.nBelegaenderungen
		    loK = This.aBelegaenderungen[lnK]
		    IF VARTYPE(loK) # "O"
		        LOOP
		    ENDIF
		    = This.Belegbetrag(loK)
		    IF VARTYPE(loK.lZuschlag) # "L"
		        LOOP
		    ENDIF
		    IF loK.lZuschlag
		        This.nZuschlagSumme = ROUND(This.BetragOderNull(This.nZuschlagSumme) + This.BetragOderNull(loK.nRechenbetrag), 2)
		    ELSE
		        This.nNachlassSumme = ROUND(This.BetragOderNull(This.nNachlassSumme) + This.BetragOderNull(loK.nRechenbetrag), 2)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nLogistikentgelte
		    loK = This.aLogistikentgelte[lnK]
		    IF VARTYPE(loK) # "O"
		        LOOP
		    ENDIF
		    loK.nRechenbetrag = .NULL.
		    IF This.IstZahl(loK.nBetrag)
		        loK.nRechenbetrag = ROUND(This.RechenNumeric(loK.nBetrag), 2)
		    ENDIF
		    This.nZuschlagSumme = ROUND(This.BetragOderNull(This.nZuschlagSumme) + This.BetragOderNull(loK.nRechenbetrag), 2)
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE Rechnen
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		= This.RechnePositionen()
		= This.RechneBelegaenderungen()
		= This.RechneSteuern()
		= This.RechneSummen()
		RETURN NOT This.lTechnischerFehler
	ENDPROC

	PROTECTED PROCEDURE RechnePositionen
		LOCAL lnPosition, loPosition, lcNummer, lnBasis, lnAenderung
		FOR lnPosition = 1 TO This.nPositionen
			loPosition = This.aPositionen[lnPosition]
			IF VARTYPE(loPosition) # "O"
				LOOP
			ENDIF
			lcNummer = ALLTRIM(STR(lnPosition))
			IF This.IstText(loPosition.cNummer)
				lcNummer = loPosition.cNummer
			ENDIF
			= This.StellenPruefen(loPosition.nMenge, 4, lcNummer, "BT-129")
			= This.StellenPruefen(loPosition.nPreis, 4, lcNummer, "BT-146")
			= This.StellenPruefen(loPosition.nBasismenge, 4, lcNummer, "BT-149")
			= This.StellenPruefen(loPosition.nSteuersatz, 2, lcNummer, "BT-152")
			lnAenderung = This.RechnePositionsaenderungen(loPosition)
			loPosition.nNettobetrag = .NULL.
			IF NOT This.IstDetailposition(loPosition)
				IF This.IstZahl(loPosition.nGliederungsbetrag)
					loPosition.nNettobetrag = ROUND(This.RechenNumeric(loPosition.nGliederungsbetrag), 2)
				ENDIF
				LOOP
			ENDIF
			lnBasis = 1
			IF NOT ISNULL(loPosition.nBasismenge)
				IF NOT This.IstZahl(loPosition.nBasismenge)
					= This.Meldung("FEHLER", lcNummer, "BT-149", "FX-TECH-03", "Die Basismenge muss eine positive Zahl sein.")
					LOOP
				ENDIF
				lnBasis = ROUND(This.RechenNumeric(loPosition.nBasismenge), 4)
			ENDIF
			IF lnBasis <= 0
				IF This.cProfil == "XRECHNUNG-CII"
					= This.Pflicht(.F., lcNummer, "BT-149", "PEPPOL-EN16931-R121")
				ENDIF
				= This.Meldung("FEHLER", lcNummer, "BT-149", "FX-TECH-03", "Die Basismenge muss nach Rundung auf vier Stellen positiv sein.")
				LOOP
			ENDIF
			IF This.IstZahl(loPosition.nMenge) AND This.IstZahl(loPosition.nPreis)
				loPosition.nNettobetrag = ROUND(ROUND(This.RechenNumeric(loPosition.nMenge), 4) * ;
					ROUND(This.RechenNumeric(loPosition.nPreis), 4) / lnBasis + lnAenderung, 2)
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE RechnePositionsaenderungen
		LPARAMETERS toP
		LOCAL lnK, loK
		STORE .NULL. TO toP.nNachlassSumme, toP.nZuschlagSumme, toP.nGesamtAenderung
		IF toP.nAbrechnungsaenderungen = 0
			RETURN 0
		ENDIF
		STORE 0 TO toP.nNachlassSumme, toP.nZuschlagSumme
		FOR lnK = 1 TO toP.nAbrechnungsaenderungen
			loK = toP.aAbrechnungsaenderungen[lnK]
			IF VARTYPE(loK) # "O"
				LOOP
			ENDIF
			loK.nRechenbetrag = .NULL.
			IF This.IstZahl(loK.nBetrag)
				loK.nRechenbetrag = ROUND(This.RechenNumeric(loK.nBetrag), 2)
			ELSE
				IF ISNULL(loK.nBetrag) AND This.IstZahl(loK.nBasis) AND This.IstZahl(loK.nProzent)
					loK.nRechenbetrag = ROUND(ROUND(This.RechenNumeric(loK.nBasis), 2) * ;
						ROUND(This.RechenNumeric(loK.nProzent), 2) / 100, 2)
				ENDIF
			ENDIF
			IF This.IstZahl(loK.nRechenbetrag) AND VARTYPE(loK.lZuschlag) = "L"
				IF loK.lZuschlag
					toP.nZuschlagSumme = toP.nZuschlagSumme + loK.nRechenbetrag
				ELSE
					toP.nNachlassSumme = toP.nNachlassSumme + loK.nRechenbetrag
				ENDIF
			ENDIF
		ENDFOR
		toP.nGesamtAenderung = ROUND(toP.nZuschlagSumme - toP.nNachlassSumme, 2)
		RETURN toP.nGesamtAenderung
	ENDPROC

	PROTECTED PROCEDURE RechneSteuern
		LOCAL lnK, loK, lnGruppe, loGruppe
		FOR lnK = 1 TO This.nPositionen
		    loK = This.aPositionen[lnK]
		    IF VARTYPE(loK) = "O" AND This.IstDetailposition(loK)
		        = This.SteuerbasisErgaenzen(loK, loK.nNettobetrag)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nBelegaenderungen
		    loK = This.aBelegaenderungen[lnK]
		    IF VARTYPE(loK) = "O" AND VARTYPE(loK.lZuschlag) = "L"
		        = This.SteuerbasisErgaenzen(loK, IIF(loK.lZuschlag, 1, -1) * loK.nRechenbetrag)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nLogistikentgelte
		    loK = This.aLogistikentgelte[lnK]
		    IF VARTYPE(loK) = "O"
		        IF This.IstZahl(loK.nSteuersatz)
		            = This.SteuerbasisErgaenzen(loK, loK.nRechenbetrag)
		        ENDIF
		    ENDIF
		ENDFOR
		= This.SteuerangabenAnwenden()
		FOR lnGruppe = 1 TO This.nSteuergruppen
		    loGruppe = This.aSteuergruppen[lnGruppe]
		    loGruppe.nSteuer = IIF(INLIST(loGruppe.cSteuerkategorie, "S", "L", "M", "B"), ROUND(loGruppe.nBasis * loGruppe.nSteuersatz / 100, 2), 0)
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE RechneSummen
		LOCAL lnPosition, loPosition, lnSumme, lnSteuer, lnGruppe, llBerechenbar, lnDetails
		LOCAL lnK, loK
		lnSumme = 0
		lnDetails = 0
		llBerechenbar = .T.
		FOR lnPosition = 1 TO This.nPositionen
			loPosition = This.aPositionen[lnPosition]
			IF VARTYPE(loPosition) = "O" AND NOT This.IstDetailposition(loPosition)
				LOOP
			ENDIF
			IF VARTYPE(loPosition) # "O"
				RETURN .F.
			ENDIF
			IF NOT This.IstZahl(loPosition.nNettobetrag)
				RETURN .F.
			ENDIF
			lnDetails = lnDetails + 1
			lnSumme = lnSumme + loPosition.nNettobetrag
			llBerechenbar = llBerechenbar AND This.SteuerBerechenbar(loPosition)
		ENDFOR
		FOR lnK = 1 TO This.nBelegaenderungen + This.nLogistikentgelte
			IF lnK <= This.nBelegaenderungen
				loK = This.aBelegaenderungen[lnK]
			ELSE
				loK = This.aLogistikentgelte[lnK - This.nBelegaenderungen]
			ENDIF
			IF VARTYPE(loK) # "O"
				llBerechenbar = .F.
				LOOP
			ENDIF
			IF lnK <= This.nBelegaenderungen AND VARTYPE(loK.lZuschlag) # "L"
				llBerechenbar = .F.
				LOOP
			ENDIF
			IF NOT This.IstZahl(loK.nRechenbetrag)
				llBerechenbar = .F.
				LOOP
			ENDIF
			* Logistics requires a numeric rate even for O; line/allowance O has none.
			IF lnK > This.nBelegaenderungen AND NOT This.IstZahl(loK.nSteuersatz)
				llBerechenbar = .F.
			ENDIF
			llBerechenbar = llBerechenbar AND This.SteuerBerechenbar(loK)
		ENDFOR
		IF lnDetails = 0 AND This.nPositionen > 0
			= This.Meldung("FEHLER", "", "BT-106", "FX-TECH-03", "Ohne abrechenbare DETAIL-Position kann keine Rechnungssumme mit Steuer berechnet werden.")
			RETURN .F.
		ENDIF
		This.nSummePositionen = ROUND(lnSumme, 2)
		This.nNetto = ROUND(This.nSummePositionen - This.BetragOderNull(This.nNachlassSumme) + This.BetragOderNull(This.nZuschlagSumme), 2)
		* Unbekannte Kategorien liefern weiterhin keine scheinbar steuerfreien Endbetraege.
		IF NOT llBerechenbar
			RETURN .F.
		ENDIF
		lnSteuer = 0
		FOR lnGruppe = 1 TO This.nSteuergruppen
			lnSteuer = lnSteuer + This.aSteuergruppen[lnGruppe].nSteuer
		ENDFOR
		This.nSteuer = ROUND(lnSteuer, 2)
		This.nBrutto = ROUND(This.nNetto + This.nSteuer, 2)
		= This.RechneZahlung()
	ENDPROC

	PROTECTED PROCEDURE RechneZahlung
		    LOCAL lnK, loK
		    This.nVorauszahlungSumme = .NULL.
		    This.nFinanzkorrekturSumme = .NULL.
		    IF This.IstZahl(This.nVorauszahlung)
		        This.nVorauszahlungSumme = ROUND(This.RechenNumeric(This.nVorauszahlung), 2)
		    ENDIF
		    IF This.nVorauszahlungen > 0
		        This.nVorauszahlungSumme = 0
		        FOR lnK = 1 TO This.nVorauszahlungen
		            loK = This.aVorauszahlungen[lnK]
		            IF VARTYPE(loK) = "O" AND This.IstZahl(loK.nBetrag)
		                This.nVorauszahlungSumme = ROUND(This.nVorauszahlungSumme + ROUND(This.RechenNumeric(loK.nBetrag), 2), 2)
		            ENDIF
		        ENDFOR
		    ENDIF
		    IF This.nFinanzkorrekturen > 0
		        This.nFinanzkorrekturSumme = 0
		        FOR lnK = 1 TO This.nFinanzkorrekturen
		            loK = This.aFinanzkorrekturen[lnK]
		            IF VARTYPE(loK) = "O" AND This.IstZahl(loK.nBetrag)
		                This.nFinanzkorrekturSumme = ROUND(This.nFinanzkorrekturSumme + ROUND(This.RechenNumeric(loK.nBetrag), 2), 2)
		            ENDIF
		        ENDFOR
		    ENDIF
		    IF This.IstZahl(This.nBrutto)
		        This.nZahlbetrag = ROUND(This.nBrutto - This.BetragOderNull(This.nVorauszahlungSumme) + ;
		            ROUND(This.BetragOderNull(This.nRundung), 2) + This.BetragOderNull(This.nFinanzkorrekturSumme), 2)
		    ENDIF
	ENDPROC

	PROTECTED PROCEDURE ReferenzBinden
		LPARAMETERS toReferenz
		IF VARTYPE(toReferenz) = "O"
			= toReferenz.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ReferenzObjekt
		LPARAMETERS toReferenz, tcBT
		IF VARTYPE(toReferenz) # "O"
			RETURN This.Pflicht(.F., "", tcBT, "FX-TECH-03")
		ENDIF
		IF toReferenz.lTechnischerFehler
			= This.Meldung("FEHLER", "", tcBT, "FX-TECH-01", "Technischer Fehler im Kopfbezug: {1}", toReferenz.cLastError)
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE RollenAttribut
		LPARAMETERS tuWert, tuSchema, tcBT, tcPosition
		IF PCOUNT() < 4
			tcPosition = ""
		ENDIF
		IF This.IstText(tuSchema) AND NOT This.IstText(tuWert)
			= This.Pflicht(.F., tcPosition, tcBT, "FX-TECH-03")
		ENDIF
		IF This.IstText(tuWert) AND NOT This.IstText(tuSchema)
			= This.Pflicht(.F., tcPosition, tcBT, "FX-TECH-03")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE RollenKennungen
		LPARAMETERS toP, toCodes, tcId, tcGlobal, tcSchema, tcAnzahl, tlExtended
		LOCAL lnK, loK
		IF toP.nKennungen > 1 AND (NOT tlExtended OR This.cProfil == "EXTENDED")
			= This.Pflicht(.F., "", tcId, tcAnzahl)
		ENDIF
		FOR lnK = 1 TO toP.nKennungen
			loK = toP.aKennungen[lnK]
			IF This.ParteiKind(loK, tcId)
				= This.KopfText(loK.cWert, tcId, tlExtended)
				= This.Pflicht(This.IstText(loK.cWert), "", tcId, "FX-TECH-03")
				= This.Pflicht(INLIST(VARTYPE(loK.cSchema), "C", "M") AND NOT This.IstText(loK.cSchema), "", tcId, "FX-TECH-03")
			ENDIF
		ENDFOR
		FOR lnK = 1 TO toP.nGlobaleKennungen
			loK = toP.aGlobaleKennungen[lnK]
			IF This.ParteiKind(loK, tcGlobal)
				= This.KopfText(loK.cWert, tcGlobal, tlExtended)
				= This.Pflicht(This.IstText(loK.cWert), "", tcGlobal, "FX-TECH-03")
				= This.KopfText(loK.cSchema, tcSchema, tlExtended)
				= This.Pflicht(This.IstText(loK.cSchema), "", tcSchema, "FX-TECH-03")
				= This.PruefeCode(toCodes, loK.cSchema, tcSchema, IIF(tcId == "BT-71", "BR-CL-26", "BR-CL-10"), "")
			ENDIF
		ENDFOR
		IF NOT tlExtended AND This.cProfil # "EXTENDED" AND toP.nKennungen > 0 AND toP.nGlobaleKennungen > 0
			= This.Meldung("WARNUNG", "", tcId, IIF(tcId == "BT-71", "CII-SR-449", "CII-SR-451"), ;
				"Lokale und globale Kennung sollen in dieser Rolle nicht zugleich gesetzt sein.")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE RollenKontakte
		LPARAMETERS toP, toCodes, tcKontakt, tcAbteilung, tcTyp, tcTelefon, tcFax, tcEmail
		LOCAL lnK, loK, lcTyp
		FOR lnK = 0 TO toP.nKontakte
			loK = toP
			lcTyp = toP.cKontaktTyp
			IF lnK > 0
				loK = toP.aKontakte[lnK]
				IF NOT This.ParteiKind(loK, tcKontakt)
					LOOP
				ENDIF
				lcTyp = loK.cTyp
			ENDIF
			= This.RollenText(toCodes, loK.cKontakt, tcKontakt, .T., "")
			= This.RollenText(toCodes, loK.cAbteilung, tcAbteilung, .T., "")
			= This.RollenText(toCodes, lcTyp, tcTyp, .T., "")
			= This.RollenText(toCodes, loK.cTelefon, tcTelefon, .T., "")
			= This.RollenText(toCodes, loK.cFax, tcFax, .T., "")
			= This.RollenText(toCodes, loK.cEmail, tcEmail, .T., "")
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE RollenPostanschrift
		LPARAMETERS toA, toCodes, tlExtended, tcPlz, tcStrasse, tcStrasse2, tcStrasse3, tcOrt, tcLand, tcRegion
		= This.RollenText(toCodes, toA.cPlz, tcPlz, tlExtended, "")
		= This.RollenText(toCodes, toA.cStrasse, tcStrasse, tlExtended, "")
		= This.RollenText(toCodes, toA.cStrasse2, tcStrasse2, tlExtended, "")
		= This.RollenText(toCodes, toA.cStrasse3, tcStrasse3, tlExtended, "")
		= This.RollenText(toCodes, toA.cOrt, tcOrt, tlExtended, "")
		= This.RollenText(toCodes, toA.cLand, tcLand, tlExtended, "BR-CL-14")
		= This.RollenText(toCodes, toA.cRegion, tcRegion, tlExtended, "")
	ENDPROC

	PROTECTED PROCEDURE RollenRegisteranschrift
		LPARAMETERS toA, toCodes, tcPlz, tcStrasse, tcStrasse2, tcStrasse3, tcOrt, tcLand, tcRegion, tcLandpflicht
		IF This.ParteiKind(toA, tcLand)
			= This.RollenPostanschrift(toA, toCodes, .T., ;
				tcPlz, tcStrasse, tcStrasse2, tcStrasse3, tcOrt, tcLand, tcRegion)
			IF This.cProfil == "EXTENDED" AND This.AdresseVorhanden(toA)
				= This.Pflicht(This.IstText(toA.cLand), "", tcLand, tcLandpflicht)
			ENDIF
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE RollenText
		LPARAMETERS toCodes, tuWert, tcBT, tlExtended, tcCode
		IF NOT This.KopfText(tuWert, tcBT, tlExtended)
			RETURN .F.
		ENDIF
		IF NOT EMPTY(tcCode) AND (NOT tlExtended OR This.cProfil == "EXTENDED")
			= This.PruefeCode(toCodes, tuWert, tcBT, tcCode, "")
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE SkontoBedingung
		LPARAMETERS toB
		RETURN NOT This.IstText(toB.cBeschreibung) AND EMPTY(toB.dFaelligkeit) AND ;
		    NOT This.IstText(toB.cMandatsreferenz) AND ISNULL(toB.nTeilzahlung) AND ;
		    EMPTY(toB.dVerzugBasisdatum) AND ISNULL(toB.nVerzugTage) AND NOT This.IstText(toB.cVerzugEinheit) AND ;
		    ISNULL(toB.nVerzugBasis) AND ISNULL(toB.nVerzugProzent) AND ISNULL(toB.nVerzugBetrag) AND ;
		    VARTYPE(toB.oZahlungsempfaenger) = "O" AND NOT toB.oZahlungsempfaenger.Vorhanden() AND ;
		    (NOT ISNULL(toB.nSkontoTage) OR NOT ISNULL(toB.nSkontoProzent) OR NOT ISNULL(toB.nSkontoBasis))
	ENDPROC

	PROTECTED PROCEDURE SkontoDezimal
		LPARAMETERS tcWert, tlVorzeichen
		IF tlVorzeichen AND LEFT(tcWert, 1) == "-"
		    tcWert = SUBSTR(tcWert, 2)
		ENDIF
		RETURN LEN(tcWert) >= 4 AND SUBSTR(tcWert, LEN(tcWert) - 2, 1) == "." AND ;
		    LEN(CHRTRAN(LEFT(tcWert, LEN(tcWert) - 3) + RIGHT(tcWert, 2), "0123456789", "")) = 0
	ENDPROC

	PROTECTED PROCEDURE SkontoWerteGueltig
		LPARAMETERS tuTage, tuProzent, tuBasis
		IF NOT This.IstZahl(tuTage) OR NOT This.IstZahl(tuProzent)
		    RETURN .F.
		ENDIF
		IF tuTage < 0 OR tuTage # INT(tuTage) OR tuProzent <= 0 OR tuProzent > 100
		    RETURN .F.
		ENDIF
		IF NOT ISNULL(tuBasis)
		    IF NOT This.IstZahl(tuBasis)
		        RETURN .F.
		    ENDIF
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE SkontoZeileGueltig
		LPARAMETERS tcZeile
		LOCAL lnEnde, lcRest, lcWert
		IF NOT (LEFT(tcZeile, 13) == "#SKONTO#TAGE=")
		    RETURN .F.
		ENDIF
		lcRest = SUBSTR(tcZeile, 14)
		lnEnde = AT("#PROZENT=", lcRest)
		IF lnEnde < 2 OR LEN(CHRTRAN(LEFT(lcRest, lnEnde - 1), "0123456789", "")) > 0
		    RETURN .F.
		ENDIF
		lcRest = SUBSTR(lcRest, lnEnde + 9)
		lnEnde = AT("#", lcRest)
		IF lnEnde = 0 OR NOT This.SkontoDezimal(LEFT(lcRest, lnEnde - 1), .F.)
		    RETURN .F.
		ENDIF
		lcRest = SUBSTR(lcRest, lnEnde + 1)
		IF EMPTY(lcRest)
		    RETURN .T.
		ENDIF
		IF NOT (LEFT(lcRest, 12) == "BASISBETRAG=") OR RIGHT(lcRest, 1) # "#"
		    RETURN .F.
		ENDIF
		RETURN This.SkontoDezimal(SUBSTR(lcRest, 13, LEN(lcRest) - 13), .T.)
	ENDPROC

	PROTECTED PROCEDURE SplitLand
		LPARAMETERS toPartei
		IF VARTYPE(toPartei) # "O"
		    RETURN .T.
		ENDIF
		RETURN (NOT This.IstText(toPartei.cLand) OR This.CodeNormal(toPartei.cLand) == "IT") AND ;
		    (VARTYPE(toPartei.oRegisterAdresse) # "O" OR NOT This.IstText(toPartei.oRegisterAdresse.cLand) OR ;
		    This.CodeNormal(toPartei.oRegisterAdresse.cLand) == "IT")
	ENDPROC

	PROTECTED PROCEDURE StellenPruefen
		LPARAMETERS tuWert, tnStellen, tcPosition, tcBT
		IF This.IstZahl(tuWert)
			IF tuWert # ROUND(tuWert, tnStellen)
				= This.Meldung("WARNUNG", tcPosition, tcBT, "FX-DEZ-01", ;
					"{1} hat mehr als {2} Dezimalstellen.", tcBT, ALLTRIM(STR(tnStellen)))
			ENDIF
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SteuerangabenAnwenden
		LOCAL lnK, loK, lnGruppe, loG
		FOR lnK = 1 TO This.nSteuerangaben
		    loK = This.aSteuerangaben[lnK]
		    IF NOT This.ProduktKind(loK, "BT-118", "")
		        LOOP
		    ENDIF
		    = This.KopfText(loK.cBefreiungsgrund, "BT-120", .F.)
		    = This.KopfText(loK.cBefreiungscode, "BT-121", .F.)
		    = This.KopfText(loK.cSteuerkategorie, "BT-118", .F.)
		    = This.Pflicht(This.IstZahl(loK.nSteuersatz), "", "BT-119", "FX-TECH-03")
		    = This.StellenPruefen(loK.nSteuersatz, 2, "", "BT-119")
		    = This.SteuerZusatzbetrag(loK.nPositionsbasis, "BT-X-262")
		    = This.SteuerZusatzbetrag(loK.nBelegaenderungsbasis, "BT-X-263")
		    IF NOT This.IstZahl(loK.nSteuersatz)
		        LOOP
		    ENDIF
		    IF This.CodeNormal(loK.cSteuerkategorie) == "O" AND ROUND(loK.nSteuersatz, 2) # 0
		        = This.Meldung("FEHLER", "", "BT-119", "FX-TECH-03", "Der Steuersatz muss f{ue}r O null sein.")
		        LOOP
		    ENDIF
		    lnGruppe = This.Steuerangabengruppe(loK)
		    IF lnGruppe = 0
		        = This.Meldung("FEHLER", "", "BT-118", "FX-TECH-03", "Die Steuerangabe passt zu keiner eindeutig zugeordneten Gruppe. In EXTENDED unterscheiden auch Grund und Code die Eintr{ae}ge.")
		        LOOP
		    ENDIF
		    loG = This.aSteuergruppen[lnGruppe]
		    loG.cBefreiungsgrund = loK.cBefreiungsgrund
		    loG.cBefreiungscode = This.CodeNormal(loK.cBefreiungscode)
		    loG.nPositionsbasis = loK.nPositionsbasis
		    loG.nBelegaenderungsbasis = loK.nBelegaenderungsbasis
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE Steuerangabengruppe
		LPARAMETERS toK
		LOCAL lnG, loG, lnAnzahl, lnTreffer, lcKategorie
		lcKategorie = This.CodeNormal(toK.cSteuerkategorie)
		lnTreffer = This.SteuergruppeFinden(toK.cSteuerkategorie, toK.nSteuersatz, toK.cBefreiungsgrund, toK.cBefreiungscode)
		IF lnTreffer > 0 OR This.cProfil # "EXTENDED" OR ;
		    NOT (lcKategorie == "Z" OR lcKategorie == "E" OR lcKategorie == "AE" OR ;
		    lcKategorie == "G" OR lcKategorie == "K" OR lcKategorie == "O" OR ;
		    lcKategorie == "L" OR lcKategorie == "M")
		    RETURN lnTreffer
		ENDIF
		* Legacy EXTENDED permits a header reason on an otherwise unique rate group.
		lnAnzahl = 0
		FOR lnG = 1 TO This.nSteuergruppen
		    loG = This.aSteuergruppen[lnG]
		    IF loG.cSteuerkategorie == lcKategorie AND loG.nSteuersatz = ROUND(toK.nSteuersatz, 2)
		        lnAnzahl = lnAnzahl + 1
		        lnTreffer = lnG
		    ENDIF
		ENDFOR
		RETURN IIF(lnAnzahl = 1, lnTreffer, 0)
	ENDPROC

	PROTECTED PROCEDURE SteuerBasis
		LPARAMETERS tnSatz, tnAnzahl, toGruppe, tcKategorie
		LOCAL lnPosition, loPosition, lnBasis, lnK, loK, lnVorzeichen, lcKategorie
		lcKategorie = "S"
		IF VARTYPE(toGruppe) = "O"
			lcKategorie = This.CodeNormal(toGruppe.cSteuerkategorie)
		ENDIF
		IF PCOUNT() >= 4
			lcKategorie = tcKategorie
		ENDIF
		lnBasis = 0
		tnAnzahl = 0
		FOR lnPosition = 1 TO This.nPositionen
			loPosition = This.aPositionen[lnPosition]
			IF VARTYPE(loPosition) = "O" AND NOT This.IstDetailposition(loPosition)
				LOOP
			ENDIF
			IF VARTYPE(loPosition) = "O"
				IF This.CodeNormal(loPosition.cSteuerkategorie) == lcKategorie AND ;
					(This.IstZahl(loPosition.nSteuersatz) OR (lcKategorie == "O" AND ISNULL(loPosition.nSteuersatz))) AND This.IstZahl(loPosition.nNettobetrag)
					IF lcKategorie == "O" OR ROUND(loPosition.nSteuersatz, 2) = tnSatz OR ;
						(This.cProfil # "EXTENDED" AND NOT INLIST(lcKategorie, "S", "L", "M", "B"))
						IF VARTYPE(toGruppe) = "O" AND This.cProfil == "EXTENDED"
							IF NOT (This.SteuergrundNormal(toGruppe.cBefreiungsgrund) == This.SteuergrundNormal(loPosition.cSteuerbefreiungsgrund)) OR NOT (toGruppe.cBefreiungscode == This.CodeNormal(loPosition.cSteuerbefreiungscode))
								LOOP
							ENDIF
						ENDIF
						lnBasis = lnBasis + loPosition.nNettobetrag
						tnAnzahl = tnAnzahl + 1
					ENDIF
				ENDIF
			ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nBelegaenderungen + This.nLogistikentgelte
			lnVorzeichen = 1
			IF lnK <= This.nBelegaenderungen
				loK = This.aBelegaenderungen[lnK]
				IF VARTYPE(loK) # "O" OR VARTYPE(loK.lZuschlag) # "L"
					LOOP
				ENDIF
				lnVorzeichen = IIF(loK.lZuschlag, 1, -1)
			ELSE
				loK = This.aLogistikentgelte[lnK - This.nBelegaenderungen]
			ENDIF
			IF VARTYPE(loK) # "O"
				LOOP
			ENDIF
			IF NOT (This.IstZahl(loK.nSteuersatz) OR (lcKategorie == "O" AND ISNULL(loK.nSteuersatz))) OR NOT This.IstZahl(loK.nRechenbetrag)
				LOOP
			ENDIF
			IF NOT (This.CodeNormal(loK.cSteuerkategorie) == lcKategorie) OR ;
				(NOT (lcKategorie == "O") AND ROUND(loK.nSteuersatz, 2) # tnSatz AND NOT (This.cProfil # "EXTENDED" AND NOT INLIST(lcKategorie, "S", "L", "M", "B")))
				LOOP
			ENDIF
			IF VARTYPE(toGruppe) = "O" AND This.cProfil == "EXTENDED"
				IF NOT (This.SteuergrundNormal(toGruppe.cBefreiungsgrund) == This.SteuergrundNormal(loK.cSteuerbefreiungsgrund)) OR ;
					NOT (toGruppe.cBefreiungscode == This.CodeNormal(loK.cSteuerbefreiungscode))
					LOOP
				ENDIF
			ENDIF
			lnBasis = lnBasis + lnVorzeichen * loK.nRechenbetrag
			tnAnzahl = tnAnzahl + 1
		ENDFOR
		RETURN ROUND(lnBasis, 2)
	ENDPROC

	PROTECTED PROCEDURE SteuerbasisErgaenzen
		LPARAMETERS toK, tnBetrag
		LOCAL lnGruppe, loGruppe, lnSatz, lcKategorie
		lcKategorie = This.CodeNormal(toK.cSteuerkategorie)
		IF NOT This.SteuerBerechenbar(toK) OR NOT This.IstZahl(tnBetrag)
		    RETURN
		ENDIF
		* O has no input rate; its internal group key and BT-119 are zero.
		lnSatz = IIF(lcKategorie == "O", 0, ROUND(This.RechenNumeric(toK.nSteuersatz), 2))
		IF (lcKategorie == "S" AND lnSatz <= 0)
		    RETURN
		ENDIF
		lnGruppe = This.SteuergruppeFinden(lcKategorie, lnSatz, toK.cSteuerbefreiungsgrund, toK.cSteuerbefreiungscode)
		IF lnGruppe = 0
		    loGruppe = CREATEOBJECT("fxSteuergruppe")
		    IF VARTYPE(loGruppe) # "O" OR NOT This.MeldezielSetzen(loGruppe)
		        RETURN .F.
		    ENDIF
		    loGruppe.cSteuerkategorie = lcKategorie
		    loGruppe.nSteuersatz = lnSatz
		    IF This.cProfil == "EXTENDED"
		        loGruppe.cBefreiungsgrund = toK.cSteuerbefreiungsgrund
		        loGruppe.cBefreiungscode = This.CodeNormal(toK.cSteuerbefreiungscode)
		    ENDIF
		    lnGruppe = This.nSteuergruppen + 1
		    DIMENSION This.aSteuergruppen[lnGruppe]
		    This.aSteuergruppen[lnGruppe] = loGruppe
		    This.nGruppenAnzahl = lnGruppe
		ENDIF
		loGruppe = This.aSteuergruppen[lnGruppe]
		loGruppe.nBasis = ROUND(loGruppe.nBasis + tnBetrag, 2)
	ENDPROC

	PROTECTED PROCEDURE SteuerBerechenbar
		LPARAMETERS toK
		LOCAL lcKategorie
		lcKategorie = This.CodeNormal(toK.cSteuerkategorie)
		RETURN (This.IstZahl(toK.nSteuersatz) OR (lcKategorie == "O" AND ISNULL(toK.nSteuersatz))) AND ;
		    This.IstRechenkategorie(lcKategorie) AND ;
		    (NOT INLIST(lcKategorie, "S", "L") OR ROUND(toK.nSteuersatz, 2) > 0) AND ;
		    (NOT (lcKategorie == "M") OR ROUND(toK.nSteuersatz, 2) >= 0)
	ENDPROC

	PROTECTED PROCEDURE Steuerfamilie
		LPARAMETERS tcKategorie
		DO CASE
		CASE tcKategorie == "K"
		    RETURN "IC"
		CASE tcKategorie == "L"
		    RETURN "AF"
		CASE tcKategorie == "M"
		    RETURN "AG"
		ENDCASE
		RETURN tcKategorie
	ENDPROC

	PROTECTED PROCEDURE SteuergrundNormal
		LPARAMETERS tuWert
		LOCAL lcWert
		IF NOT INLIST(VARTYPE(tuWert), "C", "M")
			RETURN ""
		ENDIF
		lcWert = ALLTRIM(CHRTRAN(tuWert, CHR(9) + CHR(10) + CHR(13), "   "))
		DO WHILE "  " $ lcWert
			lcWert = STRTRAN(lcWert, "  ", " ")
		ENDDO
		RETURN lcWert
	ENDPROC

	PROTECTED PROCEDURE SteuergruppeFinden
		LPARAMETERS tcKategorie, tnSatz, tcGrund, tcCode
		LOCAL lnGruppe, loGruppe
		FOR lnGruppe = 1 TO This.nSteuergruppen
			loGruppe = This.aSteuergruppen[lnGruppe]
			IF loGruppe.cSteuerkategorie == This.CodeNormal(tcKategorie) AND (loGruppe.cSteuerkategorie == "O" OR loGruppe.nSteuersatz = ROUND(tnSatz, 2))
				IF PCOUNT() >= 3 AND This.cProfil == "EXTENDED"
					IF NOT (This.SteuergrundNormal(loGruppe.cBefreiungsgrund) == This.SteuergrundNormal(tcGrund)) OR NOT (loGruppe.cBefreiungscode == This.CodeNormal(tcCode))
						LOOP
					ENDIF
				ENDIF
				RETURN lnGruppe
			ENDIF
		ENDFOR
		RETURN 0
	ENDPROC

	PROTECTED PROCEDURE SteuergruppenAnzahl
		LPARAMETERS tcKategorie
		LOCAL lnG, lnAnzahl
		lnAnzahl = 0
		FOR lnG = 1 TO This.nSteuergruppen
			IF This.CodeNormal(This.aSteuergruppen[lnG].cSteuerkategorie) == tcKategorie
				lnAnzahl = lnAnzahl + 1
			ENDIF
		ENDFOR
		RETURN lnAnzahl
	ENDPROC

	PROTECTED PROCEDURE SteuerZusatzbetrag
		LPARAMETERS tuBetrag, tcBT
		IF ISNULL(tuBetrag)
		    RETURN .T.
		ENDIF
		= This.ProfilFeld(.T., tcBT)
		= This.Pflicht(This.IstZahl(tuBetrag), "", tcBT, "FX-TECH-03")
		= This.StellenPruefen(tuBetrag, 2, "", tcBT)
	ENDPROC

	PROTECTED PROCEDURE SummenZahl
		    LPARAMETERS tuWert, tcBT
		    = This.Pflicht(ISNULL(tuWert) OR This.IstZahl(tuWert), "", tcBT, "FX-TECH-03")
		    = This.StellenPruefen(tuWert, 2, "", tcBT)
	ENDPROC

	PROTECTED PROCEDURE TelefonGueltig
		LPARAMETERS tuTelefon
		LOCAL lnZeichen, lnZiffern
		IF NOT This.IstText(tuTelefon)
			RETURN .F.
		ENDIF
		lnZiffern = 0
		FOR lnZeichen = 1 TO LEN(tuTelefon)
			IF AT(SUBSTR(tuTelefon, lnZeichen, 1), "0123456789") > 0
				lnZiffern = lnZiffern + 1
			ENDIF
		ENDFOR
		RETURN lnZiffern >= 3
	ENDPROC

	PROTECTED PROCEDURE UriGueltig
		LPARAMETERS tcUri
		LOCAL lcSchema, lnZeichen, lnDoppelpunkt, lcBuchstaben
		* Dasselbe Muster wie XR-URL-REGEX im lokalen KoSIT-Stand.
		lnDoppelpunkt = AT(":", tcUri)
		IF lnDoppelpunkt < 3
			RETURN .F.
		ENDIF
		lcBuchstaben = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		lcSchema = LEFT(tcUri, lnDoppelpunkt - 1)
		IF NOT LEFT(lcSchema, 1) $ lcBuchstaben
			RETURN .F.
		ENDIF
		FOR lnZeichen = 2 TO LEN(lcSchema)
			IF NOT SUBSTR(lcSchema, lnZeichen, 1) $ lcBuchstaben + "0123456789+.-"
				RETURN .F.
			ENDIF
		ENDFOR
		RETURN .T.
	ENDPROC

	PROCEDURE Validate
		LOCAL llOk
		This.nLaufTiefe = This.nLaufTiefe + 1
		llOk = This.ValidateLauf()
		This.nLaufTiefe = This.nLaufTiefe - 1
		RETURN llOk
	ENDPROC

	PROTECTED PROCEDURE ValidateAbrechnungszeitraum
		LOCAL loZ, llAnfang, llEnde
		loZ = This.oAbrechnungszeitraum
		IF ISNULL(loZ)
			RETURN
		ENDIF
		IF NOT This.ReferenzObjekt(loZ, "BG-14")
			RETURN
		ENDIF
		= This.KopfText(loZ.cBeschreibung, "BT-X-264", .T.)
		= This.PruefeLieferdatum(loZ.dAnfang, "BT-73")
		= This.PruefeLieferdatum(loZ.dEnde, "BT-74")
		llAnfang = VARTYPE(loZ.dAnfang) = "D" AND NOT EMPTY(loZ.dAnfang)
		llEnde = VARTYPE(loZ.dEnde) = "D" AND NOT EMPTY(loZ.dEnde)
		= This.Pflicht(llAnfang OR llEnde, "", "BG-14", "BR-CO-19")
		IF llAnfang AND llEnde
			IF loZ.dEnde < loZ.dAnfang
				= This.Meldung("FEHLER", "", "BT-74", "BR-29", "BT-74 darf nicht vor BT-73 liegen.")
			ENDIF
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateAnhaenge
		LOCAL lnAnhang, lnVorher, loA, loB, ln50, ln130, lnNamen, lnDateien
		STORE 0 TO ln50, ln130, lnNamen, lnDateien
		FOR lnAnhang = 1 TO This.nAnhaenge
			loA = This.aAnhaenge[lnAnhang]
			IF NOT This.ReferenzObjekt(loA, "BT-122")
				LOOP
			ENDIF
			= This.ValidateAnhang(loA)
			ln50 = ln50 + IIF(This.CodeNormal(loA.cTyp) == "50", 1, 0)
			ln130 = ln130 + IIF(This.CodeNormal(loA.cTyp) == "130", 1, 0)
			IF This.CodeNormal(loA.cTyp) == "916"
				lnNamen = lnNamen + IIF(This.IstText(loA.cBeschreibung), 1, 0)
				lnDateien = lnDateien + IIF(This.IstText(loA.cBase64), 1, 0)
			ENDIF
			IF This.cProfil == "XRECHNUNG-CII" AND This.IstText(loA.cBase64)
				FOR lnVorher = 1 TO lnAnhang - 1
					loB = This.aAnhaenge[lnVorher]
					IF VARTYPE(loB) = "O"
						IF This.IstText(loB.cBase64) AND loA.cDateiname == loB.cDateiname
							= This.Meldung("FEHLER", "", "BT-125-2", "BR-DE-22", ;
								"Der Anhangname {1} kommt mehrfach vor.", loA.cDateiname)
							EXIT
						ENDIF
					ENDIF
				ENDFOR
			ENDIF
		ENDFOR
		= This.AnhangAnzahlPruefen(ln50, ln130, lnNamen, lnDateien)
	ENDPROC

	PROTECTED PROCEDURE ValidateAnhang
		LPARAMETERS toA
		LOCAL lcTyp, lcBT, lcDatumBT, llDatei, loCodes
		lcTyp = This.CodeNormal(toA.cTyp)
		lcBT = IIF(lcTyp == "50", "BT-17", IIF(lcTyp == "130", "BT-18", "BT-122"))
		= This.KopfText(toA.cNummer, lcBT, .F.)
		= This.Pflicht(INLIST(VARTYPE(toA.cZeile), "C", "M") AND NOT This.IstText(toA.cZeile), "", lcBT, "FX-TECH-03")
		= This.Pflicht(This.IstText(toA.cNummer), "", lcBT, "BR-52")
		= This.Pflicht(INLIST(lcTyp, "50", "130", "916"), "", lcBT, "FX-TECH-03")
		= This.KopfText(toA.cTyp, lcBT + "-0", .F.)
		= This.KopfText(toA.cReferenzart, "BT-18-1", .F.)
		lcDatumBT = This.AnhangDatumBT(lcTyp)
		IF VARTYPE(toA.dDatum) # "D" OR NOT EMPTY(toA.dDatum)
			= This.ProfilFeld(.T., lcDatumBT)
			IF This.Pflicht(VARTYPE(toA.dDatum) = "D", "", lcDatumBT, "FX-TECH-03")
				= This.PruefeDatumswert(DTOS(toA.dDatum), "102", lcDatumBT)
			ENDIF
		ENDIF
		= This.KopfText(toA.cDatei, "BT-125", .F.)
		= This.KopfText(toA.cDateiname, "BT-125-2", .F.)
		= This.KopfText(toA.cMime, "BT-125-1", .F.)
		= This.KopfText(toA.cBeschreibung, "BT-123", .F.)
		= This.KopfText(toA.cUri, "BT-124", .F.)
		loCodes = CREATEOBJECT("fxCodelisten")
		IF NOT This.MeldezielSetzen(loCodes)
			RETURN .F.
		ENDIF
		IF lcTyp == "130"
			= This.PruefeCode(loCodes, toA.cReferenzart, "BT-18-1", ;
				IIF(This.cProfil == "EXTENDED", "FX-SCH-A-000639", "BR-CL-07"), "")
		ELSE
			IF This.IstText(toA.cReferenzart)
				= This.Meldung("FEHLER", "", "BT-18-1", "FX-TECH-03", ;
					"{1} ist hier beim Typ {2} nicht zul{ae}ssig.", "BT-18-1", lcTyp)
			ENDIF
		ENDIF
		llDatei = toA.DateiLaden()
		= This.ValidateAnhangInhalt(toA, lcTyp, loCodes)
		RETURN llDatei
	ENDPROC

	PROTECTED PROCEDURE ValidateAnhangInhalt
		LPARAMETERS toA, tcTyp, toCodes
		LOCAL lcMimeRegel
		IF tcTyp # "916"
			IF This.IstText(toA.cDatei)
				= This.Meldung("FEHLER", "", "BT-125", "FX-TECH-03", ;
					"{1} ist hier beim Typ {2} nicht zul{ae}ssig.", "BT-125", tcTyp)
			ENDIF
			IF This.IstText(toA.cBeschreibung)
				= This.Meldung("FEHLER", "", "BT-123", "FX-TECH-03", ;
					"{1} ist hier beim Typ {2} nicht zul{ae}ssig.", "BT-123", tcTyp)
			ENDIF
			IF This.IstText(toA.cUri)
				= This.Meldung("FEHLER", "", "BT-124", "FX-TECH-03", ;
					"{1} ist hier beim Typ {2} nicht zul{ae}ssig.", "BT-124", tcTyp)
			ENDIF
		ENDIF
		IF This.IstText(toA.cDatei)
			lcMimeRegel = IIF(This.cProfil == "EXTENDED", "FX-SCH-A-000644", "BR-CL-24")
			= This.Pflicht(This.IstText(toA.cMime), "", "BT-125-1", "FX-SCH-A-000285")
			= This.PruefeCode(toCodes, toA.cMime, "BT-125-1", lcMimeRegel, "")
			= This.Pflicht(This.IstText(toA.cDateiname), "", "BT-125-2", "FX-SCH-A-000286")
		ELSE
			IF This.IstText(toA.cMime)
				= This.Meldung("FEHLER", "", "BT-125-1", "FX-TECH-03", ;
					"{1} ist hier nicht zul{ae}ssig.", "BT-125-1")
			ENDIF
			IF This.IstText(toA.cDateiname)
				= This.Meldung("FEHLER", "", "BT-125-2", "FX-TECH-03", ;
					"{1} ist hier nicht zul{ae}ssig.", "BT-125-2")
			ENDIF
		ENDIF
		IF This.cProfil == "XRECHNUNG-CII" AND This.IstText(toA.cUri)
			IF NOT This.UriGueltig(This.CodeNormal(toA.cUri))
				= This.Meldung("FEHLER", "", "BT-124", "BR-TMP-2", ;
					"Die URI {1} ist keine g{ue}ltige absolute URL.", toA.cUri)
			ENDIF
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateBedingungsPayee
		LPARAMETERS toP, toCodes
		IF NOT This.KopfRolle(toP, "BT-X-504", .T.)
			RETURN
		ENDIF
		= This.RollenText(toCodes, toP.cName, "BT-X-504", .F., "")
		= This.RollenText(toCodes, toP.cRolle, "BT-X-511", .T., "")
		= This.RollenText(toCodes, toP.cRegisternummer, "BT-X-508", .F., "")
		= This.RollenText(toCodes, toP.cRegisterSchema, "BT-X-508-0", .F., "BR-CL-11")
		= This.RollenText(toCodes, toP.cHandelsname, "BT-X-505", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresse, "BT-X-510", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresseSchema, "BT-X-510-0", .T., "BR-CL-25")
		= This.RollenText(toCodes, toP.cUstId, "BT-X-509", .T., "")
		IF NOT ISNULL(toP.cBeschreibung) AND (NOT INLIST(VARTYPE(toP.cBeschreibung), "C", "M") OR This.IstText(toP.cBeschreibung))
			= This.Pflicht(.F., "", "BT-X-504", "FX-PROFIL-01")
		ENDIF
		= This.RollenKennungen(toP, toCodes, "BT-X-506", "BT-X-507", ;
			"BT-X-507-0", "FX-SCH-A-000984", .T.)
		= This.RollenAttribut(toP.cElektronischeAdresse, toP.cElektronischeAdresseSchema, "BT-X-510")
		IF This.IstText(toP.cRegisterSchema) AND NOT This.IstText(toP.cRegisternummer)
			= This.Pflicht(.F., "", "BT-X-508", "FX-TECH-03")
		ENDIF
		= This.RollenPostanschrift(toP, toCodes, .T., ;
			"BT-X-518", "BT-X-519", "BT-X-520", "BT-X-521", ;
			"BT-X-522", "BT-X-523", "BT-X-524")
		= This.RollenRegisteranschrift(toP.oRegisterAdresse, toCodes, ;
			"BT-X-525", "BT-X-526", "BT-X-527", "BT-X-528", ;
			"BT-X-529", "BT-X-530", "BT-X-531", "FX-SCH-A-000998")
		= This.RollenKontakte(toP, toCodes, "BT-X-512", "BT-X-513", "BT-X-514", ;
			"BT-X-515", "BT-X-516", "BT-X-517")
		= This.ValidateUstPraefix(toCodes, toP.cUstId, "BT-X-509")
		= This.KopfText(toP.cSteuernummer, "BT-X-509", .T.)
		IF This.IstText(toP.cSteuernummer)
			= This.Pflicht(.F., "", "BT-X-509-0", IIF(This.cProfil == "EXTENDED", "BR-FXEXT-03", "FX-PROFIL-01"))
		ENDIF
		= This.Pflicht(This.IstText(toP.cName), "", "BT-X-504", "BR-17")
		= This.Pflicht(This.IstText(toP.cName), "", "BT-X-504", "FX-SCH-A-000985")
		IF This.cProfil == "EXTENDED" AND This.AdresseVorhanden(toP)
			= This.Pflicht(This.IstText(toP.cLand), "", "BT-X-523", "FX-SCH-A-000994")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateBelegaenderung
		LPARAMETERS toK, toCodes
		LOCAL llZ, lcBT, lcRegel
		llZ = VARTYPE(toK.lZuschlag) = "L" AND toK.lZuschlag
		lcBT = IIF(llZ, "BT-99", "BT-92")
		lcRegel = IIF(This.cProfil == "XRECHNUNG-CII", "PEPPOL-EN16931-R043-1", "FX-TECH-03")
		= This.Pflicht(VARTYPE(toK.lZuschlag) = "L", "", IIF(llZ, "BG-21-1", "BG-20-1"), lcRegel)
		= This.Pflicht(This.IstZahl(toK.nRechenbetrag), "", lcBT, IIF(llZ, "BR-36", "BR-31"))
		= This.Pflicht(ISNULL(toK.nBetrag) OR This.IstZahl(toK.nBetrag), "", lcBT, "FX-TECH-03")
		= This.StellenPruefen(toK.nBetrag, 2, "", lcBT)
		= This.ValidateBelegprozent(toK, llZ)
		= This.ProduktText(toK.cGrund, IIF(llZ, "BT-104", "BT-97"), "", .F.)
		= This.ProduktText(toK.cGrundcode, IIF(llZ, "BT-105", "BT-98"), "", .F.)
		= This.ProduktText(toK.cGrundliste, "BT-177-1", "", .T.)
		IF NOT This.IstText(toK.cGrund) AND NOT This.IstText(toK.cGrundcode)
		    lcRegel = IIF(llZ, IIF(This.cProfil == "EXTENDED", "BR-FXEXT-BR-38", "BR-38"), "BR-33")
		    = This.Pflicht(.F., "", IIF(llZ, "BT-104", "BT-97"), lcRegel)
		    IF NOT llZ OR This.cProfil # "EXTENDED"
		        = This.Pflicht(.F., "", IIF(llZ, "BT-104", "BT-97"), IIF(llZ, "BR-CO-22", "BR-CO-21"))
		    ENDIF
		ENDIF
		IF This.IstText(toK.cGrundliste)
		    = This.Pflicht(llZ AND This.IstText(toK.cGrundcode) AND This.CodeNormal(toK.cGrundliste) == "5153", "", "BT-177-1", "FX-TECH-03")
		ENDIF
		lcRegel = IIF(llZ, "BR-CL-20", "BR-CL-19")
		IF This.cProfil == "EXTENDED"
		    lcRegel = IIF(llZ, IIF(This.CodeNormal(toK.cGrundliste) == "5153", "FX-SCH-A-000390", "FX-SCH-A-000978"), "FX-SCH-A-000973")
		ENDIF
		= This.PruefeCode(toCodes, toK.cGrundcode, IIF(llZ, "BT-105", "BT-98"), lcRegel, "")
		= This.ValidateBelegzusatz(toK, toCodes, llZ)
		= This.ValidateBelegsteuer(toK, toCodes, llZ, .F.)
	ENDPROC

	PROTECTED PROCEDURE ValidateBeleggruppen
		LOCAL lnK, loK, loCodes
		IF This.nBelegaenderungen = 0 AND This.nLogistikentgelte = 0
			RETURN
		ENDIF
		loCodes = CREATEOBJECT("fxCodelisten")
		= This.MeldezielSetzen(loCodes)
		= loCodes.EinheitenLaden(This.cXsdPfad)
		FOR lnK = 1 TO This.nBelegaenderungen
		    loK = This.aBelegaenderungen[lnK]
		    IF VARTYPE(loK) # "O"
		        = This.Pflicht(.F., "", "BG-20", "FX-TECH-03")
		        LOOP
		    ENDIF
		    = This.ValidateBelegaenderung(loK, loCodes)
		ENDFOR
		FOR lnK = 1 TO This.nLogistikentgelte
		    loK = This.aLogistikentgelte[lnK]
		    = This.ProfilFeld(.T., "BG-X-42")
		    IF VARTYPE(loK) # "O"
		        = This.Pflicht(.F., "", "BG-X-42", "FX-TECH-03")
		        LOOP
		    ENDIF
		    = This.ProduktText(loK.cBeschreibung, "BT-X-271", "", .T.)
		    = This.Pflicht(This.IstText(loK.cBeschreibung), "", "BT-X-271", "FX-TECH-03")
		    = This.Pflicht(This.IstZahl(loK.nBetrag), "", "BT-X-272", "FX-TECH-03")
		    = This.StellenPruefen(loK.nBetrag, 2, "", "BT-X-272")
		    = This.ValidateBelegsteuer(loK, loCodes, .T., .T.)
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateBelegprozent
		LPARAMETERS toK, tlZ
		LOCAL lnSoll, lcBT, lcRegel
		= This.Pflicht(ISNULL(toK.nBasis) OR This.IstZahl(toK.nBasis), "", IIF(tlZ, "BT-100", "BT-93"), "FX-TECH-03")
		= This.Pflicht(ISNULL(toK.nProzent) OR This.IstZahl(toK.nProzent), "", IIF(tlZ, "BT-101", "BT-94"), "FX-TECH-03")
		= This.StellenPruefen(toK.nBasis, 2, "", IIF(tlZ, "BT-100", "BT-93"))
		= This.StellenPruefen(toK.nProzent, 2, "", IIF(tlZ, "BT-101", "BT-94"))
		IF This.cProfil == "XRECHNUNG-CII"
		    = This.Pflicht(ISNULL(toK.nProzent) OR This.IstZahl(toK.nBasis), "", IIF(tlZ, "BT-100", "BT-93"), "PEPPOL-EN16931-R041")
		    = This.Pflicht(ISNULL(toK.nBasis) OR This.IstZahl(toK.nProzent), "", IIF(tlZ, "BT-101", "BT-94"), "PEPPOL-EN16931-R042")
		ENDIF
		IF This.IstZahl(toK.nRechenbetrag) AND This.IstZahl(toK.nBasis) AND This.IstZahl(toK.nProzent)
		    lnSoll = ROUND(This.RechenNumeric(toK.nBasis), 2) * ROUND(This.RechenNumeric(toK.nProzent), 2) / 100
		    IF This.cProfil # "XRECHNUNG-CII"
		        lnSoll = ROUND(lnSoll, 2)
		    ENDIF
		    lcBT = IIF(tlZ, "BT-99", "BT-92")
		    lcRegel = IIF(This.cProfil == "XRECHNUNG-CII", "PEPPOL-EN16931-R040", "FX-TECH-03")
		    IF ROUND(ABS(toK.nRechenbetrag - lnSoll), 6) > IIF(This.cProfil == "XRECHNUNG-CII", 0.02, 0)
		        = This.Meldung("FEHLER", "", lcBT, lcRegel, "Betrag {1} passt nicht zu Basis mal Prozent {2}.", ;
		            This.RechenZahl(toK.nRechenbetrag), This.RechenZahl(lnSoll))
		    ENDIF
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateBelegsteuer
		LPARAMETERS toK, toCodes, tlZ, tlLogistik
		LOCAL lcBT, lcRegel, lcKategorie
		lcBT = IIF(tlLogistik, "BT-X-273", IIF(tlZ, "BT-102", "BT-95"))
		lcRegel = IIF(tlLogistik, "FX-TECH-03", IIF(tlZ, "BR-37", "BR-32"))
		= This.ProduktText(toK.cSteuerkategorie, lcBT, "", tlLogistik)
		= This.Pflicht(This.IstText(toK.cSteuerkategorie), "", lcBT, lcRegel)
		lcRegel = "BR-CL-17"
		IF This.cProfil == "EXTENDED"
		    lcRegel = IIF(tlLogistik, "FX-SCH-A-000966", IIF(tlZ, "FX-SCH-A-000975", "FX-SCH-A-000970"))
		ENDIF
		= This.PruefeCode(toCodes, toK.cSteuerkategorie, lcBT, lcRegel, "")
		lcKategorie = This.CodeNormal(toK.cSteuerkategorie)
		IF NOT EMPTY(lcKategorie) AND NOT This.IstRechenkategorie(lcKategorie) AND toCodes.Gueltig("BR-CL-17", lcKategorie, This.cProfil)
		    = This.Meldung("FEHLER", "", lcBT, "FX-TECH-03", "Die Steuerkategorie {1} wird in diesem Stand noch nicht berechnet.", lcKategorie)
		ENDIF
		lcBT = IIF(tlLogistik, "BT-X-274", IIF(tlZ, "BT-103", "BT-96"))
		= This.Pflicht(IIF(tlLogistik, This.IstZahl(toK.nSteuersatz), ;
		    ISNULL(toK.nSteuersatz) OR This.IstZahl(toK.nSteuersatz)), "", lcBT, "FX-TECH-03")
		= This.StellenPruefen(toK.nSteuersatz, 2, "", lcBT)
		IF lcKategorie == "S"
			= This.Pflicht(This.IstZahl(toK.nSteuersatz) AND ROUND(toK.nSteuersatz, 2) > 0, "", lcBT, IIF(tlLogistik, "FX-TECH-03", IIF(tlZ, "BR-S-07", "BR-S-06")))
			IF NOT tlLogistik
				= This.Pflicht(This.VerkaeuferSteuerkennung(), "", "BT-31", IIF(tlZ, "BR-S-04", "BR-S-03"))
			ENDIF
		ENDIF
		IF NOT tlLogistik
			= This.ValidateNullsteuerEintrag(toK, "", lcBT, IIF(tlZ, 2, 1))
		ENDIF
		lcBT = IIF(tlLogistik, "BT-X-591", IIF(tlZ, "BT-175", "BT-173"))
		= This.ProduktText(toK.cSteuerbefreiungsgrund, lcBT, "", .T.)
		lcBT = IIF(tlLogistik, "BT-X-592", IIF(tlZ, "BT-176", "BT-174"))
		= This.ProduktText(toK.cSteuerbefreiungscode, lcBT, "", .T.)
		lcRegel = IIF(tlLogistik, "FX-SCH-A-000967", IIF(tlZ, "FX-SCH-A-000976", "FX-SCH-A-000971"))
		= This.PruefeCode(toCodes, toK.cSteuerbefreiungscode, lcBT, lcRegel, "")
	ENDPROC

	PROTECTED PROCEDURE ValidateBelegsummen
		LPARAMETERS tnNachlass, tnZuschlag
		LOCAL lnK, loK, lnNachlass, lnZuschlag, lnN, lnZ, lnToleranz
		STORE 0 TO lnNachlass, lnZuschlag, lnN, lnZ
		FOR lnK = 1 TO This.nBelegaenderungen
		    loK = This.aBelegaenderungen[lnK]
		    IF VARTYPE(loK) = "O" AND VARTYPE(loK.lZuschlag) = "L" AND This.IstZahl(loK.nRechenbetrag)
		        IF loK.lZuschlag
		            lnZuschlag = lnZuschlag + loK.nRechenbetrag
		            lnZ = lnZ + 1
		        ELSE
		            lnNachlass = lnNachlass + loK.nRechenbetrag
		            lnN = lnN + 1
		        ENDIF
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nLogistikentgelte
		    loK = This.aLogistikentgelte[lnK]
		    IF VARTYPE(loK) = "O" AND This.IstZahl(loK.nRechenbetrag)
		        lnZuschlag = lnZuschlag + loK.nRechenbetrag
		        lnZ = lnZ + 1
		    ENDIF
		ENDFOR
		tnNachlass = ROUND(lnNachlass, 2)
		tnZuschlag = ROUND(lnZuschlag, 2)
		lnToleranz = IIF(This.cProfil == "EXTENDED", lnN * 0.01, 0)
		= This.Pflicht(lnN = 0 OR This.IstZahl(This.nNachlassSumme), "", "BT-107", This.RechenRegel("CO-11"))
		= This.PruefeRechenwert(This.nNachlassSumme, ROUND(lnNachlass, 2), lnToleranz, "BT-107", This.RechenRegel("CO-11"), "FEHLER")
		lnToleranz = IIF(This.cProfil == "EXTENDED", lnZ * 0.01, 0)
		= This.Pflicht(lnZ = 0 OR This.IstZahl(This.nZuschlagSumme), "", "BT-108", This.RechenRegel("CO-12"))
		= This.PruefeRechenwert(This.nZuschlagSumme, ROUND(lnZuschlag, 2), lnToleranz, "BT-108", This.RechenRegel("CO-12"), "FEHLER")
	ENDPROC

	PROTECTED PROCEDURE ValidateBelegzusatz
		LPARAMETERS toK, toCodes, tlZ
		LOCAL lcBT
		lcBT = IIF(tlZ, "BT-X-268", "BT-X-265")
		= This.ProfilFeld(NOT ISNULL(toK.nReihenfolge), lcBT)
		= This.Pflicht(ISNULL(toK.nReihenfolge) OR This.IstZahl(toK.nReihenfolge), "", lcBT, "FX-TECH-03")
		= This.StellenPruefen(toK.nReihenfolge, 4, "", lcBT)
		lcBT = IIF(tlZ, "BT-X-269", "BT-X-266")
		= This.ProfilFeld(NOT ISNULL(toK.nBasismenge), lcBT)
		= This.ProduktZahl(toK.nBasismenge, lcBT, "")
		= This.ProduktText(toK.cBasiseinheit, IIF(tlZ, "BT-X-270", "BT-X-267"), "", .T.)
		IF This.IstText(toK.cBasiseinheit)
		    = This.Pflicht(This.IstZahl(toK.nBasismenge), "", lcBT, "FX-TECH-03")
		    IF This.cProfil == "EXTENDED" AND EMPTY(toCodes.cListenFehler)
		        = This.PruefeCode(toCodes, toK.cBasiseinheit, IIF(tlZ, "BT-X-270", "BT-X-267"), IIF(tlZ, "FX-SCH-A-000974", "FX-SCH-A-000969"), "")
		    ENDIF
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateCodelisten
		LOCAL loCodes, lnPosition, loPosition, llEinheiten, lcPosition, lnNotiz, loNotiz
		LOCAL lnTransport, loTransport
		loCodes = CREATEOBJECT("fxCodelisten")
		IF This.lTechnischerFehler OR VARTYPE(loCodes) # "O"
			RETURN .F.
		ENDIF
		IF NOT This.MeldezielSetzen(loCodes)
			RETURN .F.
		ENDIF
		llEinheiten = loCodes.EinheitenLaden(This.cXsdPfad)
		IF NOT llEinheiten
			= This.Meldung(IIF(This.lXsdPruefung, "FEHLER", "WARNUNG"), "", "BT-130", "BR-CL-23", ;
				"Die Einheitenliste " + loCodes.cListenFehler + " (cXsdPfad: {1}); BR-CL-23 bleibt ungepr{ue}ft.", ;
				IIF(This.IstText(This.cXsdPfad), This.cXsdPfad, "leer"))
		ENDIF
		IF This.cProfil == "EXTENDED"
			= This.PruefeCode(loCodes, This.cSprache, "BT-X-4", "FX-SCH-A-000389", "")
		ENDIF
		= This.ValidateReferenzCodes(loCodes)
		FOR lnTransport = 1 TO This.nTransporte
			loTransport = This.aTransporte[lnTransport]
			IF VARTYPE(loTransport) = "O"
				= This.PruefeCode(loCodes, loTransport.cArt, "BT-X-152", "FX-SCH-A-000346", "")
			ENDIF
		ENDFOR
		FOR lnNotiz = 1 TO This.nNotizen
			loNotiz = This.aNotizen[lnNotiz]
			IF VARTYPE(loNotiz) = "O"
				= This.PruefeCode(loCodes, loNotiz.cBetreff, "BT-21", "BR-CL-08", "")
			ENDIF
		ENDFOR
		= This.PruefeCode(loCodes, This.cRechnungstyp, "BT-3", "BR-CL-01", "")
		= This.PruefeCode(loCodes, This.cWaehrung, "BT-5", "BR-CL-04", "")
		= This.PruefeCode(loCodes, This.cWaehrung, "BT-110", "BR-CL-03", "")
		= This.PruefeCode(loCodes, This.cSteuerwaehrung, "BT-6", "BR-CL-05", "")
		= This.PruefeCode(loCodes, This.cZahlungsart, "BT-81", "BR-CL-16", "")
		= This.ValidateParteiCodes(loCodes, This.oVerkaeufer, .T.)
		= This.ValidateParteiCodes(loCodes, This.oKaeufer, .F.)
		= This.ValidateKopfrollen(loCodes)
		FOR lnPosition = 1 TO This.nPositionen
			loPosition = This.aPositionen[lnPosition]
			IF VARTYPE(loPosition) # "O"
				LOOP
			ENDIF
			lcPosition = ALLTRIM(STR(lnPosition))
			IF This.IstText(loPosition.cNummer)
				lcPosition = loPosition.cNummer
			ENDIF
			= This.ValidateProdukt(loPosition, loCodes, lcPosition)
			= This.ValidatePreise(loPosition, loCodes, lcPosition)
			= This.ValidatePositionsvereinbarung(loPosition, loCodes, lcPosition)
			= This.ValidatePositionslieferung(loPosition, loCodes, lcPosition, llEinheiten)
			= This.ValidatePositionsabrechnung(loPosition, loCodes, lcPosition)
			= This.PruefeCode(loCodes, loPosition.cSteuerkategorie, "BT-151", "BR-CL-18", lcPosition)
			IF llEinheiten
				= This.PruefeCode(loCodes, loPosition.cEinheit, "BT-130", "BR-CL-23", lcPosition)
			ENDIF
		ENDFOR
		FOR lnPosition = 1 TO This.nSteuergruppen
			= This.PruefeCode(loCodes, This.aSteuergruppen[lnPosition].cBefreiungscode, "BT-121", ;
				IIF(This.cProfil == "EXTENDED", "FX-SCH-A-000855", "BR-CL-22"), "")
		ENDFOR
		RETURN NOT loCodes.lTechnischerFehler
	ENDPROC

	PROTECTED PROCEDURE ValidateDokument
		= This.KopfText(This.cDokumentname, "BT-X-2", .T.)
		= This.KopfText(This.cSprache, "BT-X-4", .T.)
		= This.KopfText(This.cProzessKennung, "BT-23", .F.)
		= This.KopfIndikator(This.lTest, "BT-X-1")
		= This.KopfIndikator(This.lKopie, "BT-X-3")
		IF VARTYPE(This.dRechnungsdatum) = "D" AND NOT EMPTY(This.dRechnungsdatum)
			= This.PruefeDatumswert(DTOS(This.dRechnungsdatum), "102", "BT-2")
		ENDIF
		IF VARTYPE(This.dVertragsfaelligkeit) # "D" OR NOT EMPTY(This.dVertragsfaelligkeit)
			= This.ProfilFeld(.T., "BT-X-6")
			IF This.Pflicht(VARTYPE(This.dVertragsfaelligkeit) = "D", "", "BT-X-6", "FX-TECH-03")
				= This.PruefeDatumswert(DTOS(This.dVertragsfaelligkeit), "102", "BT-X-6")
			ENDIF
		ENDIF
		IF This.cProfil == "XRECHNUNG-CII" AND This.IstText(This.cRechnungstyp)
			IF NOT INLIST(This.CodeNormal(This.cRechnungstyp), "326", "380", "384", "389", "381", "875", "876", "877")
				= This.Meldung("WARNUNG", "", "BT-3", "BR-DE-17", ;
					"BT-3: XRechnung empfiehlt einen der Rechnungstypen 326, 380, 384, 389, 381, 875, 876 oder 877.")
			ENDIF
		ENDIF
		= This.ValidateNotizen()
	ENDPROC

	PROTECTED PROCEDURE ValidateElternpfad
		LPARAMETERS tnStart, taEltern
		LOCAL lnP, lnSchritt, lcNummer
		lcNummer = This.aPositionen[tnStart].cNummer
		IF taEltern[tnStart] = tnStart
			RETURN This.Meldung("FEHLER", lcNummer, "BT-X-304", "FX-TECH-03", "Eine Position darf nicht ihr eigener Elternknoten sein.")
		ENDIF
		lnP = tnStart
		* Numerische Indizes statt Rueckverweisen; jeder Pfad ist streng begrenzt.
		FOR lnSchritt = 1 TO This.nPositionen
			lnP = taEltern[lnP]
			IF lnP = 0
				RETURN .T.
			ENDIF
		ENDFOR
		RETURN This.Meldung("FEHLER", lcNummer, "BT-X-304", "FX-TECH-03", "Die Elternbez{ue}ge der Position enthalten einen Zyklus.")
	ENDPROC

	PROTECTED PROCEDURE ValidateGruppensumme
		LPARAMETERS tnGruppe, taEltern
		LOCAL lnP, loP, loG, lnSumme, llVollstaendig, llGruppen, lcTyp
		loG = This.aPositionen[tnGruppe]
		lnSumme = 0
		llVollstaendig = .T.
		llGruppen = .T.
		FOR lnP = 1 TO This.nPositionen
			IF taEltern[lnP] # tnGruppe
				LOOP
			ENDIF
			loP = This.aPositionen[lnP]
			lcTyp = This.CodeNormal(loP.cUntertyp)
			IF NOT (lcTyp == "DETAIL" OR lcTyp == "GROUP")
				LOOP
			ENDIF
			IF This.IstZahl(loP.nNettobetrag)
				lnSumme = lnSumme + loP.nNettobetrag
			ELSE
				llVollstaendig = .F.
				IF lcTyp == "GROUP"
					llGruppen = .F.
				ENDIF
			ENDIF
		ENDFOR
		= This.Pflicht(llVollstaendig AND ROUND(lnSumme, 2) = loG.nNettobetrag, loG.cNummer, "BT-131", "BR-FXEXT-08")
		= This.Pflicht(llGruppen, loG.cNummer, "BT-131", "BR-FXEXT-12")
	ENDPROC

	PROTECTED PROCEDURE ValidateHersteller
		LPARAMETERS toP, toCodes, tcPosition
		LOCAL laBT[1], laRegeln[1]
		* Leere Rollen brauchen keine neu aufgebauten BT-/Regeltabellen.
		IF NOT This.ProduktKind(toP, "BG-X-93", tcPosition)
		    RETURN
		ENDIF
		IF NOT toP.Vorhanden()
		    RETURN
		ENDIF
		= ALINES(laBT, STRTRAN( ;
		    "BG-X-93 BT-X-593 BT-X-594 BT-X-594-0 BT-X-595 BT-X-596 BT-X-597 " + ;
		    "BT-X-598 BT-X-598-0 BT-X-599 BG-X-94 BT-X-600 BT-X-601 BT-X-602 " + ;
		    "BT-X-603 BT-X-604 BT-X-605 BT-X-606 BT-X-607 BT-X-608 BT-X-609 " + ;
		    "BT-X-610 BT-X-611 BT-X-612 BT-X-613 BT-X-613-0 BT-X-614 BT-X-615", " ", CHR(13)))
		= ALINES(laRegeln, STRTRAN( ;
		    "FX-SCH-A-001160 FX-SCH-A-001161 FX-SCH-A-001162 FX-SCH-A-001164 " + ;
		    "FX-SCH-A-001165 FX-SCH-A-001172 - - FX-TECH-03", " ", CHR(13)))
		= This.ValidatePositionspartei(toP, toCodes, tcPosition, @laBT, @laRegeln, .T.)
	ENDPROC

	PROTECTED PROCEDURE ValidateHierarchie
		LOCAL lnP, loP, lcTyp, lnEltern, laEltern[1]
		IF NOT This.HatHierarchie()
			RETURN
		ENDIF
		DIMENSION laEltern[MAX(1, This.nPositionen)]
		STORE 0 TO laEltern
		FOR lnP = 1 TO This.nPositionen
			loP = This.aPositionen[lnP]
			IF VARTYPE(loP) # "O"
				LOOP
			ENDIF
			= This.ProduktText(loP.cUntertyp, "BT-X-8", loP.cNummer, .T.)
			= This.ProduktText(loP.cElternnummer, "BT-X-304", loP.cNummer, .T.)
			lcTyp = This.CodeNormal(loP.cUntertyp)
			IF NOT ISNULL(loP.nGliederungsbetrag)
				= This.PreiszusatzZahl(loP.nGliederungsbetrag, "BT-131", loP.cNummer)
				= This.Pflicht((lcTyp == "GROUP" OR lcTyp == "INFORMATION"), loP.cNummer, "BT-131", "FX-TECH-03")
			ENDIF
			IF This.cProfil # "EXTENDED"
				LOOP
			ENDIF
			IF NOT EMPTY(lcTyp)
				= This.Pflicht((lcTyp == "DETAIL" OR lcTyp == "GROUP" OR lcTyp == "INFORMATION"), loP.cNummer, "BT-X-8", "FX-SCH-A-000335")
			ENDIF
			IF This.IstText(loP.cElternnummer)
				= This.Pflicht(NOT EMPTY(lcTyp), loP.cNummer, "BT-X-8", "BR-FXEXT-06")
				lnEltern = This.PositionFinden(loP.cElternnummer)
				laEltern[lnP] = lnEltern
				= This.Pflicht(lnEltern > 0, loP.cNummer, "BT-X-304", "BR-FXEXT-11")
			ENDIF
		ENDFOR
		IF This.cProfil # "EXTENDED"
			RETURN
		ENDIF
		FOR lnP = 1 TO This.nPositionen
			loP = This.aPositionen[lnP]
			IF VARTYPE(loP) = "O"
				= This.ValidateElternpfad(lnP, @laEltern)
				IF This.CodeNormal(loP.cUntertyp) == "GROUP" AND This.IstZahl(loP.nNettobetrag)
					= This.ValidateGruppensumme(lnP, @laEltern)
				ENDIF
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateIcLieferung
		LOCAL llDatum, loZ, llLand
		llDatum = VARTYPE(This.dLieferdatum) = "D" AND NOT EMPTY(This.dLieferdatum)
		loZ = This.oAbrechnungszeitraum
		IF VARTYPE(loZ) = "O"
		    llDatum = llDatum OR (VARTYPE(loZ.dAnfang) = "D" AND NOT EMPTY(loZ.dAnfang)) OR ;
		        (VARTYPE(loZ.dEnde) = "D" AND NOT EMPTY(loZ.dEnde))
		ENDIF
		= This.Pflicht(llDatum, "", "BT-72", "BR-IC-11")
		llLand = VARTYPE(This.oLieferempfaenger) = "O" AND This.IstText(This.oLieferempfaenger.cLand)
		= This.Pflicht(llLand, "", "BT-80", "BR-IC-12")
	ENDPROC

	PROTECTED PROCEDURE ValidateKategoriegruppen
		LPARAMETERS tcKategorie
		LOCAL lnG, loG, lnAnzahl, llQuelle, lcRegel, lnBasis, lnN, lnDifferenz
		LOCAL lcFamilie
		lcFamilie = This.Steuerfamilie(tcKategorie)
		lnAnzahl = This.SteuergruppenAnzahl(tcKategorie)
		llQuelle = This.KategorieVorhanden(tcKategorie)
		lcRegel = IIF(This.cProfil == "EXTENDED", "BR-FXEXT-", "BR-") + lcFamilie + "-01"
		DO CASE
		CASE INLIST(tcKategorie, "L", "M")
		    = This.Pflicht((llQuelle AND lnAnzahl >= 1) OR (NOT llQuelle AND ;
		        (This.cProfil # "EXTENDED" OR lnAnzahl = 0)), "", "BT-118", lcRegel)
		CASE tcKategorie == "O" AND This.cProfil # "EXTENDED"
		    * BR-O-01 beschraenkt nur eine vorhandene Kopfgruppe.
		    = This.Pflicht(lnAnzahl = 0 OR (lnAnzahl = 1 AND llQuelle), "", "BT-118", lcRegel)
		OTHERWISE
		    = This.Pflicht((NOT llQuelle AND lnAnzahl = 0) OR (llQuelle AND ;
		        IIF(This.cProfil == "EXTENDED", lnAnzahl >= 1, lnAnzahl = 1)), "", "BT-118", lcRegel)
		ENDCASE
		FOR lnG = 1 TO This.nSteuergruppen
		    loG = This.aSteuergruppen[lnG]
		    IF NOT (This.CodeNormal(loG.cSteuerkategorie) == tcKategorie)
		        LOOP
		    ENDIF
		    IF INLIST(tcKategorie, "L", "M")
		        IF This.IstZahl(loG.nBasis) AND This.IstZahl(loG.nSteuersatz)
		            * The reference assertions -09 are true(); keep the business formula explicit.
		            = This.PruefeRechenwert(loG.nSteuer, ROUND(loG.nBasis * loG.nSteuersatz / 100, 2), 0, "BT-117", "BR-" + lcFamilie + "-09", "FEHLER")
		        ENDIF
		    ELSE
		        = This.Pflicht(This.IstZahl(loG.nSteuer) AND loG.nSteuer = 0, "", "BT-117", "BR-" + lcFamilie + "-09")
		    ENDIF
		    IF NOT INLIST(tcKategorie, "Z", "L", "M")
		        = This.Pflicht(This.IstText(loG.cBefreiungsgrund) OR This.IstText(loG.cBefreiungscode), "", "BT-120", "BR-" + lcFamilie + "-10")
		    ENDIF
		    IF tcKategorie == "K"
		        = This.ValidateIcLieferung()
		    ENDIF
		    IF NOT This.IstZahl(loG.nBasis) OR NOT This.IstZahl(loG.nSteuersatz)
		        LOOP
		    ENDIF
		    lnBasis = This.SteuerBasis(loG.nSteuersatz, @lnN, loG)
		    IF This.cProfil == "EXTENDED"
		        = This.ValidateNullsteuerbasis(loG, tcKategorie, lnBasis, lnN)
		    ELSE
		        lnDifferenz = ROUND(loG.nBasis - lnBasis, 2)
		        DO CASE
		        CASE INLIST(tcKategorie, "L", "M")
		            = This.PruefeRechenwert(loG.nBasis, lnBasis, 0, "BT-116", "BR-" + lcFamilie + "-08", "FEHLER")
		        CASE tcKategorie == "O"
		            = This.Pflicht(lnDifferenz = 0, "", "BT-116", "BR-O-08")
		        OTHERWISE
		            * KoSIT has an open one-euro boundary on both sides.
		            = This.Pflicht(lnDifferenz < 1 AND lnDifferenz > -1, "", "BT-116", "BR-" + lcFamilie + "-08")
		        ENDCASE
		    ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateKlassifikationen
		    LPARAMETERS toP, toCodes, tcPosition
		    LOCAL lnK, loK
		    FOR lnK = 1 TO toP.nKlassifikationen
		        loK = toP.aKlassifikationen[lnK]
		        IF NOT This.ProduktKind(loK, "BT-158", tcPosition)
		            LOOP
		        ENDIF
		        = This.ProduktText(loK.cCode, "BT-158", tcPosition, .F.)
		        = This.ProduktText(loK.cListe, "BT-158-1", tcPosition, .F.)
		        = This.ProduktText(loK.cVersion, "BT-158-2", tcPosition, .F.)
		        = This.ProduktText(loK.cName, "BT-X-13", tcPosition, .T.)
		        = This.Pflicht(This.IstText(loK.cCode), tcPosition, "BT-158", "FX-TECH-03")
		        = This.Pflicht(This.IstText(loK.cListe), tcPosition, "BT-158-1", "BR-65")
		        = This.PruefeCode(toCodes, loK.cListe, "BT-158-1", IIF(This.cProfil == "EXTENDED", "FX-SCH-A-001145", "BR-CL-13"), tcPosition)
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateKontakt
		LPARAMETERS toKontakt
		= This.Pflicht(This.IstText(toKontakt.cKontakt) OR This.IstText(toKontakt.cAbteilung), "", "BT-41", "BR-DE-5")
		= This.Pflicht(This.IstText(toKontakt.cTelefon), "", "BT-42", "BR-DE-6")
		= This.Pflicht(This.IstText(toKontakt.cEmail), "", "BT-43", "BR-DE-7")
		IF NOT This.TelefonGueltig(toKontakt.cTelefon)
		    = This.Meldung("WARNUNG", "", "BT-42", "BR-DE-27", "Die Kontakttelefonnummer muss mindestens drei Ziffern enthalten.")
		ENDIF
		IF NOT This.EmailGueltig(toKontakt.cEmail)
		    = This.Meldung("WARNUNG", "", "BT-43", "BR-DE-28", "Die Kontakt-E-Mail hat kein g{ue}ltiges Format.")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateKontierungen
		LOCAL lnReferenz, loReferenz
		IF This.cProfil # "EXTENDED" AND NOT EMPTY(This.cProfil) AND This.nKontierungen > 1
			= This.Meldung("FEHLER", "", "BT-19", "FX-PROFIL-01", "BT-19: Mehrere Kopfkontierungen sind nur in EXTENDED erlaubt.")
		ENDIF
		FOR lnReferenz = 1 TO This.nKontierungen
			loReferenz = This.aKontierungen[lnReferenz]
			IF NOT This.ReferenzObjekt(loReferenz, "BT-19")
				LOOP
			ENDIF
			= This.KopfText(loReferenz.cNummer, "BT-19", .F.)
			= This.Pflicht(This.IstText(loReferenz.cNummer), "", "BT-19", "FX-TECH-03")
			= This.KopfText(loReferenz.cTyp, "BT-X-290", .T.)
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateKopf
		= This.Pflicht(This.IstText(This.cRechnungsnummer), "", "BT-1", "BR-02")
		= This.Pflicht(VARTYPE(This.dRechnungsdatum) = "D" AND NOT EMPTY(This.dRechnungsdatum), "", "BT-2", "BR-03")
		= This.Pflicht(This.IstText(This.cRechnungstyp), "", "BT-3", "BR-04")
		= This.Pflicht(This.IstText(This.cWaehrung), "", "BT-5", "BR-05")
		= This.Pflicht(This.nPositionen > 0, "", "BT-126", "BR-16")
		IF This.FaelligkeitNoetig()
			= This.Pflicht(This.HatZahlungsfrist(), "", "BT-9", "BR-CO-25")
		ENDIF
		= This.ValidateZahlung()
		= This.ValidateZahlungsbedingungen()
	ENDPROC

	PROTECTED PROCEDURE ValidateKopflieferung
		LOCAL lnTransport, loTransport
		= This.PruefeLieferdatum(This.dLieferdatum, "BT-72")
		= This.ValidateReferenz(This.oVersandavis, "BT-16", "BT-X-200", "FX-SCH-A-000450", .F.)
		= This.ValidateReferenz(This.oEmpfangsavis, "BT-15", "BT-X-201", "FX-SCH-A-000584", .F.)
		= This.ValidateReferenz(This.oLieferschein, "BT-X-202", "BT-X-203", "FX-SCH-A-000787", .T.)
		FOR lnTransport = 1 TO This.nTransporte
			= This.ProfilFeld(.T., "BT-X-152")
			loTransport = This.aTransporte[lnTransport]
			IF NOT This.ReferenzObjekt(loTransport, "BT-X-152")
				LOOP
			ENDIF
			= This.KopfText(loTransport.cArt, "BT-X-152", .F.)
			= This.Pflicht(This.IstText(loTransport.cArt), "", "BT-X-152", "FX-SCH-A-000322")
		ENDFOR
		= This.ValidateAbrechnungszeitraum()
	ENDPROC

	PROTECTED PROCEDURE ValidateKopfreferenzen
		LOCAL lnReferenz, loReferenz
		= This.KopfText(This.cKaeuferReferenz, "BT-10", .F.)
		= This.KopfText(This.cProjektNummer, "BT-11", .F.)
		= This.KopfText(This.cProjektName, "BT-11-0", .F.)
		= This.KopfText(This.cGlaeubigerId, "BT-90", .F.)
		= This.KopfText(This.cZahlungsreferenz, "BT-83", .F.)
		= This.KopfText(This.cRechnungsausstellerReferenz, "BT-X-204", .T.)
		= This.KopfText(This.cLieferbedingung, "BT-X-145", .T.)
		= This.KopfText(This.cLieferland, "BT-X-563", .T.)
		= This.KopfText(This.cLieferort, "BT-X-564", .T.)
		IF This.IstText(This.cProjektNummer) OR This.IstText(This.cProjektName)
			= This.Pflicht(This.IstText(This.cProjektNummer), "", "BT-11", "FX-TECH-03")
			= This.Pflicht(This.IstText(This.cProjektName), "", "BT-11-0", "FX-TECH-03")
		ENDIF
		IF This.IstText(This.cLieferbedingung) OR This.IstText(This.cLieferland) OR This.IstText(This.cLieferort)
			= This.Pflicht(This.IstText(This.cLieferbedingung), "", "BT-X-145", "FX-SCH-A-000319")
		ENDIF
		= This.ValidateReferenz(This.oBestellung, "BT-13", "BT-X-147", "FX-SCH-A-000029", .F.)
		= This.ValidateReferenz(This.oAuftrag, "BT-14", "BT-X-146", "FX-SCH-A-000572", .F.)
		= This.ValidateReferenz(This.oVertrag, "BT-12", "BT-X-148", "FX-SCH-A-000430", .F.)
		= This.ValidateReferenz(This.oAngebot, "BT-X-403", "BT-X-404", "FX-SCH-A-000730", .T.)
		FOR lnReferenz = 1 TO This.nEndkundenbestellungen
			loReferenz = This.aEndkundenbestellungen[lnReferenz]
			IF VARTYPE(loReferenz) # "O"
				= This.Pflicht(.F., "", "BT-X-150", "FX-TECH-03")
			ELSE
				= This.ValidateReferenz(loReferenz, "BT-X-150", "BT-X-151", "FX-SCH-A-000783", .T.)
			ENDIF
		ENDFOR
		IF This.cProfil # "EXTENDED" AND NOT EMPTY(This.cProfil) AND This.nRechnungsreferenzen > 1
			= This.Meldung("FEHLER", "", "BT-25", "FX-PROFIL-01", "BT-25: Mehrere Vorgaengerbez{ue}ge sind wegen D16B nur in EXTENDED erlaubt.")
		ENDIF
		FOR lnReferenz = 1 TO This.nRechnungsreferenzen
			loReferenz = This.aRechnungsreferenzen[lnReferenz]
			IF VARTYPE(loReferenz) # "O"
				= This.Pflicht(.F., "", "BT-25", "FX-TECH-03")
			ELSE
				= This.ValidateReferenz(loReferenz, "BT-25", "BT-26", "BR-55", .F.)
			ENDIF
		ENDFOR
		IF This.cProfil == "XRECHNUNG-CII" AND This.CodeNormal(This.cRechnungstyp) == "384"
			IF This.nRechnungsreferenzen = 0
				= This.Meldung("WARNUNG", "", "BT-25", "BR-DE-26", "BT-25: Eine Korrekturrechnung sollte den Vorgaengerbezug enthalten.")
			ENDIF
		ENDIF
		= This.ValidateKontierungen()
	ENDPROC

	PROTECTED PROCEDURE ValidateKopfrollen
		LPARAMETERS toCodes
		= This.ValidateRolleSalesAgent(This.oVerkaufsagent, toCodes)
		= This.ValidateRolleBuyerTaxRepresentative(This.oKaeuferSteuervertreter, toCodes)
		= This.ValidateRolleSellerTaxRepresentative(This.oVerkaeuferSteuervertreter, toCodes)
		= This.ValidateRolleProductEndUser(This.oEndnutzer, toCodes)
		= This.ValidateRolleBuyerAgent(This.oEinkaufsagent, toCodes)
		= This.ValidateRolleShipTo(This.oLieferempfaenger, toCodes)
		= This.ValidateRolleUltimateShipTo(This.oEndlieferempfaenger, toCodes)
		= This.ValidateRolleShipFrom(This.oVersender, toCodes)
		= This.ValidateRolleInvoicer(This.oRechnungssteller, toCodes)
		= This.ValidateRolleInvoicee(This.oRechnungsempfaenger, toCodes)
		= This.ValidateRollePayee(This.oZahlungsempfaenger, toCodes)
		= This.ValidateRollePayer(This.oZahler, toCodes)
	ENDPROC

	PROCEDURE ValidateLauf
		LOCAL lnFehler, llProfilBekannt, llCursorNeu
		This.cLastError = ""
		This.lTechnischerFehler = .F.
		This.oMeldungen.cLastError = ""
		This.oMeldungen.lFehlerAusstehend = .F.
		This.oMeldungen.lTechnischerFehler = .F.
		= This.RechenergebnisseLeeren()
		llCursorNeu = EMPTY(This.cEigenerCursor)
		IF NOT This.MeldungsCursorOeffnen()
			RETURN .F.
		ENDIF
		IF NOT This.oMeldungen.Leeren()
			RETURN .F.
		ENDIF
		* Die Cursoranlage hat bestehende Kinder bereits vollstaendig gebunden.
		IF NOT llCursorNeu
			= This.DatenMeldezielSetzen()
		ENDIF
		FOR lnFehler = 1 TO This.nAddFehler
			* Fertige Texte nicht noch einmal als Vorlage behandeln.
			IF NOT This.oMeldungen.Eintragen(This.aAddFehler[lnFehler, 1], ;
				This.aAddFehler[lnFehler, 2], This.aAddFehler[lnFehler, 3], ;
				This.aAddFehler[lnFehler, 4], This.aAddFehler[lnFehler, 5])
				RETURN .F.
			ENDIF
		ENDFOR
		llProfilBekannt = .F.
		IF VARTYPE(This.cProfil) # "C" OR EMPTY(This.cProfil)
			= This.Meldung("FEHLER", "", "BT-24", "BR-01", "Das Profil fehlt.")
		ELSE
			llProfilBekannt = This.cProfil == "EN16931" OR This.cProfil == "XRECHNUNG-CII" OR This.cProfil == "EXTENDED"
			IF NOT llProfilBekannt
				= This.Meldung("FEHLER", "", "BT-24", "FX-PROFIL-01", ;
					"Das Profil {1} wird noch nicht unterst{ue}tzt.", This.cProfil)
			ENDIF
		ENDIF
		IF NOT EMPTY(This.cLastError) AND NOT llProfilBekannt
			RETURN .F.
		ENDIF
		= This.Rechnen()
		= This.Gutschrift()
		= This.ValidateKopf()
		= This.ValidateDokument()
		= This.ValidateKopfreferenzen()
		= This.ValidateKopflieferung()
		= This.ValidateAnhaenge()
		= This.ValidateParteien()
		= This.ValidatePositionen()
		= This.ValidateHierarchie()
		= This.ValidateBeleggruppen()
		= This.ValidateCodelisten()
		= This.ValidateRechnen()
		IF This.cProfil == "XRECHNUNG-CII"
			= This.ValidateXrechnung()
		ENDIF
		RETURN NOT This.lTechnischerFehler AND EMPTY(This.cLastError)
	ENDPROC

	PROTECTED PROCEDURE ValidateMerkmale
		    LPARAMETERS toP, toCodes, tcPosition
		    LOCAL lnK, loK, llText, llMesswert
		    FOR lnK = 1 TO toP.nMerkmale
		        loK = toP.aMerkmale[lnK]
		        IF NOT This.ProduktKind(loK, "BG-32", tcPosition)
		            LOOP
		        ENDIF
		        = This.ProduktText(loK.cName, "BT-160", tcPosition, .F.)
		        = This.ProduktText(loK.cWert, "BT-161", tcPosition, .F.)
		        = This.ProduktText(loK.cTyp, "BT-X-11", tcPosition, .T.)
		        = This.ProduktText(loK.cEinheit, "BT-X-12-0", tcPosition, .T.)
		        = This.ProduktZahl(loK.nMesswert, "BT-X-12", tcPosition)
		        llText = This.IstText(loK.cWert)
		        llMesswert = This.IstZahl(loK.nMesswert) AND This.IstText(loK.cEinheit)
		        IF This.cProfil == "EXTENDED"
		            = This.Pflicht(This.IstText(loK.cName) OR This.IstText(loK.cTyp), tcPosition, "BT-160", "BR-FXEXT-BR-54-1")
		            = This.Pflicht((llText AND ISNULL(loK.nMesswert)) OR (NOT llText AND llMesswert), tcPosition, "BT-161", "BR-FXEXT-BR-54-2")
		            = This.PruefeCode(toCodes, loK.cTyp, "BT-X-11", "BR-FXEXT-04", tcPosition)
		        ELSE
		            = This.Pflicht(This.IstText(loK.cName) AND llText, tcPosition, "BT-160", "BR-54")
		            IF NOT ISNULL(loK.nMesswert)
		                = This.Pflicht(.F., tcPosition, "BT-X-12", "FX-PROFIL-01")
		            ENDIF
		        ENDIF
		        IF This.IstText(loK.cEinheit) AND ISNULL(loK.nMesswert)
		            = This.Pflicht(.F., tcPosition, "BT-X-12", "FX-TECH-03")
		        ENDIF
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateNotizen
		LOCAL lnNotiz, loNotiz, llInhalt
		FOR lnNotiz = 1 TO This.nNotizen
			loNotiz = This.aNotizen[lnNotiz]
			IF VARTYPE(loNotiz) # "O"
				= This.Pflicht(.F., "", "BT-22", "FX-TECH-03")
				LOOP
			ENDIF
			IF loNotiz.lTechnischerFehler
				= This.Meldung("FEHLER", "", "BT-22", "FX-TECH-01", "Technischer Notizfehler: {1}", loNotiz.cLastError)
			ENDIF
			= This.KopfText(loNotiz.cText, "BT-22", .F.)
			= This.KopfText(loNotiz.cBetreff, "BT-21", .F.)
			= This.KopfText(loNotiz.cTextcode, "BT-X-5", .T.)
			llInhalt = This.IstText(loNotiz.cText) OR This.IstText(loNotiz.cTextcode)
			IF This.cProfil == "EXTENDED"
				IF This.IstText(loNotiz.cBetreff)
					= This.Pflicht(llInhalt, "", "BT-22", "BR-FXEXT-01")
				ELSE
					= This.Pflicht(llInhalt, "", "BT-22", "FX-TECH-03")
				ENDIF
			ELSE
				= This.Pflicht(This.IstText(loNotiz.cText), "", "BT-22", "FX-SCH-A-000160")
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateNullsteuerbasis
		LPARAMETERS toG, tcKategorie, tnBasis, tnAnzahl
		LOCAL lnIni, lnNIni, lcRegel
		lnIni = This.SteuerBasis(toG.nSteuersatz, @lnNIni, .NULL., tcKategorie)
		lcRegel = "BR-FXEXT-" + This.Steuerfamilie(tcKategorie) + "-08"
		* The b variant accepts either grouping; the two warnings stay independent.
		IF ROUND(ABS(toG.nBasis - lnIni), 2) > ROUND(lnNIni * 0.01, 2)
		    = This.PruefeRechenwert(toG.nBasis, tnBasis, ROUND(tnAnzahl * 0.01, 2), "BT-116", lcRegel + "b", "FEHLER")
		ENDIF
		= This.PruefeRechenwert(toG.nBasis, lnIni, ROUND(lnNIni * 0.01, 2), "BT-116", lcRegel + "ini", "WARNUNG")
		= This.PruefeRechenwert(toG.nBasis, tnBasis, ROUND(tnAnzahl * 0.01, 2), "BT-116", lcRegel + "rev", "WARNUNG")
	ENDPROC

	PROTECTED PROCEDURE ValidateNullsteuerEintrag
		LPARAMETERS toK, tcPosition, tcBT, tnOrt
		LOCAL lcKategorie, lcFamilie, lcRegel, llKennung
		lcKategorie = This.CodeNormal(toK.cSteuerkategorie)
		IF lcKategorie == "O"
		    lcRegel = "BR-O-0" + ALLTRIM(STR(5 + tnOrt))
		    = This.Pflicht(ISNULL(toK.nSteuersatz), tcPosition, tcBT, lcRegel)
		    IF This.cProfil # "EXTENDED"
		        lcRegel = "BR-O-0" + ALLTRIM(STR(2 + tnOrt))
		        llKennung = VARTYPE(This.oVerkaeufer) = "O" AND This.IstText(This.oVerkaeufer.cUstId)
		        = This.Pflicht(NOT llKennung, tcPosition, "BT-31", lcRegel)
		        IF VARTYPE(This.oVerkaeuferSteuervertreter) = "O"
		            = This.Pflicht(NOT This.IstText(This.oVerkaeuferSteuervertreter.cUstId), tcPosition, "BT-63", lcRegel)
		        ENDIF
		        llKennung = VARTYPE(This.oKaeufer) = "O" AND This.IstText(This.oKaeufer.cUstId)
		        = This.Pflicht(NOT llKennung, tcPosition, "BT-48", lcRegel)
		    ENDIF
		    RETURN
		ENDIF
		IF NOT (lcKategorie == "Z" OR lcKategorie == "E" OR lcKategorie == "AE" OR lcKategorie == "G" OR lcKategorie == "K" OR lcKategorie == "L" OR lcKategorie == "M")
		    RETURN
		ENDIF
		lcFamilie = This.Steuerfamilie(lcKategorie)
		lcRegel = "BR-" + lcFamilie + "-0" + ALLTRIM(STR(5 + tnOrt))
		IF INLIST(lcKategorie, "L", "M")
		    = This.Pflicht(This.IstZahl(toK.nSteuersatz) AND IIF(lcKategorie == "M", ROUND(toK.nSteuersatz, 2) >= 0, ROUND(toK.nSteuersatz, 2) > 0), tcPosition, tcBT, lcRegel)
		ELSE
		    = This.Pflicht(This.IstZahl(toK.nSteuersatz) AND ROUND(toK.nSteuersatz, 2) = 0, tcPosition, tcBT, lcRegel)
		ENDIF
		lcRegel = "BR-" + lcFamilie + "-0" + ALLTRIM(STR(2 + tnOrt))
		llKennung = IIF(lcKategorie == "G" OR lcKategorie == "K", This.VerkaeuferUstkennung(), This.VerkaeuferSteuerkennung())
		= This.Pflicht(llKennung, tcPosition, "BT-31", lcRegel)
		IF lcKategorie == "AE" OR lcKategorie == "K"
		    llKennung = VARTYPE(This.oKaeufer) = "O" AND ;
		        (This.IstText(This.oKaeufer.cUstId) OR (lcKategorie == "AE" AND This.IstText(This.oKaeufer.cRegisternummer)))
		    = This.Pflicht(llKennung, tcPosition, "BT-48", lcRegel)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateOMischung
		LOCAL lnK, loK, llAndereSteuer, llAndereBelegsteuer
		IF This.cProfil == "EXTENDED" OR This.SteuergruppenAnzahl("O") = 0
		    RETURN
		ENDIF
		llAndereSteuer = .F.
		llAndereBelegsteuer = .F.
		FOR lnK = 1 TO This.nSteuergruppen
		    IF NOT (This.CodeNormal(This.aSteuergruppen[lnK].cSteuerkategorie) == "O")
		        llAndereSteuer = .T.
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nPositionen
		    loK = This.aPositionen[lnK]
		    IF VARTYPE(loK) = "O" AND This.IstText(loK.cSteuerkategorie) AND NOT (This.CodeNormal(loK.cSteuerkategorie) == "O")
		        llAndereSteuer = .T.
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nBelegaenderungen
		    loK = This.aBelegaenderungen[lnK]
		    IF VARTYPE(loK) = "O" AND This.IstText(loK.cSteuerkategorie) AND NOT (This.CodeNormal(loK.cSteuerkategorie) == "O")
		        llAndereBelegsteuer = .T.
		    ENDIF
		ENDFOR
		* Beide Referenzquellen verwenden je Paar denselben XPath-Ausdruck.
		= This.Pflicht(NOT llAndereSteuer, "", "BT-118", "BR-O-11")
		= This.Pflicht(NOT llAndereSteuer, "", "BT-151", "BR-O-12")
		= This.Pflicht(NOT llAndereBelegsteuer, "", "BT-95", "BR-O-13")
		= This.Pflicht(NOT llAndereBelegsteuer, "", "BT-102", "BR-O-14")
	ENDPROC

	PROTECTED PROCEDURE ValidatePartei
		LPARAMETERS toPartei, tlVerkaeufer
		LOCAL lcNameBt, lcLandBt, llAdresse, lcNameRegel, lcAdresseRegel, lcLandRegel
		lcNameBt = IIF(tlVerkaeufer, "BT-27", "BT-44")
		lcLandBt = IIF(tlVerkaeufer, "BT-40", "BT-55")
		lcNameRegel = IIF(tlVerkaeufer, "BR-06", "BR-07")
		lcAdresseRegel = IIF(tlVerkaeufer, "BR-08", "BR-10")
		lcLandRegel = IIF(tlVerkaeufer, "BR-09", "BR-11")
		IF VARTYPE(toPartei) # "O"
			= This.Pflicht(.F., "", lcNameBt, lcNameRegel)
			= This.Pflicht(.F., "", lcLandBt, lcAdresseRegel)
			= This.Pflicht(.F., "", lcLandBt, lcLandRegel)
			RETURN .F.
		ENDIF
		IF toPartei.lTechnischerFehler
			= This.Meldung("FEHLER", "", lcNameBt, "FX-TECH-01", "Technischer Parteifehler: {1}", toPartei.cLastError)
		ENDIF
		= This.Pflicht(This.IstText(toPartei.cName), "", lcNameBt, lcNameRegel)
		IF NOT EMPTY(toPartei.cAddFehler)
			= This.Meldung("FEHLER", "", lcNameBt, "FX-TECH-03", "Abgewiesener Partei-Add-Aufruf: {1}", toPartei.cAddFehler)
		ENDIF
		= This.ValidateParteiTexte(toPartei, tlVerkaeufer)
		= This.ValidateParteiAdresse(toPartei, tlVerkaeufer, .F.)
		= This.ValidateParteiAdresse(toPartei.oRegisterAdresse, tlVerkaeufer, .T.)
		= This.ValidateParteiKennungen(toPartei, tlVerkaeufer)
		= This.ValidateParteiKontakte(toPartei, tlVerkaeufer)
		IF tlVerkaeufer
			= This.Pflicht(This.IstText(toPartei.cUstId) OR toPartei.nKennungen > 0 OR ;
				toPartei.nGlobaleKennungen > 0 OR This.IstText(toPartei.cRegisternummer), "", "BT-29", "BR-CO-26")
		ENDIF
		llAdresse = This.AdresseVorhanden(toPartei)
		= This.Pflicht(llAdresse, "", lcLandBt, lcAdresseRegel)
		= This.Pflicht(This.IstText(toPartei.cLand), "", lcLandBt, lcLandRegel)
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE ValidateParteiAdresse
		LPARAMETERS toA, tlV, tlRegister
		LOCAL lcLand, lcBT
		lcLand = IIF(tlV, "BT-40", "BT-55")
		IF tlRegister
		    lcLand = IIF(tlV, "BT-X-105", "BT-X-113")
		ENDIF
		IF tlRegister AND NOT This.ParteiKind(toA, lcLand)
		    RETURN
		ENDIF
		= This.KopfText(toA.cPlz, IIF(tlRegister, IIF(tlV, "BT-X-100", "BT-X-108"), IIF(tlV, "BT-38", "BT-53")), tlRegister)
		= This.KopfText(toA.cStrasse, IIF(tlRegister, IIF(tlV, "BT-X-101", "BT-X-109"), IIF(tlV, "BT-35", "BT-50")), tlRegister)
		= This.KopfText(toA.cStrasse2, IIF(tlRegister, IIF(tlV, "BT-X-102", "BT-X-110"), IIF(tlV, "BT-36", "BT-51")), tlRegister)
		= This.KopfText(toA.cStrasse3, IIF(tlRegister, IIF(tlV, "BT-X-103", "BT-X-111"), IIF(tlV, "BT-162", "BT-163")), tlRegister)
		= This.KopfText(toA.cOrt, IIF(tlRegister, IIF(tlV, "BT-X-104", "BT-X-112"), IIF(tlV, "BT-37", "BT-52")), tlRegister)
		= This.KopfText(toA.cLand, lcLand, tlRegister)
		= This.KopfText(toA.cRegion, IIF(tlRegister, IIF(tlV, "BT-X-106", "BT-X-114"), IIF(tlV, "BT-39", "BT-54")), tlRegister)
		IF tlRegister AND This.cProfil == "EXTENDED" AND This.AdresseVorhanden(toA)
		    = This.Pflicht(This.IstText(toA.cLand), "", lcLand, IIF(tlV, "FX-SCH-A-000779", "FX-SCH-A-000700"))
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateParteiCodes
		LPARAMETERS toCodes, toPartei, tlVerkaeufer
		LOCAL lnK, loK, loA
		IF VARTYPE(toPartei) # "O"
		    RETURN
		ENDIF
		= This.ValidateUstPraefix(toCodes, toPartei.cUstId, IIF(tlVerkaeufer, "BT-31", "BT-48"))
		= This.PruefeCode(toCodes, toPartei.cLand, IIF(tlVerkaeufer, "BT-40", "BT-55"), "BR-CL-14", "")
		IF This.IstText(toPartei.cElektronischeAdresse)
		    = This.Pflicht(This.IstText(toPartei.cElektronischeAdresseSchema), "", IIF(tlVerkaeufer, "BT-34-1", "BT-49-1"), IIF(tlVerkaeufer, "BR-62", "BR-63"))
		    = This.PruefeCode(toCodes, toPartei.cElektronischeAdresseSchema, IIF(tlVerkaeufer, "BT-34", "BT-49"), "BR-CL-25", "")
		ENDIF
		= This.PruefeCode(toCodes, toPartei.cRegisterSchema, IIF(tlVerkaeufer, "BT-30-1", "BT-47-1"), "BR-CL-11", "")
		FOR lnK = 1 TO toPartei.nGlobaleKennungen
		    loK = toPartei.aGlobaleKennungen[lnK]
		    IF VARTYPE(loK) = "O"
		        = This.PruefeCode(toCodes, loK.cSchema, IIF(tlVerkaeufer, "BT-29-1", "BT-46-1"), "BR-CL-10", "")
		    ENDIF
		ENDFOR
		loA = toPartei.oRegisterAdresse
		IF This.cProfil == "EXTENDED" AND VARTYPE(loA) = "O" AND This.AdresseVorhanden(loA)
		    = This.PruefeCode(toCodes, loA.cLand, IIF(tlVerkaeufer, "BT-X-105", "BT-X-113"), IIF(tlVerkaeufer, "FX-SCH-A-000781", "FX-SCH-A-000702"), "")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateParteien
		= This.ValidatePartei(This.oVerkaeufer, .T.)
		= This.ValidatePartei(This.oKaeufer, .F.)
	ENDPROC

	PROTECTED PROCEDURE ValidateParteiKennungen
		LPARAMETERS toP, tlV
		LOCAL lnK, loK, lcBT
		lcBT = IIF(tlV, "BT-29", "BT-46")
		IF NOT tlV AND toP.nKennungen > 1
		    = This.Pflicht(.F., "", lcBT, "FX-SCH-A-000163")
		ENDIF
		IF NOT tlV AND toP.nKennungen > 0 AND toP.nGlobaleKennungen > 0 AND This.cProfil # "EXTENDED"
		    = This.Meldung("WARNUNG", "", lcBT, "CII-SR-450", "BT-46: Lokale und globale K{ae}uferkennung sollen nicht zugleich gesetzt sein.")
		ENDIF
		IF NOT tlV AND toP.nGlobaleKennungen > 1 AND This.cProfil == "EN16931"
		    = This.Pflicht(.F., "", lcBT, "FX-SCH-A-000164")
		ENDIF
		FOR lnK = 1 TO toP.nKennungen
		    loK = toP.aKennungen[lnK]
		    IF This.ParteiKind(loK, lcBT)
		        = This.Pflicht(This.IstText(loK.cWert), "", lcBT, "FX-TECH-03")
		        = This.Pflicht(INLIST(VARTYPE(loK.cSchema), "C", "M") AND NOT This.IstText(loK.cSchema), "", lcBT, "FX-TECH-03")
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO toP.nGlobaleKennungen
		    loK = toP.aGlobaleKennungen[lnK]
		    IF This.ParteiKind(loK, lcBT)
		        = This.Pflicht(This.IstText(loK.cWert), "", lcBT, "FX-TECH-03")
		        = This.Pflicht(This.IstText(loK.cSchema), "", IIF(tlV, "BT-29-1", "BT-46-1"), IIF(tlV, "FX-SCH-A-000440", "FX-SCH-A-000420"))
		    ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateParteiKontakte
		LPARAMETERS toP, tlV
		LOCAL lnK, lnAnzahl, loK, lcTyp, llPerson, llAbteilung, lcBT
		lnAnzahl = 0
		llPerson = .F.
		llAbteilung = .F.
		lcBT = IIF(tlV, "BT-41", "BT-56")
		FOR lnK = 0 TO toP.nKontakte
		    loK = toP
		    lcTyp = toP.cKontaktTyp
		    IF lnK > 0
		        loK = toP.aKontakte[lnK]
		        IF NOT This.ParteiKind(loK, lcBT)
		            LOOP
		        ENDIF
		        lcTyp = loK.cTyp
		    ENDIF
		    = This.KontaktText(loK.cKontakt, lcBT, .F.)
		    = This.KontaktText(loK.cAbteilung, lcBT + "-0", .F.)
		    = This.KontaktText(loK.cTelefon, IIF(tlV, "BT-42", "BT-57"), .F.)
		    = This.KontaktText(loK.cEmail, IIF(tlV, "BT-43", "BT-58"), .F.)
		    = This.KontaktText(loK.cFax, IIF(tlV, "BT-X-107", "BT-X-115"), .T.)
		    = This.KontaktText(lcTyp, IIF(tlV, "BT-X-317", "BT-X-318"), .T.)
		    IF This.KontaktVorhanden(loK, lcTyp)
		        lnAnzahl = lnAnzahl + 1
		        llPerson = llPerson OR This.IstText(loK.cKontakt)
		        llAbteilung = llAbteilung OR This.IstText(loK.cAbteilung)
		        IF tlV AND This.cProfil == "XRECHNUNG-CII"
		            = This.ValidateKontakt(loK)
		        ENDIF
		    ENDIF
		ENDFOR
		IF llPerson AND llAbteilung
		    = This.Pflicht(.F., "", lcBT, IIF(tlV, "CII-SR-465", "CII-SR-466"))
		ENDIF
		IF This.cProfil # "EXTENDED" AND lnAnzahl > 1
		    = This.Pflicht(.F., "", lcBT, IIF(tlV, "CII-SR-455", "CII-SR-456"))
		ENDIF
		IF tlV AND This.cProfil == "XRECHNUNG-CII"
		    = This.Pflicht(lnAnzahl > 0, "", lcBT, "BR-DE-2")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateParteiTexte
		LPARAMETERS toP, tlV
		= This.KopfText(toP.cName, IIF(tlV, "BT-27", "BT-44"), .F.)
		= This.KopfText(toP.cRolle, IIF(tlV, "BT-X-543", "BT-X-544"), .T.)
		= This.KopfText(toP.cBeschreibung, IIF(tlV, "BT-33", "BT-X-334"), NOT tlV)
		= This.KopfText(toP.cRegisternummer, IIF(tlV, "BT-30", "BT-47"), .F.)
		= This.KopfText(toP.cRegisterSchema, IIF(tlV, "BT-30-1", "BT-47-1"), .F.)
		= This.KopfText(toP.cHandelsname, IIF(tlV, "BT-28", "BT-45"), .F.)
		= This.KopfText(toP.cUstId, IIF(tlV, "BT-31", "BT-48"), .F.)
		= This.KopfText(toP.cSteuernummer, "BT-32", .F.)
		IF NOT tlV AND This.IstText(toP.cSteuernummer)
		    = This.Meldung("FEHLER", "", "BT-32", "FX-PROFIL-01", ;
		        "K{ae}ufer: Eine Steuernummer (FC) ist nicht zul{ae}ssig, nur die USt-IdNr. (BT-48, Schema VA).")
		ENDIF
		= This.KopfText(toP.cElektronischeAdresse, IIF(tlV, "BT-34", "BT-49"), .F.)
		= This.KopfText(toP.cElektronischeAdresseSchema, IIF(tlV, "BT-34-1", "BT-49-1"), .F.)
		IF This.IstText(toP.cElektronischeAdresseSchema) AND NOT This.IstText(toP.cElektronischeAdresse)
		    = This.Pflicht(.F., "", IIF(tlV, "BT-34", "BT-49"), "FX-TECH-03")
		ENDIF
		IF This.IstText(toP.cRegisterSchema) AND NOT This.IstText(toP.cRegisternummer)
		    = This.Pflicht(.F., "", IIF(tlV, "BT-30", "BT-47"), "FX-TECH-03")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionen
		LOCAL lnPosition, loPosition, lcNummer, llMenge, llPreis, lnVorher, loVorher, llDetail
		LOCAL llPreisgruppe, lcKategorie, lcRegel
		FOR lnPosition = 1 TO This.nPositionen
			loPosition = This.aPositionen[lnPosition]
			lcNummer = ALLTRIM(STR(lnPosition))
			IF VARTYPE(loPosition) # "O"
				= This.Meldung("FEHLER", lcNummer, "BT-126", "FX-TECH-03", "Das Positionsobjekt fehlt.")
				LOOP
			ENDIF
			IF This.IstText(loPosition.cNummer)
				lcNummer = loPosition.cNummer
			ENDIF
			IF loPosition.lTechnischerFehler
				= This.Meldung("FEHLER", lcNummer, "", "FX-TECH-01", "Technischer Positionsfehler: {1}", loPosition.cLastError)
			ENDIF
			llMenge = This.IstZahl(loPosition.nMenge)
			llPreis = This.IstZahl(loPosition.nPreis)
			= This.Pflicht(This.IstText(loPosition.cNummer), lcNummer, "BT-126", "BR-21")
			FOR lnVorher = 1 TO lnPosition - 1
				loVorher = This.aPositionen[lnVorher]
				IF VARTYPE(loVorher) = "O" AND This.IstText(loPosition.cNummer)
					IF This.PositionsnummerNormal(loVorher.cNummer) == This.PositionsnummerNormal(loPosition.cNummer)
						= This.Meldung("FEHLER", lcNummer, "BT-126", "FX-TECH-03", "Die Positionsnummer {1} ist doppelt vergeben.", lcNummer)
						EXIT
					ENDIF
				ENDIF
			ENDFOR
			= This.Pflicht(This.IstText(loPosition.cName), lcNummer, "BT-153", "BR-25")
			llDetail = This.IstDetailposition(loPosition)
			IF llDetail
				= This.Pflicht(llMenge, lcNummer, "BT-129", This.PositionsRegel("22"))
				= This.Pflicht(This.IstText(loPosition.cEinheit), lcNummer, "BT-130", This.PositionsRegel("23"))
				= This.Pflicht(This.IstZahl(loPosition.nNettobetrag), lcNummer, "BT-131", This.PositionsRegel("24"))
				= This.Pflicht(llPreis, lcNummer, "BT-146", This.PositionsRegel("26"))
				= This.Pflicht(This.IstText(loPosition.cSteuerkategorie), lcNummer, "BT-151", This.KategorieRegel())
				= This.Pflicht(This.IstZahl(loPosition.nSteuersatz) OR ;
					(This.CodeNormal(loPosition.cSteuerkategorie) == "O" AND ISNULL(loPosition.nSteuersatz)), lcNummer, "BT-152", "FX-TECH-03")
			ELSE
				= This.Pflicht(ISNULL(loPosition.nMenge) OR llMenge, lcNummer, "BT-129", "FX-TECH-03")
				= This.Pflicht(ISNULL(loPosition.nPreis) OR llPreis, lcNummer, "BT-146", "FX-TECH-03")
				llPreisgruppe = NOT ISNULL(loPosition.nBasismenge)
				IF VARTYPE(loPosition.oPreissteuer) = "O"
					llPreisgruppe = llPreisgruppe OR loPosition.oPreissteuer.HatInhalt()
				ENDIF
				IF llPreisgruppe
					= This.Pflicht(llPreis, lcNummer, "BT-146", "FX-SCH-A-000532")
				ENDIF
				IF NOT ISNULL(loPosition.nBasismenge)
					IF This.IstZahl(loPosition.nBasismenge)
						= This.Pflicht(ROUND(This.RechenNumeric(loPosition.nBasismenge), 4) > 0, lcNummer, "BT-149", "FX-TECH-03")
					ELSE
						= This.Pflicht(.F., lcNummer, "BT-149", "FX-TECH-03")
					ENDIF
				ENDIF
				= This.Pflicht(ISNULL(loPosition.nSteuersatz) OR This.IstZahl(loPosition.nSteuersatz), lcNummer, "BT-152", "FX-TECH-03")
				= This.ProduktText(loPosition.cEinheit, "BT-130", lcNummer, .F.)
				= This.ProduktText(loPosition.cSteuerkategorie, "BT-151", lcNummer, .F.)
				* FeRD zaehlt auch die Kategorien der Gliederungszeilen gegen BG-23.
				lcKategorie = This.CodeNormal(loPosition.cSteuerkategorie)
				lcRegel = ""
				DO CASE
				CASE (lcKategorie == "Z" OR lcKategorie == "E" OR lcKategorie == "AE" OR ;
					lcKategorie == "G" OR lcKategorie == "K" OR lcKategorie == "O" OR ;
					lcKategorie == "L" OR lcKategorie == "M")
					IF This.SteuergruppenAnzahl(lcKategorie) = 0
						lcRegel = "BR-FXEXT-" + This.Steuerfamilie(lcKategorie) + "-01"
					ENDIF
				ENDCASE
				IF NOT EMPTY(lcRegel)
					= This.Meldung("FEHLER", lcNummer, "BT-151", lcRegel, ;
						"Die Steuerkategorie {1} der Gliederungszeile besitzt hier keine zul{ae}ssige Zuordnung zu BG-23.", lcKategorie)
				ENDIF
			ENDIF
			= This.ValidateNullsteuerEintrag(loPosition, lcNummer, "BT-152", 0)
			IF This.CodeNormal(loPosition.cSteuerkategorie) == "S"
				= This.Pflicht(This.IstZahl(loPosition.nSteuersatz) AND ;
					ROUND(loPosition.nSteuersatz, 2) > 0, lcNummer, "BT-152", "BR-S-05")
				= This.Pflicht(VARTYPE(This.oVerkaeufer) = "O" AND ;
					This.VerkaeuferSteuerkennung(), lcNummer, "BT-31", "BR-S-02")
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionsabrechnung
		LPARAMETERS toP, toCodes, tcPosition
		LOCAL lnK, loK, lnVorher, loA, loB, llRechnung, llSteuer
		= This.ValidatePositionszeitraum(toP.oAbrechnungszeitraum, tcPosition)
		= This.ValidatePositionsgleichung(toP, tcPosition)
		= This.PreiszusatzZahl(toP.nSteuerbetrag, "BT-X-95", tcPosition)
		= This.PreiszusatzZahl(toP.nBruttobetrag, "BT-X-330", tcPosition)
		= This.ProduktText(toP.cSteuerbefreiungsgrund, "BT-X-96", tcPosition, .T.)
		= This.ProduktText(toP.cSteuerbefreiungscode, "BT-X-97", tcPosition, .T.)
		= This.ProduktText(toP.cSteuerzeitpunktCode, "BT-X-589", tcPosition, .T.)
		= This.PruefeCode(toCodes, toP.cSteuerbefreiungscode, "BT-X-97", "FX-SCH-A-001130", tcPosition)
		= This.PruefeCode(toCodes, toP.cSteuerzeitpunktCode, "BT-X-589", "FX-SCH-A-001129", tcPosition)
		FOR lnK = 1 TO toP.nAbrechnungsaenderungen
			loK = toP.aAbrechnungsaenderungen[lnK]
			IF This.ProduktKind(loK, "BG-27", tcPosition)
				= This.ValidatePositionsaenderung(loK, toCodes, tcPosition)
			ENDIF
		ENDFOR
		= This.ProduktText(toP.cObjektreferenz, "BT-128", tcPosition, .F.)
		= This.ProduktText(toP.cObjektreferenzart, "BT-128-1", tcPosition, .F.)
		IF This.IstText(toP.cObjektreferenzart)
			= This.Pflicht(This.IstText(toP.cObjektreferenz), tcPosition, "BT-128", IIF(This.cProfil == "EXTENDED", "FX-SCH-A-000615", "BR-52"))
		ENDIF
		= This.PruefeCode(toCodes, toP.cObjektreferenzart, "BT-128-1", IIF(This.cProfil == "EXTENDED", "FX-SCH-A-001126", "BR-CL-07"), tcPosition)
		IF NOT ISNULL(toP.oRechnungsreferenz)
			loK = toP.oRechnungsreferenz
			IF This.ProduktKind(loK, "BG-X-48", tcPosition)
				= This.ProduktText(loK.cNummer, "BT-X-331", tcPosition, .T.)
				= This.ProduktText(loK.cZeile, "BT-X-540", tcPosition, .T.)
				= This.ProduktText(loK.cTyp, "BT-X-332", tcPosition, .T.)
				= This.ProduktText(loK.cReferenzart, "BG-X-48", tcPosition, .T.)
				= This.Pflicht(NOT This.IstText(loK.cReferenzart), tcPosition, "BG-X-48", "FX-TECH-03")
				= This.Pflicht(VARTYPE(loK.dDatum) = "D", tcPosition, "BT-X-333", "FX-TECH-03")
				= This.Pflicht(This.IstText(loK.cNummer) OR This.IstText(loK.cZeile) OR ;
					This.IstText(loK.cTyp) OR (VARTYPE(loK.dDatum) = "D" AND NOT EMPTY(loK.dDatum)), tcPosition, "BG-X-48", "FX-TECH-03")
				IF This.cProfil # "EXTENDED"
					= This.Pflicht(.F., tcPosition, "BG-X-48", "FX-PROFIL-01")
				ENDIF
				= This.PruefeCode(toCodes, loK.cTyp, "BT-X-332", "FX-SCH-A-001136", tcPosition)
			ENDIF
		ENDIF
		IF This.cProfil # "EXTENDED"
			= This.Pflicht(toP.nKontierungen <= 1, tcPosition, "BT-133", "FX-SCH-A-000614")
		ENDIF
		FOR lnK = 1 TO toP.nKontierungen
			loK = toP.aKontierungen[lnK]
			IF This.ProduktKind(loK, "BT-133", tcPosition)
				= This.ProduktText(loK.cNummer, "BT-133", tcPosition, .F.)
				= This.Pflicht(This.IstText(loK.cNummer), tcPosition, "BT-133", "FX-TECH-03")
				= This.ProduktText(loK.cTyp, "BT-X-99", tcPosition, .T.)
			ENDIF
		ENDFOR
		FOR lnK = 1 TO toP.nSteuersummen
			loK = toP.aSteuersummen[lnK]
			IF NOT This.ProduktKind(loK, "BT-X-329", tcPosition)
				LOOP
			ENDIF
			= This.PreiszusatzZahl(loK.nBetrag, "BT-X-329", tcPosition)
			= This.Pflicht(This.IstZahl(loK.nBetrag), tcPosition, "BT-X-329", "FX-TECH-03")
			= This.ProduktText(loK.cWaehrung, "BT-X-329-0", tcPosition, .T.)
			= This.PruefeCode(toCodes, loK.cWaehrung, "BT-X-329-0", "BR-CL-03", tcPosition)
			llRechnung = This.CodeNormal(loK.cWaehrung) == This.CodeNormal(This.cWaehrung)
			llSteuer = This.IstText(This.cSteuerwaehrung) AND This.CodeNormal(loK.cWaehrung) == This.CodeNormal(This.cSteuerwaehrung)
			= This.Pflicht(llRechnung OR llSteuer, tcPosition, "BT-X-590-0", "FX-TECH-03")
			IF llRechnung OR llSteuer
				FOR lnVorher = 1 TO lnK - 1
					IF VARTYPE(toP.aSteuersummen[lnVorher]) = "O"
						= This.Pflicht(NOT (This.CodeNormal(loK.cWaehrung) == This.CodeNormal(toP.aSteuersummen[lnVorher].cWaehrung)), ;
							tcPosition, IIF(llRechnung, "BT-X-329", "BT-X-590"), IIF(llRechnung, "FX-SCH-A-000387", "FX-SCH-A-000388"))
					ENDIF
				ENDFOR
			ENDIF
		ENDFOR
		IF This.cProfil == "XRECHNUNG-CII"
			FOR lnK = 1 TO toP.nAnhaenge
				loA = toP.aAnhaenge[lnK]
				IF VARTYPE(loA) # "O" OR NOT This.IstText(loA.cBase64)
					LOOP
				ENDIF
				FOR lnVorher = 1 TO lnK - 1
					loB = toP.aAnhaenge[lnVorher]
					IF VARTYPE(loB) = "O"
						IF This.IstText(loB.cBase64) AND loA.cDateiname == loB.cDateiname
							= This.Pflicht(.F., tcPosition, "BT-X-31-2", "BR-DE-22")
						ENDIF
					ENDIF
				ENDFOR
			ENDFOR
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionsaenderung
		LPARAMETERS toK, toCodes, tcPosition
		LOCAL lcBT, lcRegel, llZuschlag, llBetrag, lnSoll
		llZuschlag = VARTYPE(toK.lZuschlag) = "L" AND toK.lZuschlag
		lcBT = IIF(llZuschlag, "BT-141", "BT-136")
		= This.Pflicht(VARTYPE(toK.lZuschlag) = "L", tcPosition, lcBT, "FX-TECH-03")
		llBetrag = This.IstZahl(toK.nRechenbetrag)
		= This.Pflicht(llBetrag, tcPosition, lcBT, IIF(llZuschlag, "BR-43", "BR-41"))
		= This.Pflicht(ISNULL(toK.nBetrag) OR This.IstZahl(toK.nBetrag), tcPosition, lcBT, "FX-TECH-03")
		= This.StellenPruefen(toK.nBetrag, 2, tcPosition, lcBT)
		= This.StellenPruefen(toK.nBasis, 2, tcPosition, IIF(llZuschlag, "BT-142", "BT-137"))
		= This.StellenPruefen(toK.nProzent, 2, tcPosition, IIF(llZuschlag, "BT-143", "BT-138"))
		= This.Pflicht(ISNULL(toK.nBasis) OR This.IstZahl(toK.nBasis), tcPosition, IIF(llZuschlag, "BT-142", "BT-137"), "FX-TECH-03")
		= This.Pflicht(ISNULL(toK.nProzent) OR This.IstZahl(toK.nProzent), tcPosition, IIF(llZuschlag, "BT-143", "BT-138"), "FX-TECH-03")
		IF This.cProfil == "XRECHNUNG-CII"
			= This.Pflicht(ISNULL(toK.nProzent) OR This.IstZahl(toK.nBasis), tcPosition, IIF(llZuschlag, "BT-142", "BT-137"), "PEPPOL-EN16931-R041")
			= This.Pflicht(ISNULL(toK.nBasis) OR This.IstZahl(toK.nProzent), tcPosition, IIF(llZuschlag, "BT-143", "BT-138"), "PEPPOL-EN16931-R042")
		ENDIF
		IF llBetrag AND This.IstZahl(toK.nBasis) AND This.IstZahl(toK.nProzent)
			lnSoll = ROUND(This.RechenNumeric(toK.nBasis), 2) * ROUND(This.RechenNumeric(toK.nProzent), 2) / 100
			IF This.cProfil # "XRECHNUNG-CII"
				lnSoll = ROUND(lnSoll, 2)
			ENDIF
			lcRegel = IIF(This.cProfil == "XRECHNUNG-CII", "PEPPOL-EN16931-R040", "FX-TECH-03")
			IF ROUND(ABS(toK.nRechenbetrag - lnSoll), 6) > IIF(This.cProfil == "XRECHNUNG-CII", 0.02, 0)
				= This.Meldung("FEHLER", tcPosition, lcBT, lcRegel, "Betrag {1} passt nicht zu Basis mal Prozent {2}.", ;
					This.RechenZahl(toK.nRechenbetrag), This.RechenZahl(lnSoll))
			ENDIF
		ENDIF
		= This.ProduktText(toK.cGrund, IIF(llZuschlag, "BT-144", "BT-139"), tcPosition, .F.)
		= This.ProduktText(toK.cGrundcode, IIF(llZuschlag, "BT-145", "BT-140"), tcPosition, .F.)
		= This.ProduktText(toK.cGrundliste, "BT-193-1", tcPosition, .T.)
		IF NOT This.IstText(toK.cGrund) AND NOT This.IstText(toK.cGrundcode)
			= This.Pflicht(.F., tcPosition, IIF(llZuschlag, "BT-144", "BT-139"), IIF(llZuschlag, This.PositionsRegel("44"), "BR-42"))
			IF NOT llZuschlag OR This.cProfil # "EXTENDED"
				= This.Pflicht(.F., tcPosition, IIF(llZuschlag, "BT-144", "BT-139"), IIF(llZuschlag, "BR-CO-24", "BR-CO-23"))
			ENDIF
		ENDIF
		IF This.IstText(toK.cGrundliste)
			= This.Pflicht(llZuschlag AND This.IstText(toK.cGrundcode) AND This.CodeNormal(toK.cGrundliste) == "5153", tcPosition, "BT-193-1", "FX-TECH-03")
		ENDIF
		IF llZuschlag
			lcRegel = IIF(This.cProfil == "EXTENDED", IIF(This.CodeNormal(toK.cGrundliste) == "5153", "FX-SCH-A-001138", "FX-SCH-A-001139"), "BR-CL-20")
		ELSE
			lcRegel = IIF(This.cProfil == "EXTENDED", "FX-SCH-A-001137", "BR-CL-19")
		ENDIF
		= This.PruefeCode(toCodes, toK.cGrundcode, IIF(llZuschlag, "BT-145", "BT-140"), lcRegel, tcPosition)
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionsanhang
		LPARAMETERS toA, toCodes, tcPosition
		IF This.cProfil # "EXTENDED"
		    = This.Pflicht(.F., tcPosition, "BG-X-3", "FX-PROFIL-01")
		ENDIF
		= This.ProduktText(toA.cNummer, "BT-X-27", tcPosition, .T.)
		= This.ProduktText(toA.cTyp, "BT-X-30", tcPosition, .T.)
		= This.ProduktText(toA.cZeile, "BT-X-29", tcPosition, .T.)
		= This.ProduktText(toA.cUri, "BT-X-28", tcPosition, .T.)
		= This.ProduktText(toA.cBeschreibung, "BT-X-299", tcPosition, .T.)
		= This.ProduktText(toA.cReferenzart, "BT-X-32", tcPosition, .T.)
		= This.ProduktText(toA.cDatei, "BT-X-31", tcPosition, .T.)
		= This.ProduktText(toA.cMime, "BT-X-31-1", tcPosition, .T.)
		= This.ProduktText(toA.cDateiname, "BT-X-31-2", tcPosition, .T.)
		= This.Pflicht(This.IstText(toA.cNummer), tcPosition, "BT-X-27", "FX-SCH-A-001015")
		= This.Pflicht(This.IstText(toA.cNummer), tcPosition, "BT-X-27", "BR-52")
		= This.Pflicht(This.IstText(toA.cTyp), tcPosition, "BT-X-30", "FX-SCH-A-001016")
		= This.PruefeCode(toCodes, toA.cTyp, "BT-X-30", "FX-SCH-A-001025", tcPosition)
		= This.PruefeCode(toCodes, toA.cReferenzart, "BT-X-32", IIF(This.cProfil == "EXTENDED", "FX-SCH-A-001024", "BR-CL-07"), tcPosition)
		= This.Pflicht(VARTYPE(toA.dDatum) = "D", tcPosition, "BT-X-33", "FX-TECH-03")
		toA.cPosition = tcPosition
		toA.cDateiBT = "BT-X-31"
		= toA.DateiLaden()
		IF This.IstText(toA.cDatei)
		    = This.Pflicht(This.IstText(toA.cMime), tcPosition, "BT-X-31-1", "FX-SCH-A-001019")
		    = This.Pflicht(This.IstText(toA.cDateiname), tcPosition, "BT-X-31-2", "FX-SCH-A-001021")
		    = This.PruefeCode(toCodes, toA.cMime, "BT-X-31-1", IIF(This.cProfil == "EXTENDED", "FX-SCH-A-001020", "BR-CL-24"), tcPosition)
		ELSE
		    = This.Pflicht(NOT This.IstText(toA.cMime) AND NOT This.IstText(toA.cDateiname), tcPosition, "BT-X-31", "FX-TECH-03")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionsendlieferempfaenger
		LPARAMETERS toP, toCodes, tcPosition
		LOCAL laBT[1], laRegeln[1]
		* Leere Rollen brauchen keine neu aufgebauten BT-/Regeltabellen.
		IF NOT This.ProduktKind(toP, "BG-X-10", tcPosition)
		    RETURN
		ENDIF
		IF NOT toP.Vorhanden()
		    RETURN
		ENDIF
		= ALINES(laBT, STRTRAN( ;
		    "BG-X-10 BT-X-67 BT-X-68 BT-X-68-0 BT-X-69 BT-X-542 BG-X-10 " + ;
		    "BT-X-70 BT-X-70-0 BT-X-71 BG-X-11 BT-X-72 BT-X-72-1 BT-X-316 " + ;
		    "BT-X-73 BT-X-74 BT-X-75 BT-X-76 BT-X-77 BT-X-78 BT-X-79 " + ;
		    "BT-X-80 BT-X-81 BT-X-82 BT-X-83 BT-X-83-0 BT-X-84 BT-X-84", " ", CHR(13)))
		= ALINES(laRegeln, STRTRAN( ;
		    "FX-SCH-A-001115 FX-SCH-A-001116 FX-SCH-A-001117 FX-SCH-A-001119 " + ;
		    "FX-SCH-A-001120 FX-SCH-A-001125 FX-SCH-A-001108 - FX-SCH-A-001124", " ", CHR(13)))
		= This.ValidatePositionspartei(toP, toCodes, tcPosition, @laBT, @laRegeln, .F.)
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionsgleichung
		LPARAMETERS toP, tcPosition
		LOCAL lnBasis, lnSoll
		IF This.cProfil # "XRECHNUNG-CII" OR NOT This.IstZahl(toP.nNettobetrag) OR ;
			NOT This.IstZahl(toP.nMenge) OR NOT This.IstZahl(toP.nPreis)
			RETURN
		ENDIF
		lnBasis = 1
		IF NOT ISNULL(toP.nBasismenge)
			IF NOT This.IstZahl(toP.nBasismenge)
				RETURN
			ENDIF
			lnBasis = ROUND(This.RechenNumeric(toP.nBasismenge), 4)
		ENDIF
		IF lnBasis <= 0
			RETURN
		ENDIF
		lnSoll = ROUND(This.RechenNumeric(toP.nMenge), 4) * ROUND(This.RechenNumeric(toP.nPreis), 4) / lnBasis
		IF This.IstZahl(toP.nGesamtAenderung)
			lnSoll = lnSoll + toP.nGesamtAenderung
		ENDIF
		IF ROUND(ABS(toP.nNettobetrag - lnSoll), 8) > 0.02
			= This.Meldung("WARNUNG", tcPosition, "BT-131", "PEPPOL-EN16931-R120", "Der Positionsnettobetrag passt nicht zu Menge, Preisbasis und Positionsnachl{ae}ssen/-zuschl{ae}gen.")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionslieferempfaenger
		LPARAMETERS toP, toCodes, tcPosition
		LOCAL laBT[1], laRegeln[1]
		* Leere Rollen brauchen keine neu aufgebauten BT-/Regeltabellen.
		IF NOT This.ProduktKind(toP, "BG-X-7", tcPosition)
		    RETURN
		ENDIF
		IF NOT toP.Vorhanden()
		    RETURN
		ENDIF
		= ALINES(laBT, STRTRAN( ;
		    "BG-X-7 BT-186-00 BT-186 BT-186-1 BT-X-50 BT-X-541 BG-X-7 " + ;
		    "BT-X-51 BT-X-51-0 BT-X-52 BG-X-8 BT-X-54 BT-X-54-1 BT-X-315 " + ;
		    "BT-X-55 BT-X-56 BT-X-57 BT-X-58 BT-X-59 BT-X-60 BT-X-61 " + ;
		    "BT-X-62 BT-X-63 BT-X-64 BT-X-65 BT-X-65-0 BT-X-66 BT-X-66", " ", CHR(13)))
		= ALINES(laRegeln, STRTRAN( ;
		    "FX-SCH-A-001096 FX-SCH-A-001097 FX-SCH-A-001098 FX-SCH-A-001100 " + ;
		    "FX-SCH-A-001102 FX-SCH-A-001107 FX-SCH-A-001089 FX-SCH-A-001101 FX-SCH-A-001106", " ", CHR(13)))
		= This.ValidatePositionspartei(toP, toCodes, tcPosition, @laBT, @laRegeln, .F.)
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionslieferung
		LPARAMETERS toP, toCodes, tcPosition, tlEinheiten
		= This.Positionsliefermenge(toP.nGratismenge, toP.cGratiseinheit, "BT-X-46", "001077", "001078", toCodes, tcPosition, tlEinheiten)
		= This.Positionsliefermenge(toP.nPaketmenge, toP.cPaketeinheit, "BT-X-47", "001083", "001084", toCodes, tcPosition, tlEinheiten)
		= This.Positionsliefermenge(toP.nMengeJePaket, toP.cEinheitJePaket, "BT-X-561", "001085", "001086", toCodes, tcPosition, tlEinheiten)
		IF VARTYPE(toP.dLieferdatum) # "D" OR NOT EMPTY(toP.dLieferdatum)
		    IF This.cProfil # "EXTENDED"
		        = This.Pflicht(.F., tcPosition, "BT-X-85", "FX-PROFIL-01")
		    ENDIF
		    = This.Pflicht(VARTYPE(toP.dLieferdatum) = "D", tcPosition, "BT-X-85", "FX-TECH-03")
		ENDIF
		= This.ValidatePositionsreferenz(toP.oVersandavis, "BT-X-86", "BT-X-87", "BT-X-88", tcPosition, "BG-X-13")
		= This.ValidatePositionsreferenz(toP.oEmpfangsavis, "BT-X-89", "BT-X-90", "BT-X-91", tcPosition, "BG-X-82")
		= This.ValidatePositionsreferenz(toP.oLieferschein, "BT-X-92", "BT-X-93", "BT-X-94", tcPosition, "BG-X-83")
		= This.ValidatePositionslieferempfaenger(toP.oLieferempfaenger, toCodes, tcPosition)
		= This.ValidatePositionsendlieferempfaenger(toP.oEndlieferempfaenger, toCodes, tcPosition)
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionspartei
		* BT-Reihenfolge wie PositionsparteiTexte, ergaenzt um Gruppen und Kennungen.
		* Regeln: Globalpflicht/-code, Landpflicht/-code, Register-/Adresscode, ID-Anzahl, Register-/Adresspflicht.
		LPARAMETERS toP, toCodes, tcPosition, taBT, taRegeln, tlBeschreibung
		IF This.cProfil # "EXTENDED"
		    = This.Pflicht(.F., tcPosition, taBT[1], "FX-PROFIL-01")
		ENDIF
		= This.PositionsparteiTexte(toP, tcPosition, @taBT)
		IF NOT tlBeschreibung AND toP.WertGesetzt(toP.cBeschreibung)
		    = This.Pflicht(.F., tcPosition, taBT[1], "FX-PROFIL-01")
		ENDIF
		IF This.IstText(toP.cRegisterSchema)
		    = This.Pflicht(This.IstText(toP.cRegisternummer), tcPosition, taBT[8], "FX-TECH-03")
		ENDIF
		IF taRegeln[8] # "-" AND This.IstText(toP.cRegisternummer)
		    = This.Pflicht(This.IstText(toP.cRegisterSchema), tcPosition, taBT[9], taRegeln[8])
		ENDIF
		IF This.AdresseVorhanden(toP)
		    = This.Pflicht(This.IstText(toP.cLand), tcPosition, taBT[23], taRegeln[3])
		ENDIF
		= This.PruefeCode(toCodes, toP.cLand, taBT[23], taRegeln[4], tcPosition)
		= This.PruefeCode(toCodes, toP.cRegisterSchema, taBT[9], taRegeln[5], tcPosition)
		= This.PruefeCode(toCodes, toP.cElektronischeAdresseSchema, taBT[26], taRegeln[6], tcPosition)
		IF This.IstText(toP.cElektronischeAdresseSchema) AND NOT This.IstText(toP.cElektronischeAdresse)
		    = This.Pflicht(.F., tcPosition, taBT[25], "FX-TECH-03")
		ENDIF
		IF This.IstText(toP.cElektronischeAdresse) AND NOT This.IstText(toP.cElektronischeAdresseSchema)
		    = This.Pflicht(.F., tcPosition, IIF(taRegeln[9] == "FX-TECH-03", taBT[25], taBT[26]), taRegeln[9])
		ENDIF
		= This.ValidateUstPraefix(toCodes, toP.cUstId, taBT[28], tcPosition)
		IF This.cProfil == "EXTENDED" AND This.IstText(toP.cSteuernummer)
		    = This.Pflicht(.F., tcPosition, taBT[27], "BR-FXEXT-03")
		ENDIF
		= This.PositionsparteiKennungen(toP, toCodes, tcPosition, @taBT, @taRegeln)
		= This.PositionsparteiKontakte(toP, tcPosition, @taBT)
		IF This.ProduktKind(toP.oRegisterAdresse, taBT[1], tcPosition)
		    = This.Pflicht(NOT (toP.WertGesetzt(toP.oRegisterAdresse.cPlz) OR toP.WertGesetzt(toP.oRegisterAdresse.cStrasse) OR ;
		        toP.WertGesetzt(toP.oRegisterAdresse.cStrasse2) OR toP.WertGesetzt(toP.oRegisterAdresse.cStrasse3) OR ;
		        toP.WertGesetzt(toP.oRegisterAdresse.cOrt) OR toP.WertGesetzt(toP.oRegisterAdresse.cLand) OR ;
		        toP.WertGesetzt(toP.oRegisterAdresse.cRegion)), tcPosition, taBT[1], "FX-PROFIL-01")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionsrahmen
		LPARAMETERS toZ, tcPosition
		LOCAL loK
		loK = This.oAbrechnungszeitraum
		IF This.cProfil # "XRECHNUNG-CII" OR VARTYPE(loK) # "O" OR VARTYPE(toZ) # "O"
		    RETURN
		ENDIF
		IF VARTYPE(loK.dAnfang) = "D" AND VARTYPE(toZ.dAnfang) = "D" AND NOT EMPTY(loK.dAnfang) AND NOT EMPTY(toZ.dAnfang)
		    = This.Pflicht(toZ.dAnfang >= loK.dAnfang, tcPosition, "BT-134", "PEPPOL-EN16931-R110")
		ENDIF
		IF VARTYPE(loK.dEnde) = "D" AND VARTYPE(toZ.dEnde) = "D" AND NOT EMPTY(loK.dEnde) AND NOT EMPTY(toZ.dEnde)
		    = This.Pflicht(toZ.dEnde <= loK.dEnde, tcPosition, "BT-135", "PEPPOL-EN16931-R111")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionsreferenz
		LPARAMETERS toR, tcBT, tcZeileBT, tcDatumBT, tcPosition, tcGruppe
		LOCAL llDatum, llExtended
		IF ISNULL(toR)
		    RETURN
		ENDIF
		IF NOT This.ProduktKind(toR, tcZeileBT, tcPosition)
		    RETURN
		ENDIF
		llExtended = NOT EMPTY(tcGruppe)
		IF llExtended AND This.cProfil # "EXTENDED"
		    = This.Pflicht(.F., tcPosition, tcGruppe, "FX-PROFIL-01")
		ENDIF
		= This.ProduktText(toR.cNummer, tcBT, tcPosition, .T.)
		= This.ProduktText(toR.cZeile, tcZeileBT, tcPosition, llExtended)
		llDatum = VARTYPE(toR.dDatum) = "D"
		= This.Pflicht(llDatum, tcPosition, tcDatumBT, "FX-TECH-03")
		IF NOT llDatum OR NOT EMPTY(toR.dDatum)
		    IF This.cProfil # "EXTENDED"
		        = This.Pflicht(.F., tcPosition, tcDatumBT, "FX-PROFIL-01")
		    ENDIF
		ENDIF
		= This.ProduktText(toR.cTyp, tcBT, tcPosition, .F.)
		= This.ProduktText(toR.cReferenzart, tcBT, tcPosition, .F.)
		= This.Pflicht(NOT This.IstText(toR.cTyp) AND NOT This.IstText(toR.cReferenzart), tcPosition, tcBT, "FX-TECH-03")
		* Dokumentkennung ist optional; eine Zeile oder ein Datum darf allein stehen.
		= This.Pflicht(This.IstText(toR.cNummer) OR This.IstText(toR.cZeile) OR ;
		    (llDatum AND NOT EMPTY(toR.dDatum)), tcPosition, tcZeileBT, "FX-TECH-03")
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionsvereinbarung
		LPARAMETERS toP, toCodes, tcPosition
		LOCAL lnR, loR
		= This.ProduktText(toP.cLieferbedingung, "BT-X-562", tcPosition, .T.)
		= This.ProduktText(toP.cLieferland, "BT-X-565", tcPosition, .T.)
		= This.ProduktText(toP.cLieferort, "BT-X-566", tcPosition, .T.)
		IF This.IstText(toP.cLieferbedingung) OR This.IstText(toP.cLieferland) OR This.IstText(toP.cLieferort)
		    = This.Pflicht(This.IstText(toP.cLieferbedingung), tcPosition, "BT-X-562", "FX-SCH-A-001026")
		ENDIF
		= This.PruefeCode(toCodes, toP.cLieferbedingung, "BT-X-562", "FX-SCH-A-001027", tcPosition)
		= This.PruefeCode(toCodes, toP.cLieferland, "BT-X-565", IIF(This.cProfil == "EXTENDED", "FX-SCH-A-001028", "BR-CL-14"), tcPosition)
		= This.ValidatePositionsreferenz(toP.oBestellung, "BT-X-21", "BT-132", "BT-X-22", tcPosition, "")
		= This.ValidatePositionsreferenz(toP.oAuftrag, "BT-X-537", "BT-X-538", "BT-X-539", tcPosition, "BG-X-81")
		= This.ValidatePositionsreferenz(toP.oAngebot, "BT-X-310", "BT-X-311", "BT-X-312", tcPosition, "BG-X-47")
		= This.ValidatePositionsreferenz(toP.oVertrag, "BT-X-24", "BT-X-25", "BT-X-26", tcPosition, "BG-X-2")
		FOR lnR = 1 TO toP.nEndkundenbestellungen
		    loR = toP.aEndkundenbestellungen[lnR]
		    IF This.ProduktKind(loR, "BG-X-5", tcPosition)
		        = This.ValidatePositionsreferenz(loR, "BT-X-43", "BT-X-44", "BT-X-45", tcPosition, "BG-X-5")
		    ENDIF
		ENDFOR
		FOR lnR = 1 TO toP.nAnhaenge
		    loR = toP.aAnhaenge[lnR]
		    IF This.ProduktKind(loR, "BG-X-3", tcPosition)
		        = This.ValidatePositionsanhang(loR, toCodes, tcPosition)
		    ENDIF
		ENDFOR
		= This.ValidatePositionsverkaeufer(toP.oVerkaeufer, toCodes, tcPosition)
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionsverkaeufer
		LPARAMETERS toP, toCodes, tcPosition
		LOCAL laBT[1], laRegeln[1]
		* Leere Rollen brauchen keine neu aufgebauten BT-/Regeltabellen.
		IF NOT This.ProduktKind(toP, "BG-X-90", tcPosition)
		    RETURN
		ENDIF
		IF NOT toP.Vorhanden()
		    RETURN
		ENDIF
		= ALINES(laBT, STRTRAN( ;
		    "BG-X-90 BT-X-567 BT-X-568 BT-X-568-0 BT-X-569 BT-X-570 BT-X-571 " + ;
		    "BT-X-572 BT-X-572-0 BT-X-573 BG-X-91 BT-X-574 BT-X-574-1 BT-X-575 " + ;
		    "BT-X-576 BT-X-577 BT-X-578 BT-X-579 BT-X-580 BT-X-581 BT-X-582 " + ;
		    "BT-X-583 BT-X-584 BT-X-585 BT-X-586 BT-X-586-0 BT-X-587 BT-X-588", " ", CHR(13)))
		= ALINES(laRegeln, STRTRAN( ;
		    "FX-SCH-A-001046 FX-SCH-A-001047 FX-SCH-A-001048 FX-SCH-A-001050 " + ;
		    "FX-SCH-A-001051 FX-SCH-A-001058 - - FX-TECH-03", " ", CHR(13)))
		IF This.cProfil # "EXTENDED"
		    laRegeln[2] = "BR-CL-10"
		    laRegeln[4] = "BR-CL-14"
		    laRegeln[5] = "BR-CL-11"
		    laRegeln[6] = "BR-CL-25"
		ENDIF
		= This.ValidatePositionspartei(toP, toCodes, tcPosition, @laBT, @laRegeln, .T.)
	ENDPROC

	PROTECTED PROCEDURE ValidatePositionszeitraum
		LPARAMETERS toZ, tcPosition
		LOCAL llAnfang, llEnde
		IF ISNULL(toZ)
			RETURN
		ENDIF
		IF NOT This.ProduktKind(toZ, "BG-26", tcPosition)
			RETURN
		ENDIF
		= This.Pflicht(VARTYPE(toZ.dAnfang) = "D", tcPosition, "BT-134", "FX-TECH-03")
		= This.Pflicht(VARTYPE(toZ.dEnde) = "D", tcPosition, "BT-135", "FX-TECH-03")
		= This.Pflicht(INLIST(VARTYPE(toZ.cBeschreibung), "C", "M") AND EMPTY(toZ.cBeschreibung), tcPosition, "BG-26", "FX-PROFIL-01")
		llAnfang = VARTYPE(toZ.dAnfang) = "D" AND NOT EMPTY(toZ.dAnfang)
		llEnde = VARTYPE(toZ.dEnde) = "D" AND NOT EMPTY(toZ.dEnde)
		= This.ValidatePositionsrahmen(toZ, tcPosition)
		= This.Pflicht(llAnfang OR llEnde, tcPosition, "BG-26", "BR-CO-20")
		IF llAnfang AND llEnde
			= This.Pflicht(toZ.dEnde >= toZ.dAnfang, tcPosition, "BT-135", "BR-30")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidatePreisaenderung
		LPARAMETERS toK, toCodes, tcPosition
		LOCAL lcBT, lcRegel
		lcBT = IIF(VARTYPE(toK.lZuschlag) = "L" AND toK.lZuschlag, "BT-X-302", "BT-147")
		lcRegel = IIF(This.cProfil == "XRECHNUNG-CII", "PEPPOL-EN16931-R043-2", "FX-TECH-03")
		= This.Pflicht(VARTYPE(toK.lZuschlag) = "L", tcPosition, lcBT, lcRegel)
		IF VARTYPE(toK.lZuschlag) # "L" AND This.cProfil == "XRECHNUNG-CII"
			= This.Pflicht(.F., tcPosition, lcBT, "PEPPOL-EN16931-R044")
		ENDIF
		lcRegel = IIF(lcBT == "BT-X-302" AND This.cProfil == "EXTENDED", "FX-SCH-A-001035", "FX-SCH-A-000531")
		= This.Pflicht(This.IstZahl(toK.nBetrag), tcPosition, lcBT, lcRegel)
		IF (VARTYPE(toK.lZuschlag) # "L" OR NOT This.IstZahl(toK.nBetrag)) AND This.cProfil # "EXTENDED"
			= This.Meldung("WARNUNG", tcPosition, lcBT, "CII-SR-119", "Ein Preisnachlass braucht einen logischen Indikator und einen Betrag.")
		ENDIF
		IF This.IstZahl(toK.nBetrag)
			= This.Pflicht(toK.nBetrag >= 0, tcPosition, lcBT, "FX-TECH-03")
			= This.StellenPruefen(toK.nBetrag, 4, tcPosition, lcBT)
		ENDIF
		IF VARTYPE(toK.lZuschlag) = "L" AND toK.lZuschlag AND This.cProfil # "EXTENDED"
			lcRegel = IIF(This.cProfil == "XRECHNUNG-CII", "PEPPOL-EN16931-R044", "FX-PROFIL-01")
			= This.Pflicht(.F., tcPosition, "BT-X-302", lcRegel)
			= This.Meldung("WARNUNG", tcPosition, "BT-X-302", "CII-SR-119", "Auf Preisebene sollen nur Nachl{ae}sse stehen.")
		ENDIF
		= This.PreiszusatzZahl(toK.nProzent, IIF(lcBT == "BT-147", "BT-X-34", "BT-X-300"), tcPosition)
		= This.PreiszusatzZahl(toK.nBasis, IIF(lcBT == "BT-147", "BT-X-35", "BT-X-301"), tcPosition)
		= This.ProduktText(toK.cGrund, IIF(lcBT == "BT-147", "BT-X-36", "BT-X-303"), tcPosition, .T.)
		= This.ProduktText(toK.cGrundcode, IIF(lcBT == "BT-147", "BT-X-313", IIF(This.CodeNormal(toK.cGrundliste) == "5153", "BT-X-616", "BT-X-314")), tcPosition, .T.)
		= This.ProduktText(toK.cGrundliste, "BT-X-616-1", tcPosition, .T.)
		IF This.IstText(toK.cGrundliste)
			= This.Pflicht(lcBT == "BT-X-302" AND This.IstText(toK.cGrundcode) AND This.CodeNormal(toK.cGrundliste) == "5153", tcPosition, "BT-X-616-1", "FX-TECH-03")
		ENDIF
		IF This.cProfil == "EXTENDED"
			IF lcBT == "BT-147"
				= This.PruefeCode(toCodes, toK.cGrundcode, "BT-X-313", "FX-SCH-A-001033", tcPosition)
			ELSE
				IF This.CodeNormal(toK.cGrundliste) == "5153"
					= This.PruefeCode(toCodes, toK.cGrundcode, "BT-X-616", "FX-SCH-A-001036", tcPosition)
				ENDIF
			ENDIF
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidatePreise
		LPARAMETERS toP, toCodes, tcPosition
		LOCAL lnK, loK, lnNachlaesse
		IF This.IstZahl(toP.nPreis)
			= This.Pflicht(toP.nPreis >= 0, tcPosition, "BT-146", "BR-27")
		ENDIF
		= This.ProduktZahl(toP.nBruttopreis, "BT-148", tcPosition)
		IF This.IstZahl(toP.nBruttopreis)
			= This.Pflicht(toP.nBruttopreis >= 0, tcPosition, "BT-148", "BR-28")
		ENDIF
		= This.Preisbasis(toP.nBruttobasismenge, "BT-149-1", tcPosition)
		IF NOT ISNULL(toP.nBruttobasismenge) OR toP.nPreisaenderungen > 0
			= This.Pflicht(This.IstZahl(toP.nBruttopreis), tcPosition, "BT-148", "FX-SCH-A-000273")
		ENDIF
		lnNachlaesse = 0
		FOR lnK = 1 TO toP.nPreisaenderungen
			loK = toP.aPreisaenderungen[lnK]
			IF This.ProduktKind(loK, "BT-147", tcPosition)
				= This.ValidatePreisaenderung(loK, toCodes, tcPosition)
				IF VARTYPE(loK.lZuschlag) = "L" AND NOT loK.lZuschlag
					lnNachlaesse = lnNachlaesse + 1
				ENDIF
			ENDIF
		ENDFOR
		IF This.cProfil == "EN16931" AND lnNachlaesse > 1
			= This.Pflicht(.F., tcPosition, "BT-147", "FX-SCH-A-000274")
		ENDIF
		IF This.cProfil == "XRECHNUNG-CII"
			IF toP.nPreisaenderungen > 1
				= This.Meldung("FEHLER", tcPosition, "BT-147", "FX-TECH-03", "In XRechnung ist auf Preisebene h{oe}chstens ein Nachlass zul{ae}ssig.")
			ENDIF
			= This.ValidatePreisgleichung(toP, tcPosition)
		ENDIF
		= This.ValidatePreissteuer(toP.oPreissteuer, toCodes, tcPosition)
	ENDPROC

	PROTECTED PROCEDURE ValidatePreisgleichung
		LPARAMETERS toP, tcPosition
		LOCAL lnNachlass, loK
		IF This.IstZahl(toP.nBruttobasismenge) AND This.IstZahl(toP.nBasismenge)
			= This.Pflicht(ROUND(toP.nBruttobasismenge, 4) = ROUND(toP.nBasismenge, 4), ;
				tcPosition, "BT-149-1", "BR-TMP-3")
		ENDIF
		IF NOT This.IstZahl(toP.nBruttopreis) OR NOT This.IstZahl(toP.nPreis)
			RETURN
		ENDIF
		lnNachlass = 0
		* Mehrere Preisnachlaesse sind in diesem XR-Pruefstand nicht auswertbar.
		IF toP.nPreisaenderungen > 0
			loK = toP.aPreisaenderungen[1]
			IF VARTYPE(loK) = "O" AND This.IstZahl(loK.nBetrag)
				lnNachlass = ROUND(loK.nBetrag, 4)
			ENDIF
		ENDIF
		= This.Pflicht(ROUND(toP.nPreis, 4) = ROUND(ROUND(toP.nBruttopreis, 4) - lnNachlass, 4), ;
			tcPosition, "BT-146", "PEPPOL-EN16931-R046")
	ENDPROC

	PROTECTED PROCEDURE ValidatePreissteuer
		LPARAMETERS toS, toCodes, tcPosition
		IF NOT This.ProduktKind(toS, "BG-X-4", tcPosition)
			RETURN
		ENDIF
		IF NOT toS.HatInhalt()
			RETURN
		ENDIF
		= This.PreiszusatzZahl(toS.nBetrag, "BT-X-37", tcPosition)
		= This.PreiszusatzZahl(toS.nSatz, "BT-X-42", tcPosition)
		= This.ProduktText(toS.cTyp, "BT-X-38", tcPosition, .T.)
		= This.ProduktText(toS.cKategorie, "BT-X-40", tcPosition, .T.)
		= This.ProduktText(toS.cBefreiungsgrund, "BT-X-39", tcPosition, .T.)
		= This.ProduktText(toS.cBefreiungscode, "BT-X-41", tcPosition, .T.)
		IF This.cProfil # "EXTENDED"
			RETURN
		ENDIF
		= This.Pflicht(This.IstZahl(toS.nBetrag), tcPosition, "BT-X-37", "FX-SCH-A-001060")
		= This.Pflicht(This.IstText(toS.cTyp), tcPosition, "BT-X-38", "FX-SCH-A-001061")
		= This.Pflicht(This.IstText(toS.cKategorie), tcPosition, "BT-X-40", "FX-SCH-A-001062")
		= This.Pflicht(This.IstZahl(toS.nSatz), tcPosition, "BT-X-42", "FX-SCH-A-001063")
		= This.PruefeCode(toCodes, toS.cKategorie, "BT-X-40", "FX-SCH-A-001064", tcPosition)
		= This.PruefeCode(toCodes, toS.cBefreiungscode, "BT-X-41", "FX-SCH-A-001065", tcPosition)
		= This.PruefeCode(toCodes, toS.cTyp, "BT-X-38", "FX-SCH-A-001066", tcPosition)
	ENDPROC

	PROTECTED PROCEDURE ValidateProdukt
		    LPARAMETERS toP, toCodes, tcPosition
		    LOCAL lnK, loK
		    = This.ProduktKind(toP, "BG-31", tcPosition)
		= This.ProduktText(toP.cBeschreibung, "BT-154", tcPosition, .F.)
		= This.ProduktText(toP.cVerkaeuferArtikelnummer, "BT-155", tcPosition, .F.)
		= This.ProduktText(toP.cKaeuferArtikelnummer, "BT-156", tcPosition, .F.)
		= This.ProduktText(toP.cGlobaleKennung, "BT-157", tcPosition, .F.)
		= This.ProduktText(toP.cGlobalesSchema, "BT-157-1", tcPosition, .F.)
		= This.ProduktText(toP.cUrsprungsland, "BT-159", tcPosition, .F.)
		= This.ProduktText(toP.cProduktkennung, "BT-X-305", tcPosition, .T.)
		= This.ProduktText(toP.cBranchenkennung, "BT-X-532", tcPosition, .T.)
		= This.ProduktText(toP.cModellkennung, "BT-X-533", tcPosition, .T.)
		= This.ProduktText(toP.cMarke, "BT-X-535", tcPosition, .T.)
		= This.ProduktText(toP.cModellname, "BT-X-536", tcPosition, .T.)
		= This.ProduktText(toP.cStatus, "BT-X-7", tcPosition, .T.)
		IF This.IstText(toP.cGlobaleKennung)
			= This.Pflicht(This.IstText(toP.cGlobalesSchema), tcPosition, "BT-157-1", "BR-64")
			= This.PruefeCode(toCodes, toP.cGlobalesSchema, "BT-157-1", IIF(This.cProfil == "EXTENDED", "FX-SCH-A-001146", "BR-CL-21"), tcPosition)
		ELSE
			= This.Pflicht(NOT This.IstText(toP.cGlobalesSchema), tcPosition, "BT-157", "FX-TECH-03")
		ENDIF
		= This.PruefeCode(toCodes, toP.cUrsprungsland, "BT-159", IIF(This.cProfil == "EXTENDED", "FX-SCH-A-001173", "BR-CL-15"), tcPosition)
		IF This.cProfil == "EXTENDED"
			= This.PruefeCode(toCodes, toP.cStatus, "BT-X-7", "FX-SCH-A-000334", tcPosition)
		ENDIF
		= This.ValidateProduktnotizen(toP, toCodes, tcPosition)
		= This.ValidateMerkmale(toP, toCodes, tcPosition)
		= This.ValidateKlassifikationen(toP, toCodes, tcPosition)
		= This.ValidateProduktwiederholungen(toP, toCodes, tcPosition)
		= This.ValidateHersteller(toP.oHersteller, toCodes, tcPosition)
	ENDPROC

	PROTECTED PROCEDURE ValidateProduktnotizen
		    LPARAMETERS toP, toCodes, tcPosition
		    LOCAL lnK, loK, llInhalt
		    IF toP.nNotizen > 1 AND This.cProfil # "EXTENDED"
		        IF This.cProfil == "EN16931"
		            = This.Pflicht(.F., tcPosition, "BT-127", "FX-SCH-A-000271")
		        ELSE
		            = This.Meldung("WARNUNG", tcPosition, "BT-127", "CII-SR-039", "XRechnung empfiehlt h{oe}chstens eine Positionsnotiz.")
		            = This.Meldung("WARNUNG", tcPosition, "BT-127", "CII-SR-040", "XRechnung empfiehlt h{oe}chstens einen Positionsnotiztext.")
		        ENDIF
		    ENDIF
		    FOR lnK = 1 TO toP.nNotizen
		        loK = toP.aNotizen[lnK]
		        IF NOT This.ProduktKind(loK, "BT-127", tcPosition)
		            LOOP
		        ENDIF
		        = This.ProduktText(loK.cText, "BT-127", tcPosition, .F.)
		        = This.ProduktText(loK.cTextcode, "BT-X-9", tcPosition, .T.)
		        = This.ProduktText(loK.cBetreff, "BT-X-10", tcPosition, .T.)
		        llInhalt = This.IstText(loK.cText) OR This.IstText(loK.cTextcode)
		        IF This.cProfil == "EXTENDED"
		            = This.Pflicht(llInhalt, tcPosition, "BT-127", IIF(This.IstText(loK.cBetreff), "BR-FXEXT-02", "FX-TECH-03"))
		            = This.PruefeCode(toCodes, loK.cBetreff, "BT-X-10", "FX-SCH-A-001014", tcPosition)
		        ELSE
		            = This.Pflicht(This.IstText(loK.cText), tcPosition, "BT-127", "FX-TECH-03")
		        ENDIF
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateProduktreferenz
		    LPARAMETERS toR, toCodes, tcPosition
		    LOCAL lnK, loK
		= This.ProduktText(toR.cNummer, "BT-X-308", tcPosition, .T.)
		= This.ProduktText(toR.cName, "BT-X-18", tcPosition, .T.)
		= This.ProduktText(toR.cBeschreibung, "BT-X-19", tcPosition, .T.)
		= This.ProduktText(toR.cVerkaeuferArtikelnummer, "BT-X-16", tcPosition, .T.)
		= This.ProduktText(toR.cKaeuferArtikelnummer, "BT-X-17", tcPosition, .T.)
		= This.ProduktText(toR.cBranchenkennung, "BT-X-309", tcPosition, .T.)
		= This.ProduktText(toR.cEinheit, "BT-X-20-1", tcPosition, .T.)
		IF This.cProfil # "EXTENDED"
			= This.Pflicht(.F., tcPosition, "BG-X-1", "FX-PROFIL-01")
		ENDIF
		= This.Pflicht(This.IstText(toR.cName), tcPosition, "BT-X-18", "FX-SCH-A-001148")
		= This.ProduktZahl(toR.nMenge, "BT-X-20", tcPosition)
		IF This.cProfil == "EXTENDED" AND EMPTY(toCodes.cListenFehler)
			= This.PruefeCode(toCodes, toR.cEinheit, "BT-X-20-1", "FX-SCH-A-001153", tcPosition)
		ENDIF
		IF NOT ISNULL(toR.nMenge)
			= This.Pflicht(This.IstText(toR.cEinheit), tcPosition, "BT-X-20-1", "FX-SCH-A-001152")
		ELSE
			= This.Pflicht(NOT This.IstText(toR.cEinheit), tcPosition, "BT-X-20", "FX-TECH-03")
		ENDIF
		FOR lnK = 1 TO toR.nGlobaleKennungen
			loK = toR.aGlobaleKennungen[lnK]
			IF This.ProduktKind(loK, "BT-X-15", tcPosition)
				= This.ProduktText(loK.cWert, "BT-X-15", tcPosition, .T.)
				= This.ProduktText(loK.cSchema, "BT-X-15-1", tcPosition, .T.)
				= This.Pflicht(This.IstText(loK.cWert), tcPosition, "BT-X-15", "FX-TECH-03")
				= This.Pflicht(This.IstText(loK.cSchema), tcPosition, "BT-X-15-1", "FX-SCH-A-001150")
				= This.PruefeCode(toCodes, loK.cSchema, "BT-X-15-1", "FX-SCH-A-001151", tcPosition)
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateProduktwiederholungen
		    LPARAMETERS toP, toCodes, tcPosition
		    LOCAL lnK, loK
		    FOR lnK = 1 TO toP.nChargen
		        loK = toP.aChargen[lnK]
		        IF This.ProduktKind(loK, "BT-X-534", tcPosition)
		            = This.ProduktText(loK.cWert, "BT-X-534", tcPosition, .T.)
		            = This.ProduktText(loK.cSchema, "BT-X-534", tcPosition, .T.)
		            = This.Pflicht(NOT This.IstText(loK.cSchema), tcPosition, "BT-X-534", "FX-TECH-03")
		            = This.Pflicht(This.IstText(loK.cWert), tcPosition, "BT-X-534", "FX-TECH-03")
		        ENDIF
		    ENDFOR
		    FOR lnK = 1 TO toP.nInstanzen
		        loK = toP.aInstanzen[lnK]
		        IF This.ProduktKind(loK, "BG-X-84", tcPosition)
		            = This.ProduktText(loK.cCharge, "BT-X-306", tcPosition, .T.)
		            = This.ProduktText(loK.cSeriennummer, "BT-X-307", tcPosition, .T.)
		            = This.Pflicht(This.IstText(loK.cCharge) OR This.IstText(loK.cSeriennummer), tcPosition, "BG-X-84", "FX-TECH-03")
		        ENDIF
		    ENDFOR
		    FOR lnK = 1 TO toP.nProduktreferenzen
		        loK = toP.aProduktreferenzen[lnK]
		        IF This.ProduktKind(loK, "BG-X-1", tcPosition)
		            = This.ValidateProduktreferenz(loK, toCodes, tcPosition)
		        ENDIF
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateRechnen
		= This.ValidateSteuergruppen()
		= This.ValidateSummen()
		= This.ValidateZahlungssummen()
		= This.ValidateSollwerte()
		= This.ValidateSteuerzeitpunkt()
		= This.ValidateSteuerkurs()
		= This.KopfText(This.cSteuerwaehrung, "BT-6", .F.)
		IF This.IstText(This.cSteuerwaehrung)
			= This.Pflicht(This.IstZahl(This.nSteuerInSteuerwaehrung) AND ;
			    NOT (This.CodeNormal(This.cSteuerwaehrung) == This.CodeNormal(This.cWaehrung)), "", "BT-111", "BR-53")
			= This.Pflicht(NOT (This.CodeNormal(This.cSteuerwaehrung) == This.CodeNormal(This.cWaehrung)), "", "BT-6", ;
			    "FX-TECH-03")
			IF This.IstZahl(This.nSteuerInSteuerwaehrung)
			    = This.Pflicht(NOT (This.CodeNormal(This.cSteuerwaehrung) == This.CodeNormal(This.cWaehrung)), ;
			        "", "BT-111", "FX-SCH-A-000042")
			ENDIF
			IF This.cProfil == "XRECHNUNG-CII"
			    = This.Pflicht(NOT (This.CodeNormal(This.cSteuerwaehrung) == This.CodeNormal(This.cWaehrung)), "", "BT-6", "PEPPOL-EN16931-R005")
			    = This.Pflicht(This.IstZahl(This.nSteuerInSteuerwaehrung) AND ;
			        NOT (This.CodeNormal(This.cSteuerwaehrung) == This.CodeNormal(This.cWaehrung)), "", "BT-111", "PEPPOL-EN16931-R054")
			    IF This.IstZahl(This.nSteuer)
			        = This.Pflicht(This.IstZahl(This.nSteuerInSteuerwaehrung) AND ((This.nSteuer < 0 AND ROUND(This.nSteuerInSteuerwaehrung, 2) < 0) OR ;
			            (This.nSteuer >= 0 AND ROUND(This.nSteuerInSteuerwaehrung, 2) >= 0)), "", "BT-111", "PEPPOL-EN16931-R055")
			    ENDIF
			ENDIF
		ENDIF
		IF NOT ISNULL(This.nSteuerInSteuerwaehrung)
			= This.Pflicht(This.IstZahl(This.nSteuerInSteuerwaehrung) AND This.IstText(This.cSteuerwaehrung), "", "BT-111", "FX-TECH-03")
			= This.StellenPruefen(This.nSteuerInSteuerwaehrung, 2, "", "BT-111")
			IF This.cProfil == "XRECHNUNG-CII" AND NOT This.IstText(This.cSteuerwaehrung)
			    = This.Pflicht(.F., "", "BT-111", "PEPPOL-EN16931-R054")
			ENDIF
			IF This.cProfil == "XRECHNUNG-CII"
			    = This.Pflicht(NOT (This.CodeNormal(This.cSteuerwaehrung) == This.CodeNormal(This.cWaehrung)), "", "BT-111", "PEPPOL-EN16931-R053")
			ENDIF
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateReferenz
		LPARAMETERS toReferenz, tcBT, tcDatumBT, tcRegel, tlExtended
		LOCAL llDatum
		IF ISNULL(toReferenz)
			RETURN
		ENDIF
		IF NOT This.ReferenzObjekt(toReferenz, tcBT)
			RETURN
		ENDIF
		IF tlExtended
			= This.ProfilFeld(.T., tcBT)
		ENDIF
		= This.KopfText(toReferenz.cNummer, tcBT, .F.)
		= This.Pflicht(INLIST(VARTYPE(toReferenz.cZeile), "C", "M") AND NOT This.IstText(toReferenz.cZeile), "", tcBT, "FX-TECH-03")
		= This.Pflicht(This.IstText(toReferenz.cNummer), "", tcBT, tcRegel)
		llDatum = VARTYPE(toReferenz.dDatum) = "D"
		= This.Pflicht(llDatum, "", tcDatumBT, "FX-TECH-03")
		IF tcBT # "BT-25"
			= This.ProfilFeld(NOT llDatum OR NOT EMPTY(toReferenz.dDatum), tcDatumBT)
		ENDIF
		IF tcBT == "BT-25"
			= This.KopfText(toReferenz.cTyp, "BT-X-555", .T.)
		ELSE
			= This.Pflicht(INLIST(VARTYPE(toReferenz.cTyp), "C", "M") AND NOT This.IstText(toReferenz.cTyp), "", "BT-X-555", "FX-TECH-03")
		ENDIF
		IF tcBT == "BT-12"
			= This.KopfText(toReferenz.cReferenzart, "BT-X-405", .T.)
		ELSE
			= This.Pflicht(INLIST(VARTYPE(toReferenz.cReferenzart), "C", "M") AND NOT This.IstText(toReferenz.cReferenzart), "", "BT-X-405", "FX-TECH-03")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateReferenzCodes
		LPARAMETERS toCodes
		LOCAL lnReferenz, loReferenz
		IF This.cProfil # "EXTENDED"
			RETURN
		ENDIF
		= This.PruefeCode(toCodes, This.cLieferbedingung, "BT-X-145", "FX-SCH-A-000320", "")
		= This.PruefeCode(toCodes, This.cLieferland, "BT-X-563", "FX-SCH-A-000648", "")
		IF VARTYPE(This.oVertrag) = "O"
			= This.PruefeCode(toCodes, This.oVertrag.cReferenzart, "BT-X-405", "FX-SCH-A-000707", "")
		ENDIF
		FOR lnReferenz = 1 TO This.nRechnungsreferenzen
			loReferenz = This.aRechnungsreferenzen[lnReferenz]
			IF VARTYPE(loReferenz) = "O"
				= This.PruefeCode(toCodes, loReferenz.cTyp, "BT-X-555", "FX-SCH-A-000863", "")
			ENDIF
		ENDFOR
		FOR lnReferenz = 1 TO This.nKontierungen
			loReferenz = This.aKontierungen[lnReferenz]
			IF VARTYPE(loReferenz) = "O"
				= This.PruefeCode(toCodes, loReferenz.cTyp, "BT-X-290", "FX-SCH-A-000949", "")
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateRolleBuyerAgent
		LPARAMETERS toP, toCodes
		IF NOT This.KopfRolle(toP, "BT-X-406", .T.)
			RETURN
		ENDIF
		= This.RollenText(toCodes, toP.cName, "BT-X-406", .T., "")
		= This.RollenText(toCodes, toP.cRolle, "BT-X-549", .T., "")
		= This.RollenText(toCodes, toP.cRegisternummer, "BT-X-410", .T., "")
		= This.RollenText(toCodes, toP.cRegisterSchema, "BT-X-410-0", .T., "BR-CL-11")
		= This.RollenText(toCodes, toP.cHandelsname, "BT-X-407", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresse, "BT-X-412", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresseSchema, "BT-X-412-0", .T., "BR-CL-25")
		= This.RollenText(toCodes, toP.cUstId, "BT-X-411", .T., "")
		IF NOT ISNULL(toP.cBeschreibung) AND (NOT INLIST(VARTYPE(toP.cBeschreibung), "C", "M") OR This.IstText(toP.cBeschreibung))
			= This.Pflicht(.F., "", "BT-X-406", "FX-PROFIL-01")
		ENDIF
		= This.RollenKennungen(toP, toCodes, "BT-X-408", "BT-X-409", ;
			"BT-X-409-0", "FX-SCH-A-000649", .T.)
		= This.RollenAttribut(toP.cElektronischeAdresse, toP.cElektronischeAdresseSchema, "BT-X-412")
		IF This.IstText(toP.cRegisterSchema) AND NOT This.IstText(toP.cRegisternummer)
			= This.Pflicht(.F., "", "BT-X-410", "FX-TECH-03")
		ENDIF
		= This.RollenPostanschrift(toP, toCodes, .T., ;
			"BT-X-419", "BT-X-420", "BT-X-421", "BT-X-422", ;
			"BT-X-423", "BT-X-424", "BT-X-425")
		= This.RollenRegisteranschrift(toP.oRegisterAdresse, toCodes, ;
			"BT-X-426", "BT-X-427", "BT-X-428", "BT-X-429", ;
			"BT-X-430", "BT-X-431", "BT-X-432", "FX-SCH-A-000662")
		= This.RollenKontakte(toP, toCodes, "BT-X-413", "BT-X-414", "BT-X-415", ;
			"BT-X-416", "BT-X-417", "BT-X-418")
		= This.ValidateUstPraefix(toCodes, toP.cUstId, "BT-X-411")
		= This.KopfText(toP.cSteuernummer, "BT-X-411", .T.)
		IF This.IstText(toP.cSteuernummer)
			= This.Pflicht(.F., "", "BT-X-411-0", IIF(This.cProfil == "EXTENDED", "BR-FXEXT-03", "FX-PROFIL-01"))
		ENDIF
		= This.Pflicht(This.cProfil # "EXTENDED" OR This.IstText(toP.cName), "", "BT-X-406", "FX-SCH-A-000650")
		IF This.cProfil == "EXTENDED" AND This.AdresseVorhanden(toP)
			= This.Pflicht(This.IstText(toP.cLand), "", "BT-X-424", "FX-SCH-A-000658")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateRolleBuyerTaxRepresentative
		LPARAMETERS toP, toCodes
		IF NOT This.KopfRolle(toP, "BT-X-362", .T.)
			RETURN
		ENDIF
		= This.RollenText(toCodes, toP.cName, "BT-X-362", .T., "")
		= This.RollenText(toCodes, toP.cRolle, "BT-X-546", .T., "")
		= This.RollenText(toCodes, toP.cRegisternummer, "BT-X-366", .T., "")
		= This.RollenText(toCodes, toP.cRegisterSchema, "BT-X-366-0", .T., "BR-CL-11")
		= This.RollenText(toCodes, toP.cHandelsname, "BT-X-363", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresse, "BT-X-368", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresseSchema, "BT-X-368-0", .T., "BR-CL-25")
		= This.RollenText(toCodes, toP.cUstId, "BT-X-367", .T., "")
		IF NOT ISNULL(toP.cBeschreibung) AND (NOT INLIST(VARTYPE(toP.cBeschreibung), "C", "M") OR This.IstText(toP.cBeschreibung))
			= This.Pflicht(.F., "", "BT-X-362", "FX-PROFIL-01")
		ENDIF
		= This.RollenKennungen(toP, toCodes, "BT-X-364", "BT-X-365", ;
			"BT-X-365-0", "FX-SCH-A-000672", .T.)
		= This.RollenAttribut(toP.cElektronischeAdresse, toP.cElektronischeAdresseSchema, "BT-X-368")
		IF This.IstText(toP.cRegisterSchema) AND NOT This.IstText(toP.cRegisternummer)
			= This.Pflicht(.F., "", "BT-X-366", "FX-TECH-03")
		ENDIF
		= This.RollenPostanschrift(toP, toCodes, .T., ;
			"BT-X-375", "BT-X-376", "BT-X-377", "BT-X-378", ;
			"BT-X-379", "BT-X-380", "BT-X-381")
		= This.RollenRegisteranschrift(toP.oRegisterAdresse, toCodes, ;
			"BT-X-382", "BT-X-383", "BT-X-384", "BT-X-385", ;
			"BT-X-386", "BT-X-387", "BT-X-388", "FX-SCH-A-000686")
		= This.RollenKontakte(toP, toCodes, "BT-X-369", "BT-X-370", "BT-X-371", ;
			"BT-X-372", "BT-X-373", "BT-X-374")
		= This.ValidateUstPraefix(toCodes, toP.cUstId, "BT-X-367")
		= This.KopfText(toP.cSteuernummer, "BT-X-367", .T.)
		IF This.IstText(toP.cSteuernummer)
			= This.Pflicht(.F., "", "BT-X-367-0", IIF(This.cProfil == "EXTENDED", "BR-FXEXT-03", "FX-PROFIL-01"))
		ENDIF
		= This.Pflicht(This.cProfil # "EXTENDED" OR This.IstText(toP.cName), "", "BT-X-362", "FX-SCH-A-000673")
		IF This.cProfil == "EXTENDED" AND This.AdresseVorhanden(toP)
			= This.Pflicht(This.IstText(toP.cLand), "", "BT-X-380", "FX-SCH-A-000682")
		ENDIF
		= This.Pflicht(This.cProfil # "EXTENDED" OR This.IstText(toP.cUstId), "", "BT-X-367", "FX-SCH-A-000676")
	ENDPROC

	PROTECTED PROCEDURE ValidateRolleInvoicee
