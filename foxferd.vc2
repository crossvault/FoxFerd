	PROCEDURE ZielSetzen
		LPARAMETERS tcAlias, tnSession, tcDatei
		LOCAL lnK
		= DODEFAULT(tcAlias, tnSession, tcDatei)
		FOR lnK = 1 TO This.nNotizen
		    IF VARTYPE(This.aNotizen[lnK]) = "O"
		        = This.aNotizen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nMerkmale
		    IF VARTYPE(This.aMerkmale[lnK]) = "O"
		        = This.aMerkmale[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nKlassifikationen
		    IF VARTYPE(This.aKlassifikationen[lnK]) = "O"
		        = This.aKlassifikationen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nInstanzen
		    IF VARTYPE(This.aInstanzen[lnK]) = "O"
		        = This.aInstanzen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nChargen
		    IF VARTYPE(This.aChargen[lnK]) = "O"
		        = This.aChargen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nProduktreferenzen
		    IF VARTYPE(This.aProduktreferenzen[lnK]) = "O"
		        = This.aProduktreferenzen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nPreisaenderungen
			IF VARTYPE(This.aPreisaenderungen[lnK]) = "O"
				= This.aPreisaenderungen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
			ENDIF
		ENDFOR
		IF VARTYPE(This.oPreissteuer) = "O"
			= This.oPreissteuer.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oHersteller) = "O"
		    = This.oHersteller.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oLieferempfaenger) = "O"
		    = This.oLieferempfaenger.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oEndlieferempfaenger) = "O"
		    = This.oEndlieferempfaenger.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oVersandavis) = "O"
		    = This.oVersandavis.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oEmpfangsavis) = "O"
		    = This.oEmpfangsavis.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oLieferschein) = "O"
		    = This.oLieferschein.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oVerkaeufer) = "O"
		    = This.oVerkaeufer.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oBestellung) = "O"
		    = This.oBestellung.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oAuftrag) = "O"
		    = This.oAuftrag.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oAngebot) = "O"
		    = This.oAngebot.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oVertrag) = "O"
		    = This.oVertrag.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		FOR lnK = 1 TO This.nEndkundenbestellungen
		    IF VARTYPE(This.aEndkundenbestellungen[lnK]) = "O"
		        = This.aEndkundenbestellungen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nAnhaenge
		    IF VARTYPE(This.aAnhaenge[lnK]) = "O"
		        This.aAnhaenge[lnK].cPosition = This.cNummer
		        This.aAnhaenge[lnK].cDateiBT = "BT-X-31"
		        = This.aAnhaenge[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nAbrechnungsaenderungen
			IF VARTYPE(This.aAbrechnungsaenderungen[lnK]) = "O"
				= This.aAbrechnungsaenderungen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
			ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nKontierungen
			IF VARTYPE(This.aKontierungen[lnK]) = "O"
				= This.aKontierungen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
			ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nSteuersummen
			IF VARTYPE(This.aSteuersummen[lnK]) = "O"
				= This.aSteuersummen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
			ENDIF
		ENDFOR
		IF VARTYPE(This.oAbrechnungszeitraum) = "O"
			= This.oAbrechnungszeitraum.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		IF VARTYPE(This.oRechnungsreferenz) = "O"
			= This.oRechnungsreferenz.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
	ENDPROC

ENDDEFINE

