			= This.Pflicht(.F., "", "BT-X-257-0", IIF(This.cProfil == "EXTENDED", "BR-FXEXT-03", "FX-PROFIL-01"))
		ENDIF
		= This.Pflicht(This.IstText(toP.cName), "", "BT-59", "BR-17")
		IF INLIST(This.cProfil, "EN16931", "XRECHNUNG-CII") AND This.PayeeWieVerkaeufer(toP)
			= This.Meldung("FEHLER", "", "BT-59", "BR-17", ;
				"Zahlungsempf{ae}nger und Verk{ae}ufer haben denselben Namen oder dieselbe Kennung.")
