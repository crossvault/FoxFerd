	PROTECTED PROCEDURE AddFehler
		LPARAMETERS tcText, tcBT
		IF PCOUNT() < 2
		    tcBT = ""
		ENDIF
		This.cAddFehlerText = This.cAddFehlerText + tcText + CHR(13) + CHR(10)
		This.nAddFehler = This.nAddFehler + 1
		DIMENSION This.aAddFehler[This.nAddFehler, 2]
		This.aAddFehler[This.nAddFehler, 1] = tcBT
		This.aAddFehler[This.nAddFehler, 2] = tcText
		= This.Eintragen("FEHLER", This.cNummer, tcBT, "FX-TECH-03", tcText)
		RETURN .F.
	ENDPROC

	PROCEDURE AddFehlerMelden
		LPARAMETERS tcPosition, tcBT
		LOCAL lnFehler, lcBT, lcText
		* Jeder Add-Befund behaelt seinen BT auch nach dem Leeren des Cursors.
		FOR lnFehler = 1 TO This.nAddFehler
		    lcBT = This.aAddFehler[lnFehler, 1]
		    IF EMPTY(lcBT)
		        lcBT = tcBT
		    ENDIF
		    lcText = This.MeldungsText("Abgewiesener Produkt-Add-Aufruf: {1}", This.aAddFehler[lnFehler, 2])
		    = This.Eintragen("FEHLER", tcPosition, lcBT, "FX-TECH-03", lcText)
		ENDFOR
	ENDPROC

