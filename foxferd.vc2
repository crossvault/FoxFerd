		= This.RollenText(toCodes, toP.cName, "BT-X-226", .T., "")
		= This.RollenText(toCodes, toP.cRolle, "BT-X-554", .T., "")
		= This.RollenText(toCodes, toP.cRegisternummer, "BT-X-227", .T., "")
