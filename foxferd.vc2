	PROCEDURE EinheitenLaden
		LPARAMETERS tcPfad
		LOCAL lcDatei, lnDatei, lcDaten, lnLaenge
		This.cEinheiten = ""
		This.cListenFehler = "fehlt oder ist nicht lesbar"
		IF VARTYPE(tcPfad) # "C" OR EMPTY(tcPfad)
			RETURN .F.
		ENDIF
		lcDatei = ADDBS(tcPfad) + "codelisten/unit-v17b.txt"
		IF NOT FILE(lcDatei)
			RETURN .F.
		ENDIF
		lnDatei = FOPEN(lcDatei, 0)
		IF lnDatei < 0
			RETURN .F.
		ENDIF
		lnLaenge = FSEEK(lnDatei, 0, 2)
		lcDaten = ""
		IF lnLaenge = 10591
			= FSEEK(lnDatei, 0, 0)
			lcDaten = FREAD(lnDatei, lnLaenge)
		ENDIF
		= FCLOSE(lnDatei)
		This.cListenFehler = "ist besch{ae}digt oder hat einen anderen Stand"
		* Laenge und native Pruefsumme binden die Liste an den vorbereiteten Stand.
		IF This.lTechnischerFehler OR LEN(lcDaten) # 10591 OR NOT (SYS(2007, lcDaten) == "39235")
			RETURN .F.
		ENDIF
		This.cEinheiten = " " + STRTRAN(SUBSTR(lcDaten, 25), CHR(13) + CHR(10), " ")
		This.cListenFehler = ""
		RETURN .T.
	ENDPROC

	PROCEDURE Gueltig
		LPARAMETERS tcRegel, tuWert, tcProfil
		LOCAL lcWert, lcListe
		IF VARTYPE(tuWert) # "C" AND VARTYPE(tuWert) # "M"
			RETURN .F.
		ENDIF
		lcWert = ALLTRIM(CHRTRAN(tuWert, CHR(9) + CHR(10) + CHR(13), "   "))
		IF EMPTY(lcWert) OR " " $ lcWert
			RETURN .F.
		ENDIF
		lcListe = This.Liste(tcRegel, tcProfil)
		RETURN (" " + lcWert + " ") $ lcListe
	ENDPROC

	PROTECTED PROCEDURE Kategorien
		LOCAL lcListe
		lcListe = " AE L M E S Z G O K B "
		RETURN lcListe
	ENDPROC

