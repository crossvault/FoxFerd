		overtrag = .NULL.
	*</PropValue>
	
	PROTECTED PROCEDURE AddAbrechnungsaenderung
		LPARAMETERS tnBetrag, tcGrund, tlZuschlag
		LOCAL loK
		IF NOT ISNULL(tnBetrag) AND NOT INLIST(VARTYPE(tnBetrag), "N", "Y")
			RETURN This.AddFehler("Positionsnachlass/-zuschlag: Zahl oder NULL erwartet.", IIF(tlZuschlag, "BT-141", "BT-136"))
		ENDIF
		IF (VARTYPE(tcGrund) = "L" AND tcGrund) OR (VARTYPE(tcGrund) # "L" AND NOT INLIST(VARTYPE(tcGrund), "C", "M"))
			RETURN This.AddFehler("Positionsnachlass/-zuschlag: Grund als Text erwartet.")
		ENDIF
		loK = CREATEOBJECT("fxPositionsaenderung")
		loK.nBetrag = tnBetrag
		loK.lZuschlag = tlZuschlag
		IF INLIST(VARTYPE(tcGrund), "C", "M")
			loK.cGrund = tcGrund
		ENDIF
		This.nAbrechnungsaenderungAnzahl = This.nAbrechnungsaenderungAnzahl + 1
		DIMENSION This.aAbrechnungsaenderungen[This.nAbrechnungsaenderungAnzahl]
		This.aAbrechnungsaenderungen[This.nAbrechnungsaenderungAnzahl] = loK
		= loK.ZielSetzen(This.cEigenerCursor, This.nMeldungsSession, This.cCursorDatei)
		RETURN loK
	ENDPROC

	PROCEDURE AddAbrechnungszeitraum
		LPARAMETERS tdAnfang, tdEnde
		LOCAL loZ
		IF NOT ISNULL(This.oAbrechnungszeitraum) OR VARTYPE(tdAnfang) # "D" OR VARTYPE(tdEnde) # "D"
			RETURN This.AddFehler("BG-26: Genau ein Zeitraum mit Datumswerten erwartet.", "BG-26")
		ENDIF
		loZ = CREATEOBJECT("fxZeitraum")
		loZ.dAnfang = tdAnfang
		loZ.dEnde = tdEnde
		= loZ.ZielSetzen(This.cEigenerCursor, This.nMeldungsSession, This.cCursorDatei)
		This.oAbrechnungszeitraum = loZ
		RETURN loZ
	ENDPROC

	PROCEDURE AddAngebot
		LPARAMETERS tcNummer
		LOCAL loR
		IF NOT ISNULL(This.oAngebot)
		    RETURN This.AddFehler("BT-X-310: Dieser Bezug darf nur einmal je Position vorkommen.", "BT-X-310")
		ENDIF
		loR = This.NeueReferenz("fxReferenz", tcNummer)
		IF VARTYPE(loR) = "O"
		    This.oAngebot = loR
		ENDIF
		RETURN loR
	ENDPROC

	PROCEDURE AddAnhang
		LPARAMETERS tcDatei, tcMime, tcBeschreibung
		LOCAL loA, lnA
		IF NOT INLIST(VARTYPE(tcDatei), "C", "M") OR ;
		        NOT INLIST(VARTYPE(tcMime), "C", "M") OR NOT INLIST(VARTYPE(tcBeschreibung), "C", "M")
		    RETURN This.AddFehler("BT-X-31: AddAnhang erwartet drei Textparameter.")
		ENDIF
		loA = This.NeueReferenz("fxAnhang", JUSTFNAME(tcDatei))
		IF VARTYPE(loA) # "O"
		    RETURN .F.
		ENDIF
		loA.cPosition = This.cNummer
		loA.cDateiBT = "BT-X-31"
		loA.cDatei = tcDatei
		loA.cDateiname = JUSTFNAME(tcDatei)
		loA.cTyp = "916"
		loA.cMime = tcMime
		loA.cBeschreibung = tcBeschreibung
		lnA = This.nAnhaenge + 1
		DIMENSION This.aAnhaenge[lnA]
		This.aAnhaenge[lnA] = loA
		This.nAnhangAnzahl = lnA
		= loA.DateiLaden()
		RETURN loA
	ENDPROC

