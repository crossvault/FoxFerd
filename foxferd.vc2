			= This.Pflicht(This.IstText(toP.cLand), "", "BT-X-254", "FX-SCH-A-000915")
		ENDIF
		IF This.cProfil == "EN16931" AND toP.nGlobaleKennungen > 1
			= This.Pflicht(.F., "", "BT-60-0", "FX-SCH-A-000468")
		ENDIF
	ENDPROC

