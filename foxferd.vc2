DEFINE CLASS fxvorauszahlung AS fxbasis OF "foxferd.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: addsteuer
		*m: caddfehler_access
		*m: caddfehler_assign
		*m: destroy
		*m: init
		*m: nsteuern_access
		*m: nsteuern_assign
		*m: zielsetzen
		*p: caddfehler		&& BG-X-46 Bleibender Fehler eines AddSteuer-Aufrufs, nur lesbar
		*p: caddfehlertext		&& BG-X-46 Interner bleibender Add-Fehler
		*p: cempfangsdatum		&& BT-X-292 Optionaler Zahlungseingang YYYYMMDD oder YYYYMMDDHHMM
		*p: cempfangsformat		&& BT-X-292-0 Format des Zahlungseingangs, 102 oder 205
		*p: crechnungsdatum		&& BT-X-560 Optionales Datum der Vorauszahlungsrechnung
		*p: crechnungsformat		&& BT-X-560-0 Datumsformat der Vorauszahlungsrechnung, 102 oder 205
		*p: crechnungsnummer		&& BT-X-558 Kennung der Vorauszahlungsrechnung
		*p: crechnungstyp		&& BT-X-559 Optionaler Typ der Vorauszahlungsrechnung
		*p: nbetrag		&& BT-X-291 Bereits gezahlter Betrag, nur EXTENDED
		*p: nsteueranzahl		&& BG-X-46 Interner Zaehler
		*p: nsteuern		&& BG-X-46 Anzahl enthaltener Steuerangaben, nur lesbar
		*a: asteuern[1]		&& BG-X-46 Enthaltene Steuern ohne Rueckverweis
	*</DefinedPropArrayMethod>

	PROTECTED caddfehlertext,nsteueranzahl
	*<PropValue>
		caddfehler = 
		caddfehlertext = 
		cempfangsdatum = 
		cempfangsformat = 
		crechnungsdatum = 
		crechnungsformat = 
		crechnungsnummer = 
		crechnungstyp = 
		Name = "fxvorauszahlung"
		nbetrag = .NULL.
		nsteueranzahl = 0
		nsteuern = 0
	*</PropValue>
	
	PROCEDURE AddSteuer
		    LPARAMETERS tnBetrag, tcTyp, tcKategorie, tnSatz
		    LOCAL loS, lnK
		    IF PCOUNT() < 4
		        tnSatz = .NULL.
		    ENDIF
		    IF NOT INLIST(VARTYPE(tnBetrag), "N", "Y") OR NOT INLIST(VARTYPE(tcTyp), "C", "M") OR ;
		        NOT INLIST(VARTYPE(tcKategorie), "C", "M") OR NOT (ISNULL(tnSatz) OR INLIST(VARTYPE(tnSatz), "N", "Y"))
		        This.cAddFehlerText = "AddSteuer verlangt Betrag, Steuerart, Kategorie und optional einen Satz."
		        = This.Eintragen("FEHLER", "", "BT-X-293", "FX-TECH-03", This.cAddFehlerText)
		        RETURN .F.
		    ENDIF
		    loS = CREATEOBJECT("fxVoraussteuer")
		    loS.nBetrag = tnBetrag
		    loS.cTyp = tcTyp
		    loS.cKategorie = tcKategorie
		    loS.nSatz = tnSatz
		    lnK = This.nSteuern + 1
		    DIMENSION This.aSteuern[lnK]
		    This.aSteuern[lnK] = loS
		    This.nSteuerAnzahl = lnK
		    = loS.ZielSetzen(This.cEigenerCursor, This.nMeldungsSession, This.cCursorDatei)
		    RETURN loS
	ENDPROC

	PROCEDURE cAddFehler_Access
		    RETURN This.cAddFehlerText
	ENDPROC

	PROCEDURE cAddFehler_Assign
		    LPARAMETERS tuWert
	ENDPROC

	PROCEDURE Destroy
		    DIMENSION This.aSteuern[1]
		    This.aSteuern[1] = .NULL.
	ENDPROC

	PROCEDURE Init
		= DODEFAULT()
		This.cEmpfangsformat = "102"
		This.cRechnungsformat = "102"
	ENDPROC

	PROCEDURE nSteuern_Access
		    RETURN This.nSteuerAnzahl
	ENDPROC

	PROCEDURE nSteuern_Assign
		    LPARAMETERS tuWert
	ENDPROC

	PROCEDURE ZielSetzen
		    LPARAMETERS tcAlias, tnSession, tcDatei
		    LOCAL lnK
		    = DODEFAULT(tcAlias, tnSession, tcDatei)
		    FOR lnK = 1 TO This.nSteuern
		        IF VARTYPE(This.aSteuern[lnK]) = "O"
		            = This.aSteuern[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		        ENDIF
		    ENDFOR
	ENDPROC

ENDDEFINE

DEFINE CLASS fxwritercii AS fxbasis OF "foxferd.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: adddatum
		*m: addel
		*m: addindikator
		*m: addtext
		*m: addzahl
		*m: attribut
		*m: build
		*m: codenormal
