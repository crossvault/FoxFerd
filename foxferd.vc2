DEFINE CLASS fxproduktreferenz AS fxbasis OF "foxferd.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: addfehler
		*m: addglobalekennung
		*m: caddfehler_access
		*m: caddfehler_assign
		*m: nglobalekennungen_access
		*m: nglobalekennungen_assign
		*m: zielsetzen
		*p: caddfehler
		*p: caddfehlertext
		*p: cbeschreibung		&& BT-X-19 Beschreibung des referenzierten Produkts, nur EXTENDED
		*p: cbranchenkennung		&& BT-X-309 Branchenkennung des referenzierten Produkts
		*p: ceinheit		&& BT-X-20-1 Einheit des referenzierten Produkts
		*p: ckaeuferartikelnummer		&& BT-X-17 Kaeuferkennung des referenzierten Produkts
		*p: cname		&& BT-X-18 Name des referenzierten Produkts, nur EXTENDED
		*p: cnummer		&& BT-X-308 Produktreferenzkennung, nur EXTENDED
		*p: cverkaeuferartikelnummer		&& BT-X-16 Verkaeuferkennung des referenzierten Produkts
		*p: nglobalekennunganzahl
		*p: nglobalekennungen		&& BT-X-15 Anzahl, nur lesbar
		*p: nmenge		&& BT-X-20 Menge des referenzierten Produkts, nur EXTENDED
		*a: aglobalekennungen[1,0]
	*</DefinedPropArrayMethod>

	PROTECTED caddfehlertext,nglobalekennunganzahl
	*<PropValue>
		caddfehler = 
		caddfehlertext = 
		cbeschreibung = 
		cbranchenkennung = 
		ceinheit = 
		ckaeuferartikelnummer = 
		cname = 
		cnummer = 
		cverkaeuferartikelnummer = 
		Name = "fxProduktreferenz"
		nglobalekennunganzahl = 0
		nglobalekennungen = 0
		nmenge = .NULL.
	*</PropValue>
	
	PROTECTED PROCEDURE AddFehler
		    LPARAMETERS tcText
		    This.cAddFehlerText = This.cAddFehlerText + tcText + CHR(13) + CHR(10)
		    = This.Eintragen("FEHLER", "", "", "FX-TECH-03", tcText)
		    RETURN .F.
	ENDPROC

	PROCEDURE AddGlobaleKennung
		    LPARAMETERS tcWert, tcSchema
		    LOCAL loK
		    IF NOT INLIST(VARTYPE(tcWert), "C", "M") OR NOT INLIST(VARTYPE(tcSchema), "C", "M")
		        RETURN This.AddFehler("AddGlobaleKennung: Textparameter erwartet.")
		    ENDIF
		    loK = CREATEOBJECT("fxKennung")
		    loK.cWert = tcWert
		loK.cSchema = tcSchema
		    This.nGlobaleKennungAnzahl = This.nGlobaleKennungAnzahl + 1
		    DIMENSION This.aGlobaleKennungen[This.nGlobaleKennungAnzahl]
		    This.aGlobaleKennungen[This.nGlobaleKennungAnzahl] = loK
		    = loK.ZielSetzen(This.cEigenerCursor, This.nMeldungsSession, This.cCursorDatei)
		    RETURN loK
	ENDPROC

	PROCEDURE cAddFehler_Access
		    RETURN This.cAddFehlerText
	ENDPROC

	PROCEDURE cAddFehler_Assign
		    LPARAMETERS tuWert
		    * Bleibende Add-Fehler sind nur lesbar.
	ENDPROC

	PROCEDURE Destroy
		DIMENSION This.aGlobaleKennungen[1]
		This.aGlobaleKennungen[1] = .NULL.
	ENDPROC

	PROCEDURE Init
		This.aGlobaleKennungen[1] = .NULL.
	ENDPROC

	PROCEDURE nGlobaleKennungen_Access
		    RETURN This.nGlobaleKennungAnzahl
	ENDPROC

	PROCEDURE nGlobaleKennungen_Assign
		    LPARAMETERS tuWert
		    * Nur erfolgreiche Add-Aufrufe veraendern den Zaehler.
	ENDPROC

	PROCEDURE ZielSetzen
		LPARAMETERS tcAlias, tnSession, tcDatei
		LOCAL lnK
		= DODEFAULT(tcAlias, tnSession, tcDatei)
		FOR lnK = 1 TO This.nGlobaleKennungen
		    IF VARTYPE(This.aGlobaleKennungen[lnK]) = "O"
		        = This.aGlobaleKennungen[lnK].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
	ENDPROC

ENDDEFINE

