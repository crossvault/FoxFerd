			= This.Pflicht(.F., "", "BT-59", "FX-PROFIL-01")
		ENDIF
		= This.RollenKennungen(toP, toCodes, "BT-60", "BT-60-0", ;
			"BT-60-1", "FX-SCH-A-000467", .F.)
