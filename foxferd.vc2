	PROTECTED PROCEDURE NeueReferenz
		LPARAMETERS tcKlasse, tcNummer
		LOCAL loR
		IF NOT INLIST(VARTYPE(tcNummer), "C", "M")
		    RETURN This.AddFehler("Positionsbezug: Die Kennung muss Text sein.")
		ENDIF
		loR = CREATEOBJECT(tcKlasse)
		IF VARTYPE(loR) # "O"
		    RETURN .F.
		ENDIF
		loR.cNummer = tcNummer
		= loR.ZielSetzen(This.cEigenerCursor, This.nMeldungsSession, This.cCursorDatei)
		RETURN loR
	ENDPROC

