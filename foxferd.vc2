		ENDIF
		IF This.AdresseVorhanden(toP)
			= This.Pflicht(This.IstText(toP.cLand), "", "BT-80", "BR-57")
			IF This.cProfil == "XRECHNUNG-CII"
				= This.Pflicht(This.IstText(toP.cOrt), "", "BT-77", "BR-DE-10")
				= This.Pflicht(This.IstText(toP.cPlz), "", "BT-78", "BR-DE-11")
			ENDIF
		ENDIF
		IF This.cProfil == "EN16931" AND toP.nGlobaleKennungen > 1
			= This.Pflicht(.F., "", "BT-71-0", "FX-SCH-A-000452")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateRolleUltimateShipTo
		LPARAMETERS toP, toCodes
		IF NOT This.KopfRolle(toP, "BT-X-164", .T.)
			RETURN
		ENDIF
		= This.RollenText(toCodes, toP.cName, "BT-X-164", .T., "")
		= This.RollenText(toCodes, toP.cRolle, "BT-X-551", .T., "")
		= This.RollenText(toCodes, toP.cRegisternummer, "BT-X-165", .T., "")
		= This.RollenText(toCodes, toP.cRegisterSchema, "BT-X-165-0", .T., "BR-CL-11")
		= This.RollenText(toCodes, toP.cHandelsname, "BT-X-166", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresse, "BT-X-179", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresseSchema, "BT-X-179-0", .T., "BR-CL-25")
		= This.RollenText(toCodes, toP.cUstId, "BT-X-180", .T., "")
		IF NOT ISNULL(toP.cBeschreibung) AND (NOT INLIST(VARTYPE(toP.cBeschreibung), "C", "M") OR This.IstText(toP.cBeschreibung))
			= This.Pflicht(.F., "", "BT-X-164", "FX-PROFIL-01")
		ENDIF
		= This.RollenKennungen(toP, toCodes, "BT-X-162", "BT-X-163", ;
			"BT-X-163-0", "FX-SCH-A-000832", .T.)
		= This.RollenAttribut(toP.cElektronischeAdresse, toP.cElektronischeAdresseSchema, "BT-X-179")
		IF This.IstText(toP.cRegisterSchema) AND NOT This.IstText(toP.cRegisternummer)
			= This.Pflicht(.F., "", "BT-X-165", "FX-TECH-03")
		ENDIF
		= This.RollenPostanschrift(toP, toCodes, .T., ;
			"BT-X-172", "BT-X-173", "BT-X-174", "BT-X-175", ;
			"BT-X-176", "BT-X-177", "BT-X-178")
		= This.RollenRegisteranschrift(toP.oRegisterAdresse, toCodes, ;
			"BT-X-440", "BT-X-441", "BT-X-442", "BT-X-443", ;
			"BT-X-444", "BT-X-445", "BT-X-446", "FX-SCH-A-000845")
		= This.RollenKontakte(toP, toCodes, "BT-X-167", "BT-X-168", "BT-X-322", ;
			"BT-X-169", "BT-X-170", "BT-X-171")
		= This.ValidateUstPraefix(toCodes, toP.cUstId, "BT-X-180")
		= This.KopfText(toP.cSteuernummer, "BT-X-180", .T.)
		IF This.IstText(toP.cSteuernummer)
			= This.Pflicht(.F., "", "BT-X-180-0", IIF(This.cProfil == "EXTENDED", "BR-FXEXT-03", "FX-PROFIL-01"))
		ENDIF
		IF This.cProfil == "EXTENDED" AND This.AdresseVorhanden(toP)
			= This.Pflicht(This.IstText(toP.cLand), "", "BT-X-177", "FX-SCH-A-000841")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateSkonto
		LPARAMETERS toB
		= This.PruefeLieferdatum(toB.dSkontoBasisdatum, "BT-X-282")
		= This.ProfilFeld(NOT EMPTY(toB.dSkontoBasisdatum), "BT-X-282")
		= This.ProduktZahl(toB.nSkontoTage, "BT-X-283", "")
		= This.KopfText(toB.cSkontoEinheit, "BT-X-284", .F.)
		= This.SummenZahl(toB.nSkontoBasis, "BT-X-285")
		= This.SummenZahl(toB.nSkontoProzent, "BT-X-286")
		= This.SummenZahl(toB.nSkontoBetrag, "BT-X-287")
		= This.ProfilFeld(NOT ISNULL(toB.nSkontoBetrag), "BT-X-287")
		IF This.cProfil # "EXTENDED" AND toB.HatSkonto()
		    = This.Pflicht(This.SkontoWerteGueltig(toB.nSkontoTage, toB.nSkontoProzent, toB.nSkontoBasis), "", "BT-20", "FX-TECH-03")
		    = This.ProfilFeld(This.IstText(toB.cSkontoEinheit) AND NOT (This.CodeNormal(toB.cSkontoEinheit) == "DAY"), "BT-X-284")
		ENDIF
		IF This.IstText(toB.cSkontoEinheit) AND ISNULL(toB.nSkontoTage)
		    = This.Pflicht(.F., "", "BT-X-283", "FX-TECH-03")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateSkontoText
		LPARAMETERS tcText
		LOCAL lcRest, lcZeile, lnUmbruch, lnErsteRaute, lnLetzteRaute, llSkonto, llEnde
		IF NOT This.IstText(tcText) OR NOT ("#" $ tcText)
		    RETURN .T.
		ENDIF
		* Zeilenenden wie der XML-Parser normalisieren (XML 1.0 2.11), so wie KoSIT sie sieht.
		lcRest = STRTRAN(tcText, CHR(13) + CHR(10), CHR(10))
		lcRest = CHRTRAN(lcRest, CHR(13), CHR(10))
		llSkonto = .F.
		llEnde = .F.
		DO WHILE NOT EMPTY(lcRest)
		    lnUmbruch = AT(CHR(10), lcRest)
		    lcZeile = lcRest
		    IF lnUmbruch > 0
		        lcZeile = LEFT(lcRest, lnUmbruch - 1)
		    ENDIF
		    * KoSIT sucht #.+# innerhalb einer Zeile, auch im folgenden Freitext.
		    lnErsteRaute = AT("#", lcZeile)
		    lnLetzteRaute = RAT("#", lcZeile)
		    IF lnErsteRaute > 0 AND lnLetzteRaute - lnErsteRaute > 1
		        llEnde = lnUmbruch > 0 AND ;
		            LEN(CHRTRAN(SUBSTR(lcZeile, lnLetzteRaute + 1), " " + CHR(9) + CHR(13), "")) = 0
		    ENDIF
		    lcZeile = This.CodeNormal(lcZeile)
		    IF LEFT(lcZeile, 1) == "#"
		        llSkonto = .T.
		        IF lnUmbruch = 0 OR NOT This.SkontoZeileGueltig(lcZeile)
		            RETURN This.Pflicht(.F., "", "BT-20", "BR-DE-18")
		        ENDIF
		    ENDIF
		    IF lnUmbruch = 0
		        EXIT
		    ENDIF
		    lcRest = SUBSTR(lcRest, lnUmbruch + 1)
		ENDDO
		IF llSkonto AND NOT llEnde
		    RETURN This.Pflicht(.F., "", "BT-20", "BR-DE-18")
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE ValidateSollwerte
		LOCAL lnSoll, lnGruppe, lnBetrag, lnDifferenz, lcStufe, lcZusatz, lnJeGruppe, lnGerechnet
		= This.PruefeGesamtSoll(This.nSollSteuer, This.nSteuer, "BT-110", "FX-SOLL-01")
		= This.PruefeGesamtSoll(This.nSollBrutto, This.nBrutto, "BT-112", "FX-SOLL-02")
		FOR lnSoll = 1 TO This.nSollAnzahl
			= This.StellenPruefen(This.aSollSteuern[lnSoll, 2], 2, "", "BT-119")
			lnBetrag = This.aSollSteuern[lnSoll, 3]
			IF ISNULL(lnBetrag)
				LOOP
			ENDIF
			= This.StellenPruefen(lnBetrag, 2, "", "BT-117")
			lnGruppe = This.SteuergruppeFinden(This.aSollSteuern[lnSoll, 1], This.aSollSteuern[lnSoll, 2])
			IF lnGruppe = 0
				= This.Meldung("FEHLER", "", "BT-117", "FX-BT117-01", ;
					"Zum Sollwert {1} f{ue}r {2}/{3} gibt es keine gerechnete Steuergruppe.", ;
					This.RechenZahl(lnBetrag), This.CodeNormal(This.aSollSteuern[lnSoll, 1]), This.RechenZahl(This.aSollSteuern[lnSoll, 2]))
				LOOP
			ENDIF
			lnGerechnet = 0
			FOR lnJeGruppe = 1 TO This.nSteuergruppen
				IF This.aSteuergruppen[lnJeGruppe].cSteuerkategorie == This.CodeNormal(This.aSollSteuern[lnSoll, 1]) AND ;
					This.aSteuergruppen[lnJeGruppe].nSteuersatz = ROUND(This.aSollSteuern[lnSoll, 2], 2)
					lnGerechnet = lnGerechnet + This.aSteuergruppen[lnJeGruppe].nSteuer
				ENDIF
			ENDFOR
			lnDifferenz = ABS(ROUND(lnBetrag - lnGerechnet, 2))
			IF lnDifferenz = 0
				LOOP
			ENDIF
			lcStufe = "WARNUNG"
			lcZusatz = "Die Abweichung liegt innerhalb eines Cents."
			IF lnDifferenz > 0.01
				lcStufe = "FEHLER"
				lcZusatz = "Diese Pr{ue}fung ist bewusst strenger als KoSIT (BR-CO-17)."
			ENDIF
			= This.Meldung(lcStufe, "", "BT-117", "FX-BT117-01", "Sollwert {1}, gerechnet {2} f{ue}r {3}. {4}", ;
				This.RechenZahl(lnBetrag), This.RechenZahl(lnGerechnet), ;
				This.CodeNormal(This.aSollSteuern[lnSoll, 1]) + "/" + This.RechenZahl(This.aSollSteuern[lnSoll, 2]), ;
				This.oMeldungen.MeldungsText(lcZusatz))
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateSplitPayment
		LOCAL llB, llS, llIt, lnK, loP, laRollen[1], lnRolle, lnV, lnS, loV, loS
		llB = This.KategorieVorhanden("B") OR This.SteuergruppenAnzahl("B") > 0
		llS = This.KategorieVorhanden("S") OR This.SteuergruppenAnzahl("S") > 0
		llIt = NOT This.IstText(This.cLieferland) OR This.CodeNormal(This.cLieferland) == "IT"
		FOR lnK = 1 TO This.nPositionen
		    loP = This.aPositionen[lnK]
		    IF VARTYPE(loP) # "O"
		        LOOP
		    ENDIF
		    llB = llB OR This.CodeNormal(loP.cSteuerkategorie) == "B"
		    llS = llS OR This.CodeNormal(loP.cSteuerkategorie) == "S"
		    IF VARTYPE(loP.oPreissteuer) = "O"
		        llB = llB OR This.CodeNormal(loP.oPreissteuer.cKategorie) == "B"
		        llS = llS OR This.CodeNormal(loP.oPreissteuer.cKategorie) == "S"
		    ENDIF
		    llIt = llIt AND This.SplitLand(loP.oHersteller) AND This.SplitLand(loP.oVerkaeufer) AND ;
		        This.SplitLand(loP.oLieferempfaenger) AND This.SplitLand(loP.oEndlieferempfaenger) AND ;
		        (NOT This.IstText(loP.cLieferland) OR This.CodeNormal(loP.cLieferland) == "IT")
		ENDFOR
		FOR lnV = 1 TO This.nVorauszahlungen
		    loV = This.aVorauszahlungen[lnV]
		    IF VARTYPE(loV) # "O"
		        LOOP
		    ENDIF
		    FOR lnS = 1 TO loV.nSteuern
		        loS = loV.aSteuern[lnS]
		        IF VARTYPE(loS) = "O"
		            llB = llB OR This.CodeNormal(loS.cKategorie) == "B"
		            llS = llS OR This.CodeNormal(loS.cKategorie) == "S"
		        ENDIF
		    ENDFOR
		ENDFOR
		IF NOT llB
		    RETURN
		ENDIF
		= ALINES(laRollen, STRTRAN("oLieferempfaenger oEndlieferempfaenger oVersender oEinkaufsagent oEndnutzer oKaeufer oKaeuferSteuervertreter oRechnungsempfaenger oRechnungssteller oVerkaeufer oVerkaeuferSteuervertreter oVerkaufsagent oZahler oZahlungsempfaenger", " ", CHR(13)))
		FOR lnRolle = 1 TO ALEN(laRollen)
		    llIt = llIt AND This.SplitLand(GETPEM(This, laRollen[lnRolle]))
		ENDFOR
		= This.Pflicht(llIt, "", "BT-118", "BR-B-01")
		= This.Pflicht(NOT llS, "", "BT-118", "BR-B-02")
	ENDPROC

	PROTECTED PROCEDURE ValidateStandardsteuer
		LOCAL lnPosition, llS, lnGruppe, loGruppe, lnBasis, lnAnzahl, lnToleranz, lnBasisIni, lnAnzahlIni, lnToleranzIni, lnSGruppen
		lnSGruppen = 0
		FOR lnGruppe = 1 TO This.nSteuergruppen
			IF This.aSteuergruppen[lnGruppe].cSteuerkategorie == "S"
				lnSGruppen = lnSGruppen + 1
			ENDIF
		ENDFOR
		llS = .F.
		FOR lnPosition = 1 TO This.nPositionen
			IF VARTYPE(This.aPositionen[lnPosition]) = "O"
				llS = llS OR (This.IstDetailposition(This.aPositionen[lnPosition]) AND ;
					This.CodeNormal(This.aPositionen[lnPosition].cSteuerkategorie) == "S")
			ENDIF
		ENDFOR
		FOR lnPosition = 1 TO This.nBelegaenderungen
			IF VARTYPE(This.aBelegaenderungen[lnPosition]) = "O"
				llS = llS OR This.CodeNormal(This.aBelegaenderungen[lnPosition].cSteuerkategorie) == "S"
			ENDIF
		ENDFOR
		FOR lnPosition = 1 TO This.nLogistikentgelte
			IF VARTYPE(This.aLogistikentgelte[lnPosition]) = "O"
				llS = llS OR This.CodeNormal(This.aLogistikentgelte[lnPosition].cSteuerkategorie) == "S"
			ENDIF
		ENDFOR
		IF llS AND lnSGruppen = 0 OR (NOT llS AND lnSGruppen > 0 AND This.cProfil == "EXTENDED")
			= This.Pflicht(.F., "", "BT-118", This.RechenRegel("S-01"))
		ENDIF
		FOR lnGruppe = 1 TO This.nSteuergruppen
			loGruppe = This.aSteuergruppen[lnGruppe]
			IF NOT (loGruppe.cSteuerkategorie == "S")
				LOOP
			ENDIF
			lnBasis = This.SteuerBasis(loGruppe.nSteuersatz, @lnAnzahl, loGruppe)
			IF This.cProfil == "EXTENDED"
				lnToleranz = ROUND(lnAnzahl * 0.01, 2)
				lnBasisIni = This.SteuerBasis(loGruppe.nSteuersatz, @lnAnzahlIni)
				lnToleranzIni = ROUND(lnAnzahlIni * 0.01, 2)
				IF ROUND(ABS(loGruppe.nBasis - lnBasisIni), 2) > lnToleranzIni
				= This.PruefeRechenwert(loGruppe.nBasis, lnBasis, lnToleranz, "BT-116", "BR-FXEXT-S08b", "FEHLER")
				ENDIF
				= This.PruefeRechenwert(loGruppe.nBasis, lnBasisIni, lnToleranzIni, "BT-116", "BR-FXEXT-S-08ini", "WARNUNG")
				= This.PruefeRechenwert(loGruppe.nBasis, lnBasis, lnToleranz, "BT-116", "BR-FXEXT-S-08rev", "WARNUNG")
				= This.PruefeRechenwert(loGruppe.nSteuer, ROUND(loGruppe.nBasis * loGruppe.nSteuersatz / 100, 2), ;
					lnToleranz, "BT-117", "BR-FXEXT-S-09b", "FEHLER")
			ELSE
				= This.PruefeRechenwert(loGruppe.nBasis, lnBasis, 0, "BT-116", "BR-S-08", "FEHLER")
				* Das lokale Schematron verwendet Betraege und eine offene Ein-Euro-Grenze.
				= This.PruefeRechenwert(ABS(loGruppe.nSteuer), ROUND(ABS(loGruppe.nBasis) * loGruppe.nSteuersatz / 100, 2), ;
					0.99, "BT-117", "BR-S-09", "FEHLER")
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateSteuerformel
		LPARAMETERS toG
		LOCAL llOk, lnSoll
		IF NOT This.IstZahl(toG.nSteuer) OR NOT This.IstZahl(toG.nBasis)
		    RETURN
		ENDIF
		llOk = FLOOR(toG.nSteuer + 0.5) = 0
		IF This.IstZahl(toG.nSteuersatz) AND FLOOR(toG.nSteuersatz + 0.5) # 0
		    lnSoll = ROUND(ABS(toG.nBasis) * toG.nSteuersatz / 100, 2)
		    llOk = ABS(toG.nSteuer) - 1 <= lnSoll AND ABS(toG.nSteuer) + 1 >= lnSoll
		ENDIF
		= This.Pflicht(llOk, "", "BT-117", "BR-CO-17")
	ENDPROC

	PROTECTED PROCEDURE ValidateSteuergruppen
		LOCAL lnG, loG
		= This.Pflicht(This.nSteuergruppen > 0, "", "BG-23", "BR-CO-18")
		= This.ValidateStandardsteuer()
		= This.ValidateKategoriegruppen("Z")
		= This.ValidateKategoriegruppen("E")
		= This.ValidateKategoriegruppen("AE")
		= This.ValidateKategoriegruppen("G")
		= This.ValidateKategoriegruppen("K")
		= This.ValidateKategoriegruppen("O")
		= This.ValidateKategoriegruppen("L")
		= This.ValidateKategoriegruppen("M")
		= This.ValidateSplitPayment()
		= This.ValidateOMischung()
		= This.ValidateSteuersperren()
		FOR lnG = 1 TO This.nSteuergruppen
		    loG = This.aSteuergruppen[lnG]
		    = This.Pflicht(This.IstZahl(loG.nBasis), "", "BT-116", "BR-45")
		    = This.Pflicht(This.IstZahl(loG.nSteuer), "", "BT-117", "BR-46")
		    = This.Pflicht(This.IstText(loG.cSteuerkategorie), "", "BT-118", "BR-47")
		    = This.Pflicht(This.IstZahl(loG.nSteuersatz) OR This.CodeNormal(loG.cSteuerkategorie) == "O", "", "BT-119", "BR-48")
		    IF This.cProfil == "XRECHNUNG-CII"
		        = This.Pflicht(This.IstZahl(loG.nSteuersatz), "", "BT-119", "BR-DE-14")
		    ENDIF
		    IF This.cProfil # "EXTENDED"
		        = This.ValidateSteuerformel(loG)
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateSteuerkurs
		LOCAL llKurs, loCodes
		= This.KopfText(This.cSteuerkursQuelle, "BT-X-258", .T.)
		= This.KopfText(This.cSteuerkursZiel, "BT-X-259", .T.)
		= This.KopfText(This.cSteuerkursdatum, "BT-X-261", .T.)
		= This.KopfText(This.cSteuerkursformat, "BT-X-261-0", .F.)
		= This.ProfilFeld(NOT ISNULL(This.nSteuerkurs), "BT-X-260")
		= This.ProfilFeld(NOT (This.CodeNormal(This.cSteuerkursformat) == "102"), "BT-X-261-0")
		llKurs = This.IstText(This.cSteuerkursQuelle) OR This.IstText(This.cSteuerkursZiel) OR ;
		    NOT ISNULL(This.nSteuerkurs) OR This.IstText(This.cSteuerkursdatum) OR NOT (This.CodeNormal(This.cSteuerkursformat) == "102")
		IF NOT llKurs
		    RETURN
		ENDIF
		= This.Pflicht(This.IstText(This.cSteuerkursQuelle), "", "BT-X-258", "FX-TECH-03")
		= This.Pflicht(This.IstText(This.cSteuerkursZiel), "", "BT-X-259", "FX-TECH-03")
		= This.Pflicht(This.IstZahl(This.nSteuerkurs) AND ROUND(This.RechenNumeric(This.nSteuerkurs), 8) > 0, "", "BT-X-260", "FX-TECH-03")
		= This.StellenPruefen(This.nSteuerkurs, 8, "", "BT-X-260")
		= This.Pflicht(This.IstText(This.cSteuerwaehrung), "", "BT-6", "FX-TECH-03")
		= This.Pflicht(This.CodeNormal(This.cSteuerkursQuelle) == This.CodeNormal(This.cWaehrung), "", "BT-X-258", "FX-TECH-03")
		= This.Pflicht(This.CodeNormal(This.cSteuerkursZiel) == This.CodeNormal(This.cSteuerwaehrung), "", "BT-X-259", "FX-TECH-03")
		loCodes = CREATEOBJECT("fxCodelisten")
		= This.MeldezielSetzen(loCodes)
		= This.PruefeCode(loCodes, This.cSteuerkursQuelle, "BT-X-258", ;
		    IIF(This.cProfil == "EXTENDED", "FX-SCH-A-000332", "BR-CL-04"), "")
		= This.PruefeCode(loCodes, This.cSteuerkursZiel, "BT-X-259", ;
		    IIF(This.cProfil == "EXTENDED", "FX-SCH-A-000333", "BR-CL-05"), "")
		* The exchange date uses FeRD code list 3, which contains only 102.
		= This.Pflicht(This.CodeNormal(This.cSteuerkursformat) == "102", "", "BT-X-261-0", ;
		    IIF(This.cProfil == "EXTENDED", "FX-SCH-A-001010", "FX-TECH-03"))
		IF This.IstText(This.cSteuerkursdatum) AND INLIST(This.CodeNormal(This.cSteuerkursformat), "102", "205")
		    = This.PruefeDatumswert(This.cSteuerkursdatum, This.cSteuerkursformat, "BT-X-261")
		    IF This.cProfil == "XRECHNUNG-CII"
		        = This.Pflicht(This.CodeNormal(This.cSteuerkursformat) == "102", "", "BT-X-261", "BR-TMP-7")
		    ENDIF
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateSteuersperren
		LOCAL lnG, loG, lcKategorie, lcRegel
		IF NOT INLIST(This.cProfil, "EN16931", "XRECHNUNG-CII")
		    RETURN
		ENDIF
		FOR lnG = 1 TO This.nSteuergruppen
		    loG = This.aSteuergruppen[lnG]
		    lcKategorie = This.CodeNormal(loG.cSteuerkategorie)
		    IF NOT INLIST(lcKategorie, "S", "Z", "L", "M")
		        LOOP
		    ENDIF
		    lcRegel = "BR-" + This.Steuerfamilie(lcKategorie) + "-10"
		    IF This.IstText(loG.cBefreiungsgrund)
		        = This.Meldung("FEHLER", "", "BT-120", lcRegel, ;
		            "Steuergruppen der Kategorie S/Z/L/M d{ue}rfen in diesem Profil keinen Befreiungsgrund tragen.")
		    ENDIF
		    IF This.IstText(loG.cBefreiungscode)
		        = This.Meldung("FEHLER", "", "BT-121", lcRegel, ;
		            "Steuergruppen der Kategorie S/Z/L/M d{ue}rfen in diesem Profil keinen Befreiungscode tragen.")
		    ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateSteuerzeitpunkt
		LOCAL loCodes, llDatum
		llDatum = VARTYPE(This.dSteuerdatum) = "D" AND NOT EMPTY(This.dSteuerdatum)
		= This.Pflicht(VARTYPE(This.dSteuerdatum) = "D", "", "BT-7", "FX-TECH-03")
		= This.KopfText(This.cSteuerzeitpunkt, "BT-8", .F.)
		= This.Pflicht(NOT (llDatum AND This.IstText(This.cSteuerzeitpunkt)), "", "BT-8", "BR-CO-03")
		loCodes = CREATEOBJECT("fxCodelisten")
		= This.MeldezielSetzen(loCodes)
		= This.PruefeCode(loCodes, This.cSteuerzeitpunkt, "BT-8", "BR-CL-06", "")
	ENDPROC

	PROTECTED PROCEDURE ValidateSummen
		LOCAL lnPosition, lnSumme, lnToleranz, loPosition, lnNachlass, lnZuschlag, lnDetails, lnSteuer, lnG
		= This.Pflicht(This.IstZahl(This.nSummePositionen), "", "BT-106", "BR-12")
		= This.Pflicht(This.IstZahl(This.nNetto), "", "BT-109", "BR-13")
		= This.Pflicht(This.IstZahl(This.nBrutto), "", "BT-112", "BR-14")
		= This.Pflicht(This.IstZahl(This.nZahlbetrag), "", "BT-115", "BR-15")
		lnSteuer = 0
		FOR lnG = 1 TO This.nSteuergruppen
		    lnSteuer = lnSteuer + This.aSteuergruppen[lnG].nSteuer
		ENDFOR
		= This.PruefeRechenwert(This.nSteuer, ROUND(lnSteuer, 2), 0, "BT-110", "BR-CO-14", "FEHLER")
		lnSumme = 0
		lnDetails = 0
		FOR lnPosition = 1 TO This.nPositionen
			loPosition = This.aPositionen[lnPosition]
			IF VARTYPE(loPosition) = "O" AND NOT This.IstDetailposition(loPosition)
				LOOP
			ENDIF
			IF VARTYPE(loPosition) # "O"
				RETURN .F.
			ENDIF
			IF NOT This.IstZahl(loPosition.nNettobetrag)
				RETURN .F.
			ENDIF
			lnSumme = lnSumme + loPosition.nNettobetrag
			lnDetails = lnDetails + 1
		ENDFOR
		lnSumme = ROUND(lnSumme, 2)
		lnToleranz = 0
		IF This.cProfil == "EXTENDED"
			lnToleranz = ROUND(This.nPositionen * 0.01, 2)
		ENDIF
		= This.PruefeRechenwert(This.nSummePositionen, lnSumme, lnToleranz, "BT-106", This.RechenRegel("CO-10"), "FEHLER")
		IF This.cProfil # "EXTENDED"
			lnSumme = This.nSummePositionen
		ENDIF
		= This.ValidateBelegsummen(@lnNachlass, @lnZuschlag)
		IF This.cProfil == "EXTENDED"
			lnSumme = ROUND(lnSumme - lnNachlass + lnZuschlag, 2)
		ELSE
			lnSumme = ROUND(lnSumme - This.BetragOderNull(This.nNachlassSumme) + This.BetragOderNull(This.nZuschlagSumme), 2)
		ENDIF
		IF This.cProfil == "EXTENDED"
			lnToleranz = ROUND((lnDetails + This.nBelegaenderungen + This.nLogistikentgelte) * 0.01, 2)
		ENDIF
		= This.PruefeRechenwert(This.nNetto, lnSumme, lnToleranz, "BT-109", This.RechenRegel("CO-13"), "FEHLER")
		= This.PruefeRechenwert(This.nBrutto, ROUND(This.nNetto + This.nSteuer, 2), lnToleranz, "BT-112", This.RechenRegel("CO-15"), "FEHLER")
	ENDPROC

	PROTECTED PROCEDURE ValidateUstPraefix
		LPARAMETERS toCodes, tuWert, tcBT, tcPosition
		LOCAL lcPraefix
		IF PCOUNT() < 4
			tcPosition = ""
		ENDIF
		IF This.IstText(tuWert)
			lcPraefix = LEFT(tuWert, 2)
			= This.Pflicht(lcPraefix == UPPER(lcPraefix) AND toCodes.Gueltig("BR-CO-09", lcPraefix, This.cProfil), tcPosition, tcBT, "BR-CO-09")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateVerzug
		LPARAMETERS toB
		= This.PruefeLieferdatum(toB.dVerzugBasisdatum, "BT-X-276")
		= This.ProfilFeld(NOT EMPTY(toB.dVerzugBasisdatum), "BT-X-276")
		= This.ProduktZahl(toB.nVerzugTage, "BT-X-277", "")
		= This.ProfilFeld(NOT ISNULL(toB.nVerzugTage), "BT-X-277")
		= This.KopfText(toB.cVerzugEinheit, "BT-X-278", .T.)
		IF NOT ISNULL(toB.nVerzugTage)
		    = This.Pflicht(This.IstText(toB.cVerzugEinheit), "", "BT-X-278", "FX-SCH-A-000277")
		ENDIF
		= This.SummenZahl(toB.nVerzugBasis, "BT-X-279")
		= This.ProfilFeld(NOT ISNULL(toB.nVerzugBasis), "BT-X-279")
		= This.SummenZahl(toB.nVerzugProzent, "BT-X-280")
		= This.ProfilFeld(NOT ISNULL(toB.nVerzugProzent), "BT-X-280")
		= This.SummenZahl(toB.nVerzugBetrag, "BT-X-281")
		= This.ProfilFeld(NOT ISNULL(toB.nVerzugBetrag), "BT-X-281")
		IF This.IstText(toB.cVerzugEinheit) AND ISNULL(toB.nVerzugTage)
		    = This.Pflicht(.F., "", "BT-X-277", "FX-TECH-03")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateVorausdatum
		    LPARAMETERS tuDatum, tcFormat, tcBT, tcFormatBT, tcRegel
		    LOCAL lcFormat
		    lcFormat = This.CodeNormal(tcFormat)
		    = This.KopfText(tuDatum, tcBT, .T.)
		    IF NOT INLIST(VARTYPE(tcFormat), "C", "M")
		        = This.ProfilFeld(.T., tcFormatBT)
		    ENDIF
		    IF NOT This.KopfText(tcFormat, tcFormatBT, .F.)
		        RETURN
		    ENDIF
		    IF NOT This.IstText(tuDatum) AND lcFormat == "102"
		        RETURN
		    ENDIF
		    = This.ProfilFeld(.T., tcFormatBT)
		    = This.Pflicht(lcFormat == "102" OR lcFormat == "205", "", tcFormatBT, tcRegel)
		    = This.Pflicht(This.IstText(tuDatum), "", tcBT, "FX-TECH-03")
		    IF This.IstText(tuDatum) AND (lcFormat == "102" OR lcFormat == "205")
		        = This.PruefeDatumswert(tuDatum, lcFormat, tcBT)
		    ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateVorauszahlung
		    LPARAMETERS toV
		    LOCAL lnK, loS, loCodes
		    = This.ProfilFeld(.T., "BT-X-291")
		    = This.SummenZahl(toV.nBetrag, "BT-X-291")
		    = This.Pflicht(This.IstZahl(toV.nBetrag), "", "BT-X-291", "FX-TECH-03")
		    IF NOT EMPTY(toV.cAddFehler)
		        = This.Meldung("FEHLER", "", "BT-X-293", "FX-TECH-03", "Abgewiesener AddSteuer-Aufruf: {1}", toV.cAddFehler)
		    ENDIF
		    = This.Pflicht(toV.nSteuern > 0, "", "BG-X-46", "FX-SCH-A-000325")
		    = This.ValidateVorausdatum(toV.cEmpfangsdatum, toV.cEmpfangsformat, "BT-X-292", "BT-X-292-0", "FX-SCH-A-000951")
		    = This.KopfText(toV.cRechnungsnummer, "BT-X-558", .T.)
		    = This.KopfText(toV.cRechnungstyp, "BT-X-559", .T.)
		    = This.ValidateVorausdatum(toV.cRechnungsdatum, toV.cRechnungsformat, "BT-X-560", "BT-X-560-0", "FX-SCH-A-000960")
		    IF This.IstText(toV.cRechnungstyp) OR This.IstText(toV.cRechnungsdatum)
		        = This.Pflicht(This.IstText(toV.cRechnungsnummer), "", "BT-X-558", "FX-SCH-A-000958")
		    ENDIF
		    loCodes = CREATEOBJECT("fxCodelisten")
		    = This.MeldezielSetzen(loCodes)
		    IF This.cProfil == "EXTENDED"
		        = This.PruefeCode(loCodes, toV.cRechnungstyp, "BT-X-559", "FX-SCH-A-000961", "")
		    ENDIF
		    FOR lnK = 1 TO toV.nSteuern
		        loS = toV.aSteuern[lnK]
		        IF NOT This.ReferenzObjekt(loS, "BT-X-293")
		            LOOP
		        ENDIF
		        = This.SummenZahl(loS.nBetrag, "BT-X-293")
		        = This.SummenZahl(loS.nSatz, "BT-X-298")
		        = This.KopfText(loS.cTyp, "BT-X-294", .T.)
		        = This.KopfText(loS.cKategorie, "BT-X-296", .T.)
		        = This.KopfText(loS.cBefreiungsgrund, "BT-X-295", .T.)
		        = This.KopfText(loS.cBefreiungscode, "BT-X-297", .T.)
		        = This.ProfilFeld(NOT ISNULL(loS.nBetrag), "BT-X-293")
		        = This.ProfilFeld(NOT ISNULL(loS.nSatz), "BT-X-298")
		        = This.Pflicht(This.IstZahl(loS.nBetrag), "", "BT-X-293", "FX-SCH-A-000952")
		        = This.Pflicht(This.IstText(loS.cTyp), "", "BT-X-294", "FX-SCH-A-000953")
		        = This.Pflicht(This.IstText(loS.cKategorie), "", "BT-X-296", "FX-SCH-A-000954")
		        IF This.cProfil == "EXTENDED"
		            = This.PruefeCode(loCodes, loS.cTyp, "BT-X-294", "FX-SCH-A-000957", "")
		            = This.PruefeCode(loCodes, loS.cKategorie, "BT-X-296", "FX-SCH-A-000955", "")
		            = This.PruefeCode(loCodes, loS.cBefreiungscode, "BT-X-297", "FX-SCH-A-000956", "")
		        ENDIF
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE ValidateXrechnung
		LOCAL loVerkaeufer, loKaeufer, llKontakt, lnPosition, lcKategorie, llSteuerkennung
		= This.Pflicht(This.IstText(This.cKaeuferReferenz), "", "BT-10", "BR-DE-15")
		= This.Pflicht(This.IstText(This.cProzessKennung), "", "BT-23", "PEPPOL-EN16931-R001")
		IF (VARTYPE(This.dLieferdatum) # "D" OR EMPTY(This.dLieferdatum)) AND ISNULL(This.oAbrechnungszeitraum) AND NOT This.AllePositionsperioden()
			= This.Meldung("HINWEIS", "", "BT-72", "BR-DE-TMP-32", "Lieferdatum oder Abrechnungsperiode fehlen.")
		ENDIF
		loVerkaeufer = This.oVerkaeufer
		loKaeufer = This.oKaeufer
		IF VARTYPE(loVerkaeufer) = "O"
			IF This.AdresseVorhanden(loVerkaeufer)
				= This.Pflicht(This.IstText(loVerkaeufer.cOrt), "", "BT-37", "BR-DE-3")
				= This.Pflicht(This.IstText(loVerkaeufer.cPlz), "", "BT-38", "BR-DE-4")
			ENDIF
			= This.Pflicht(This.IstText(loVerkaeufer.cElektronischeAdresse), "", "BT-34", "PEPPOL-EN16931-R020")
		ENDIF
		llSteuerkennung = .F.
		FOR lnPosition = 1 TO This.nPositionen
			IF VARTYPE(This.aPositionen[lnPosition]) = "O"
				lcKategorie = This.CodeNormal(This.aPositionen[lnPosition].cSteuerkategorie)
				llSteuerkennung = llSteuerkennung OR lcKategorie == "S" OR lcKategorie == "Z" OR ;
					lcKategorie == "E" OR lcKategorie == "AE" OR lcKategorie == "K" OR lcKategorie == "G" OR ;
					lcKategorie == "L" OR lcKategorie == "M"
			ENDIF
		ENDFOR
		IF llSteuerkennung
			= This.Pflicht(This.VerkaeuferSteuerkennung() OR (VARTYPE(This.oVerkaeuferSteuervertreter) = "O" AND This.oVerkaeuferSteuervertreter.Vorhanden()), "", "BT-31", "BR-DE-16")
		ENDIF
		IF VARTYPE(loKaeufer) = "O"
			IF This.AdresseVorhanden(loKaeufer)
				= This.Pflicht(This.IstText(loKaeufer.cOrt), "", "BT-52", "BR-DE-8")
				= This.Pflicht(This.IstText(loKaeufer.cPlz), "", "BT-53", "BR-DE-9")
			ENDIF
			= This.Pflicht(This.IstText(loKaeufer.cElektronischeAdresse), "", "BT-49", "PEPPOL-EN16931-R010")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateXrZahlung
		LPARAMETERS tcArt, tlKarte, tlKonto
		LOCAL llLastschrift, llGlaeubiger, llSchuldner, llMandat, lcBT
		llGlaeubiger = This.IstText(This.cGlaeubigerId)
		llSchuldner = This.IstText(This.cSchuldnerIban)
		llMandat = This.HatMandat()
		llLastschrift = llGlaeubiger OR llSchuldner OR llMandat
		IF llLastschrift
			lcBT = IIF(llGlaeubiger, "BT-91", "BT-90")
			= This.Pflicht((llMandat OR llSchuldner) AND llGlaeubiger, "", lcBT, "BR-DE-30")
			lcBT = IIF(llSchuldner, "BT-90", "BT-91")
			= This.Pflicht((llMandat OR llGlaeubiger) AND llSchuldner, "", lcBT, "BR-DE-31")
		ENDIF
		DO CASE
		CASE tcArt == "30" OR tcArt == "58"
			= This.Pflicht(tlKonto, "", "BT-84", "BR-DE-23-a")
			IF tlKarte OR llLastschrift
				lcBT = IIF(tlKarte, "BG-18", IIF(llGlaeubiger, "BT-90", IIF(llSchuldner, "BT-91", "BT-89")))
				= This.Meldung("FEHLER", "", lcBT, "BR-DE-23-b", "{1} ist bei Zahlungsart {2} nicht zul{ae}ssig.", lcBT, tcArt)
			ENDIF
		CASE tcArt == "48" OR tcArt == "54" OR tcArt == "55"
			= This.Pflicht(tlKarte, "", "BG-18", "BR-DE-24-a")
			IF tlKonto OR llLastschrift
				lcBT = IIF(tlKonto, "BG-17", "BG-19")
				= This.Meldung("FEHLER", "", lcBT, "BR-DE-24-b", "{1} ist bei Zahlungsart {2} nicht zul{ae}ssig.", lcBT, tcArt)
			ENDIF
		CASE tcArt == "59"
			= This.Pflicht(llLastschrift, "", "BG-19", "BR-DE-25-a")
			IF tlKonto OR tlKarte OR This.IstText(This.cBic) OR This.IstText(This.cSchuldnerBic)
				lcBT = IIF(tlKarte, "BG-18", IIF(tlKonto, "BG-17", IIF(This.IstText(This.cBic), "BT-86", "BT-215")))
				= This.Meldung("FEHLER", "", lcBT, "BR-DE-25-b", "{1} ist bei Zahlungsart {2} nicht zul{ae}ssig.", lcBT, tcArt)
			ENDIF
		ENDCASE
		IF tcArt == "49" OR tcArt == "59"
			= This.Pflicht(This.HatMandat(), "", "BT-89", "PEPPOL-EN16931-R061")
		ENDIF
		IF tcArt == "58" AND NOT This.IbanGueltig(This.cIban)
			= This.Meldung("WARNUNG", "", "BT-84", "BR-DE-19", "Die IBAN besteht die Format- oder Pr{ue}fziffernpr{ue}fung nicht.")
		ENDIF
		IF tcArt == "59" AND NOT This.IbanGueltig(This.cSchuldnerIban)
			= This.Meldung("WARNUNG", "", "BT-91", "BR-DE-20", "Die Schuldner-IBAN besteht die Format- oder Pr{ue}fziffernpr{ue}fung nicht.")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateZahlung
		LOCAL llKarte, llKonto, llSchuldner, llKennung, llZahlung, lcArt, lcKarte
		= This.KopfText(This.cZahlungsart, "BT-81", .F.)
		= This.KopfText(This.cZahlungsinfo, "BT-82", .F.)
		= This.KopfText(This.cIban, "BT-84", .F.)
		= This.KopfText(This.cKontoinhaber, "BT-85", .F.)
		= This.KopfText(This.cKontonummer, "BT-84-0", .F.)
		= This.KopfText(This.cBic, "BT-86", .F.)
		= This.KopfText(This.cKartennummer, "BT-87", .F.)
		= This.KopfText(This.cKarteninhaber, "BT-88", .F.)
		= This.KopfText(This.cMandatsreferenz, "BT-89", .F.)
		= This.KopfText(This.cSchuldnerIban, "BT-91", .F.)
		= This.KopfText(This.cSchuldnerKontoinhaber, "BT-216", .T.)
		= This.KopfText(This.cSchuldnerBic, "BT-215", .T.)
		lcArt = This.CodeNormal(This.cZahlungsart)
		llKarte = This.IstText(This.cKartennummer) OR This.IstText(This.cKarteninhaber)
		llKonto = This.IstText(This.cIban) OR This.IstText(This.cKontoinhaber) OR This.IstText(This.cKontonummer)
		llSchuldner = This.IstText(This.cSchuldnerIban) OR This.IstText(This.cSchuldnerKontoinhaber)
		llKennung = This.IstText(This.cIban) OR This.IstText(This.cKontonummer)
		llZahlung = This.IstText(This.cZahlungsart) OR This.IstText(This.cZahlungsinfo) OR llKarte OR ;
			llKonto OR llSchuldner OR This.IstText(This.cBic) OR This.IstText(This.cSchuldnerBic)
		IF llZahlung
			= This.Pflicht(This.IstText(This.cZahlungsart), "", "BT-81", "BR-49")
		ENDIF
		IF llKarte
			= This.Pflicht(This.IstText(This.cKartennummer), "", "BT-87", "FX-SCH-A-000608")
			lcKarte = This.CodeNormal(This.cKartennummer)
			DO WHILE "  " $ lcKarte
				lcKarte = STRTRAN(lcKarte, "  ", " ")
			ENDDO
			= This.Pflicht(LEN(lcKarte) <= 10, "", "BT-87", "BR-51")
		ENDIF
		IF llSchuldner
			= This.Pflicht(This.IstText(This.cSchuldnerIban), "", "BT-91", "FX-SCH-A-000195")
		ENDIF
		IF lcArt == "30" OR lcArt == "58"
			IF llKonto
				= This.Pflicht(llKennung, "", "BT-84", "BR-50")
				= This.Pflicht(llKennung, "", "BT-84", "BR-61")
			ENDIF
			IF This.cProfil # "EXTENDED"
				= This.Pflicht(llKennung, "", "BT-84", "CII-SR-470")
			ENDIF
			* Nur FeRD-EN verlangt genau eine der beiden Kontokennungen.
			IF This.cProfil == "EN16931" AND This.IstText(This.cIban) AND This.IstText(This.cKontonummer)
				= This.Pflicht(.F., "", "BT-84", "CII-SR-470")
			ENDIF
		ENDIF
		IF This.cProfil == "XRECHNUNG-CII"
			= This.Pflicht(llZahlung, "", "BT-81", "BR-DE-1")
			= This.ValidateXrZahlung(lcArt, llKarte, llKonto)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateZahlungsbedingung
		LPARAMETERS toB, toCodes
		LOCAL lcText
		= This.KopfText(toB.cBeschreibung, "BT-20", .F.)
		= This.KopfText(toB.cMandatsreferenz, "BT-89", .F.)
		= This.PruefeLieferdatum(toB.dFaelligkeit, "BT-9")
		= This.SummenZahl(toB.nTeilzahlung, "BT-X-275")
		= This.ProfilFeld(NOT ISNULL(toB.nTeilzahlung), "BT-X-275")
		= This.ValidateVerzug(toB)
		= This.ValidateSkonto(toB)
		= This.ValidateBedingungsPayee(toB.oZahlungsempfaenger, toCodes)
		lcText = toB.Beschreibung(This.cProfil, This.cWaehrung)
		IF This.cProfil == "XRECHNUNG-CII"
		    = This.ValidateSkontoText(lcText)
		ENDIF
		IF NOT This.IstText(lcText) AND EMPTY(toB.dFaelligkeit) AND NOT This.IstText(toB.cMandatsreferenz) AND ;
		    ISNULL(toB.nTeilzahlung) AND NOT toB.HatVerzug() AND NOT toB.HatSkonto() AND ;
		    VARTYPE(toB.oZahlungsempfaenger) = "O" AND NOT toB.oZahlungsempfaenger.Vorhanden()
		    = This.Meldung(IIF(This.cProfil == "EXTENDED", "WARNUNG", "FEHLER"), "", "BT-20", ;
		        "PEPPOL-EN16931-R008", "Eine explizite Zahlungsbedingung ohne Inhalt ist leer.")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateZahlungsbedingungen
		LOCAL lnB, loB, lnAnzahl, lcText, loCodes
		= This.KopfText(This.cZahlungsbedingungen, "BT-20", .F.)
		IF NOT ISNULL(This.dFaelligkeit)
			= This.PruefeLieferdatum(This.dFaelligkeit, "BT-9")
		ENDIF
		lcText = This.ZahlungsText()
		lnAnzahl = IIF(This.IstText(lcText) OR (VARTYPE(This.dFaelligkeit) = "D" AND ;
			NOT EMPTY(This.dFaelligkeit)) OR This.IstText(This.cMandatsreferenz), 1, 0)
		IF This.cProfil == "XRECHNUNG-CII"
		    = This.ValidateSkontoText(lcText)
		ENDIF
		IF This.nZahlungsbedingungen = 0
			RETURN
		ENDIF
		loCodes = CREATEOBJECT("fxCodelisten")
		= This.MeldezielSetzen(loCodes)
		FOR lnB = 1 TO This.nZahlungsbedingungen
		    loB = This.aZahlungsbedingungen[lnB]
		    IF NOT This.ReferenzObjekt(loB, "BT-20")
		        LOOP
		    ENDIF
		    IF This.cProfil == "EXTENDED" OR NOT This.SkontoBedingung(loB)
		        lnAnzahl = lnAnzahl + 1
		    ENDIF
		    = This.ValidateZahlungsbedingung(loB, loCodes)
		ENDFOR
		IF This.cProfil # "EXTENDED" AND lnAnzahl > 1
		    = This.Meldung("FEHLER", "", "BT-20", "FX-PROFIL-01", "Das Profil erlaubt nur eine Zahlungsbedingung; Skontostufen werden in BT-20 zusammengefasst.")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateZahlungssummen
		    LOCAL lnK, loK, lnVoraus, lnFinanz, llVoraus, lnErwartet
		    = This.SummenZahl(This.nVorauszahlung, "BT-113")
		    = This.SummenZahl(This.nRundung, "BT-114")
		    STORE 0 TO lnVoraus, lnFinanz
		    llVoraus = .T.
		    FOR lnK = 1 TO This.nVorauszahlungen
		        loK = This.aVorauszahlungen[lnK]
		        IF NOT This.ReferenzObjekt(loK, "BT-X-291")
		            llVoraus = .F.
		            LOOP
		        ENDIF
		        = This.ValidateVorauszahlung(loK)
		        IF This.IstZahl(loK.nBetrag)
		            lnVoraus = lnVoraus + ROUND(This.RechenNumeric(loK.nBetrag), 2)
		        ELSE
		            llVoraus = .F.
		        ENDIF
		    ENDFOR
		    FOR lnK = 1 TO This.nFinanzkorrekturen
		        loK = This.aFinanzkorrekturen[lnK]
		        IF NOT This.ReferenzObjekt(loK, "BT-179")
		            LOOP
		        ENDIF
		        = This.ProfilFeld(.T., "BT-179")
		        = This.KopfText(loK.cGrund, "BT-180", .T.)
		        = This.Pflicht(This.IstText(loK.cGrund), "", "BT-180", "FX-SCH-A-000383")
		        = This.SummenZahl(loK.nBetrag, "BT-179")
		        = This.Pflicht(This.IstZahl(loK.nBetrag), "", "BT-179", "FX-SCH-A-000962")
		        IF This.IstZahl(loK.nBetrag)
		            lnFinanz = lnFinanz + ROUND(This.RechenNumeric(loK.nBetrag), 2)
		        ENDIF
		    ENDFOR
		    IF This.nVorauszahlungen > 0 AND llVoraus
		        = This.PruefeGesamtSoll(This.nVorauszahlung, ROUND(lnVoraus, 2), "BT-113", "FX-SOLL-03")
		    ENDIF
		    lnErwartet = ROUND(This.nBrutto - This.BetragOderNull(This.nVorauszahlungSumme) + ;
		        ROUND(This.BetragOderNull(This.nRundung), 2) + ROUND(lnFinanz, 2), 2)
		    = This.PruefeRechenwert(This.nZahlbetrag, lnErwartet, 0, "BT-115", This.RechenRegel("CO-16"), "FEHLER")
		    = This.PruefeGesamtSoll(This.nSollZahlbetrag, This.nZahlbetrag, "BT-115", "FX-SOLL-04")
	ENDPROC

	PROTECTED PROCEDURE VerkaeuferSteuerkennung
		LOCAL llKennung
		llKennung = .F.
		IF VARTYPE(This.oVerkaeufer) = "O"
			llKennung = This.IstText(This.oVerkaeufer.cUstId) OR This.IstText(This.oVerkaeufer.cSteuernummer)
		ENDIF
		IF VARTYPE(This.oVerkaeuferSteuervertreter) = "O"
			llKennung = llKennung OR This.IstText(This.oVerkaeuferSteuervertreter.cUstId)
		ENDIF
		RETURN llKennung
	ENDPROC

	PROTECTED PROCEDURE VerkaeuferUstkennung
		LOCAL llKennung
		llKennung = VARTYPE(This.oVerkaeufer) = "O" AND This.IstText(This.oVerkaeufer.cUstId)
		IF VARTYPE(This.oVerkaeuferSteuervertreter) = "O"
		    llKennung = llKennung OR This.IstText(This.oVerkaeuferSteuervertreter.cUstId)
		ENDIF
		RETURN llKennung
	ENDPROC

	PROCEDURE ZahlungsText
		LOCAL lcText, lnB, loB, lcSkonto
		lcText = ""
		IF This.IstText(This.cZahlungsbedingungen)
		    lcText = This.cZahlungsbedingungen
		ENDIF
		IF This.cProfil # "EXTENDED"
		    FOR lnB = 1 TO This.nZahlungsbedingungen
		        loB = This.aZahlungsbedingungen[lnB]
		        IF VARTYPE(loB) = "O" AND This.SkontoBedingung(loB)
		            lcSkonto = loB.SkontoText(This.cProfil, This.cWaehrung)
		            IF This.IstText(lcSkonto)
		                IF NOT EMPTY(lcText) AND RIGHT(lcText, 1) # CHR(10)
		                    lcText = lcText + CHR(10)
		                ENDIF
		                lcText = lcText + lcSkonto
		            ENDIF
		        ENDIF
		    ENDFOR
		ENDIF
		RETURN lcText
	ENDPROC

ENDDEFINE

DEFINE CLASS fxadresse AS fxbasis OF "foxferd.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*p: cland		&& BT-X-105 / BT-X-113 Registeranschrift Land; Kopfrollen BT-X-360 / BT-X-387 / BT-X-394 / BT-X-401 / BT-X-431 / BT-X-438 / BT-X-445 / BT-X-452 / BT-X-459 / BT-X-466 / BT-X-474 / BT-X-502 / BT-X-530
		*p: cort		&& BT-X-104 / BT-X-112 Registeranschrift Ort; Kopfrollen BT-X-359 / BT-X-386 / BT-X-393 / BT-X-400 / BT-X-430 / BT-X-437 / BT-X-444 / BT-X-451 / BT-X-458 / BT-X-465 / BT-X-473 / BT-X-501 / BT-X-529
		*p: cplz		&& BT-X-100 / BT-X-108 Registeranschrift Postleitzahl; Kopfrollen BT-X-355 / BT-X-382 / BT-X-389 / BT-X-396 / BT-X-426 / BT-X-433 / BT-X-440 / BT-X-447 / BT-X-454 / BT-X-461 / BT-X-469 / BT-X-497 / BT-X-525
		*p: cregion		&& BT-X-106 / BT-X-114 Registeranschrift Region; Kopfrollen BT-X-361 / BT-X-388 / BT-X-395 / BT-X-402 / BT-X-432 / BT-X-439 / BT-X-446 / BT-X-453 / BT-X-460 / BT-X-467 / BT-X-475 / BT-X-503 / BT-X-531
		*p: cstrasse		&& BT-X-101 / BT-X-109 Registeranschrift Zeile 1; Kopfrollen BT-X-356 / BT-X-383 / BT-X-390 / BT-X-397 / BT-X-427 / BT-X-434 / BT-X-441 / BT-X-448 / BT-X-455 / BT-X-462 / BT-X-470 / BT-X-498 / BT-X-526
		*p: cstrasse2		&& BT-X-102 / BT-X-110 Registeranschrift Zeile 2; Kopfrollen BT-X-357 / BT-X-384 / BT-X-391 / BT-X-398 / BT-X-428 / BT-X-435 / BT-X-442 / BT-X-449 / BT-X-456 / BT-X-463 / BT-X-471 / BT-X-499 / BT-X-527
		*p: cstrasse3		&& BT-X-103 / BT-X-111 Registeranschrift Zeile 3; Kopfrollen BT-X-358 / BT-X-385 / BT-X-392 / BT-X-399 / BT-X-429 / BT-X-436 / BT-X-443 / BT-X-450 / BT-X-457 / BT-X-464 / BT-X-472 / BT-X-500 / BT-X-528
	*</DefinedPropArrayMethod>

	*<PropValue>
		cland = 
		cort = 
		cplz = 
		cregion = 
		cstrasse = 
		cstrasse2 = 
		cstrasse3 = 
		Name = "fxAdresse"
	*</PropValue>

ENDDEFINE

DEFINE CLASS fxanhang AS fxreferenz OF "foxferd.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: base64kodieren
		*m: cbase64_access
		*m: cbase64_assign
		*m: cdateifehler_access
		*m: cdateifehler_assign
		*m: dateifehler
		*m: dateikodieren
		*m: dateiladen
		*m: dateipfad
		*m: error
		*m: hexdaten
		*p: cbase64		&& BT-125 BT-X-31 MSXML-bin.base64-Ergebnis, nur lesbar
		*p: cbeschreibung		&& BT-123 BT-X-299 Beschreibung des Kopf- oder Positionsbelegs
		*p: cdatei		&& BT-125 BT-X-31 Quelldatei; leer fuer URI oder Referenz; erneut bei Validate gelesen
		*p: cdateibt
		*p: cdateidaten
		*p: cdateifehler		&& BT-125 Aktueller Ladefehler, nur lesbar; Objekt bleibt korrigierbar
		*p: cdateiname		&& BT-125-2 BT-X-31-2 Dateiname im XML, ohne Verzeichnis
		*p: clesefehler
		*p: cmime		&& BT-125-1 BT-X-31-1 MIME-Typ der eingebetteten Datei
		*p: cnummer		&& BT-122 BT-17 BT-18 BT-X-27 Belegkennung; bei Datei anfangs deren Dateiname
		*p: cposition
		*p: creferenzart		&& BT-18-1 BT-X-32 Referenzart; am Kopf nur fuer Typ 130
		*p: ctyp		&& BT-122-0 BT-17-0 BT-18-0 BT-X-30 916 Anhang, 50 Ausschreibung, 130 Abrechnungsobjekt
		*p: curi		&& BT-124 BT-X-28 Externer Dokumentverweis, keine Datei wird heruntergeladen
		*p: ddatum		&& BT-X-149 BT-X-556 BT-X-557 BT-X-33 Optionales Anhangdatum, nur EXTENDED, Format 102
		*p: ldateilauf
	*</DefinedPropArrayMethod>

	PROTECTED cdateidaten,clesefehler,ldateilauf
	*<PropValue>
		cbase64 = 
		cbeschreibung = 
		cdatei = 
		cdateibt = BT-125
		cdateidaten = 
		cdateifehler = 
		cdateiname = 
		clesefehler = 
		cmime = 
		cnummer = 
		cposition = 
		creferenzart = 
		ctyp = 
		curi = 
		ddatum = {}
		ldateilauf = .F.
		Name = "fxAnhang"
	*</PropValue>
	
	PROTECTED PROCEDURE Base64Kodieren
		LPARAMETERS tcBytes, toDom
		LOCAL loHex, loWert, luBytes, lcBase64
		loHex = toDom.createElement("hex")
		IF NOT EMPTY(This.cLesefehler) OR VARTYPE(loHex) # "O"
			RETURN .F.
		ENDIF
		loHex.dataType = "bin.hex"
		IF NOT EMPTY(This.cLesefehler)
			RETURN .F.
		ENDIF
		loHex.text = This.HexDaten(tcBytes)
		IF NOT EMPTY(This.cLesefehler)
			RETURN .F.
		ENDIF
		luBytes = loHex.nodeTypedValue
		IF NOT EMPTY(This.cLesefehler)
			RETURN .F.
		ENDIF
		loWert = toDom.createElement("binary")
		IF NOT EMPTY(This.cLesefehler) OR VARTYPE(loWert) # "O"
			RETURN .F.
		ENDIF
		loWert.dataType = "bin.base64"
		IF NOT EMPTY(This.cLesefehler)
			RETURN .F.
		ENDIF
		loWert.nodeTypedValue = luBytes
		IF NOT EMPTY(This.cLesefehler)
			RETURN .F.
		ENDIF
		lcBase64 = loWert.text
		IF NOT EMPTY(This.cLesefehler)
			RETURN .F.
		ENDIF
		This.cDateidaten = This.cDateidaten + CHRTRAN(lcBase64, CHR(10) + CHR(13), "")
		RETURN EMPTY(This.cLesefehler)
	ENDPROC

	PROCEDURE cBase64_Access
		RETURN This.cDateidaten
	ENDPROC

	PROCEDURE cBase64_Assign
		LPARAMETERS tuWert
	ENDPROC

	PROCEDURE cDateifehler_Access
		RETURN This.cLesefehler
	ENDPROC

	PROCEDURE cDateifehler_Assign
		LPARAMETERS tuWert
	ENDPROC

	PROTECTED PROCEDURE DateiFehler
		LPARAMETERS tcUrsache
		This.cLesefehler = This.MeldungsText("{1}: Quelldatei {2} kann nicht eingebettet werden: {3}", This.cDateiBT, This.cDatei, tcUrsache)
		= This.Eintragen("FEHLER", This.cPosition, This.cDateiBT, "FX-TECH-04", This.cLesefehler)
		RETURN .F.
	ENDPROC

	PROTECTED PROCEDURE DateiKodieren
		LOCAL lnDatei, lnRest, lnAnfang, lnAnzahl, lnFehler, lcBytes, loDom, llOk, llZu, lcDatei
		lcDatei = This.DateiPfad()
		IF EMPTY(lcDatei)
			RETURN .F.
		ENDIF
		This.cDatei = lcDatei
		lnDatei = FOPEN(This.cDatei, 0)
		IF lnDatei < 0
			RETURN This.DateiFehler(This.MeldungsText("Die Datei fehlt, ist gesperrt oder nicht lesbar."))
		ENDIF
		lnRest = FSEEK(lnDatei, 0, 2)
		lnAnfang = FSEEK(lnDatei, 0, 0)
		llOk = lnRest > 0 AND lnAnfang = 0 AND EMPTY(This.cLesefehler)
		IF NOT llOk
			= This.DateiFehler(This.MeldungsText("Die Datei ist leer oder nicht lesbar."))
		ELSE
			loDom = CREATEOBJECT("MSXML2.DOMDocument.6.0")
			llOk = VARTYPE(loDom) = "O" AND EMPTY(This.cLesefehler)
		ENDIF
		DO WHILE llOk AND lnRest > 0
			* Ganze Dreierbloecke verhindern Base64-Padding mitten im Inhalt.
			lnAnzahl = MIN(3072, lnRest)
			lcBytes = FREAD(lnDatei, lnAnzahl)
			lnFehler = FERROR()
			IF NOT EMPTY(This.cLesefehler) OR lnFehler # 0 OR LEN(lcBytes) # lnAnzahl
				llOk = This.DateiFehler(This.MeldungsText("Die Datei konnte nicht vollst{ae}ndig gelesen werden."))
				EXIT
			ENDIF
			llOk = This.Base64Kodieren(lcBytes, loDom) AND EMPTY(This.cLesefehler)
			lnRest = lnRest - lnAnzahl
		ENDDO
		llZu = FCLOSE(lnDatei)
		IF NOT llZu
			llOk = This.DateiFehler(This.MeldungsText("Die Quelldatei konnte nicht geschlossen werden."))
		ENDIF
		RETURN llOk
	ENDPROC

	PROCEDURE DateiLaden
		LOCAL llOk
		This.cDateidaten = ""
		This.cLesefehler = ""
		IF NOT This.lTechnischerFehler
			This.cLastError = ""
		ENDIF
		IF NOT INLIST(VARTYPE(This.cDatei), "C", "M")
			RETURN This.DateiFehler(This.MeldungsText("Der Dateipfad muss Text sein."))
		ENDIF
		IF EMPTY(ALLTRIM(This.cDatei))
			RETURN .T.
		ENDIF
		This.lDateiLauf = .T.
		llOk = This.DateiKodieren()
		This.lDateiLauf = .F.
		IF NOT llOk
			This.cDateidaten = ""
		ENDIF
		IF NOT llOk AND EMPTY(This.cLesefehler)
			RETURN This.DateiFehler(This.MeldungsText("Die Datei konnte nicht bin{ae}r gelesen oder kodiert werden."))
		ENDIF
		RETURN llOk
	ENDPROC

	PROTECTED PROCEDURE DateiPfad
		LOCAL lcName
		* Wie ZielPfad: Quellnamen niemals ueber SET PATH suchen.
		lcName = CHRTRAN(ALLTRIM(This.cDatei), "/", "\")
		DO CASE
		CASE LEFT(lcName, 2) == "\\" OR SUBSTR(lcName, 2, 2) == ":\"
			RETURN lcName
		CASE SUBSTR(lcName, 2, 1) == ":"
			= This.DateiFehler(This.MeldungsText("Laufwerksrelative Quelldateinamen sind nicht erlaubt."))
			RETURN ""
		CASE LEFT(lcName, 1) == "\"
			RETURN SYS(5) + lcName
		ENDCASE
		RETURN ADDBS(SYS(5) + SYS(2003)) + lcName
	ENDPROC

	PROCEDURE Error
		LPARAMETERS tnError, tcMethod, tnLine
		LOCAL lcUrsache
		lcUrsache = MESSAGE()
		IF This.lInError
			This.lDateiLauf = .F.
			This.lTechnischerFehler = .T.
			This.cLesefehler = lcUrsache
			RETURN
		ENDIF
		IF This.lDateiLauf
			This.lDateiLauf = .F.
			This.lInError = .T.
			* Lesefehler sind beim naechsten echten Ladeversuch korrigierbar.
			IF This.nMeldungsSession = SET("DATASESSION")
				= This.DateiFehler(lcUrsache)
			ELSE
				* Das Meldeziel einer fremden Session kann bereits beendet sein.
				This.cLesefehler = lcUrsache
				This.lTechnischerFehler = .T.
				IF This.lFehlerAusstehend
					This.cTechnischerText = This.cTechnischerText + CHR(13) + CHR(10) + lcUrsache
				ELSE
					This.cTechnischerText = lcUrsache
				ENDIF
				This.lFehlerAusstehend = .T.
			ENDIF
			This.lInError = .F.
			RETURN
		ENDIF
		DODEFAULT(tnError, tcMethod, tnLine)
	ENDPROC

	PROTECTED PROCEDURE HexDaten
		LPARAMETERS tcBytes
		LOCAL lcHex, lcZiffern, lnByte, lnWert
		* VFP6-Strings werden ohne Codepage-Konvertierung zu MSXML-Bytes.
		lcHex = ""
		lcZiffern = "0123456789ABCDEF"
		FOR lnByte = 1 TO LEN(tcBytes)
			lnWert = ASC(SUBSTR(tcBytes, lnByte, 1))
			lcHex = lcHex + SUBSTR(lcZiffern, INT(lnWert / 16) + 1, 1) + SUBSTR(lcZiffern, MOD(lnWert, 16) + 1, 1)
		ENDFOR
		RETURN lcHex
	ENDPROC

ENDDEFINE

DEFINE CLASS fxbasis AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: auswahlzurueck
		*m: cursoraktivieren
		*m: cursordatei
		*m: cursorschliessen
		*m: cursorvorhanden
		*m: eintragen
		*m: leeren
		*m: letzterfehler
		*m: ltechnischerfehler_access
		*m: meldungstext
		*m: zielsetzen
		*p: ccursordatei
		*p: ceigenercursor
		*p: clasterror
		*p: ctechnischertext
		*p: lfehlerausstehend
		*p: linerror
		*p: ltechnischerfehler
		*p: nmeldungssession
	*</DefinedPropArrayMethod>

	*<PropValue>
		ccursordatei = 
		ceigenercursor = 
		clasterror = 
		ctechnischertext = 
		lfehlerausstehend = .F.
		linerror = .F.
		ltechnischerfehler = .F.
		Name = "fxBasis"
		nmeldungssession = 0
	*</PropValue>
	
	PROCEDURE AuswahlZurueck
		LPARAMETERS tnSession, tnArea, tnZielArea
		* Auch die Arbeitsbereichsauswahl in der Zielsession erhalten.
		SELECT (tnZielArea)
		SET DATASESSION TO (tnSession)
		SELECT (tnArea)
	ENDPROC

	PROCEDURE CursorAktivieren
		LPARAMETERS tnZielArea
		LOCAL lnSession, lnArea, laOffen[1], lnAnzahl, lnCursor
		tnZielArea = 0
		IF EMPTY(This.cEigenerCursor) OR EMPTY(This.cCursorDatei) OR This.nMeldungsSession = 0
			RETURN .F.
		ENDIF
		lnAnzahl = 0
		lnAnzahl = AUSED(laOffen, This.nMeldungsSession)
		lnCursor = 1
		DO WHILE lnCursor <= lnAnzahl
			IF UPPER(laOffen[lnCursor, 1]) == UPPER(This.cEigenerCursor)
				EXIT
			ENDIF
			lnCursor = lnCursor + 1
		ENDDO
		IF lnCursor > lnAnzahl
			RETURN .F.
		ENDIF
		lnSession = SET("DATASESSION")
		SET DATASESSION TO (This.nMeldungsSession)
		lnArea = SELECT(0)
		IF USED(This.cEigenerCursor)
			IF This.CursorDatei(This.cEigenerCursor) == This.cCursorDatei
				tnZielArea = lnArea
				SELECT (This.cEigenerCursor)
				RETURN .T.
			ENDIF
		ENDIF
		SELECT (lnArea)
		SET DATASESSION TO (lnSession)
		RETURN .F.
	ENDPROC

	PROCEDURE CursorDatei
		LPARAMETERS tcAlias
		LOCAL lcFullpath, lcDatei
		lcFullpath = SET("FULLPATH")
		SET FULLPATH ON
		lcDatei = UPPER(DBF(tcAlias))
		IF lcFullpath == "OFF"
			SET FULLPATH OFF
		ENDIF
		RETURN lcDatei
	ENDPROC

	PROCEDURE CursorSchliessen
		LOCAL lnSession, lnArea, lnZielArea
		lnSession = SET("DATASESSION")
		lnArea = SELECT(0)
		IF This.CursorAktivieren(@lnZielArea)
			USE IN (This.cEigenerCursor)
			= This.AuswahlZurueck(lnSession, lnArea, lnZielArea)
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE CursorVorhanden
		LOCAL lnSession, lnArea, llOffen, lnZielArea
		lnSession = SET("DATASESSION")
		* In derselben Session genuegt die Identitaetspruefung ohne Auswahlwechsel.
		IF This.nMeldungsSession = lnSession
			IF EMPTY(This.cEigenerCursor) OR EMPTY(This.cCursorDatei) OR NOT USED(This.cEigenerCursor)
				RETURN .F.
			ENDIF
			RETURN This.CursorDatei(This.cEigenerCursor) == This.cCursorDatei
		ENDIF
		lnArea = SELECT(0)
		llOffen = This.CursorAktivieren(@lnZielArea)
		IF llOffen
			= This.AuswahlZurueck(lnSession, lnArea, lnZielArea)
		ENDIF
		RETURN llOffen
	ENDPROC

	PROCEDURE Eintragen
		LPARAMETERS tcStufe, tcPosition, tcBT, tcRegel, tcText
		LOCAL lnSession, lnArea, llOk, lnZielArea
		IF tcStufe == "FEHLER" AND EMPTY(tcText)
			tcText = "FEHLER ohne Meldungstext."
		ENDIF
		IF tcStufe == "FEHLER"
			This.cLastError = tcText
		ENDIF
		lnSession = SET("DATASESSION")
		lnArea = SELECT(0)
		IF NOT This.CursorAktivieren(@lnZielArea)
			RETURN .F.
		ENDIF
		INSERT INTO (This.cEigenerCursor) (Stufe, Position, BT, Regel, Text) ;
			VALUES (tcStufe, tcPosition, tcBT, tcRegel, tcText)
		llOk = NOT This.lTechnischerFehler
		= This.AuswahlZurueck(lnSession, lnArea, lnZielArea)
		RETURN llOk
	ENDPROC

	PROCEDURE Error
		LPARAMETERS tnError, tcMethod, tnLine
		LOCAL lcUrsache, lcText
		lcUrsache = MESSAGE()
		This.lTechnischerFehler = .T.
		IF This.lInError
			RETURN
		ENDIF
		This.lInError = .T.
		lcText = This.MeldungsText("Technischer Fehler {1} in {2}, Zeile {3}: {4}", ;
			ALLTRIM(STR(tnError)), tcMethod, ALLTRIM(STR(tnLine)), lcUrsache)
		* Ein gehaltenes Kind darf sein geschlossenes Meldeziel nicht neu anlegen.
		IF This.nMeldungsSession = SET("DATASESSION")
			= This.Eintragen("FEHLER", "", "", "FX-TECH-01", lcText)
		ELSE
			* Fremde Sessions koennen beendet sein. Erst nach Error beim Flagzugriff zustellen.
			IF This.lFehlerAusstehend
				This.cTechnischerText = This.cTechnischerText + CHR(13) + CHR(10) + lcText
			ELSE
				This.cTechnischerText = lcText
			ENDIF
			This.lFehlerAusstehend = .T.
		ENDIF
		This.lInError = .F.
	ENDPROC

	PROCEDURE Leeren
		LOCAL lnSession, lnArea, lcSafety, llOk, lnZielArea
		lnSession = SET("DATASESSION")
		lnArea = SELECT(0)
		IF NOT This.CursorAktivieren(@lnZielArea)
			RETURN .F.
		ENDIF
		lcSafety = SET("SAFETY")
		SET SAFETY OFF
		ZAP
		IF lcSafety == "ON"
			SET SAFETY ON
		ENDIF
		llOk = NOT This.lTechnischerFehler
		= This.AuswahlZurueck(lnSession, lnArea, lnZielArea)
		RETURN llOk
	ENDPROC

	PROCEDURE LetzterFehler
		LOCAL lnSession, lnArea, lnRec, lcText, llBof, llEof, lnZielArea, lnMeldung
		lnSession = SET("DATASESSION")
		lnArea = SELECT(0)
		IF NOT This.CursorAktivieren(@lnZielArea)
			RETURN This.cLastError
		ENDIF
		IF RECCOUNT() = 0
			= This.AuswahlZurueck(lnSession, lnArea, lnZielArea)
			RETURN ""
		ENDIF
		lnRec = RECNO()
		llBof = BOF()
		llEof = EOF()
		lcText = ""
		* Physische Reihenfolge bleibt auch bei einem Filter des Aufrufers eindeutig.
		FOR lnMeldung = RECCOUNT() TO 1 STEP -1
			GO (lnMeldung)
			IF ALLTRIM(Stufe) == "FEHLER"
				lcText = Text
				EXIT
			ENDIF
		ENDFOR
		DO CASE
		CASE llBof AND llEof
			GO BOTTOM
		CASE llBof
			GO TOP
			IF NOT BOF()
				SKIP -1
			ENDIF
		CASE llEof
			GO TOP
			IF NOT EOF()
				GO BOTTOM
				SKIP
			ENDIF
		OTHERWISE
			GO (lnRec)
		ENDCASE
		= This.AuswahlZurueck(lnSession, lnArea, lnZielArea)
		RETURN lcText
	ENDPROC

	PROCEDURE lTechnischerFehler_Access
		LOCAL lcText
		IF This.lFehlerAusstehend AND NOT This.lInError
			lcText = This.cTechnischerText
			This.lFehlerAusstehend = .F.
			= This.Eintragen("FEHLER", "", "", "FX-TECH-01", lcText)
			* Ein ungueltiges Meldeziel darf keinen weiteren Versuch vormerken.
			This.lFehlerAusstehend = .F.
		ENDIF
		RETURN This.lTechnischerFehler
	ENDPROC

	PROCEDURE MeldungsText
		LPARAMETERS tcVorlage, tcWert1, tcWert2, tcWert3, tcWert4
		LOCAL lcVorlage, lcText, lnZeichen, lnKlammer, lcToken, lnWert, laWerte[4]
		IF VARTYPE(tcVorlage) # "C" AND VARTYPE(tcVorlage) # "M"
			tcVorlage = "Meldungsvorlage fehlt."
		ENDIF
		lcVorlage = STRTRAN(tcVorlage, "{ae}", CHR(228))
		lcVorlage = STRTRAN(lcVorlage, "{oe}", CHR(246))
		lcVorlage = STRTRAN(lcVorlage, "{ue}", CHR(252))
		lcVorlage = STRTRAN(lcVorlage, "{Ae}", CHR(196))
		lcVorlage = STRTRAN(lcVorlage, "{Oe}", CHR(214))
		lcVorlage = STRTRAN(lcVorlage, "{Ue}", CHR(220))
		lcVorlage = STRTRAN(lcVorlage, "{ss}", CHR(223))
		lcVorlage = STRTRAN(lcVorlage, "{euro}", CHR(128))
		laWerte[1] = tcWert1
		laWerte[2] = tcWert2
		laWerte[3] = tcWert3
		laWerte[4] = tcWert4
		lcText = ""
		lnZeichen = 1
		DO WHILE lnZeichen <= LEN(lcVorlage)
			* Literaltext blockweise kopieren; eingefuegte Werte bleiben unveraendert.
			lnKlammer = AT("{", SUBSTR(lcVorlage, lnZeichen))
			IF lnKlammer = 0
				lcText = lcText + SUBSTR(lcVorlage, lnZeichen)
				EXIT
			ENDIF
			lnKlammer = lnZeichen + lnKlammer - 1
			lcText = lcText + SUBSTR(lcVorlage, lnZeichen, lnKlammer - lnZeichen)
			lcToken = SUBSTR(lcVorlage, lnKlammer, 3)
			lnWert = AT(lcToken, "{1}{2}{3}{4}")
			IF LEN(lcToken) = 3 AND lnWert > 0 AND MOD(lnWert - 1, 3) = 0
				lnWert = (lnWert + 2) / 3
				IF VARTYPE(laWerte[lnWert]) = "C" OR VARTYPE(laWerte[lnWert]) = "M"
					lcText = lcText + laWerte[lnWert]
				ENDIF
				lnZeichen = lnKlammer + 3
			ELSE
				lcText = lcText + "{"
				lnZeichen = lnKlammer + 1
			ENDIF
		ENDDO
		RETURN lcText
	ENDPROC

	PROCEDURE ZielSetzen
		LPARAMETERS tcAlias, tnSession, tcDatei
		This.cEigenerCursor = tcAlias
		This.nMeldungsSession = tnSession
		This.cCursorDatei = tcDatei
	ENDPROC

ENDDEFINE

DEFINE CLASS fxbelegaenderung AS fxbasis OF "foxferd.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*p: cbasiseinheit		&& BT-X-267 BT-X-270 Einheit der Basismenge, nur EXTENDED
		*p: cgrund		&& BT-97 BT-104 Grund des Belegnachlasses oder Zuschlags
		*p: cgrundcode		&& BT-98 BT-105 BT-177 Grundcode
		*p: cgrundliste		&& BT-177-1 Liste 5153 des Zuschlagsgrundcodes, nur EXTENDED
		*p: csteuerbefreiungscode		&& BT-174 BT-176 Steuerbefreiungscode, nur EXTENDED
		*p: csteuerbefreiungsgrund		&& BT-173 BT-175 Steuerbefreiungsgrund, nur EXTENDED
		*p: csteuerkategorie		&& BT-95 BT-102 Steuerkategorie
		*p: lzuschlag		&& BG-20-1 BG-21-1 Kennzeichen des Belegzuschlags
		*p: nbasis		&& BT-93 BT-100 Berechnungsbasis
		*p: nbasismenge		&& BT-X-266 BT-X-269 Optionale Basismenge, nur EXTENDED; reine Zusatzangabe
		*p: nbetrag		&& BT-92 BT-99 Vorgabebetrag; NULL berechnet aus Basis und Prozent
		*p: nprozent		&& BT-94 BT-101 Prozentsatz
		*p: nrechenbetrag		&& BT-92 BT-99 Gerundeter Ausgabebetrag
		*p: nreihenfolge		&& BT-X-265 BT-X-268 Reihenfolge, nur EXTENDED
		*p: nsteuersatz		&& BT-96 BT-103 Steuersatz
	*</DefinedPropArrayMethod>

	*<PropValue>
		cbasiseinheit = 
		cgrund = 
		cgrundcode = 
		cgrundliste = 
		csteuerbefreiungscode = 
		csteuerbefreiungsgrund = 
		csteuerkategorie = 
		lzuschlag = .F.
		Name = "fxBelegaenderung"
		nbasis = .NULL.
		nbasismenge = .NULL.
		nbetrag = .NULL.
		nprozent = .NULL.
		nrechenbetrag = .NULL.
		nreihenfolge = .NULL.
		nsteuersatz = .NULL.
	*</PropValue>

ENDDEFINE

