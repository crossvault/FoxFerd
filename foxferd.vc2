	PROCEDURE Stufe
		LPARAMETERS tcRegel, tcProfil
		IF tcRegel == "BR-FXEXT-04"
			RETURN "WARNUNG"
		ENDIF
		IF tcProfil == "XRECHNUNG-CII" AND INLIST(tcRegel, "BR-CL-21", "BR-CL-23")
			RETURN "WARNUNG"
		ENDIF
		RETURN "FEHLER"
	ENDPROC

