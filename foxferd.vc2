	PROCEDURE AddAbrechnungszeitraum
		LPARAMETERS tdAnfang, tdEnde
		LOCAL loZeitraum
		IF NOT ISNULL(This.oAbrechnungszeitraum)
			RETURN This.AddFehler("", "BG-14", "FX-TECH-03", "BG-14 darf nur einmal vorkommen.")
		ENDIF
		IF VARTYPE(tdAnfang) # "D" OR VARTYPE(tdEnde) # "D"
			RETURN This.AddFehler("", "BG-14", "FX-TECH-03", "BG-14 verlangt zwei Datumswerte, ungesetzt als {}.")
		ENDIF
		loZeitraum = CREATEOBJECT("fxZeitraum")
		IF NOT EMPTY(This.cEigenerCursor)
			IF NOT This.MeldungsCursorOeffnen()
				RETURN This.AddFehler("", "BG-14", "FX-TECH-03", "Das Meldeziel des Zeitraums fehlt.")
			ENDIF
			= This.ReferenzBinden(loZeitraum)
		ENDIF
		loZeitraum.dAnfang = tdAnfang
		loZeitraum.dEnde = tdEnde
		This.oAbrechnungszeitraum = loZeitraum
		RETURN loZeitraum
	ENDPROC

	PROCEDURE AddAngebot
		LPARAMETERS tcNummer
		LOCAL loReferenz
		IF NOT ISNULL(This.oAngebot)
			RETURN This.AddFehler("", "BT-X-403", "FX-TECH-03", "BT-X-403: Dieser Kopfbezug darf nur einmal vorkommen.")
		ENDIF
		loReferenz = This.NeueReferenz("fxReferenz", tcNummer, "BT-X-403")
		IF VARTYPE(loReferenz) = "O"
			This.oAngebot = loReferenz
		ENDIF
		RETURN loReferenz
	ENDPROC

	PROCEDURE AddAnhang
		LPARAMETERS tcDatei, tcMime, tcBeschreibung
		LOCAL loAnhang, lnAnhang, llOk
		llOk = This.AddPflicht(INLIST(VARTYPE(tcDatei), "C", "M"), "", "BT-125", "FX-TECH-03")
		llOk = This.AddPflicht(INLIST(VARTYPE(tcMime), "C", "M"), "", "BT-125-1", "FX-TECH-03") AND llOk
		llOk = This.AddPflicht(INLIST(VARTYPE(tcBeschreibung), "C", "M"), "", "BT-123", "FX-TECH-03") AND llOk
		IF NOT llOk
			RETURN .F.
		ENDIF
		loAnhang = This.NeueReferenz("fxAnhang", JUSTFNAME(tcDatei), "BT-122")
		IF VARTYPE(loAnhang) # "O"
			RETURN .F.
		ENDIF
		IF This.IstText(tcDatei)
			IF NOT This.MeldezielSetzen(loAnhang)
				RETURN This.AddFehler("", "BT-125", "FX-TECH-03", "Das Meldeziel des Anhangs fehlt.")
			ENDIF
			loAnhang.cDatei = tcDatei
			loAnhang.cDateiname = JUSTFNAME(tcDatei)
		ENDIF
		loAnhang.cTyp = "916"
		loAnhang.cMime = tcMime
		loAnhang.cBeschreibung = tcBeschreibung
		lnAnhang = This.nAnhaenge + 1
		DIMENSION This.aAnhaenge[lnAnhang]
		This.aAnhaenge[lnAnhang] = loAnhang
		This.nAnhangAnzahl = lnAnhang
		* Auch ein Dateifehler liefert das Objekt fuer die echte Korrektur.
		= loAnhang.DateiLaden()
		RETURN loAnhang
	ENDPROC

	PROCEDURE AddAuftrag
		LPARAMETERS tcNummer
		LOCAL loReferenz
		IF NOT ISNULL(This.oAuftrag)
			RETURN This.AddFehler("", "BT-14", "FX-TECH-03", "BT-14: Dieser Kopfbezug darf nur einmal vorkommen.")
		ENDIF
		loReferenz = This.NeueReferenz("fxReferenz", tcNummer, "BT-14")
		IF VARTYPE(loReferenz) = "O"
			This.oAuftrag = loReferenz
		ENDIF
		RETURN loReferenz
	ENDPROC

	PROTECTED PROCEDURE AddBelegaenderung
		LPARAMETERS tnBetrag, tcKategorie, tnSatz, tcGrund, tlZuschlag
		LOCAL loK, lnK
		IF NOT This.Belegparameter(tnBetrag, tcKategorie, tnSatz, tcGrund, tlZuschlag, .F.)
		    RETURN .F.
		ENDIF
		loK = CREATEOBJECT("fxBelegaenderung")
		loK.nBetrag = tnBetrag
		loK.cSteuerkategorie = tcKategorie
		loK.nSteuersatz = tnSatz
		loK.lZuschlag = tlZuschlag
		IF INLIST(VARTYPE(tcGrund), "C", "M")
		    loK.cGrund = tcGrund
		ENDIF
		lnK = This.nBelegaenderungen + 1
		DIMENSION This.aBelegaenderungen[lnK]
		This.aBelegaenderungen[lnK] = loK
		This.nBelegaenderungAnzahl = lnK
		= This.ReferenzBinden(loK)
		RETURN loK
	ENDPROC

	PROCEDURE AddBestellung
		LPARAMETERS tcNummer
		LOCAL loReferenz
		IF NOT ISNULL(This.oBestellung)
			RETURN This.AddFehler("", "BT-13", "FX-TECH-03", "BT-13: Dieser Kopfbezug darf nur einmal vorkommen.")
		ENDIF
		loReferenz = This.NeueReferenz("fxReferenz", tcNummer, "BT-13")
		IF VARTYPE(loReferenz) = "O"
			This.oBestellung = loReferenz
		ENDIF
		RETURN loReferenz
	ENDPROC

	PROCEDURE AddEmpfangsavis
		LPARAMETERS tcNummer
		LOCAL loReferenz
		IF NOT ISNULL(This.oEmpfangsavis)
			RETURN This.AddFehler("", "BT-15", "FX-TECH-03", "{1}: Dieser Lieferbezug darf nur einmal vorkommen.", "BT-15")
		ENDIF
		loReferenz = This.NeueReferenz("fxReferenz", tcNummer, "BT-15")
		IF VARTYPE(loReferenz) = "O"
			This.oEmpfangsavis = loReferenz
		ENDIF
		RETURN loReferenz
	ENDPROC

	PROCEDURE AddEndkundenbestellung
		LPARAMETERS tcNummer
		LOCAL loReferenz, lnAnzahl
		loReferenz = This.NeueReferenz("fxReferenz", tcNummer, "BT-X-150")
		IF VARTYPE(loReferenz) # "O"
			RETURN .F.
		ENDIF
		lnAnzahl = This.nEndkundenbestellungen + 1
		DIMENSION This.aEndkundenbestellungen[lnAnzahl]
		This.aEndkundenbestellungen[lnAnzahl] = loReferenz
		This.nEndkundenbestellungAnzahl = lnAnzahl
		RETURN loReferenz
	ENDPROC

	PROCEDURE AddFehler
		LPARAMETERS tcPosition, tcBT, tcRegel, tcVorlage, tcWert1, tcWert2, tcWert3, tcWert4
		LOCAL lcText
		lcText = This.MeldungsText(tcVorlage, tcWert1, tcWert2, tcWert3, tcWert4)
		= This.AddFehlerMerken(tcPosition, tcBT, tcRegel, lcText)
		IF This.MeldungsCursorOeffnen()
			= This.oMeldungen.Eintragen("FEHLER", tcPosition, tcBT, tcRegel, lcText)
		ENDIF
		RETURN .F.
	ENDPROC

	PROTECTED PROCEDURE AddFehlerMerken
		LPARAMETERS tcPosition, tcBT, tcRegel, tcText
		LOCAL lnFehler
		This.nAddFehler = This.nAddFehler + 1
		lnFehler = This.nAddFehler
		DIMENSION This.aAddFehler[lnFehler, 5]
		This.aAddFehler[lnFehler, 1] = "FEHLER"
		This.aAddFehler[lnFehler, 2] = tcPosition
		This.aAddFehler[lnFehler, 3] = tcBT
		This.aAddFehler[lnFehler, 4] = tcRegel
		This.aAddFehler[lnFehler, 5] = tcText
	ENDPROC

	PROCEDURE AddFinanzkorrektur
		    LPARAMETERS tnBetrag, tcGrund
		    LOCAL loK, lnK, llOk
		    llOk = This.AddPflicht(This.IstZahl(tnBetrag), "", "BT-179", "FX-TECH-03")
		    llOk = This.AddPflicht(INLIST(VARTYPE(tcGrund), "C", "M"), "", "BT-180", "FX-TECH-03") AND llOk
		    IF NOT llOk
		        RETURN .F.
		    ENDIF
		    loK = CREATEOBJECT("fxFinanzkorrektur")
		    loK.nBetrag = tnBetrag
		    loK.cGrund = tcGrund
		    lnK = This.nFinanzkorrekturen + 1
		    DIMENSION This.aFinanzkorrekturen[lnK]
		    This.aFinanzkorrekturen[lnK] = loK
		    This.nFinanzkorrekturAnzahl = lnK
		    = This.ReferenzBinden(loK)
		    RETURN loK
	ENDPROC

	PROCEDURE AddGliederung
		LPARAMETERS tcNummer, tcName, tcUntertyp, tnBetrag
		LOCAL loP, llOk, lcTyp
		IF PCOUNT() < 4
			tnBetrag = .NULL.
		ENDIF
		lcTyp = This.CodeNormal(tcUntertyp)
		llOk = This.AddPflicht(This.IstText(tcNummer), "", "BT-126", "BR-21")
		llOk = This.AddPflicht(This.IstText(tcName), "", "BT-153", "BR-25") AND llOk
		llOk = This.AddPflicht((lcTyp == "GROUP" OR lcTyp == "INFORMATION"), ;
			"", "BT-X-8", IIF(This.cProfil == "EXTENDED", "FX-SCH-A-000335", "FX-TECH-03")) AND llOk
		llOk = This.AddPflicht(ISNULL(tnBetrag) OR This.IstZahl(tnBetrag), "", "BT-131", "FX-TECH-03") AND llOk
		IF NOT llOk
			RETURN .F.
		ENDIF
		loP = CREATEOBJECT("fxPosition")
		IF VARTYPE(loP) # "O"
			RETURN .F.
		ENDIF
		loP.cNummer = tcNummer
		loP.cName = tcName
		loP.cUntertyp = tcUntertyp
		loP.nGliederungsbetrag = tnBetrag
		RETURN This.PositionAnfuegen(loP)
	ENDPROC

	PROCEDURE AddKontierung
		LPARAMETERS tcNummer
		LOCAL loReferenz, lnAnzahl
		IF This.cProfil # "EXTENDED" AND NOT EMPTY(This.cProfil) AND This.nKontierungen > 0
			RETURN This.AddFehler("", "BT-19", "FX-PROFIL-01", "BT-19: Mehrere Kopfkontierungen sind nur in EXTENDED erlaubt.")
		ENDIF
		loReferenz = This.NeueReferenz("fxKontierung", tcNummer, "BT-19")
		IF VARTYPE(loReferenz) # "O"
			RETURN .F.
		ENDIF
		lnAnzahl = This.nKontierungen + 1
		DIMENSION This.aKontierungen[lnAnzahl]
		This.aKontierungen[lnAnzahl] = loReferenz
		This.nKontierungAnzahl = lnAnzahl
		RETURN loReferenz
	ENDPROC

	PROCEDURE AddLieferschein
		LPARAMETERS tcNummer
		LOCAL loReferenz
		IF NOT ISNULL(This.oLieferschein)
			RETURN This.AddFehler("", "BT-X-202", "FX-TECH-03", "{1}: Dieser Lieferbezug darf nur einmal vorkommen.", "BT-X-202")
		ENDIF
		loReferenz = This.NeueReferenz("fxReferenz", tcNummer, "BT-X-202")
		IF VARTYPE(loReferenz) = "O"
			This.oLieferschein = loReferenz
		ENDIF
		RETURN loReferenz
	ENDPROC

	PROCEDURE AddLogistikentgelt
		LPARAMETERS tnBetrag, tcKategorie, tnSatz, tcBeschreibung
		LOCAL loK, lnK
		IF NOT This.Belegparameter(tnBetrag, tcKategorie, tnSatz, tcBeschreibung, .T., .T.)
		    RETURN .F.
		ENDIF
		loK = CREATEOBJECT("fxLogistikentgelt")
		loK.nBetrag = tnBetrag
		loK.cSteuerkategorie = tcKategorie
		loK.nSteuersatz = tnSatz
		IF INLIST(VARTYPE(tcBeschreibung), "C", "M")
		    loK.cBeschreibung = tcBeschreibung
		ENDIF
		lnK = This.nLogistikentgelte + 1
		DIMENSION This.aLogistikentgelte[lnK]
		This.aLogistikentgelte[lnK] = loK
		This.nLogistikAnzahl = lnK
		= This.ReferenzBinden(loK)
		RETURN loK
	ENDPROC

	PROCEDURE AddNachlass
		LPARAMETERS tnBetrag, tcKategorie, tnSatz, tcGrund
		RETURN This.AddBelegaenderung(tnBetrag, tcKategorie, tnSatz, tcGrund, .F.)
	ENDPROC

	PROCEDURE AddNotiz
		LPARAMETERS tcText, tcBetreff
		LOCAL llOk, loNotiz, lnNotiz
		IF PCOUNT() < 2
			tcBetreff = ""
		ENDIF
		* Leerer Text bleibt moeglich: EXTENDED erlaubt spaeter einen Textcode.
		llOk = This.AddPflicht(INLIST(VARTYPE(tcText), "C", "M"), "", "BT-22", "FX-TECH-03")
		llOk = This.AddPflicht(INLIST(VARTYPE(tcBetreff), "C", "M"), "", "BT-21", "FX-TECH-03") AND llOk
		IF NOT llOk
			RETURN .F.
		ENDIF
		loNotiz = CREATEOBJECT("fxNotiz")
		IF VARTYPE(loNotiz) # "O"
			RETURN .F.
		ENDIF
		loNotiz.cText = tcText
		loNotiz.cBetreff = tcBetreff
		IF NOT EMPTY(This.cEigenerCursor)
			IF NOT This.MeldungsCursorOeffnen()
				RETURN This.AddFehler("", "BT-22", "FX-TECH-03", "Das Meldeziel der Notiz fehlt.")
			ENDIF
			= loNotiz.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		lnNotiz = This.nNotizen + 1
		DIMENSION This.aNotizen[lnNotiz]
		This.aNotizen[lnNotiz] = loNotiz
		This.nNotizAnzahl = lnNotiz
		RETURN loNotiz
	ENDPROC

	PROTECTED PROCEDURE AddPflicht
		LPARAMETERS tlOk, tcPosition, tcBT, tcRegel
		IF NOT tlOk
			RETURN This.AddFehler(tcPosition, tcBT, tcRegel, "Add-Aufruf abgewiesen: {1} fehlt oder hat einen falschen Typ.", tcBT)
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE AddPosition
		LPARAMETERS tcNummer, tcName, tnMenge, tcEinheit, tnPreis, tcKategorie, tnSteuersatz
		LOCAL llOk, lcPosition, loPosition, lnPosition
		lcPosition = ""
		IF This.IstText(tcNummer)
			lcPosition = tcNummer
		ENDIF
		llOk = This.AddPflicht(This.IstText(tcNummer), lcPosition, "BT-126", "BR-21")
		llOk = This.AddPflicht(This.IstText(tcName), lcPosition, "BT-153", "BR-25") AND llOk
		llOk = This.AddPflicht(This.IstZahl(tnMenge), lcPosition, "BT-129", This.PositionsRegel("22")) AND llOk
		llOk = This.AddPflicht(This.IstText(tcEinheit), lcPosition, "BT-130", This.PositionsRegel("23")) AND llOk
		llOk = This.AddPflicht(This.IstZahl(tnPreis), lcPosition, "BT-146", This.PositionsRegel("26")) AND llOk
		llOk = This.AddPflicht(This.IstText(tcKategorie), lcPosition, "BT-151", This.KategorieRegel()) AND llOk
		llOk = This.AddPflicht(This.IstZahl(tnSteuersatz) OR ;
			(This.CodeNormal(tcKategorie) == "O" AND ISNULL(tnSteuersatz)), lcPosition, "BT-152", "FX-TECH-03") AND llOk
		IF NOT llOk
			RETURN .F.
		ENDIF
		loPosition = CREATEOBJECT("fxPosition")
		IF VARTYPE(loPosition) # "O"
			RETURN .F.
		ENDIF
		loPosition.cNummer = tcNummer
		loPosition.cName = tcName
		loPosition.nMenge = tnMenge
		loPosition.cEinheit = tcEinheit
		loPosition.nPreis = tnPreis
		loPosition.cSteuerkategorie = tcKategorie
		loPosition.nSteuersatz = tnSteuersatz
		RETURN This.PositionAnfuegen(loPosition)
	ENDPROC

	PROCEDURE AddRechnungsreferenz
		LPARAMETERS tcNummer
		LOCAL loReferenz, lnAnzahl
		IF This.cProfil # "EXTENDED" AND NOT EMPTY(This.cProfil) AND This.nRechnungsreferenzen > 0
			RETURN This.AddFehler("", "BT-25", "FX-PROFIL-01", "BT-25: Mehrere Vorgaengerbez{ue}ge sind wegen D16B nur in EXTENDED erlaubt.")
		ENDIF
		loReferenz = This.NeueReferenz("fxReferenz", tcNummer, "BT-25")
		IF VARTYPE(loReferenz) # "O"
			RETURN .F.
		ENDIF
		lnAnzahl = This.nRechnungsreferenzen + 1
		DIMENSION This.aRechnungsreferenzen[lnAnzahl]
		This.aRechnungsreferenzen[lnAnzahl] = loReferenz
		This.nRechnungsreferenzAnzahl = lnAnzahl
		RETURN loReferenz
	ENDPROC

	PROCEDURE AddSepaLastschrift
		LPARAMETERS tcSchuldnerIban, tcGlaeubigerId, tcMandatsreferenz
		LOCAL llOk
		* Alle Parameter vor der Zuweisung pruefen; fremde Zahlungsdaten bleiben erhalten.
		llOk = This.AddPflicht(VARTYPE(tcSchuldnerIban) = "C", "", "BT-91", "FX-TECH-03")
		llOk = This.AddPflicht(VARTYPE(tcGlaeubigerId) = "C", "", "BT-90", "FX-TECH-03") AND llOk
		IF PCOUNT() >= 3
			llOk = This.AddPflicht(VARTYPE(tcMandatsreferenz) = "C", "", "BT-89", "FX-TECH-03") AND llOk
		ENDIF
		IF NOT llOk
			RETURN .F.
		ENDIF
		This.cZahlungsart = "59"
		This.cSchuldnerIban = tcSchuldnerIban
		This.cGlaeubigerId = tcGlaeubigerId
		IF PCOUNT() >= 3
			This.cMandatsreferenz = tcMandatsreferenz
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE AddSepaUeberweisung
		LPARAMETERS tcIban, tcKontoinhaber
		LOCAL llOk
		* Eine inhaltlich ungueltige IBAN bleibt fuer die Profilpruefung erhalten.
		llOk = This.AddPflicht(VARTYPE(tcIban) = "C", "", "BT-84", "FX-TECH-03")
		llOk = This.AddPflicht(VARTYPE(tcKontoinhaber) = "C", "", "BT-85", "FX-TECH-03") AND llOk
		IF NOT llOk
			RETURN .F.
		ENDIF
		This.cZahlungsart = "58"
		This.cIban = tcIban
		This.cKontoinhaber = tcKontoinhaber
		RETURN .T.
	ENDPROC

	PROCEDURE AddSkonto
		LPARAMETERS tnTage, tnProzent, tnBasis
		LOCAL loB
		IF PCOUNT() < 3
		    tnBasis = .NULL.
		ENDIF
		IF NOT This.SkontoWerteGueltig(tnTage, tnProzent, tnBasis)
		    RETURN This.AddFehler("", "BT-20", "FX-TECH-03", ;
		        "AddSkonto verlangt ganze nichtnegative Tage, Prozent gr{oe}sser 0 bis 100 und einen optionalen numerischen Basisbetrag.")
		ENDIF
		loB = This.AddZahlungsbedingung()
		IF VARTYPE(loB) # "O"
		    RETURN .F.
		ENDIF
		loB.nSkontoTage = tnTage
		loB.cSkontoEinheit = "DAY"
		loB.nSkontoProzent = tnProzent
		loB.nSkontoBasis = tnBasis
		RETURN loB
	ENDPROC

	PROCEDURE AddSollSteuer
		LPARAMETERS tcKategorie, tnSatz, tnBetrag
		LOCAL llOk, lnSoll
		llOk = This.AddPflicht(This.IstText(tcKategorie), "", "BT-118", "FX-TECH-03")
		IF llOk AND NOT This.IstRechenkategorie(tcKategorie)
			llOk = This.AddFehler("", "BT-118", "FX-TECH-03", ;
				"Sollsteuer f{ue}r Kategorie {1} wird in diesem Stand nicht unterst{ue}tzt.", This.CodeNormal(tcKategorie))
		ENDIF
		llOk = This.AddPflicht(This.IstZahl(tnSatz), "", "BT-119", "FX-TECH-03") AND llOk
		llOk = This.AddPflicht(ISNULL(tnBetrag) OR This.IstZahl(tnBetrag), "", "BT-117", "FX-TECH-03") AND llOk
		IF NOT llOk
			RETURN .F.
		ENDIF
		IF (INLIST(This.CodeNormal(tcKategorie), "S", "L") AND ROUND(tnSatz, 2) <= 0) OR ;
			(This.CodeNormal(tcKategorie) == "M" AND ROUND(tnSatz, 2) < 0) OR ;
			(This.CodeNormal(tcKategorie) == "O" AND ROUND(tnSatz, 2) # 0)
			RETURN This.AddFehler("", "BT-119", "FX-TECH-03", "Der Sollsteuersatz muss f{ue}r S/L positiv, f{ue}r M nichtnegativ und f{ue}r O null sein. Andere S{ae}tze m{ue}ssen zu einer gerechneten Gruppe passen.")
		ENDIF
		* Je Kategorie und darstellbarem Satz genau eine Vorgabe, spaetere ersetzt fruehere.
		lnSoll = 1
		DO WHILE lnSoll <= This.nSollAnzahl
			IF This.CodeNormal(This.aSollSteuern[lnSoll, 1]) == This.CodeNormal(tcKategorie) AND ;
				ROUND(This.aSollSteuern[lnSoll, 2], 2) = ROUND(tnSatz, 2)
				EXIT
			ENDIF
			lnSoll = lnSoll + 1
		ENDDO
		IF lnSoll > This.nSollAnzahl
			This.nSollAnzahl = lnSoll
			DIMENSION This.aSollSteuern[lnSoll, 3]
		ENDIF
		This.aSollSteuern[lnSoll, 1] = tcKategorie
		This.aSollSteuern[lnSoll, 2] = tnSatz
		This.aSollSteuern[lnSoll, 3] = tnBetrag
		RETURN .T.
	ENDPROC

	PROCEDURE AddSteuerangabe
		LPARAMETERS tcKategorie, tnSatz
		LOCAL loK, llOk
		llOk = This.AddPflicht(This.IstText(tcKategorie) AND This.IstRechenkategorie(tcKategorie), "", "BT-118", "FX-TECH-03")
		llOk = This.AddPflicht(This.IstZahl(tnSatz), "", "BT-119", "FX-TECH-03") AND llOk
		IF NOT llOk
		    RETURN .F.
		ENDIF
		IF This.CodeNormal(tcKategorie) == "O" AND ROUND(tnSatz, 2) # 0
			= This.AddFehler("", "BT-119", "FX-TECH-03", "Der Steuersatz muss f{ue}r O null sein.")
			RETURN .F.
		ENDIF
		loK = CREATEOBJECT("fxSteuerangabe")
		IF VARTYPE(loK) # "O" OR NOT This.MeldezielSetzen(loK)
		    RETURN .F.
		ENDIF
		loK.cSteuerkategorie = tcKategorie
		loK.nSteuersatz = tnSatz
		This.nSteuerangaben = This.nSteuerangaben + 1
		DIMENSION This.aSteuerangaben[This.nSteuerangaben]
		This.aSteuerangaben[This.nSteuerangaben] = loK
		RETURN loK
	ENDPROC

	PROCEDURE AddTransport
		LPARAMETERS tcArt
		LOCAL loTransport, lnAnzahl
		IF NOT INLIST(VARTYPE(tcArt), "C", "M")
			RETURN This.AddFehler("", "BT-X-152", "FX-TECH-03", "Die Transportart muss Text sein.")
		ENDIF
		loTransport = CREATEOBJECT("fxTransport")
		IF NOT EMPTY(This.cEigenerCursor)
			IF NOT This.MeldungsCursorOeffnen()
				RETURN This.AddFehler("", "BT-X-152", "FX-TECH-03", "Das Meldeziel des Transports fehlt.")
			ENDIF
			= This.ReferenzBinden(loTransport)
		ENDIF
		loTransport.cArt = tcArt
		lnAnzahl = This.nTransporte + 1
		DIMENSION This.aTransporte[lnAnzahl]
		This.aTransporte[lnAnzahl] = loTransport
		This.nTransportAnzahl = lnAnzahl
		RETURN loTransport
	ENDPROC

	PROCEDURE AddVersandavis
		LPARAMETERS tcNummer
		LOCAL loReferenz
		IF NOT ISNULL(This.oVersandavis)
			RETURN This.AddFehler("", "BT-16", "FX-TECH-03", "{1}: Dieser Lieferbezug darf nur einmal vorkommen.", "BT-16")
		ENDIF
		loReferenz = This.NeueReferenz("fxReferenz", tcNummer, "BT-16")
		IF VARTYPE(loReferenz) = "O"
			This.oVersandavis = loReferenz
		ENDIF
		RETURN loReferenz
	ENDPROC

	PROCEDURE AddVertrag
		LPARAMETERS tcNummer
		LOCAL loReferenz
		IF NOT ISNULL(This.oVertrag)
			RETURN This.AddFehler("", "BT-12", "FX-TECH-03", "BT-12: Dieser Kopfbezug darf nur einmal vorkommen.")
		ENDIF
		loReferenz = This.NeueReferenz("fxReferenz", tcNummer, "BT-12")
		IF VARTYPE(loReferenz) = "O"
			This.oVertrag = loReferenz
		ENDIF
		RETURN loReferenz
	ENDPROC

	PROCEDURE AddVorauszahlung
		    LPARAMETERS tnBetrag
		    LOCAL loV, lnK
		    IF NOT This.AddPflicht(This.IstZahl(tnBetrag), "", "BT-X-291", "FX-TECH-03")
		        RETURN .F.
		    ENDIF
		    loV = CREATEOBJECT("fxVorauszahlung")
		    loV.nBetrag = tnBetrag
		    lnK = This.nVorauszahlungen + 1
		    DIMENSION This.aVorauszahlungen[lnK]
		    This.aVorauszahlungen[lnK] = loV
		    This.nVorauszahlungAnzahl = lnK
		    = This.ReferenzBinden(loV)
		    RETURN loV
	ENDPROC

	PROCEDURE AddZahlungsbedingung
		LPARAMETERS tcBeschreibung
		LOCAL loB, lnB
		IF PCOUNT() = 0
		    tcBeschreibung = ""
		ENDIF
		IF NOT This.AddPflicht(INLIST(VARTYPE(tcBeschreibung), "C", "M"), "", "BT-20", "FX-TECH-03")
		    RETURN .F.
		ENDIF
		loB = CREATEOBJECT("fxZahlungsbedingung")
		IF VARTYPE(loB) # "O"
		    RETURN .F.
		ENDIF
		loB.cBeschreibung = tcBeschreibung
		lnB = This.nZahlungsbedingungen + 1
		DIMENSION This.aZahlungsbedingungen[lnB]
		This.aZahlungsbedingungen[lnB] = loB
		This.nZahlungsbedingungAnzahl = lnB
		= This.ReferenzBinden(loB)
		RETURN loB
	ENDPROC

	PROCEDURE AddZuschlag
		LPARAMETERS tnBetrag, tcKategorie, tnSatz, tcGrund
		RETURN This.AddBelegaenderung(tnBetrag, tcKategorie, tnSatz, tcGrund, .T.)
	ENDPROC

	PROTECTED PROCEDURE AdresseVorhanden
		LPARAMETERS toPartei
		RETURN This.IstText(toPartei.cStrasse) OR This.IstText(toPartei.cStrasse2) OR ;
		    This.IstText(toPartei.cStrasse3) OR This.IstText(toPartei.cOrt) OR ;
		    This.IstText(toPartei.cPlz) OR This.IstText(toPartei.cLand) OR This.IstText(toPartei.cRegion)
	ENDPROC

	PROTECTED PROCEDURE AllePositionsperioden
		LOCAL lnP, loP, loZ
		IF This.nPositionen = 0
			RETURN .F.
		ENDIF
		FOR lnP = 1 TO This.nPositionen
			loP = This.aPositionen[lnP]
			IF VARTYPE(loP) # "O" OR VARTYPE(loP.oAbrechnungszeitraum) # "O"
				RETURN .F.
			ENDIF
		ENDFOR
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE AnhangAnzahlPruefen
		LPARAMETERS tn50, tn130, tnNamen, tnDateien
		LOCAL lcStufe
		IF This.cProfil # "EXTENDED"
			IF tn50 > 1
				= This.Meldung("WARNUNG", "", "BT-17", "CII-SR-457", "BT-17: Es sollte nur eine Ausschreibungsreferenz vorkommen.")
			ENDIF
			IF tn130 > 1
				= This.Meldung("WARNUNG", "", "BT-18", "CII-SR-458", "BT-18: Es sollte nur ein Abrechnungsobjekt vorkommen.")
			ENDIF
		ENDIF
		* Die lokalen Quellen zaehlen hier ueber alle 916-Belege hinweg.
		lcStufe = "WARNUNG"
		IF This.cProfil == "EN16931"
			lcStufe = "FEHLER"
		ENDIF
		IF This.cProfil == "XRECHNUNG-CII"
			lcStufe = "HINWEIS"
		ENDIF
		IF tnNamen > 1
			= This.Meldung(lcStufe, "", "BT-123", "CII-SR-475", "Die lokale Pr{ue}fung begrenzt die Gesamtzahl der Anhangbeschreibungen auf eins.")
		ENDIF
		IF tnDateien > 1
			= This.Meldung(lcStufe, "", "BT-125", "CII-SR-476", "Die lokale Pr{ue}fung begrenzt die Gesamtzahl eingebetteter Kopfanh{ae}nge auf eins.")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE AnhangDatumBT
		LPARAMETERS tcTyp
		DO CASE
		CASE tcTyp == "50"
			RETURN "BT-X-556"
		CASE tcTyp == "130"
			RETURN "BT-X-557"
		ENDCASE
		RETURN "BT-X-149"
	ENDPROC

	PROTECTED PROCEDURE Belegbetrag
		LPARAMETERS toK
		toK.nRechenbetrag = .NULL.
		IF This.IstZahl(toK.nBetrag)
		    toK.nRechenbetrag = ROUND(This.RechenNumeric(toK.nBetrag), 2)
		ELSE
		    IF ISNULL(toK.nBetrag) AND This.IstZahl(toK.nBasis) AND This.IstZahl(toK.nProzent)
		        toK.nRechenbetrag = ROUND(ROUND(This.RechenNumeric(toK.nBasis), 2) * ;
		            ROUND(This.RechenNumeric(toK.nProzent), 2) / 100, 2)
		    ENDIF
		ENDIF
		RETURN toK.nRechenbetrag
	ENDPROC

	PROTECTED PROCEDURE Belegparameter
		LPARAMETERS tnBetrag, tcKategorie, tnSatz, tcGrund, tlZuschlag, tlLogistik
		LOCAL llOk
		llOk = This.AddPflicht(ISNULL(tnBetrag) OR This.IstZahl(tnBetrag), "", IIF(tlLogistik, "BT-X-272", IIF(tlZuschlag, "BT-99", "BT-92")), "FX-TECH-03")
		llOk = This.AddPflicht(INLIST(VARTYPE(tcKategorie), "C", "M"), "", IIF(tlLogistik, "BT-X-273", IIF(tlZuschlag, "BT-102", "BT-95")), "FX-TECH-03") AND llOk
		llOk = This.AddPflicht(ISNULL(tnSatz) OR This.IstZahl(tnSatz), "", IIF(tlLogistik, "BT-X-274", IIF(tlZuschlag, "BT-103", "BT-96")), "FX-TECH-03") AND llOk
		llOk = This.AddPflicht(INLIST(VARTYPE(tcGrund), "C", "M") OR ;
		    (VARTYPE(tcGrund) = "L" AND NOT tcGrund), "", IIF(tlLogistik, "BT-X-271", IIF(tlZuschlag, "BT-104", "BT-97")), "FX-TECH-03") AND llOk
		RETURN llOk
	ENDPROC

	PROTECTED PROCEDURE BetragOderNull
		LPARAMETERS tnWert
		IF This.IstZahl(tnWert)
		    RETURN tnWert
		ENDIF
		RETURN 0
	ENDPROC

	PROCEDURE cLastError_Access
		IF VARTYPE(This.oMeldungen) = "O"
			IF This.oMeldungen.CursorVorhanden()
				RETURN This.oMeldungen.LetzterFehler()
			ENDIF
			IF EMPTY(This.cLastError)
				RETURN This.oMeldungen.cLastError
			ENDIF
		ENDIF
		RETURN This.cLastError
	ENDPROC

	PROTECTED PROCEDURE CodeNormal
		LPARAMETERS tuWert
		IF VARTYPE(tuWert) # "C" AND VARTYPE(tuWert) # "M"
			RETURN ""
		ENDIF
		RETURN ALLTRIM(CHRTRAN(tuWert, CHR(9) + CHR(10) + CHR(13), "   "))
	ENDPROC

	PROCEDURE CreateXML
		LPARAMETERS tcDatei
		LOCAL llOk
		* Technische Fehler gehoeren zu diesem Lauf, nicht zu bleibenden Add-Fehlern.
		This.nLaufTiefe = This.nLaufTiefe + 1
		llOk = This.CreateXmlLauf(tcDatei)
		This.nLaufTiefe = This.nLaufTiefe - 1
		RETURN llOk
	ENDPROC

	PROTECTED PROCEDURE CreateXmlLauf
		LPARAMETERS tcDatei
		LOCAL loWriter, loD, llOk
		IF NOT This.Validate() OR This.lTechnischerFehler OR NOT EMPTY(This.cLastError)
			RETURN .F.
		ENDIF
		loWriter = This.NeuerWriter()
		IF This.lTechnischerFehler OR VARTYPE(loWriter) # "O"
			RETURN .F.
		ENDIF
		IF NOT This.MeldezielSetzen(loWriter)
			RETURN .F.
		ENDIF
		loD = loWriter.Build(This)
		This.lTechnischerFehler = loWriter.lTechnischerFehler
		IF This.lTechnischerFehler OR NOT EMPTY(This.cLastError)
			RETURN .F.
		ENDIF
		IF VARTYPE(loD) # "O"
			= This.Meldung("FEHLER", "", "", "FX-TECH-02", "Der Writer hat kein DOM erzeugt.")
			RETURN .F.
		ENDIF
		IF This.lXsdPruefung
			llOk = loWriter.PruefeXsd(loD, This.cProfil, This.cXsdPfad)
		ELSE
			llOk = This.Meldung("WARNUNG", "", "", "XSD", "Die XSD-Pr{ue}fung ist abgeschaltet.")
		ENDIF
		This.lTechnischerFehler = This.lTechnischerFehler OR loWriter.lTechnischerFehler
		IF NOT llOk OR This.lTechnischerFehler OR NOT EMPTY(This.cLastError)
			RETURN .F.
		ENDIF
		llOk = loWriter.Speichern(loD, tcDatei)
		This.lTechnischerFehler = This.lTechnischerFehler OR loWriter.lTechnischerFehler
		RETURN llOk AND NOT This.lTechnischerFehler AND EMPTY(This.cLastError)
	ENDPROC

	PROCEDURE cstandardstand_Assign
		LPARAMETERS tcWert
		* Ein Bibliotheksstand, kein Versionsschalter.
	ENDPROC

	PROTECTED PROCEDURE DatenMeldezielSetzen
		LOCAL lnPosition
		IF VARTYPE(This.oVerkaeufer) = "O"
			= This.oVerkaeufer.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oKaeufer) = "O"
			= This.oKaeufer.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oVerkaufsagent) = "O"
			= This.oVerkaufsagent.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oKaeuferSteuervertreter) = "O"
			= This.oKaeuferSteuervertreter.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oVerkaeuferSteuervertreter) = "O"
			= This.oVerkaeuferSteuervertreter.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oEndnutzer) = "O"
			= This.oEndnutzer.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oEinkaufsagent) = "O"
			= This.oEinkaufsagent.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oLieferempfaenger) = "O"
			= This.oLieferempfaenger.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oEndlieferempfaenger) = "O"
			= This.oEndlieferempfaenger.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oVersender) = "O"
			= This.oVersender.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oRechnungssteller) = "O"
			= This.oRechnungssteller.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oRechnungsempfaenger) = "O"
			= This.oRechnungsempfaenger.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oZahlungsempfaenger) = "O"
			= This.oZahlungsempfaenger.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		IF VARTYPE(This.oZahler) = "O"
			= This.oZahler.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		FOR lnPosition = 1 TO This.nSteuerangaben
			= This.ReferenzBinden(This.aSteuerangaben[lnPosition])
		ENDFOR
		FOR lnPosition = 1 TO This.nZahlungsbedingungen
			= This.ReferenzBinden(This.aZahlungsbedingungen[lnPosition])
		ENDFOR
		FOR lnPosition = 1 TO This.nVorauszahlungen
			= This.ReferenzBinden(This.aVorauszahlungen[lnPosition])
		ENDFOR
		FOR lnPosition = 1 TO This.nFinanzkorrekturen
			= This.ReferenzBinden(This.aFinanzkorrekturen[lnPosition])
		ENDFOR
		FOR lnPosition = 1 TO This.nBelegaenderungen
			= This.ReferenzBinden(This.aBelegaenderungen[lnPosition])
		ENDFOR
		FOR lnPosition = 1 TO This.nLogistikentgelte
			= This.ReferenzBinden(This.aLogistikentgelte[lnPosition])
		ENDFOR
		FOR lnPosition = 1 TO This.nPositionen
			IF VARTYPE(This.aPositionen[lnPosition]) = "O"
				= This.aPositionen[lnPosition].ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
			ENDIF
		ENDFOR
		FOR lnPosition = 1 TO This.nNotizen
			IF VARTYPE(This.aNotizen[lnPosition]) = "O"
				= This.aNotizen[lnPosition].ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
			ENDIF
		ENDFOR
		FOR lnPosition = 1 TO This.nAnhaenge
			= This.ReferenzBinden(This.aAnhaenge[lnPosition])
		ENDFOR
		= This.ReferenzBinden(This.oBestellung)
		= This.ReferenzBinden(This.oAuftrag)
		= This.ReferenzBinden(This.oVertrag)
		= This.ReferenzBinden(This.oAngebot)
		= This.ReferenzBinden(This.oVersandavis)
		= This.ReferenzBinden(This.oEmpfangsavis)
		= This.ReferenzBinden(This.oLieferschein)
		= This.ReferenzBinden(This.oAbrechnungszeitraum)
		FOR lnPosition = 1 TO This.nTransporte
			= This.ReferenzBinden(This.aTransporte[lnPosition])
		ENDFOR
		FOR lnPosition = 1 TO This.nEndkundenbestellungen
			= This.ReferenzBinden(This.aEndkundenbestellungen[lnPosition])
		ENDFOR
		FOR lnPosition = 1 TO This.nRechnungsreferenzen
			= This.ReferenzBinden(This.aRechnungsreferenzen[lnPosition])
		ENDFOR
		FOR lnPosition = 1 TO This.nKontierungen
			= This.ReferenzBinden(This.aKontierungen[lnPosition])
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE DatumswertGueltig
		LPARAMETERS tuWert, tcFormat
		LOCAL lcWert, lcFormat, lnLaenge
		lcFormat = This.CodeNormal(tcFormat)
		IF NOT INLIST(VARTYPE(tuWert), "C", "M") OR NOT (lcFormat == "102" OR lcFormat == "205")
			RETURN .F.
		ENDIF
		lcWert = This.CodeNormal(tuWert)
		lnLaenge = IIF(lcFormat == "102", 8, 12)
		IF LEN(lcWert) # lnLaenge OR LEN(CHRTRAN(lcWert, "0123456789", "")) > 0
			RETURN .F.
		ENDIF
		IF NOT BETWEEN(VAL(SUBSTR(lcWert, 5, 2)), 1, 12) OR NOT BETWEEN(VAL(SUBSTR(lcWert, 7, 2)), 1, 31)
			RETURN .F.
		ENDIF
		IF lcFormat == "205"
			RETURN BETWEEN(VAL(SUBSTR(lcWert, 9, 2)), 0, 23) AND BETWEEN(VAL(RIGHT(lcWert, 2)), 0, 59)
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE Destroy
		LOCAL lnPosition
		DIMENSION This.aZahlungsbedingungen[1]
		This.aZahlungsbedingungen[1] = .NULL.
		DIMENSION This.aVorauszahlungen[1]
		This.aVorauszahlungen[1] = .NULL.
		DIMENSION This.aFinanzkorrekturen[1]
		This.aFinanzkorrekturen[1] = .NULL.
		DIMENSION This.aSteuerangaben[1]
		This.aSteuerangaben[1] = .NULL.
		DIMENSION This.aBelegaenderungen[1]
		This.aBelegaenderungen[1] = .NULL.
		DIMENSION This.aLogistikentgelte[1]
		This.aLogistikentgelte[1] = .NULL.
		FOR lnPosition = 1 TO This.nPositionen
			This.aPositionen[lnPosition] = .NULL.
		ENDFOR
		DIMENSION This.aPositionen[1]
		This.aPositionen[1] = .NULL.
		This.nPositionsAnzahl = 0
		FOR lnPosition = 1 TO This.nNotizen
			This.aNotizen[lnPosition] = .NULL.
		ENDFOR
		DIMENSION This.aNotizen[1]
		This.aNotizen[1] = .NULL.
		This.nNotizAnzahl = 0
		FOR lnPosition = 1 TO This.nAnhaenge
			This.aAnhaenge[lnPosition] = .NULL.
		ENDFOR
		DIMENSION This.aAnhaenge[1]
		This.aAnhaenge[1] = .NULL.
		This.nAnhangAnzahl = 0
		This.oVerkaeufer = .NULL.
		This.oKaeufer = .NULL.
		This.oVerkaufsagent = .NULL.
		This.oKaeuferSteuervertreter = .NULL.
		This.oVerkaeuferSteuervertreter = .NULL.
		This.oEndnutzer = .NULL.
		This.oEinkaufsagent = .NULL.
		This.oLieferempfaenger = .NULL.
		This.oEndlieferempfaenger = .NULL.
		This.oVersender = .NULL.
		This.oRechnungssteller = .NULL.
		This.oRechnungsempfaenger = .NULL.
		This.oZahlungsempfaenger = .NULL.
		This.oZahler = .NULL.
		This.oVersandavis = .NULL.
		This.oEmpfangsavis = .NULL.
		This.oLieferschein = .NULL.
		This.oAbrechnungszeitraum = .NULL.
		FOR lnPosition = 1 TO This.nTransporte
			This.aTransporte[lnPosition] = .NULL.
		ENDFOR
		DIMENSION This.aTransporte[1]
		This.aTransporte[1] = .NULL.
		This.nTransportAnzahl = 0
		This.oBestellung = .NULL.
		This.oAuftrag = .NULL.
		This.oVertrag = .NULL.
		This.oAngebot = .NULL.
		FOR lnPosition = 1 TO This.nEndkundenbestellungen
			This.aEndkundenbestellungen[lnPosition] = .NULL.
		ENDFOR
		DIMENSION This.aEndkundenbestellungen[1]
		This.aEndkundenbestellungen[1] = .NULL.
		This.nEndkundenbestellungAnzahl = 0
		FOR lnPosition = 1 TO This.nRechnungsreferenzen
			This.aRechnungsreferenzen[lnPosition] = .NULL.
		ENDFOR
		DIMENSION This.aRechnungsreferenzen[1]
		This.aRechnungsreferenzen[1] = .NULL.
		This.nRechnungsreferenzAnzahl = 0
		FOR lnPosition = 1 TO This.nKontierungen
			This.aKontierungen[lnPosition] = .NULL.
		ENDFOR
		DIMENSION This.aKontierungen[1]
		This.aKontierungen[1] = .NULL.
		This.nKontierungAnzahl = 0
		IF VARTYPE(This.oMeldungen) = "O"
			= This.oMeldungen.CursorSchliessen()
			This.oMeldungen = .NULL.
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE EmailGueltig
		LPARAMETERS tuEmail
		LOCAL lcEmail, lnAt, lcDomain
		IF NOT This.IstText(tuEmail)
			RETURN .F.
		ENDIF
		lcEmail = ALLTRIM(CHRTRAN(tuEmail, CHR(9) + CHR(10) + CHR(13), "   "))
		lnAt = AT("@", lcEmail)
		IF lnAt <= 1 OR AT("@", lcEmail, 2) > 0 OR " " $ lcEmail
			RETURN .F.
		ENDIF
		lcDomain = SUBSTR(lcEmail, lnAt + 1)
		RETURN "." $ lcDomain AND LEFT(lcDomain, 1) # "." AND RIGHT(lcDomain, 1) # "." AND NOT ".." $ lcDomain
	ENDPROC

	PROCEDURE Error
		LPARAMETERS tnError, tcMethod, tnLine
		LOCAL lcText, lcUrsache
		lcUrsache = MESSAGE()
		This.lTechnischerFehler = .T.
		IF This.lInError OR VARTYPE(This.oMeldungen) # "O"
			RETURN
		ENDIF
		This.lInError = .T.
		lcText = This.MeldungsText("Technischer Fehler {1} in {2}, Zeile {3}: {4}", ;
			ALLTRIM(STR(tnError)), tcMethod, ALLTRIM(STR(tnLine)), lcUrsache)
		* Eine gescheiterte Cursoranlage wird im Fehlerpfad nicht wiederholt.
		IF NOT This.lCursorAnlage
			= This.MeldungsCursorOeffnen()
		ENDIF
		This.cLastError = lcText
		IF NOT This.lCursorAnlage AND This.nLaufTiefe = 0
			= This.AddFehlerMerken("", "", "FX-TECH-01", lcText)
		ENDIF
		= This.oMeldungen.Eintragen("FEHLER", "", "", "FX-TECH-01", lcText)
		This.lInError = .F.
	ENDPROC

	PROTECTED PROCEDURE FaelligkeitNoetig
		RETURN This.IstZahl(This.nZahlbetrag) AND This.nZahlbetrag > 0
	ENDPROC

	PROTECTED PROCEDURE Gutschrift
		LOCAL lnK
		IF VARTYPE(This.lNegativAlsGutschrift) # "L"
			RETURN This.Meldung("FEHLER", "", "BT-3", "FX-TECH-03", "lNegativAlsGutschrift muss .T. oder .F. sein.")
		ENDIF
		IF This.CodeNormal(This.cRechnungstyp) == "380" AND This.IstZahl(This.nBrutto) AND This.nBrutto < 0
			IF NOT This.lNegativAlsGutschrift
				RETURN This.Meldung("WARNUNG", "", "BT-112", "FX-TECH-05", ;
					"Typ 380 hat einen negativen Rechnungsbetrag. Ohne lNegativAlsGutschrift bleiben Typ und Vorzeichen unver{ae}ndert.")
			ENDIF
			* Rechnen hat alle Ergebnisse gebildet. Eingaben und Ergebnisse gemeinsam drehen,
			* damit auch dieser erste Prueflauf dieselben Werte sieht wie jeder spaetere.
			= This.GutschriftKopf()
			FOR lnK = 1 TO This.nPositionen
				IF VARTYPE(This.aPositionen[lnK]) = "O"
					= This.GutschriftPosition(This.aPositionen[lnK])
				ENDIF
			ENDFOR
			= This.GutschriftSteuern()
			= This.GutschriftZahlung()
			This.cRechnungstyp = "381"
			This.lGutschriftUmgewandelt = .T.
		ENDIF
		IF This.lGutschriftUmgewandelt AND This.CodeNormal(This.cRechnungstyp) == "381"
			= This.Meldung("HINWEIS", "", "BT-112", "FX-TECH-06", ;
				"Negative Rechnung vom Typ 380 in Gutschrift 381 umgewandelt. Betr{ae}ge, Mengen und Sollwerte haben das Vorzeichen gewechselt; Preise, Basismengen und Prozente bleiben.")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE GutschriftBetrag
		LPARAMETERS tuWert
		* NULL und falsche Typen bleiben fuer die regulaere Fachpruefung erhalten.
		IF NOT This.IstZahl(tuWert)
			RETURN tuWert
		ENDIF
		IF tuWert = 0
			RETURN 0
		ENDIF
		RETURN -tuWert
	ENDPROC

	PROTECTED PROCEDURE GutschriftKopf
		LOCAL lnK, loK
		This.nSummePositionen = This.GutschriftBetrag(This.nSummePositionen)
		This.nNachlassSumme = This.GutschriftBetrag(This.nNachlassSumme)
		This.nZuschlagSumme = This.GutschriftBetrag(This.nZuschlagSumme)
		This.nNetto = This.GutschriftBetrag(This.nNetto)
		This.nSteuer = This.GutschriftBetrag(This.nSteuer)
		This.nBrutto = This.GutschriftBetrag(This.nBrutto)
		This.nSollSteuer = This.GutschriftBetrag(This.nSollSteuer)
		This.nSollBrutto = This.GutschriftBetrag(This.nSollBrutto)
		This.nSteuerInSteuerwaehrung = This.GutschriftBetrag(This.nSteuerInSteuerwaehrung)
		FOR lnK = 1 TO This.nBelegaenderungen
			loK = This.aBelegaenderungen[lnK]
			IF VARTYPE(loK) = "O"
				loK.nBetrag = This.GutschriftBetrag(loK.nBetrag)
				loK.nBasis = This.GutschriftBetrag(loK.nBasis)
				loK.nRechenbetrag = This.GutschriftBetrag(loK.nRechenbetrag)
			ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nLogistikentgelte
			loK = This.aLogistikentgelte[lnK]
			IF VARTYPE(loK) = "O"
				loK.nBetrag = This.GutschriftBetrag(loK.nBetrag)
				loK.nRechenbetrag = This.GutschriftBetrag(loK.nRechenbetrag)
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE GutschriftPosition
		LPARAMETERS toP
		LOCAL lnK, loK
		toP.nMenge = This.GutschriftBetrag(toP.nMenge)
		toP.nGratismenge = This.GutschriftBetrag(toP.nGratismenge)
		toP.nPaketmenge = This.GutschriftBetrag(toP.nPaketmenge)
		toP.nNettobetrag = This.GutschriftBetrag(toP.nNettobetrag)
		toP.nGliederungsbetrag = This.GutschriftBetrag(toP.nGliederungsbetrag)
		toP.nBruttobetrag = This.GutschriftBetrag(toP.nBruttobetrag)
		toP.nSteuerbetrag = This.GutschriftBetrag(toP.nSteuerbetrag)
		toP.nNachlassSumme = This.GutschriftBetrag(toP.nNachlassSumme)
		toP.nZuschlagSumme = This.GutschriftBetrag(toP.nZuschlagSumme)
		toP.nGesamtAenderung = This.GutschriftBetrag(toP.nGesamtAenderung)
		* Nettopreis, Bruttopreis, Preisnachlaesse/-zuschlaege samt Basen und der im
		* Nettopreis enthaltene Steuerbetrag (BT-X-37) bleiben als Preisbestandteile gleich.
		* Menge je Paket und die Menge eines enthaltenen Produkts (BT-X-20) sind Faktoren
		* je Einheit und keine zurueckgegebenen Gesamtmengen.
		FOR lnK = 1 TO toP.nAbrechnungsaenderungen
			loK = toP.aAbrechnungsaenderungen[lnK]
			IF VARTYPE(loK) = "O"
				loK.nBetrag = This.GutschriftBetrag(loK.nBetrag)
				loK.nBasis = This.GutschriftBetrag(loK.nBasis)
				loK.nRechenbetrag = This.GutschriftBetrag(loK.nRechenbetrag)
			ENDIF
		ENDFOR
		FOR lnK = 1 TO toP.nSteuersummen
			loK = toP.aSteuersummen[lnK]
			IF VARTYPE(loK) = "O"
				loK.nBetrag = This.GutschriftBetrag(loK.nBetrag)
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE GutschriftSteuern
		LOCAL lnK, loK
		FOR lnK = 1 TO This.nSollAnzahl
			This.aSollSteuern[lnK, 3] = This.GutschriftBetrag(This.aSollSteuern[lnK, 3])
		ENDFOR
		FOR lnK = 1 TO This.nSteuerangaben
			loK = This.aSteuerangaben[lnK]
			IF VARTYPE(loK) = "O"
				loK.nPositionsbasis = This.GutschriftBetrag(loK.nPositionsbasis)
				loK.nBelegaenderungsbasis = This.GutschriftBetrag(loK.nBelegaenderungsbasis)
			ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nSteuergruppen
			loK = This.aSteuergruppen[lnK]
			IF VARTYPE(loK) = "O"
				loK.nBasis = This.GutschriftBetrag(loK.nBasis)
				loK.nSteuer = This.GutschriftBetrag(loK.nSteuer)
				loK.nPositionsbasis = This.GutschriftBetrag(loK.nPositionsbasis)
				loK.nBelegaenderungsbasis = This.GutschriftBetrag(loK.nBelegaenderungsbasis)
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE GutschriftZahlung
		LOCAL lnK, lnS, loK, loS
		This.nZahlbetrag = This.GutschriftBetrag(This.nZahlbetrag)
		This.nSollZahlbetrag = This.GutschriftBetrag(This.nSollZahlbetrag)
		This.nVorauszahlung = This.GutschriftBetrag(This.nVorauszahlung)
		This.nVorauszahlungSumme = This.GutschriftBetrag(This.nVorauszahlungSumme)
		This.nRundung = This.GutschriftBetrag(This.nRundung)
		This.nFinanzkorrekturSumme = This.GutschriftBetrag(This.nFinanzkorrekturSumme)
		FOR lnK = 1 TO This.nVorauszahlungen
			loK = This.aVorauszahlungen[lnK]
			IF VARTYPE(loK) # "O"
				LOOP
			ENDIF
			loK.nBetrag = This.GutschriftBetrag(loK.nBetrag)
			FOR lnS = 1 TO loK.nSteuern
				loS = loK.aSteuern[lnS]
				IF VARTYPE(loS) = "O"
					loS.nBetrag = This.GutschriftBetrag(loS.nBetrag)
				ENDIF
			ENDFOR
		ENDFOR
		FOR lnK = 1 TO This.nFinanzkorrekturen
			loK = This.aFinanzkorrekturen[lnK]
			IF VARTYPE(loK) = "O"
				loK.nBetrag = This.GutschriftBetrag(loK.nBetrag)
			ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nZahlungsbedingungen
			loK = This.aZahlungsbedingungen[lnK]
			IF VARTYPE(loK) = "O"
				loK.nTeilzahlung = This.GutschriftBetrag(loK.nTeilzahlung)
				loK.nVerzugBasis = This.GutschriftBetrag(loK.nVerzugBasis)
				loK.nVerzugBetrag = This.GutschriftBetrag(loK.nVerzugBetrag)
				loK.nSkontoBasis = This.GutschriftBetrag(loK.nSkontoBasis)
				loK.nSkontoBetrag = This.GutschriftBetrag(loK.nSkontoBetrag)
			ENDIF
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE HatHierarchie
		LOCAL lnP, loP
		* Flache Belege brauchen weder Elternarray noch Pfadpruefung.
		FOR lnP = 1 TO This.nPositionen
			loP = This.aPositionen[lnP]
			IF VARTYPE(loP) = "O"
				IF VARTYPE(loP.cUntertyp) # "C" OR NOT EMPTY(loP.cUntertyp) OR ;
					VARTYPE(loP.cElternnummer) # "C" OR NOT EMPTY(loP.cElternnummer) OR ;
					NOT ISNULL(loP.nGliederungsbetrag)
					RETURN .T.
				ENDIF
			ENDIF
		ENDFOR
		RETURN .F.
	ENDPROC

	PROTECTED PROCEDURE HatMandat
		LOCAL lnB, loB
		IF This.IstText(This.cMandatsreferenz)
		    RETURN .T.
		ENDIF
		FOR lnB = 1 TO This.nZahlungsbedingungen
		    loB = This.aZahlungsbedingungen[lnB]
		    IF VARTYPE(loB) = "O"
		        IF This.IstText(loB.cMandatsreferenz)
		            RETURN .T.
		        ENDIF
		    ENDIF
		ENDFOR
		RETURN .F.
	ENDPROC

	PROTECTED PROCEDURE HatZahlungsfrist
		LOCAL lnB, loB
		IF (VARTYPE(This.dFaelligkeit) = "D" AND NOT EMPTY(This.dFaelligkeit)) OR This.IstText(This.ZahlungsText())
		    RETURN .T.
		ENDIF
		FOR lnB = 1 TO This.nZahlungsbedingungen
		    loB = This.aZahlungsbedingungen[lnB]
		    IF VARTYPE(loB) = "O"
		        IF (VARTYPE(loB.dFaelligkeit) = "D" AND NOT EMPTY(loB.dFaelligkeit)) OR ;
		            This.IstText(loB.cBeschreibung) OR This.IstText(loB.SkontoText(This.cProfil, This.cWaehrung))
		            RETURN .T.
		        ENDIF
		    ENDIF
		ENDFOR
		RETURN .F.
	ENDPROC

	PROTECTED PROCEDURE IbanGueltig
		LPARAMETERS tuIban
		LOCAL lcIban, lcUmlauf, lcZeichen, lnZeichen, lnCode, lnRest
		IF NOT This.IstText(tuIban)
			RETURN .F.
		ENDIF
		lcIban = CHRTRAN(tuIban, " " + CHR(9) + CHR(10) + CHR(13), "")
		IF LEN(lcIban) < 4 OR LEN(lcIban) > 34
			RETURN .F.
		ENDIF
		IF NOT (LEFT(lcIban, 1) $ "ABCDEFGHIJKLMNOPQRSTUVWXYZ") OR ;
			NOT (SUBSTR(lcIban, 2, 1) $ "ABCDEFGHIJKLMNOPQRSTUVWXYZ") OR ;
			NOT (SUBSTR(lcIban, 3, 1) $ "0123456789") OR NOT (SUBSTR(lcIban, 4, 1) $ "0123456789")
			RETURN .F.
		ENDIF
		lcUmlauf = SUBSTR(lcIban, 5) + LEFT(lcIban, 4)
		lnRest = 0
		FOR lnZeichen = 1 TO LEN(lcUmlauf)
			lcZeichen = SUBSTR(lcUmlauf, lnZeichen, 1)
			lnCode = ASC(lcZeichen)
			DO CASE
			CASE lcZeichen $ "0123456789"
				lnRest = MOD(lnRest * 10 + lnCode - 48, 97)
			CASE lcZeichen $ "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
				* Der lokale KoSIT-Code verwendet bei kleinen BBAN-Buchstaben den Originalcodepoint.
				lnRest = MOD(lnRest * 100 + lnCode - 55, 97)
			OTHERWISE
				RETURN .F.
			ENDCASE
		ENDFOR
		RETURN lnRest = 1
	ENDPROC

	PROCEDURE Init
		This.aZahlungsbedingungen[1] = .NULL.
		This.cSteuerkursformat = "102"
		This.oVerkaeufer = CREATEOBJECT("fxPartei")
		This.oKaeufer = CREATEOBJECT("fxPartei")
		This.oVerkaufsagent = CREATEOBJECT("fxPartei")
		This.oKaeuferSteuervertreter = CREATEOBJECT("fxPartei")
		This.oVerkaeuferSteuervertreter = CREATEOBJECT("fxPartei")
		This.oEndnutzer = CREATEOBJECT("fxPartei")
		This.oEinkaufsagent = CREATEOBJECT("fxPartei")
		This.oLieferempfaenger = CREATEOBJECT("fxPartei")
		This.oEndlieferempfaenger = CREATEOBJECT("fxPartei")
		This.oVersender = CREATEOBJECT("fxPartei")
		This.oRechnungssteller = CREATEOBJECT("fxPartei")
		This.oRechnungsempfaenger = CREATEOBJECT("fxPartei")
		This.oZahlungsempfaenger = CREATEOBJECT("fxPartei")
		This.oZahler = CREATEOBJECT("fxPartei")
		This.aBelegaenderungen[1] = .NULL.
		This.aLogistikentgelte[1] = .NULL.
		This.aPositionen[1] = .NULL.
		This.aNotizen[1] = .NULL.
		This.aAnhaenge[1] = .NULL.
		This.aSteuerangaben[1] = .NULL.
		This.aSteuergruppen[1] = .NULL.
		This.oMeldungen = CREATEOBJECT("fxBasis")
		This.aEndkundenbestellungen[1] = .NULL.
		This.aRechnungsreferenzen[1] = .NULL.
		This.aKontierungen[1] = .NULL.
		This.aTransporte[1] = .NULL.
		RETURN VARTYPE(This.oMeldungen) = "O"
	ENDPROC

	PROTECTED PROCEDURE IstDetailposition
		LPARAMETERS toP
		LOCAL lcTyp
		IF This.cProfil # "EXTENDED" OR (VARTYPE(toP.cUntertyp) = "C" AND EMPTY(toP.cUntertyp))
			RETURN .T.
		ENDIF
		lcTyp = This.CodeNormal(toP.cUntertyp)
		RETURN EMPTY(lcTyp) OR lcTyp == "DETAIL"
	ENDPROC

	PROTECTED PROCEDURE IstRechenkategorie
		LPARAMETERS tuKategorie
		LOCAL lcKategorie
		lcKategorie = This.CodeNormal(tuKategorie)
		* INLIST vergleicht Texte bei SET EXACT OFF auch als Praefixe.
		RETURN lcKategorie == "S" OR lcKategorie == "Z" OR lcKategorie == "E" OR ;
			lcKategorie == "AE" OR lcKategorie == "G" OR lcKategorie == "K" OR lcKategorie == "O" OR ;
			lcKategorie == "L" OR lcKategorie == "M" OR (lcKategorie == "B" AND This.cProfil # "EN16931")
	ENDPROC

	PROTECTED PROCEDURE IstText
		LPARAMETERS tuWert
		IF VARTYPE(tuWert) # "C" AND VARTYPE(tuWert) # "M"
			RETURN .F.
		ENDIF
		RETURN NOT EMPTY(CHRTRAN(tuWert, " " + CHR(9) + CHR(10) + CHR(13), ""))
	ENDPROC

	PROTECTED PROCEDURE IstZahl
		LPARAMETERS tuWert
		RETURN INLIST(VARTYPE(tuWert), "N", "Y")
	ENDPROC

	PROTECTED PROCEDURE KategorieRegel
		IF VARTYPE(This.cProfil) = "C" AND This.cProfil == "EXTENDED"
			RETURN "BR-FXEXT-CO-04"
		ENDIF
		RETURN "BR-CO-04"
	ENDPROC

	PROTECTED PROCEDURE KategorieVorhanden
		LPARAMETERS tcKategorie
		LOCAL lnK
		FOR lnK = 1 TO This.nPositionen
		    * Gliederungszeilen werden an BT-151 geprueft und bilden keine Steuerbasis.
		    IF VARTYPE(This.aPositionen[lnK]) = "O" AND This.IstDetailposition(This.aPositionen[lnK]) AND ;
		        This.CodeNormal(This.aPositionen[lnK].cSteuerkategorie) == tcKategorie
		        RETURN .T.
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO This.nBelegaenderungen
		    IF VARTYPE(This.aBelegaenderungen[lnK]) = "O" AND This.CodeNormal(This.aBelegaenderungen[lnK].cSteuerkategorie) == tcKategorie
		        RETURN .T.
		    ENDIF
		ENDFOR
		IF This.cProfil == "EXTENDED"
		    FOR lnK = 1 TO This.nLogistikentgelte
		        IF VARTYPE(This.aLogistikentgelte[lnK]) = "O" AND This.CodeNormal(This.aLogistikentgelte[lnK].cSteuerkategorie) == tcKategorie
		            RETURN .T.
		        ENDIF
		    ENDFOR
		ENDIF
		RETURN .F.
	ENDPROC

	PROTECTED PROCEDURE KontaktText
		LPARAMETERS tuWert, tcBT, tlExtended
		* Bestehende Aufrufer verwenden NULL auch fuer ungesetzte Kontakttexte.
		IF ISNULL(tuWert)
			RETURN .T.
		ENDIF
		RETURN This.KopfText(tuWert, tcBT, tlExtended)
	ENDPROC

	PROTECTED PROCEDURE KontaktVorhanden
		LPARAMETERS toK, tcTyp
		RETURN This.IstText(toK.cKontakt) OR This.IstText(toK.cAbteilung) OR ;
		    This.IstText(toK.cTelefon) OR This.IstText(toK.cFax) OR This.IstText(toK.cEmail) OR This.IstText(tcTyp)
	ENDPROC

	PROTECTED PROCEDURE KopfIndikator
		LPARAMETERS tuWert, tcBT
		IF ISNULL(tuWert)
			RETURN .T.
		ENDIF
		= This.ProfilFeld(.T., tcBT)
		RETURN This.Pflicht(VARTYPE(tuWert) = "L", "", tcBT, "FX-TECH-03")
	ENDPROC

	PROTECTED PROCEDURE KopfRolle
		LPARAMETERS toP, tcBT, tlExtended
		IF NOT This.ParteiKind(toP, tcBT)
			RETURN .F.
		ENDIF
		IF NOT toP.Vorhanden()
			RETURN .F.
		ENDIF
		= This.ProfilFeld(tlExtended, tcBT)
		IF NOT EMPTY(toP.cAddFehler)
			= This.Meldung("FEHLER", "", tcBT, "FX-TECH-03", "Abgewiesener Partei-Add-Aufruf: {1}", toP.cAddFehler)
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE KopfText
		LPARAMETERS tuWert, tcBT, tlExtended
		LOCAL llText
		llText = INLIST(VARTYPE(tuWert), "C", "M")
		* Gueltige Texte brauchen keinen weiteren Pflichtaufruf.
		IF tlExtended AND This.cProfil # "EXTENDED"
			= This.ProfilFeld(NOT llText OR This.IstText(tuWert), tcBT)
		ENDIF
		IF llText
			RETURN .T.
		ENDIF
		RETURN This.Pflicht(.F., "", tcBT, "FX-TECH-03")
	ENDPROC

	PROCEDURE lTechnischerFehler_Access
		IF VARTYPE(This.oMeldungen) = "O"
			RETURN This.lTechnischerFehler OR This.oMeldungen.lTechnischerFehler
		ENDIF
		RETURN This.lTechnischerFehler
	ENDPROC

	PROCEDURE MeldezielSetzen
		LPARAMETERS toKind
		IF NOT This.MeldungsCursorOeffnen()
			RETURN .F.
		ENDIF
		* Nur skalare Werte weitergeben, das Kind speichert keinen Container.
		toKind.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, ;
			This.oMeldungen.cCursorDatei)
		RETURN NOT This.lTechnischerFehler
	ENDPROC

	PROCEDURE Meldung
		LPARAMETERS tcStufe, tcPosition, tcBT, tcRegel, tcVorlage, tcWert1, tcWert2, tcWert3, tcWert4
		LOCAL lcText
		lcText = This.MeldungsText(tcVorlage, tcWert1, tcWert2, tcWert3, tcWert4)
		IF NOT This.MeldungsCursorOeffnen()
			RETURN .F.
		ENDIF
		RETURN This.oMeldungen.Eintragen(tcStufe, tcPosition, tcBT, tcRegel, lcText)
	ENDPROC

	PROCEDURE MeldungsCursorOeffnen
		LOCAL lcAlias, lnArea, lnSession
		IF NOT EMPTY(This.cEigenerCursor)
			IF This.oMeldungen.CursorVorhanden()
				RETURN .T.
			ENDIF
			This.cLastError = "Der eigene Meldungscursor ist nicht mehr offen."
			RETURN .F.
		ENDIF
		lcAlias = This.cMeldungsCursor
		This.lCursorAnlage = .T.
		IF USED(lcAlias)
			This.cLastError = "Meldungscursor ist bereits belegt."
			This.lCursorAnlage = .F.
			RETURN .F.
		ENDIF
		lnSession = SET("DATASESSION")
		lnArea = SELECT(0)
		CREATE CURSOR (lcAlias) (Stufe C(7), Position C(40), BT C(20), Regel C(40), Text M)
		IF NOT USED(lcAlias)
			SELECT (lnArea)
			This.lCursorAnlage = .F.
			RETURN .F.
		ENDIF
		This.lCursorAnlage = .F.
		This.cEigenerCursor = lcAlias
		This.oMeldungen.ZielSetzen(lcAlias, lnSession, This.oMeldungen.CursorDatei(lcAlias))
		SELECT (lnArea)
		= This.DatenMeldezielSetzen()
		RETURN .T.
	ENDPROC

	PROCEDURE MeldungsText
		LPARAMETERS tcVorlage, tcWert1, tcWert2, tcWert3, tcWert4
		RETURN This.oMeldungen.MeldungsText(tcVorlage, tcWert1, tcWert2, tcWert3, tcWert4)
	ENDPROC

