		*p: nkontaktanzahl
		*p: nkontakte		&& BG-6 / BG-9 Anzahl zusaetzlicher Kontakte, nur lesbar
		*p: oregisteradresse		&& BG-X-14 / BG-X-15 Eigene Registeranschrift, nur EXTENDED
		*a: aglobalekennungen[1,0]
		*a: akennungen[1,0]
		*a: akontakte[1,0]
	*</DefinedPropArrayMethod>

	PROTECTED caddfehlertext,nglobalanzahl,nkennunganzahl,nkontaktanzahl
	*<PropValue>
		cabteilung = 
		caddfehler = 
		caddfehlertext = 
		cbeschreibung = 
		celektronischeadresse = 
		celektronischeadresseschema = 
		cemail = 
		cfax = 
		chandelsname = 
		ckontakt = 
		ckontakttyp = 
		cland = 
		cname = 
		cort = 
		cplz = 
		cregion = 
		cregisternummer = 
		cregisterschema = 
		crolle = 
		csteuernummer = 
		cstrasse = 
		cstrasse2 = 
		cstrasse3 = 
		ctelefon = 
		custid = 
		Name = "fxPartei"
		nglobalanzahl = 0
		nglobalekennungen = 0
		nkennunganzahl = 0
		nkennungen = 0
		nkontaktanzahl = 0
		nkontakte = 0
		oregisteradresse = .NULL.
	*</PropValue>
	
	PROTECTED PROCEDURE AddFehler
		LPARAMETERS tcText
		tcText = This.MeldungsText(tcText)
		This.cAddFehlerText = This.cAddFehlerText + tcText + CHR(13) + CHR(10)
		= This.Eintragen("FEHLER", "", "", "FX-TECH-03", tcText)
		RETURN .F.
	ENDPROC

	PROCEDURE AddGlobaleKennung
		LPARAMETERS tcWert, tcSchema
		LOCAL loK
		IF NOT This.TextParameter(tcWert) OR NOT This.TextParameter(tcSchema)
		    RETURN This.AddFehler("Globale Parteikennung und Schema m{ue}ssen Text sein.")
		ENDIF
		loK = CREATEOBJECT("fxKennung")
		loK.cWert = tcWert
		loK.cSchema = tcSchema
		This.nGlobalAnzahl = This.nGlobalAnzahl + 1
		DIMENSION This.aGlobaleKennungen[This.nGlobalAnzahl]
		This.aGlobaleKennungen[This.nGlobalAnzahl] = loK
		= loK.ZielSetzen(This.cEigenerCursor, This.nMeldungsSession, This.cCursorDatei)
		RETURN loK
	ENDPROC

	PROCEDURE AddKennung
		LPARAMETERS tcWert
		LOCAL loK
		IF NOT This.TextParameter(tcWert)
		    RETURN This.AddFehler("Die lokale Parteikennung muss Text sein.")
		ENDIF
		loK = CREATEOBJECT("fxKennung")
		loK.cWert = tcWert
		This.nKennungAnzahl = This.nKennungAnzahl + 1
		DIMENSION This.aKennungen[This.nKennungAnzahl]
		This.aKennungen[This.nKennungAnzahl] = loK
		= loK.ZielSetzen(This.cEigenerCursor, This.nMeldungsSession, This.cCursorDatei)
		RETURN loK
	ENDPROC

	PROCEDURE AddKontakt
		LPARAMETERS tcName, tcTelefon, tcEmail
		LOCAL loK
		IF NOT This.TextParameter(tcName) OR NOT This.TextParameter(tcTelefon) OR NOT This.TextParameter(tcEmail)
		    RETURN This.AddFehler("Name, Telefon und E-Mail des Kontakts m{ue}ssen Text sein.")
		ENDIF
		loK = CREATEOBJECT("fxKontakt")
		loK.cKontakt = tcName
		loK.cTelefon = tcTelefon
		loK.cEmail = tcEmail
		This.nKontaktAnzahl = This.nKontaktAnzahl + 1
		DIMENSION This.aKontakte[This.nKontaktAnzahl]
		This.aKontakte[This.nKontaktAnzahl] = loK
		= loK.ZielSetzen(This.cEigenerCursor, This.nMeldungsSession, This.cCursorDatei)
		RETURN loK
	ENDPROC

	PROCEDURE cAddFehler_Access
		RETURN This.cAddFehlerText
	ENDPROC

	PROCEDURE cAddFehler_Assign
		LPARAMETERS tuWert
		* Nur lesbar; erfolgreiche Add-Aufrufe bestimmen den Zustand.
	ENDPROC

	PROCEDURE Destroy
		This.oRegisterAdresse = .NULL.
		DIMENSION This.aKennungen[1]
		DIMENSION This.aGlobaleKennungen[1]
		DIMENSION This.aKontakte[1]
		This.aKennungen[1] = .NULL.
		This.aGlobaleKennungen[1] = .NULL.
		This.aKontakte[1] = .NULL.
	ENDPROC

	PROCEDURE Init
		This.oRegisterAdresse = CREATEOBJECT("fxAdresse")
		This.aKennungen[1] = .NULL.
		This.aGlobaleKennungen[1] = .NULL.
		This.aKontakte[1] = .NULL.
	ENDPROC

	PROCEDURE nGlobaleKennungen_Access
		RETURN This.nGlobalAnzahl
	ENDPROC

	PROCEDURE nGlobaleKennungen_Assign
		LPARAMETERS tuWert
		* Nur lesbar; erfolgreiche Add-Aufrufe bestimmen den Zustand.
	ENDPROC

	PROCEDURE nKennungen_Access
		RETURN This.nKennungAnzahl
	ENDPROC

	PROCEDURE nKennungen_Assign
		LPARAMETERS tuWert
		* Nur lesbar; erfolgreiche Add-Aufrufe bestimmen den Zustand.
	ENDPROC

	PROCEDURE nKontakte_Access
		RETURN This.nKontaktAnzahl
	ENDPROC

	PROCEDURE nKontakte_Assign
		LPARAMETERS tuWert
		* Nur lesbar; erfolgreiche Add-Aufrufe bestimmen den Zustand.
	ENDPROC

	PROTECTED PROCEDURE TextParameter
		LPARAMETERS tuWert
		RETURN INLIST(VARTYPE(tuWert), "C", "M")
	ENDPROC

	PROCEDURE Vorhanden
		LOCAL lnK, loK
		IF This.lTechnischerFehler OR NOT EMPTY(This.cAddFehler) OR This.nKennungAnzahl > 0 OR This.nGlobalAnzahl > 0
			RETURN .T.
		ENDIF
		* Native Pruefungen vermeiden 30 Methodenaufrufe je leerer Partei.
		* NULL bleibt ungesetzt; auch leere Werte falschen Typs sind vorhanden.
		IF (NOT INLIST(VARTYPE(This.cName), "C", "M", "X") OR NOT EMPTY(NVL(This.cName, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cRolle), "C", "M", "X") OR NOT EMPTY(NVL(This.cRolle, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cRegisternummer), "C", "M", "X") OR NOT EMPTY(NVL(This.cRegisternummer, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cRegisterSchema), "C", "M", "X") OR NOT EMPTY(NVL(This.cRegisterSchema, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cHandelsname), "C", "M", "X") OR NOT EMPTY(NVL(This.cHandelsname, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cElektronischeAdresse), "C", "M", "X") OR NOT EMPTY(NVL(This.cElektronischeAdresse, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cElektronischeAdresseSchema), "C", "M", "X") OR NOT EMPTY(NVL(This.cElektronischeAdresseSchema, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cUstId), "C", "M", "X") OR NOT EMPTY(NVL(This.cUstId, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cPlz), "C", "M", "X") OR NOT EMPTY(NVL(This.cPlz, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cStrasse), "C", "M", "X") OR NOT EMPTY(NVL(This.cStrasse, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cStrasse2), "C", "M", "X") OR NOT EMPTY(NVL(This.cStrasse2, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cStrasse3), "C", "M", "X") OR NOT EMPTY(NVL(This.cStrasse3, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cOrt), "C", "M", "X") OR NOT EMPTY(NVL(This.cOrt, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cLand), "C", "M", "X") OR NOT EMPTY(NVL(This.cLand, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cRegion), "C", "M", "X") OR NOT EMPTY(NVL(This.cRegion, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cBeschreibung), "C", "M", "X") OR NOT EMPTY(NVL(This.cBeschreibung, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cSteuernummer), "C", "M", "X") OR NOT EMPTY(NVL(This.cSteuernummer, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cKontakt), "C", "M", "X") OR NOT EMPTY(NVL(This.cKontakt, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cAbteilung), "C", "M", "X") OR NOT EMPTY(NVL(This.cAbteilung, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cTelefon), "C", "M", "X") OR NOT EMPTY(NVL(This.cTelefon, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cEmail), "C", "M", "X") OR NOT EMPTY(NVL(This.cEmail, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cFax), "C", "M", "X") OR NOT EMPTY(NVL(This.cFax, ""))) OR ;
			(NOT INLIST(VARTYPE(This.cKontaktTyp), "C", "M", "X") OR NOT EMPTY(NVL(This.cKontaktTyp, "")))
			RETURN .T.
		ENDIF
		IF VARTYPE(This.oRegisterAdresse) # "O"
			RETURN .T.
		ENDIF
		IF This.oRegisterAdresse.lTechnischerFehler OR ;
			(NOT INLIST(VARTYPE(This.oRegisterAdresse.cPlz), "C", "M", "X") OR NOT EMPTY(NVL(This.oRegisterAdresse.cPlz, ""))) OR ;
			(NOT INLIST(VARTYPE(This.oRegisterAdresse.cStrasse), "C", "M", "X") OR NOT EMPTY(NVL(This.oRegisterAdresse.cStrasse, ""))) OR ;
			(NOT INLIST(VARTYPE(This.oRegisterAdresse.cStrasse2), "C", "M", "X") OR NOT EMPTY(NVL(This.oRegisterAdresse.cStrasse2, ""))) OR ;
			(NOT INLIST(VARTYPE(This.oRegisterAdresse.cStrasse3), "C", "M", "X") OR NOT EMPTY(NVL(This.oRegisterAdresse.cStrasse3, ""))) OR ;
			(NOT INLIST(VARTYPE(This.oRegisterAdresse.cOrt), "C", "M", "X") OR NOT EMPTY(NVL(This.oRegisterAdresse.cOrt, ""))) OR ;
			(NOT INLIST(VARTYPE(This.oRegisterAdresse.cLand), "C", "M", "X") OR NOT EMPTY(NVL(This.oRegisterAdresse.cLand, ""))) OR ;
			(NOT INLIST(VARTYPE(This.oRegisterAdresse.cRegion), "C", "M", "X") OR NOT EMPTY(NVL(This.oRegisterAdresse.cRegion, "")))
			RETURN .T.
		ENDIF
		FOR lnK = 1 TO This.nKontaktAnzahl
			loK = This.aKontakte[lnK]
			IF VARTYPE(loK) # "O"
				RETURN .T.
			ENDIF
			IF loK.lTechnischerFehler OR ;
				(NOT INLIST(VARTYPE(loK.cKontakt), "C", "M", "X") OR NOT EMPTY(NVL(loK.cKontakt, ""))) OR ;
				(NOT INLIST(VARTYPE(loK.cAbteilung), "C", "M", "X") OR NOT EMPTY(NVL(loK.cAbteilung, ""))) OR ;
				(NOT INLIST(VARTYPE(loK.cTyp), "C", "M", "X") OR NOT EMPTY(NVL(loK.cTyp, ""))) OR ;
				(NOT INLIST(VARTYPE(loK.cTelefon), "C", "M", "X") OR NOT EMPTY(NVL(loK.cTelefon, ""))) OR ;
				(NOT INLIST(VARTYPE(loK.cFax), "C", "M", "X") OR NOT EMPTY(NVL(loK.cFax, ""))) OR ;
				(NOT INLIST(VARTYPE(loK.cEmail), "C", "M", "X") OR NOT EMPTY(NVL(loK.cEmail, "")))
				RETURN .T.
			ENDIF
		ENDFOR
		RETURN .F.
	ENDPROC

	PROCEDURE WertGesetzt
		LPARAMETERS tuWert
		IF ISNULL(tuWert)
			RETURN .F.
		ENDIF
		IF INLIST(VARTYPE(tuWert), "C", "M")
			RETURN NOT EMPTY(CHRTRAN(tuWert, " " + CHR(9) + CHR(10) + CHR(13), ""))
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE ZielSetzen
		LPARAMETERS tcAlias, tnSession, tcDatei
		LOCAL lnKind
		= DODEFAULT(tcAlias, tnSession, tcDatei)
		IF VARTYPE(This.oRegisterAdresse) = "O"
		    = This.oRegisterAdresse.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		FOR lnKind = 1 TO This.nKennungAnzahl
		    IF VARTYPE(This.aKennungen[lnKind]) = "O"
		        = This.aKennungen[lnKind].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnKind = 1 TO This.nGlobalAnzahl
		    IF VARTYPE(This.aGlobaleKennungen[lnKind]) = "O"
		        = This.aGlobaleKennungen[lnKind].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
		FOR lnKind = 1 TO This.nKontaktAnzahl
		    IF VARTYPE(This.aKontakte[lnKind]) = "O"
		        = This.aKontakte[lnKind].ZielSetzen(tcAlias, tnSession, tcDatei)
		    ENDIF
		ENDFOR
	ENDPROC

ENDDEFINE

