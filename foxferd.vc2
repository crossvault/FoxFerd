	PROTECTED PROCEDURE NeueReferenz
		LPARAMETERS tcKlasse, tcNummer, tcBT
		LOCAL loReferenz
		IF NOT INLIST(VARTYPE(tcNummer), "C", "M")
			RETURN This.AddFehler("", tcBT, "FX-TECH-03", "{1}: Die Kennung muss Text sein.", tcBT)
		ENDIF
		loReferenz = CREATEOBJECT(tcKlasse)
		IF VARTYPE(loReferenz) # "O"
			RETURN .F.
		ENDIF
		loReferenz.cNummer = tcNummer
		IF NOT EMPTY(This.cEigenerCursor)
			IF NOT This.MeldungsCursorOeffnen()
				RETURN This.AddFehler("", tcBT, "FX-TECH-03", "{1}: Das Meldeziel des Kopfbezugs fehlt.", tcBT)
			ENDIF
			= loReferenz.ZielSetzen(This.cEigenerCursor, This.oMeldungen.nMeldungsSession, This.oMeldungen.cCursorDatei)
		ENDIF
		RETURN loReferenz
	ENDPROC

	PROTECTED PROCEDURE NeuerWriter
		RETURN CREATEOBJECT("fxWriterCii")
	ENDPROC

