		= This.RollenAttribut(toP.cElektronischeAdresse, toP.cElektronischeAdresseSchema, "BT-X-241")
		IF This.IstText(toP.cRegisterSchema) AND NOT This.IstText(toP.cRegisternummer)
			= This.Pflicht(.F., "", "BT-X-227", "FX-TECH-03")
		ENDIF
		= This.RollenPostanschrift(toP, toCodes, .T., ;
			"BT-X-234", "BT-X-235", "BT-X-236", "BT-X-237", ;
			"BT-X-238", "BT-X-239", "BT-X-240")
		= This.RollenRegisteranschrift(toP.oRegisterAdresse, toCodes, ;
			"BT-X-461", "BT-X-462", "BT-X-463", "BT-X-464", ;
			"BT-X-465", "BT-X-466", "BT-X-467", "FX-SCH-A-000878")
		= This.RollenKontakte(toP, toCodes, "BT-X-229", "BT-X-230", "BT-X-325", ;
			"BT-X-231", "BT-X-232", "BT-X-233")
		= This.ValidateUstPraefix(toCodes, toP.cUstId, "BT-X-242")
		= This.KopfText(toP.cSteuernummer, "BT-X-242", .T.)
		IF This.IstText(toP.cSteuernummer)
			= This.Pflicht(.F., "", "BT-X-242-0", IIF(This.cProfil == "EXTENDED", "BR-FXEXT-03", "FX-PROFIL-01"))
		ENDIF
		= This.Pflicht(This.cProfil # "EXTENDED" OR This.IstText(toP.cName), "", "BT-X-226", "FX-SCH-A-000865")
		IF This.cProfil == "EXTENDED" AND This.AdresseVorhanden(toP)
			= This.Pflicht(This.IstText(toP.cLand), "", "BT-X-239", "FX-SCH-A-000874")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE ValidateRolleInvoicer
		LPARAMETERS toP, toCodes
		IF NOT This.KopfRolle(toP, "BT-X-207", .T.)
			RETURN
		ENDIF
		= This.RollenText(toCodes, toP.cName, "BT-X-207", .T., "")
		= This.RollenText(toCodes, toP.cRolle, "BT-X-553", .T., "")
		= This.RollenText(toCodes, toP.cRegisternummer, "BT-X-208", .T., "")
		= This.RollenText(toCodes, toP.cRegisterSchema, "BT-X-208-0", .T., "BR-CL-11")
		= This.RollenText(toCodes, toP.cHandelsname, "BT-X-209", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresse, "BT-X-222", .T., "")
		= This.RollenText(toCodes, toP.cElektronischeAdresseSchema, "BT-X-222-0", .T., "BR-CL-25")
		= This.RollenText(toCodes, toP.cUstId, "BT-X-223", .T., "")
		IF NOT ISNULL(toP.cBeschreibung) AND (NOT INLIST(VARTYPE(toP.cBeschreibung), "C", "M") OR This.IstText(toP.cBeschreibung))
			= This.Pflicht(.F., "", "BT-X-207", "FX-PROFIL-01")
		ENDIF
		= This.RollenKennungen(toP, toCodes, "BT-X-205", "BT-X-206", ;
			"BT-X-206-0", "FX-SCH-A-000886", .T.)
		= This.RollenAttribut(toP.cElektronischeAdresse, toP.cElektronischeAdresseSchema, "BT-X-222")
		IF This.IstText(toP.cRegisterSchema) AND NOT This.IstText(toP.cRegisternummer)
			= This.Pflicht(.F., "", "BT-X-208", "FX-TECH-03")
		ENDIF
		= This.RollenPostanschrift(toP, toCodes, .T., ;
			"BT-X-215", "BT-X-216", "BT-X-217", "BT-X-218", ;
			"BT-X-219", "BT-X-220", "BT-X-221")
		= This.RollenRegisteranschrift(toP.oRegisterAdresse, toCodes, ;
			"BT-X-454", "BT-X-455", "BT-X-456", "BT-X-457", ;
			"BT-X-458", "BT-X-459", "BT-X-460", "FX-SCH-A-000900")
		= This.RollenKontakte(toP, toCodes, "BT-X-210", "BT-X-211", "BT-X-324", ;
			"BT-X-212", "BT-X-213", "BT-X-214")
		= This.ValidateUstPraefix(toCodes, toP.cUstId, "BT-X-223")
		= This.KopfText(toP.cSteuernummer, "BT-X-223", .T.)
		IF This.IstText(toP.cSteuernummer)
			= This.Pflicht(.F., "", "BT-X-223-0", IIF(This.cProfil == "EXTENDED", "BR-FXEXT-03", "FX-PROFIL-01"))
		ENDIF
		= This.Pflicht(This.cProfil # "EXTENDED" OR This.IstText(toP.cName), "", "BT-X-207", "FX-SCH-A-000887")
