DEFINE CLASS fxpreissteuer AS fxbasis OF "foxferd.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: hatinhalt
		*p: cbefreiungscode		&& BT-X-41 Befreiungscode
		*p: cbefreiungsgrund		&& BT-X-39 Befreiungsgrund
		*p: ckategorie		&& BT-X-40 Steuerkategorie
		*p: ctyp		&& BT-X-38 Steuerart
		*p: nbetrag		&& BT-X-37 Im Nettopreis enthaltener Steuerbetrag
		*p: nsatz		&& BT-X-42 Steuersatz
	*</DefinedPropArrayMethod>

	*<PropValue>
		cbefreiungscode = 
		cbefreiungsgrund = 
		ckategorie = 
		ctyp = 
		Name = "fxpreissteuer"
		nbetrag = .NULL.
		nsatz = .NULL.
	*</PropValue>
	
	PROCEDURE HatInhalt
		RETURN NOT ISNULL(This.nBetrag) OR NOT ISNULL(This.nSatz) OR ;
			VARTYPE(This.cTyp) # "C" OR NOT EMPTY(This.cTyp) OR ;
			VARTYPE(This.cKategorie) # "C" OR NOT EMPTY(This.cKategorie) OR ;
			VARTYPE(This.cBefreiungsgrund) # "C" OR NOT EMPTY(This.cBefreiungsgrund) OR ;
			VARTYPE(This.cBefreiungscode) # "C" OR NOT EMPTY(This.cBefreiungscode)
	ENDPROC

ENDDEFINE

