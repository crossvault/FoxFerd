		*m: schreibeposition
		*m: schreibepositionsabrechnung
		*m: schreibepositionsbezuege
		*m: schreibepositionsdokument
		*m: schreibepositionslieferung
		*m: schreibepositionsverkaeufer
		*m: schreibepreisaenderung
		*m: schreibepreise
		*m: schreibepreissteuer
		*m: schreibeprodukt
		*m: schreibeproduktreferenz
		*m: schreibereferenz
		*m: schreibeskonto
		*m: schreibesteuerkennung
		*m: schreibesteuerkurs
		*m: schreibesummen
		*m: schreibetransaktion
		*m: schreibeverzug
		*m: schreibevorausdatum
		*m: schreibevorauszahlungen
		*m: schreibezahlung
		*m: schreibezahlungsbedingungen
		*m: speichern
		*m: tempdatei
		*m: temploeschen
		*m: textvorhanden
		*m: zahl
		*m: zielersetzen
		*m: zielpfad
		*p: odom
	*</DefinedPropArrayMethod>

	PROTECTED odom
	*<PropValue>
		Name = "fxWriterCii"
		odom = .NULL.
	*</PropValue>
	
	PROTECTED PROCEDURE AddDatum
		LPARAMETERS toParent, tcName, tdWert
		LOCAL loDatum, loWert
		IF VARTYPE(tdWert) # "D" OR EMPTY(tdWert)
			RETURN .NULL.
		ENDIF
		loDatum = This.AddEl(toParent, tcName)
		loWert = This.AddEl(loDatum, "udt:DateTimeString", This.Datum(tdWert))
		= This.Attribut(loWert, "format", "102")
		RETURN loDatum
	ENDPROC

	PROCEDURE AddEl
		LPARAMETERS toParent, tcName, tcWert
		LOCAL loEl, lcNamespace
		loEl = .NULL.
		IF This.lTechnischerFehler
			RETURN .NULL.
		ENDIF
		lcNamespace = This.Namensraum(tcName)
		IF This.lTechnischerFehler
			RETURN .NULL.
		ENDIF
		loEl = This.oDom.createNode(1, tcName, lcNamespace)
		IF This.lTechnischerFehler OR VARTYPE(loEl) # "O"
			RETURN .NULL.
		ENDIF
		IF PCOUNT() >= 3
			loEl.text = tcWert
			IF This.lTechnischerFehler
				RETURN .NULL.
			ENDIF
		ENDIF
		toParent.appendChild(loEl)
		IF This.lTechnischerFehler
			RETURN .NULL.
		ENDIF
		RETURN loEl
	ENDPROC

	PROTECTED PROCEDURE AddIndikator
		LPARAMETERS toParent, tcName, tuWert
		LOCAL loIndikator
		IF VARTYPE(tuWert) # "L"
			RETURN .NULL.
		ENDIF
		loIndikator = This.AddEl(toParent, tcName)
		RETURN This.AddEl(loIndikator, "udt:Indicator", IIF(tuWert, "true", "false"))
	ENDPROC

	PROTECTED PROCEDURE AddText
		LPARAMETERS toParent, tcName, tuWert
		IF NOT This.TextVorhanden(tuWert)
			RETURN .NULL.
		ENDIF
		RETURN This.AddEl(toParent, tcName, tuWert)
	ENDPROC

	PROTECTED PROCEDURE AddZahl
		LPARAMETERS toParent, tcName, tuWert, tnStellen
		IF NOT INLIST(VARTYPE(tuWert), "N", "Y")
			RETURN .NULL.
		ENDIF
		RETURN This.AddEl(toParent, tcName, This.Zahl(tuWert, tnStellen))
	ENDPROC

	PROCEDURE Attribut
		LPARAMETERS toElement, tcName, tcWert
		LOCAL loAttribut, lcNamespace
		loAttribut = .NULL.
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		lcNamespace = This.Namensraum(tcName)
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		loAttribut = This.oDom.createNode(2, tcName, lcNamespace)
		IF This.lTechnischerFehler OR VARTYPE(loAttribut) # "O"
			RETURN .F.
		ENDIF
		loAttribut.value = tcWert
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		toElement.setAttributeNode(loAttribut)
		RETURN NOT This.lTechnischerFehler
	ENDPROC

	PROCEDURE Build
		LPARAMETERS toRechnung
		LOCAL loPi, loRoot, lnPosition, loPosition
		This.oDom = This.NeuesDom()
		IF This.lTechnischerFehler OR VARTYPE(This.oDom) # "O"
			RETURN .NULL.
		ENDIF
		This.oDom.async = .F.
		IF This.lTechnischerFehler
			RETURN .NULL.
		ENDIF
		This.oDom.validateOnParse = .F.
		IF This.lTechnischerFehler
			RETURN .NULL.
		ENDIF
		This.oDom.resolveExternals = .F.
		IF This.lTechnischerFehler
			RETURN .NULL.
		ENDIF
		loPi = This.oDom.createProcessingInstruction("xml", 'version="1.0" encoding="UTF-8"')
		IF This.lTechnischerFehler OR VARTYPE(loPi) # "O"
			RETURN .NULL.
		ENDIF
		This.oDom.appendChild(loPi)
		IF This.lTechnischerFehler
			RETURN .NULL.
		ENDIF
		loRoot = This.AddEl(This.oDom, "rsm:CrossIndustryInvoice")
		IF This.lTechnischerFehler OR VARTYPE(loRoot) # "O"
			RETURN .NULL.
		ENDIF
		* Ohne Rechnung bleibt dies der interne DOM-Einstieg fuer technische Proben.
		IF PCOUNT() > 0
			* Auch der interne Writer darf BT110 nicht durch BT111 verdoppeln.
			IF NOT ISNULL(toRechnung.nSteuerInSteuerwaehrung) AND ;
			    This.TextVorhanden(toRechnung.cSteuerwaehrung) AND ;
			    This.CodeNormal(toRechnung.cSteuerwaehrung) == This.CodeNormal(toRechnung.cWaehrung)
			    = This.Eintragen("FEHLER", "", "BT-111", "FX-TECH-02", ;
			        This.MeldungsText("BT-111: Der Writer kann keine zweite Steuersumme in der Rechnungsw{ae}hrung ausgeben."))
			    RETURN .NULL.
			ENDIF
			IF toRechnung.cProfil == "XRECHNUNG-CII"
				FOR lnPosition = 1 TO toRechnung.nPositionen
					loPosition = toRechnung.aPositionen[lnPosition]
					IF VARTYPE(loPosition) = "O" AND loPosition.nPreisaenderungen > 1
						= This.Fehler("FX-TECH-02", "In XRechnung ist auf Preisebene h{oe}chstens ein Nachlass zul{ae}ssig.")
						RETURN .NULL.
					ENDIF
				ENDFOR
			ENDIF
			IF NOT INLIST(VARTYPE(toRechnung.nZahlbetrag), "N", "Y")
				= This.Fehler("FX-TECH-02", "BT-115 ist noch nicht berechnet. Diese Steuerkategorie wird noch nicht unterst{ue}tzt.")
				RETURN .NULL.
			ENDIF
			* XRechnung-R008 nimmt die schema-verlangte leere Liefergruppe aus.
			* FeRD-R008 hat diese Ausnahme nicht; BG-14 fuellt nur die Abrechnung.
			IF toRechnung.cProfil # "XRECHNUNG-CII" AND NOT This.LieferdatenVorhanden(toRechnung)
				= This.Eintragen("FEHLER", "", "BT-72", "FX-TECH-02", ;
					This.MeldungsText("Die Liefergruppe braucht BT-72, eine Lieferpartei, einen Lieferbezug oder einen Transport; BG-14 allein gen{ue}gt hier nicht."))
				RETURN .NULL.
			ENDIF
			= This.SchreibeKopf(loRoot, toRechnung)
			= This.SchreibeTransaktion(loRoot, toRechnung)
		ENDIF
		IF This.lTechnischerFehler
			RETURN .NULL.
		ENDIF
		RETURN This.oDom
	ENDPROC

	PROTECTED PROCEDURE CodeNormal
		LPARAMETERS tuWert
		IF VARTYPE(tuWert) # "C" AND VARTYPE(tuWert) # "M"
			RETURN ""
		ENDIF
		RETURN ALLTRIM(CHRTRAN(tuWert, CHR(9) + CHR(10) + CHR(13), "   "))
	ENDPROC

	PROCEDURE Datum
		LPARAMETERS tdWert
		RETURN DTOS(tdWert)
	ENDPROC

	PROCEDURE Destroy
		This.oDom = .NULL.
	ENDPROC

	PROTECTED PROCEDURE DomSpeichern
		LPARAMETERS toDom, tcTemp
		toDom.save(tcTemp)
		RETURN NOT This.lTechnischerFehler
	ENDPROC

	PROTECTED PROCEDURE Fehler
		LPARAMETERS tcRegel, tcVorlage, tcWert1, tcWert2
		LOCAL lcText
		lcText = This.MeldungsText(tcVorlage, tcWert1, tcWert2)
		= This.Eintragen("FEHLER", "", "", tcRegel, lcText)
		RETURN .F.
	ENDPROC

	PROTECTED PROCEDURE GliederungsgruppeLeeren
		LPARAMETERS toGruppe, toP
		LOCAL lnKinder, loEltern
		IF This.lTechnischerFehler OR (EMPTY(This.CodeNormal(toP.cUntertyp)) OR This.CodeNormal(toP.cUntertyp) == "DETAIL")
			RETURN
		ENDIF
		lnKinder = toGruppe.childNodes.length
		IF This.lTechnischerFehler OR lnKinder > 0
			RETURN
		ENDIF
		loEltern = toGruppe.parentNode
		IF This.lTechnischerFehler OR VARTYPE(loEltern) # "O"
			RETURN
		ENDIF
		loEltern.removeChild(toGruppe)
		IF This.lTechnischerFehler
			RETURN
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE LieferdatenVorhanden
		LPARAMETERS toR
		RETURN (VARTYPE(toR.dLieferdatum) = "D" AND NOT EMPTY(toR.dLieferdatum)) OR ;
			toR.oLieferempfaenger.Vorhanden() OR toR.oEndlieferempfaenger.Vorhanden() OR toR.oVersender.Vorhanden() OR ;
			NOT ISNULL(toR.oVersandavis) OR NOT ISNULL(toR.oEmpfangsavis) OR NOT ISNULL(toR.oLieferschein) OR toR.nTransporte > 0
	ENDPROC

	PROTECTED PROCEDURE Namensraum
		LPARAMETERS tcName
		LOCAL lcPrefix
		IF NOT ":" $ tcName
			RETURN ""
		ENDIF
		lcPrefix = LEFT(tcName, AT(":", tcName) - 1)
		DO CASE
		CASE lcPrefix == "rsm"
			RETURN "urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100"
		CASE lcPrefix == "ram"
			RETURN "urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100"
		CASE lcPrefix == "udt"
			RETURN "urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100"
		CASE lcPrefix == "qdt"
			RETURN "urn:un:unece:uncefact:data:standard:QualifiedDataType:100"
		CASE lcPrefix == "xml"
			RETURN "http://www.w3.org/XML/1998/namespace"
		ENDCASE
		= This.Fehler("FX-TECH-02", "Unbekanntes XML-Pr{ae}fix: {1}", lcPrefix)
		This.lTechnischerFehler = .T.
		RETURN ""
	ENDPROC

	PROTECTED PROCEDURE NeuesDom
		LOCAL loD
		loD = .NULL.
		loD = CREATEOBJECT("MSXML2.DOMDocument.6.0")
		RETURN loD
	ENDPROC

	PROTECTED PROCEDURE ProfilKennung
		LPARAMETERS tcProfil
		DO CASE
		CASE tcProfil == "EN16931"
			RETURN "urn:cen.eu:en16931:2017"
		CASE tcProfil == "XRECHNUNG-CII"
			RETURN "urn:cen.eu:en16931:2017#compliant#urn:xeinkauf.de:kosit:xrechnung_3.0"
		CASE tcProfil == "EXTENDED"
			RETURN "urn:cen.eu:en16931:2017#conformant#urn:factur-x.eu:1p0:extended"
		ENDCASE
		= This.Fehler("FX-PROFIL-01", "Unbekanntes CII-Profil: {1}", tcProfil)
		RETURN ""
	ENDPROC

	PROCEDURE PruefeXsd
		LPARAMETERS toDom, tcProfil, tcXsdPfad
		LOCAL lcSchema, loCache, loFehler, lnCode, lcGrund
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		IF VARTYPE(tcXsdPfad) # "C" OR EMPTY(tcXsdPfad)
			RETURN This.Fehler("XSD", "Der XSD-Ordner fehlt (cXsdPfad).")
		ENDIF
		IF NOT DIRECTORY(tcXsdPfad)
			RETURN This.Fehler("XSD", "Der XSD-Ordner fehlt: {1}", tcXsdPfad)
		ENDIF
		lcSchema = This.SchemaDatei(tcProfil, tcXsdPfad)
		IF EMPTY(lcSchema) OR NOT FILE(lcSchema)
			RETURN This.Fehler("XSD", "Die Schema-Datei fehlt f{ue}r {1}: {2}", tcProfil, lcSchema)
		ENDIF
		loCache = CREATEOBJECT("MSXML2.XMLSchemaCache.6.0")
		IF This.lTechnischerFehler OR VARTYPE(loCache) # "O"
			RETURN .F.
		ENDIF
		loCache.add(This.Namensraum("rsm:CrossIndustryInvoice"), FULLPATH(lcSchema))
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		toDom.schemas = loCache
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		loFehler = toDom.validate()
		IF This.lTechnischerFehler OR VARTYPE(loFehler) # "O"
			RETURN .F.
		ENDIF
		lnCode = loFehler.errorCode
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		IF lnCode # 0
			lcGrund = loFehler.reason
			IF This.lTechnischerFehler
				RETURN .F.
			ENDIF
			RETURN This.Fehler("XSD", "XSD-Pr{ue}fung f{ue}r {1}: {2}", tcProfil, lcGrund)
		ENDIF
		RETURN .T.
	ENDPROC

	PROCEDURE SchemaDatei
		LPARAMETERS tcProfil, tcXsdPfad
		LOCAL lcDatei
		DO CASE
		CASE tcProfil == "EN16931"
			lcDatei = "zugferd-2.5.2\en16931\Factur-X_1.09.2_EN16931.xsd"
		CASE tcProfil == "XRECHNUNG-CII"
			lcDatei = "cii-d16b\CrossIndustryInvoice_100pD16B.xsd"
		CASE tcProfil == "EXTENDED"
			lcDatei = "zugferd-2.5.2\extended\Factur-X_1.09.2_EXTENDED.xsd"
		OTHERWISE
			RETURN ""
		ENDCASE
		RETURN ADDBS(tcXsdPfad) + lcDatei
	ENDPROC

	PROTECTED PROCEDURE SchreibeAbrechnung
		LPARAMETERS toTransaktion, toRechnung
		LOCAL loAbrechnung, loSteuer, loGruppe, lnGruppe, loDatum, loWert
		loAbrechnung = This.AddEl(toTransaktion, "ram:ApplicableHeaderTradeSettlement")
		= This.AddText(loAbrechnung, "ram:CreditorReferenceID", toRechnung.cGlaeubigerId)
		= This.AddText(loAbrechnung, "ram:PaymentReference", toRechnung.cZahlungsreferenz)
		= This.AddText(loAbrechnung, "ram:TaxCurrencyCode", This.CodeNormal(toRechnung.cSteuerwaehrung))
		= This.AddText(loAbrechnung, "ram:InvoiceCurrencyCode", This.CodeNormal(toRechnung.cWaehrung))
		= This.AddText(loAbrechnung, "ram:InvoiceIssuerReference", toRechnung.cRechnungsausstellerReferenz)
		= This.SchreibePartei(loAbrechnung, "ram:InvoicerTradeParty", toRechnung.oRechnungssteller)
		= This.SchreibePartei(loAbrechnung, "ram:InvoiceeTradeParty", toRechnung.oRechnungsempfaenger)
		= This.SchreibePartei(loAbrechnung, "ram:PayeeTradeParty", toRechnung.oZahlungsempfaenger)
		= This.SchreibePartei(loAbrechnung, "ram:PayerTradeParty", toRechnung.oZahler)
		= This.SchreibeSteuerkurs(loAbrechnung, toRechnung)
		= This.SchreibeZahlung(loAbrechnung, toRechnung)
		FOR lnGruppe = 1 TO toRechnung.nSteuergruppen
			loGruppe = toRechnung.aSteuergruppen[lnGruppe]
			loSteuer = This.AddEl(loAbrechnung, "ram:ApplicableTradeTax")
			= This.AddZahl(loSteuer, "ram:CalculatedAmount", loGruppe.nSteuer, 2)
			= This.AddEl(loSteuer, "ram:TypeCode", "VAT")
			= This.AddText(loSteuer, "ram:ExemptionReason", loGruppe.cBefreiungsgrund)
			= This.AddZahl(loSteuer, "ram:BasisAmount", loGruppe.nBasis, 2)
			= This.AddZahl(loSteuer, "ram:LineTotalBasisAmount", loGruppe.nPositionsbasis, 2)
			= This.AddZahl(loSteuer, "ram:AllowanceChargeBasisAmount", loGruppe.nBelegaenderungsbasis, 2)
			= This.AddText(loSteuer, "ram:CategoryCode", loGruppe.cSteuerkategorie)
			= This.AddText(loSteuer, "ram:ExemptionReasonCode", loGruppe.cBefreiungscode)
			* BT-7/8 are invoice-wide and appear on the first breakdown only.
			IF lnGruppe = 1
			    IF VARTYPE(toRechnung.dSteuerdatum) = "D" AND NOT EMPTY(toRechnung.dSteuerdatum)
			        loDatum = This.AddEl(loSteuer, "ram:TaxPointDate")
			        loWert = This.AddEl(loDatum, "udt:DateString", This.Datum(toRechnung.dSteuerdatum))
			        = This.Attribut(loWert, "format", "102")
			    ENDIF
			    = This.AddText(loSteuer, "ram:DueDateTypeCode", This.CodeNormal(toRechnung.cSteuerzeitpunkt))
			ENDIF
			= This.AddZahl(loSteuer, "ram:RateApplicablePercent", loGruppe.nSteuersatz, 2)
		ENDFOR
		= This.SchreibeAbrechnungszeitraum(loAbrechnung, toRechnung.oAbrechnungszeitraum)
		= This.SchreibeBeleggruppen(loAbrechnung, toRechnung)
		= This.SchreibeZahlungsbedingungen(loAbrechnung, toRechnung)
		= This.SchreibeSummen(loAbrechnung, toRechnung)
		= This.SchreibeFinanzkorrekturen(loAbrechnung, toRechnung)
		= This.SchreibeAbrechnungsbezuege(loAbrechnung, toRechnung)
		= This.SchreibeVorauszahlungen(loAbrechnung, toRechnung)
	ENDPROC

	PROTECTED PROCEDURE SchreibeAbrechnungsbezuege
		LPARAMETERS toAbrechnung, toRechnung
		LOCAL lnReferenz, loReferenz, loGruppe
		FOR lnReferenz = 1 TO toRechnung.nRechnungsreferenzen
			= This.SchreibeReferenz(toAbrechnung, "ram:InvoiceReferencedDocument", toRechnung.aRechnungsreferenzen[lnReferenz])
		ENDFOR
		FOR lnReferenz = 1 TO toRechnung.nKontierungen
			loReferenz = toRechnung.aKontierungen[lnReferenz]
			loGruppe = This.AddEl(toAbrechnung, "ram:ReceivableSpecifiedTradeAccountingAccount")
			= This.AddText(loGruppe, "ram:ID", loReferenz.cNummer)
			= This.AddText(loGruppe, "ram:TypeCode", This.CodeNormal(loReferenz.cTyp))
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibeAbrechnungszeitraum
		LPARAMETERS toAbrechnung, toZ
		LOCAL loG
		IF ISNULL(toZ)
			RETURN
		ENDIF
		loG = This.AddEl(toAbrechnung, "ram:BillingSpecifiedPeriod")
		= This.AddText(loG, "ram:Description", toZ.cBeschreibung)
		= This.AddDatum(loG, "ram:StartDateTime", toZ.dAnfang)
		= This.AddDatum(loG, "ram:EndDateTime", toZ.dEnde)
	ENDPROC

	PROTECTED PROCEDURE SchreibeAdresse
		LPARAMETERS toParteiKnoten, toPartei
		LOCAL loAdresse
		IF NOT (This.TextVorhanden(toPartei.cPlz) OR This.TextVorhanden(toPartei.cStrasse) OR ;
		    This.TextVorhanden(toPartei.cStrasse2) OR This.TextVorhanden(toPartei.cStrasse3) OR ;
		    This.TextVorhanden(toPartei.cOrt) OR This.TextVorhanden(toPartei.cLand) OR This.TextVorhanden(toPartei.cRegion))
		    RETURN
		ENDIF
		loAdresse = This.AddEl(toParteiKnoten, "ram:PostalTradeAddress")
		= This.AddText(loAdresse, "ram:PostcodeCode", toPartei.cPlz)
		= This.AddText(loAdresse, "ram:LineOne", toPartei.cStrasse)
		= This.AddText(loAdresse, "ram:LineTwo", toPartei.cStrasse2)
		= This.AddText(loAdresse, "ram:LineThree", toPartei.cStrasse3)
		= This.AddText(loAdresse, "ram:CityName", toPartei.cOrt)
		= This.AddText(loAdresse, "ram:CountryID", This.CodeNormal(toPartei.cLand))
		= This.AddText(loAdresse, "ram:CountrySubDivisionName", toPartei.cRegion)
	ENDPROC

	PROTECTED PROCEDURE SchreibeAnhang
		LPARAMETERS toParent, toA
		LOCAL loGruppe, loDatei, loDatum, loWert
		loGruppe = This.AddEl(toParent, "ram:AdditionalReferencedDocument")
		= This.AddText(loGruppe, "ram:IssuerAssignedID", toA.cNummer)
		= This.AddText(loGruppe, "ram:URIID", This.CodeNormal(toA.cUri))
		= This.AddText(loGruppe, "ram:LineID", toA.cZeile)
		= This.AddText(loGruppe, "ram:TypeCode", This.CodeNormal(toA.cTyp))
		= This.AddText(loGruppe, "ram:Name", toA.cBeschreibung)
		IF This.TextVorhanden(toA.cBase64)
			loDatei = This.AddEl(loGruppe, "ram:AttachmentBinaryObject", toA.cBase64)
			IF This.TextVorhanden(toA.cMime)
				= This.Attribut(loDatei, "mimeCode", This.CodeNormal(toA.cMime))
			ENDIF
			IF This.TextVorhanden(toA.cDateiname)
				= This.Attribut(loDatei, "filename", toA.cDateiname)
			ENDIF
		ENDIF
		= This.AddText(loGruppe, "ram:ReferenceTypeCode", This.CodeNormal(toA.cReferenzart))
		IF VARTYPE(toA.dDatum) = "D" AND NOT EMPTY(toA.dDatum)
			loDatum = This.AddEl(loGruppe, "ram:FormattedIssueDateTime")
			loWert = This.AddEl(loDatum, "qdt:DateTimeString", This.Datum(toA.dDatum))
			= This.Attribut(loWert, "format", "102")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibeBelegaenderung
		LPARAMETERS toG, toK
		LOCAL loG, loW
		loG = This.AddEl(toG, "ram:SpecifiedTradeAllowanceCharge")
		= This.AddIndikator(loG, "ram:ChargeIndicator", toK.lZuschlag)
		IF INLIST(VARTYPE(toK.nReihenfolge), "N", "Y")
			= This.AddZahl(loG, "ram:SequenceNumeric", toK.nReihenfolge, IIF(toK.nReihenfolge = INT(toK.nReihenfolge), 0, 4))
		ENDIF
		= This.AddZahl(loG, "ram:CalculationPercent", toK.nProzent, 2)
		= This.AddZahl(loG, "ram:BasisAmount", toK.nBasis, 2)
		IF NOT ISNULL(toK.nBasismenge)
			loW = This.AddZahl(loG, "ram:BasisQuantity", toK.nBasismenge, 4)
			IF This.TextVorhanden(toK.cBasiseinheit)
				= This.Attribut(loW, "unitCode", This.CodeNormal(toK.cBasiseinheit))
			ENDIF
		ENDIF
		= This.AddZahl(loG, "ram:ActualAmount", toK.nRechenbetrag, 2)
		loW = This.AddText(loG, "ram:ReasonCode", This.CodeNormal(toK.cGrundcode))
		IF VARTYPE(loW) = "O" AND This.TextVorhanden(toK.cGrundliste)
		    = This.Attribut(loW, "listID", This.CodeNormal(toK.cGrundliste))
		ENDIF
		= This.AddText(loG, "ram:Reason", toK.cGrund)
		= This.SchreibeBelegsteuer(loG, "ram:CategoryTradeTax", toK)
	ENDPROC

	PROTECTED PROCEDURE SchreibeBeleggruppen
		LPARAMETERS toG, toF
		LOCAL lnK, loK, loG
		FOR lnK = 1 TO toF.nBelegaenderungen
		    loK = toF.aBelegaenderungen[lnK]
		    IF VARTYPE(loK) = "O"
		        = This.SchreibeBelegaenderung(toG, loK)
		    ENDIF
		ENDFOR
		FOR lnK = 1 TO toF.nLogistikentgelte
		    loK = toF.aLogistikentgelte[lnK]
		    IF VARTYPE(loK) # "O"
		        LOOP
		    ENDIF
		    loG = This.AddEl(toG, "ram:SpecifiedLogisticsServiceCharge")
		    = This.AddText(loG, "ram:Description", loK.cBeschreibung)
		    = This.AddZahl(loG, "ram:AppliedAmount", loK.nRechenbetrag, 2)
		    = This.SchreibeBelegsteuer(loG, "ram:AppliedTradeTax", loK)
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibeBelegsteuer
		LPARAMETERS toG, tcName, toK
		LOCAL loS
		loS = This.AddEl(toG, tcName)
		= This.AddEl(loS, "ram:TypeCode", "VAT")
		= This.AddText(loS, "ram:ExemptionReason", toK.cSteuerbefreiungsgrund)
		= This.AddText(loS, "ram:CategoryCode", This.CodeNormal(toK.cSteuerkategorie))
		= This.AddText(loS, "ram:ExemptionReasonCode", This.CodeNormal(toK.cSteuerbefreiungscode))
		= This.AddZahl(loS, "ram:RateApplicablePercent", toK.nSteuersatz, 2)
	ENDPROC

	PROTECTED PROCEDURE SchreibeFinanzkorrekturen
		    LPARAMETERS toAbrechnung, toRechnung
		    LOCAL lnK, loK, loG
		    FOR lnK = 1 TO toRechnung.nFinanzkorrekturen
		        loK = toRechnung.aFinanzkorrekturen[lnK]
		        loG = This.AddEl(toAbrechnung, "ram:SpecifiedFinancialAdjustment")
		        = This.AddText(loG, "ram:Reason", loK.cGrund)
		        = This.AddZahl(loG, "ram:ActualAmount", loK.nBetrag, 2)
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibeKlassifikationen
		    LPARAMETERS toG, toP
		    LOCAL lnK, loK, loN, loW
		    FOR lnK = 1 TO toP.nKlassifikationen
		        loK = toP.aKlassifikationen[lnK]
		        loN = This.AddEl(toG, "ram:DesignatedProductClassification")
		        loW = This.AddText(loN, "ram:ClassCode", loK.cCode)
		        IF This.TextVorhanden(loK.cListe)
		            = This.Attribut(loW, "listID", This.CodeNormal(loK.cListe))
		        ENDIF
		        IF This.TextVorhanden(loK.cVersion)
		            = This.Attribut(loW, "listVersionID", loK.cVersion)
		        ENDIF
		        = This.AddText(loN, "ram:ClassName", loK.cName)
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibeKommunikation
		LPARAMETERS toParent, tcGruppe, tcFeld, tcWert
		LOCAL loGruppe
		IF This.TextVorhanden(tcWert)
		    loGruppe = This.AddEl(toParent, tcGruppe)
		    = This.AddText(loGruppe, tcFeld, tcWert)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibeKontakt
		LPARAMETERS toParteiKnoten, toK, tcTyp
		LOCAL loKontakt
		IF NOT (This.TextVorhanden(toK.cKontakt) OR This.TextVorhanden(toK.cAbteilung) OR ;
		    This.TextVorhanden(toK.cTelefon) OR This.TextVorhanden(toK.cEmail) OR ;
		    This.TextVorhanden(toK.cFax) OR This.TextVorhanden(tcTyp))
		    RETURN
		ENDIF
		loKontakt = This.AddEl(toParteiKnoten, "ram:DefinedTradeContact")
		= This.AddText(loKontakt, "ram:PersonName", toK.cKontakt)
		= This.AddText(loKontakt, "ram:DepartmentName", toK.cAbteilung)
		= This.AddText(loKontakt, "ram:TypeCode", This.CodeNormal(tcTyp))
		= This.SchreibeKommunikation(loKontakt, "ram:TelephoneUniversalCommunication", "ram:CompleteNumber", toK.cTelefon)
		= This.SchreibeKommunikation(loKontakt, "ram:FaxUniversalCommunication", "ram:CompleteNumber", toK.cFax)
		= This.SchreibeKommunikation(loKontakt, "ram:EmailURIUniversalCommunication", "ram:URIID", toK.cEmail)
	ENDPROC

	PROTECTED PROCEDURE SchreibeKopf
		LPARAMETERS toRoot, toRechnung
		LOCAL loKontext, loGruppe, loDokument
		loKontext = This.AddEl(toRoot, "rsm:ExchangedDocumentContext")
		= This.AddIndikator(loKontext, "ram:TestIndicator", toRechnung.lTest)
		IF This.TextVorhanden(toRechnung.cProzessKennung)
			loGruppe = This.AddEl(loKontext, "ram:BusinessProcessSpecifiedDocumentContextParameter")
			= This.AddText(loGruppe, "ram:ID", toRechnung.cProzessKennung)
		ENDIF
		loGruppe = This.AddEl(loKontext, "ram:GuidelineSpecifiedDocumentContextParameter")
		= This.AddText(loGruppe, "ram:ID", This.ProfilKennung(toRechnung.cProfil))
		loDokument = This.AddEl(toRoot, "rsm:ExchangedDocument")
		= This.AddText(loDokument, "ram:ID", toRechnung.cRechnungsnummer)
		= This.AddText(loDokument, "ram:Name", toRechnung.cDokumentname)
		= This.AddText(loDokument, "ram:TypeCode", This.CodeNormal(toRechnung.cRechnungstyp))
		= This.AddDatum(loDokument, "ram:IssueDateTime", toRechnung.dRechnungsdatum)
		= This.AddIndikator(loDokument, "ram:CopyIndicator", toRechnung.lKopie)
		= This.AddText(loDokument, "ram:LanguageID", This.CodeNormal(toRechnung.cSprache))
		= This.SchreibeNotizen(loDokument, toRechnung)
		IF VARTYPE(toRechnung.dVertragsfaelligkeit) = "D" AND NOT EMPTY(toRechnung.dVertragsfaelligkeit)
			loGruppe = This.AddEl(loDokument, "ram:EffectiveSpecifiedPeriod")
			= This.AddDatum(loGruppe, "ram:CompleteDateTime", toRechnung.dVertragsfaelligkeit)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibeKopfbezuege
		LPARAMETERS toAgreement, toRechnung
		LOCAL loGruppe, loOrt, lnReferenz
		IF This.TextVorhanden(toRechnung.cLieferbedingung) OR This.TextVorhanden(toRechnung.cLieferland) OR This.TextVorhanden(toRechnung.cLieferort)
			loGruppe = This.AddEl(toAgreement, "ram:ApplicableTradeDeliveryTerms")
			= This.AddText(loGruppe, "ram:DeliveryTypeCode", This.CodeNormal(toRechnung.cLieferbedingung))
			IF This.TextVorhanden(toRechnung.cLieferland) OR This.TextVorhanden(toRechnung.cLieferort)
				loOrt = This.AddEl(loGruppe, "ram:RelevantTradeLocation")
				= This.AddText(loOrt, "ram:CountryID", This.CodeNormal(toRechnung.cLieferland))
				= This.AddText(loOrt, "ram:Name", toRechnung.cLieferort)
			ENDIF
		ENDIF
		= This.SchreibeReferenz(toAgreement, "ram:SellerOrderReferencedDocument", toRechnung.oAuftrag)
		= This.SchreibeReferenz(toAgreement, "ram:BuyerOrderReferencedDocument", toRechnung.oBestellung)
		= This.SchreibeReferenz(toAgreement, "ram:QuotationReferencedDocument", toRechnung.oAngebot)
		= This.SchreibeReferenz(toAgreement, "ram:ContractReferencedDocument", toRechnung.oVertrag)
		FOR lnReferenz = 1 TO toRechnung.nAnhaenge
			= This.SchreibeAnhang(toAgreement, toRechnung.aAnhaenge[lnReferenz])
		ENDFOR
		= This.SchreibePartei(toAgreement, "ram:BuyerAgentTradeParty", toRechnung.oEinkaufsagent)
		IF This.TextVorhanden(toRechnung.cProjektNummer) OR This.TextVorhanden(toRechnung.cProjektName)
			loGruppe = This.AddEl(toAgreement, "ram:SpecifiedProcuringProject")
			= This.AddText(loGruppe, "ram:ID", toRechnung.cProjektNummer)
			= This.AddText(loGruppe, "ram:Name", toRechnung.cProjektName)
		ENDIF
		FOR lnReferenz = 1 TO toRechnung.nEndkundenbestellungen
			= This.SchreibeReferenz(toAgreement, "ram:UltimateCustomerOrderReferencedDocument", toRechnung.aEndkundenbestellungen[lnReferenz])
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibeKopflieferung
		LPARAMETERS toTransaktion, toR
		LOCAL loG, loSendung, loTransport, loEreignis, lnTransport
		loG = This.AddEl(toTransaktion, "ram:ApplicableHeaderTradeDelivery")
		IF toR.nTransporte > 0
			loSendung = This.AddEl(loG, "ram:RelatedSupplyChainConsignment")
			FOR lnTransport = 1 TO toR.nTransporte
				loTransport = This.AddEl(loSendung, "ram:SpecifiedLogisticsTransportMovement")
				= This.AddText(loTransport, "ram:ModeCode", This.CodeNormal(toR.aTransporte[lnTransport].cArt))
			ENDFOR
		ENDIF
		= This.SchreibePartei(loG, "ram:ShipToTradeParty", toR.oLieferempfaenger)
		= This.SchreibePartei(loG, "ram:UltimateShipToTradeParty", toR.oEndlieferempfaenger)
		= This.SchreibePartei(loG, "ram:ShipFromTradeParty", toR.oVersender)
		IF VARTYPE(toR.dLieferdatum) = "D" AND NOT EMPTY(toR.dLieferdatum)
			loEreignis = This.AddEl(loG, "ram:ActualDeliverySupplyChainEvent")
			= This.AddDatum(loEreignis, "ram:OccurrenceDateTime", toR.dLieferdatum)
		ENDIF
		= This.SchreibeReferenz(loG, "ram:DespatchAdviceReferencedDocument", toR.oVersandavis)
		= This.SchreibeReferenz(loG, "ram:ReceivingAdviceReferencedDocument", toR.oEmpfangsavis)
		= This.SchreibeReferenz(loG, "ram:DeliveryNoteReferencedDocument", toR.oLieferschein)
	ENDPROC

	PROTECTED PROCEDURE SchreibeLiefermenge
		LPARAMETERS toG, tcName, tuMenge, tuEinheit
		LOCAL loWert
		loWert = This.AddZahl(toG, tcName, tuMenge, 4)
		IF VARTYPE(loWert) = "O" AND This.TextVorhanden(tuEinheit)
		    = This.Attribut(loWert, "unitCode", This.CodeNormal(tuEinheit))
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibeMerkmale
		    LPARAMETERS toG, toP
		    LOCAL lnK, loK, loN, loW
		    FOR lnK = 1 TO toP.nMerkmale
		        loK = toP.aMerkmale[lnK]
		        loN = This.AddEl(toG, "ram:ApplicableProductCharacteristic")
		        = This.AddText(loN, "ram:TypeCode", This.CodeNormal(loK.cTyp))
		        = This.AddText(loN, "ram:Description", loK.cName)
		        IF NOT ISNULL(loK.nMesswert)
		            loW = This.AddZahl(loN, "ram:ValueMeasure", loK.nMesswert, 4)
		            IF This.TextVorhanden(loK.cEinheit)
		                = This.Attribut(loW, "unitCode", This.CodeNormal(loK.cEinheit))
		            ENDIF
		        ENDIF
		        = This.AddText(loN, "ram:Value", loK.cWert)
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibeNotizen
		LPARAMETERS toDokument, toRechnung
		LOCAL lnNotiz, loNotiz, loGruppe
		FOR lnNotiz = 1 TO toRechnung.nNotizen
			loNotiz = toRechnung.aNotizen[lnNotiz]
			loGruppe = This.AddEl(toDokument, "ram:IncludedNote")
			= This.AddText(loGruppe, "ram:ContentCode", This.CodeNormal(loNotiz.cTextcode))
			= This.AddText(loGruppe, "ram:Content", loNotiz.cText)
			= This.AddText(loGruppe, "ram:SubjectCode", This.CodeNormal(loNotiz.cBetreff))
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibeOrganisation
		LPARAMETERS toPartei, toP
		LOCAL loGruppe, loId, loA
		loA = toP.oRegisterAdresse
		IF NOT (This.TextVorhanden(toP.cRegisternummer) OR This.TextVorhanden(toP.cHandelsname) OR ;
		    This.TextVorhanden(loA.cPlz) OR This.TextVorhanden(loA.cStrasse) OR This.TextVorhanden(loA.cStrasse2) OR ;
		    This.TextVorhanden(loA.cStrasse3) OR This.TextVorhanden(loA.cOrt) OR ;
		    This.TextVorhanden(loA.cLand) OR This.TextVorhanden(loA.cRegion))
		    RETURN
		ENDIF
		loGruppe = This.AddEl(toPartei, "ram:SpecifiedLegalOrganization")
		loId = This.AddText(loGruppe, "ram:ID", toP.cRegisternummer)
		IF This.TextVorhanden(toP.cRegisterSchema)
		    = This.Attribut(loId, "schemeID", This.CodeNormal(toP.cRegisterSchema))
		ENDIF
		= This.AddText(loGruppe, "ram:TradingBusinessName", toP.cHandelsname)
		= This.SchreibeAdresse(loGruppe, loA)
	ENDPROC

	PROTECTED PROCEDURE SchreibePartei
		LPARAMETERS toParent, tcName, toPartei
		LOCAL loPartei, lnK, loK, loGruppe, loId
		IF NOT INLIST(tcName, "ram:SellerTradeParty", "ram:BuyerTradeParty") AND NOT toPartei.Vorhanden()
			RETURN
		ENDIF
		loPartei = This.AddEl(toParent, tcName)
		FOR lnK = 1 TO toPartei.nKennungen
		    = This.AddText(loPartei, "ram:ID", toPartei.aKennungen[lnK].cWert)
		ENDFOR
		FOR lnK = 1 TO toPartei.nGlobaleKennungen
		    loK = toPartei.aGlobaleKennungen[lnK]
		    loId = This.AddText(loPartei, "ram:GlobalID", loK.cWert)
		    IF This.TextVorhanden(loK.cSchema)
		        = This.Attribut(loId, "schemeID", This.CodeNormal(loK.cSchema))
		    ENDIF
		ENDFOR
		= This.AddText(loPartei, "ram:Name", toPartei.cName)
		= This.AddText(loPartei, "ram:RoleCode", This.CodeNormal(toPartei.cRolle))
		= This.AddText(loPartei, "ram:Description", toPartei.cBeschreibung)
		= This.SchreibeOrganisation(loPartei, toPartei)
		= This.SchreibeKontakt(loPartei, toPartei, toPartei.cKontaktTyp)
		FOR lnK = 1 TO toPartei.nKontakte
		    loK = toPartei.aKontakte[lnK]
		    = This.SchreibeKontakt(loPartei, loK, loK.cTyp)
		ENDFOR
		= This.SchreibeAdresse(loPartei, toPartei)
		IF This.TextVorhanden(toPartei.cElektronischeAdresse)
		    loGruppe = This.AddEl(loPartei, "ram:URIUniversalCommunication")
		    loId = This.AddText(loGruppe, "ram:URIID", toPartei.cElektronischeAdresse)
		    IF This.TextVorhanden(toPartei.cElektronischeAdresseSchema)
		        = This.Attribut(loId, "schemeID", This.CodeNormal(toPartei.cElektronischeAdresseSchema))
		    ENDIF
		ENDIF
		= This.SchreibeSteuerkennung(loPartei, toPartei.cUstId, "VA")
		= This.SchreibeSteuerkennung(loPartei, toPartei.cSteuernummer, "FC")
	ENDPROC

	PROTECTED PROCEDURE SchreibePosition
		LPARAMETERS toTransaktion, toPosition, tcProfil
		LOCAL loZeile, loGruppe, loPreis, loWert, loSteuer
		loZeile = This.AddEl(toTransaktion, "ram:IncludedSupplyChainTradeLineItem")
		= This.SchreibePositionsdokument(loZeile, toPosition)
		= This.SchreibeProdukt(loZeile, toPosition)
		loGruppe = This.AddEl(loZeile, "ram:SpecifiedLineTradeAgreement")
		= This.SchreibePositionsbezuege(loGruppe, toPosition)
		= This.SchreibePreise(loGruppe, toPosition)
		= This.SchreibePositionsverkaeufer(loGruppe, toPosition)
		IF NOT EMPTY(toPosition.cUntertyp)
			= This.GliederungsgruppeLeeren(loGruppe, toPosition)
		ENDIF
		= This.SchreibePositionslieferung(loZeile, toPosition)
		= This.SchreibePositionsabrechnung(loZeile, toPosition, tcProfil)
	ENDPROC

	PROTECTED PROCEDURE SchreibePositionsabrechnung
		LPARAMETERS toZeile, toP, tcProfil
		LOCAL loG, loS, loW, loK, lnK
		loG = This.AddEl(toZeile, "ram:SpecifiedLineTradeSettlement")
		loS = This.AddEl(loG, "ram:ApplicableTradeTax")
		= This.AddZahl(loS, "ram:CalculatedAmount", toP.nSteuerbetrag, 2)
		= This.AddEl(loS, "ram:TypeCode", "VAT")
		= This.AddText(loS, "ram:ExemptionReason", toP.cSteuerbefreiungsgrund)
		= This.AddText(loS, "ram:CategoryCode", This.CodeNormal(toP.cSteuerkategorie))
		= This.AddText(loS, "ram:ExemptionReasonCode", This.CodeNormal(toP.cSteuerbefreiungscode))
		= This.AddText(loS, "ram:DueDateTypeCode", This.CodeNormal(toP.cSteuerzeitpunktCode))
		= This.AddZahl(loS, "ram:RateApplicablePercent", toP.nSteuersatz, 2)
		= This.SchreibeAbrechnungszeitraum(loG, toP.oAbrechnungszeitraum)
		FOR lnK = 1 TO toP.nAbrechnungsaenderungen
			loK = toP.aAbrechnungsaenderungen[lnK]
			loS = This.AddEl(loG, "ram:SpecifiedTradeAllowanceCharge")
			= This.AddIndikator(loS, "ram:ChargeIndicator", loK.lZuschlag)
			= This.AddZahl(loS, "ram:CalculationPercent", loK.nProzent, 2)
			= This.AddZahl(loS, "ram:BasisAmount", loK.nBasis, 2)
			= This.AddZahl(loS, "ram:ActualAmount", loK.nRechenbetrag, 2)
			loW = This.AddText(loS, "ram:ReasonCode", This.CodeNormal(loK.cGrundcode))
			IF VARTYPE(loW) = "O" AND This.TextVorhanden(loK.cGrundliste)
				= This.Attribut(loW, "listID", This.CodeNormal(loK.cGrundliste))
			ENDIF
			= This.AddText(loS, "ram:Reason", loK.cGrund)
		ENDFOR
		loS = This.AddEl(loG, "ram:SpecifiedTradeSettlementLineMonetarySummation")
		= This.AddZahl(loS, "ram:LineTotalAmount", toP.nNettobetrag, 2)
		IF tcProfil == "EXTENDED"
			= This.AddZahl(loS, "ram:ChargeTotalAmount", toP.nZuschlagSumme, 2)
			= This.AddZahl(loS, "ram:AllowanceTotalAmount", toP.nNachlassSumme, 2)
		ENDIF
		FOR lnK = 1 TO toP.nSteuersummen
			loK = toP.aSteuersummen[lnK]
			loW = This.AddZahl(loS, "ram:TaxTotalAmount", loK.nBetrag, 2)
			IF VARTYPE(loW) = "O" AND This.TextVorhanden(loK.cWaehrung)
				= This.Attribut(loW, "currencyID", This.CodeNormal(loK.cWaehrung))
			ENDIF
		ENDFOR
		= This.AddZahl(loS, "ram:GrandTotalAmount", toP.nBruttobetrag, 2)
		IF tcProfil == "EXTENDED"
			= This.AddZahl(loS, "ram:TotalAllowanceChargeAmount", toP.nGesamtAenderung, 2)
		ENDIF
		IF NOT EMPTY(toP.cUntertyp)
			= This.GliederungsgruppeLeeren(loS, toP)
		ENDIF
		= This.SchreibeReferenz(loG, "ram:InvoiceReferencedDocument", toP.oRechnungsreferenz)
		IF This.TextVorhanden(toP.cObjektreferenz) OR This.TextVorhanden(toP.cObjektreferenzart)
			loS = This.AddEl(loG, "ram:AdditionalReferencedDocument")
			= This.AddText(loS, "ram:IssuerAssignedID", toP.cObjektreferenz)
			= This.AddEl(loS, "ram:TypeCode", "130")
			= This.AddText(loS, "ram:ReferenceTypeCode", This.CodeNormal(toP.cObjektreferenzart))
		ENDIF
		FOR lnK = 1 TO toP.nKontierungen
			loK = toP.aKontierungen[lnK]
			loS = This.AddEl(loG, "ram:ReceivableSpecifiedTradeAccountingAccount")
			= This.AddText(loS, "ram:ID", loK.cNummer)
			= This.AddText(loS, "ram:TypeCode", This.CodeNormal(loK.cTyp))
		ENDFOR
		IF NOT EMPTY(toP.cUntertyp)
			= This.GliederungsgruppeLeeren(loG, toP)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibePositionsbezuege
		LPARAMETERS toA, toP
		LOCAL loG, loOrt, lnR
		IF This.TextVorhanden(toP.cLieferbedingung) OR This.TextVorhanden(toP.cLieferland) OR This.TextVorhanden(toP.cLieferort)
		    loG = This.AddEl(toA, "ram:ApplicableTradeDeliveryTerms")
		    = This.AddText(loG, "ram:DeliveryTypeCode", This.CodeNormal(toP.cLieferbedingung))
		    IF This.TextVorhanden(toP.cLieferland) OR This.TextVorhanden(toP.cLieferort)
		        loOrt = This.AddEl(loG, "ram:RelevantTradeLocation")
		        = This.AddText(loOrt, "ram:CountryID", This.CodeNormal(toP.cLieferland))
		        = This.AddText(loOrt, "ram:Name", toP.cLieferort)
		    ENDIF
		ENDIF
		= This.SchreibeReferenz(toA, "ram:SellerOrderReferencedDocument", toP.oAuftrag)
		= This.SchreibeReferenz(toA, "ram:BuyerOrderReferencedDocument", toP.oBestellung)
		= This.SchreibeReferenz(toA, "ram:QuotationReferencedDocument", toP.oAngebot)
		= This.SchreibeReferenz(toA, "ram:ContractReferencedDocument", toP.oVertrag)
		FOR lnR = 1 TO toP.nAnhaenge
		    = This.SchreibeAnhang(toA, toP.aAnhaenge[lnR])
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibePositionsdokument
		    LPARAMETERS toZeile, toP
		    LOCAL loG, loN, lnK, loK
		    loG = This.AddEl(toZeile, "ram:AssociatedDocumentLineDocument")
		    = This.AddText(loG, "ram:LineID", toP.cNummer)
		    = This.AddText(loG, "ram:ParentLineID", This.CodeNormal(toP.cElternnummer))
		    = This.AddText(loG, "ram:LineStatusCode", This.CodeNormal(toP.cStatus))
		    = This.AddText(loG, "ram:LineStatusReasonCode", This.CodeNormal(toP.cUntertyp))
		    FOR lnK = 1 TO toP.nNotizen
		        loK = toP.aNotizen[lnK]
		        loN = This.AddEl(loG, "ram:IncludedNote")
		        = This.AddText(loN, "ram:ContentCode", This.CodeNormal(loK.cTextcode))
		        = This.AddText(loN, "ram:Content", loK.cText)
		        = This.AddText(loN, "ram:SubjectCode", This.CodeNormal(loK.cBetreff))
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibePositionslieferung
		LPARAMETERS toZeile, toP
		LOCAL loG, loE, loZeit, loWert
		loG = This.AddEl(toZeile, "ram:SpecifiedLineTradeDelivery")
		loWert = This.AddZahl(loG, "ram:BilledQuantity", toP.nMenge, 4)
		IF VARTYPE(loWert) = "O" OR (EMPTY(This.CodeNormal(toP.cUntertyp)) OR This.CodeNormal(toP.cUntertyp) == "DETAIL")
		    = This.Attribut(loWert, "unitCode", This.CodeNormal(toP.cEinheit))
		ENDIF
		= This.SchreibeLiefermenge(loG, "ram:ChargeFreeQuantity", toP.nGratismenge, toP.cGratiseinheit)
		= This.SchreibeLiefermenge(loG, "ram:PackageQuantity", toP.nPaketmenge, toP.cPaketeinheit)
		= This.SchreibeLiefermenge(loG, "ram:PerPackageUnitQuantity", toP.nMengeJePaket, toP.cEinheitJePaket)
		= This.SchreibePartei(loG, "ram:ShipToTradeParty", toP.oLieferempfaenger)
		= This.SchreibePartei(loG, "ram:UltimateShipToTradeParty", toP.oEndlieferempfaenger)
		IF VARTYPE(toP.dLieferdatum) = "D" AND NOT EMPTY(toP.dLieferdatum)
		    loE = This.AddEl(loG, "ram:ActualDeliverySupplyChainEvent")
		    loZeit = This.AddEl(loE, "ram:OccurrenceDateTime")
		    loWert = This.AddEl(loZeit, "udt:DateTimeString", This.Datum(toP.dLieferdatum))
		    = This.Attribut(loWert, "format", "102")
		ENDIF
		= This.SchreibeReferenz(loG, "ram:DespatchAdviceReferencedDocument", toP.oVersandavis)
		= This.SchreibeReferenz(loG, "ram:ReceivingAdviceReferencedDocument", toP.oEmpfangsavis)
		= This.SchreibeReferenz(loG, "ram:DeliveryNoteReferencedDocument", toP.oLieferschein)
		IF NOT EMPTY(toP.cUntertyp)
			= This.GliederungsgruppeLeeren(loG, toP)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibePositionsverkaeufer
		LPARAMETERS toA, toP
		LOCAL lnR
		= This.SchreibePartei(toA, "ram:ItemSellerTradeParty", toP.oVerkaeufer)
		FOR lnR = 1 TO toP.nEndkundenbestellungen
		    = This.SchreibeReferenz(toA, "ram:UltimateCustomerOrderReferencedDocument", toP.aEndkundenbestellungen[lnR])
		ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibePreisaenderung
		LPARAMETERS toPreis, toK
		LOCAL loK, loWert
		loK = This.AddEl(toPreis, "ram:AppliedTradeAllowanceCharge")
		= This.AddIndikator(loK, "ram:ChargeIndicator", toK.lZuschlag)
		= This.AddZahl(loK, "ram:CalculationPercent", toK.nProzent, 2)
		= This.AddZahl(loK, "ram:BasisAmount", toK.nBasis, 2)
		= This.AddZahl(loK, "ram:ActualAmount", toK.nBetrag, 4)
		loWert = This.AddText(loK, "ram:ReasonCode", This.CodeNormal(toK.cGrundcode))
		IF VARTYPE(loWert) = "O" AND This.TextVorhanden(toK.cGrundliste)
			= This.Attribut(loWert, "listID", This.CodeNormal(toK.cGrundliste))
		ENDIF
		= This.AddText(loK, "ram:Reason", toK.cGrund)
	ENDPROC

	PROTECTED PROCEDURE SchreibePreise
		LPARAMETERS toGruppe, toP
		LOCAL loPreis, loWert, lnK, loK
		IF NOT ISNULL(toP.nBruttopreis) OR toP.nPreisaenderungen > 0 OR NOT ISNULL(toP.nBruttobasismenge)
			loPreis = This.AddEl(toGruppe, "ram:GrossPriceProductTradePrice")
			= This.AddZahl(loPreis, "ram:ChargeAmount", toP.nBruttopreis, 4)
			IF NOT ISNULL(toP.nBruttobasismenge)
				loWert = This.AddZahl(loPreis, "ram:BasisQuantity", toP.nBruttobasismenge, 4)
				= This.Attribut(loWert, "unitCode", This.CodeNormal(toP.cEinheit))
			ENDIF
			FOR lnK = 1 TO toP.nPreisaenderungen
				loK = toP.aPreisaenderungen[lnK]
				IF VARTYPE(loK) = "O"
					= This.SchreibePreisaenderung(loPreis, loK)
				ENDIF
			ENDFOR
		ENDIF
		loPreis = This.AddEl(toGruppe, "ram:NetPriceProductTradePrice")
		= This.AddZahl(loPreis, "ram:ChargeAmount", toP.nPreis, 4)
		IF NOT ISNULL(toP.nBasismenge)
			loWert = This.AddZahl(loPreis, "ram:BasisQuantity", toP.nBasismenge, 4)
			= This.Attribut(loWert, "unitCode", This.CodeNormal(toP.cEinheit))
		ENDIF
		= This.SchreibePreissteuer(loPreis, toP.oPreissteuer)
		IF NOT EMPTY(toP.cUntertyp)
			= This.GliederungsgruppeLeeren(loPreis, toP)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibePreissteuer
		LPARAMETERS toPreis, toS
		LOCAL loS
		IF VARTYPE(toS) # "O"
			RETURN
		ENDIF
		IF NOT toS.HatInhalt()
			RETURN
		ENDIF
		loS = This.AddEl(toPreis, "ram:IncludedTradeTax")
		= This.AddZahl(loS, "ram:CalculatedAmount", toS.nBetrag, 2)
		= This.AddText(loS, "ram:TypeCode", This.CodeNormal(toS.cTyp))
		= This.AddText(loS, "ram:ExemptionReason", toS.cBefreiungsgrund)
		= This.AddText(loS, "ram:CategoryCode", This.CodeNormal(toS.cKategorie))
		= This.AddText(loS, "ram:ExemptionReasonCode", This.CodeNormal(toS.cBefreiungscode))
		= This.AddZahl(loS, "ram:RateApplicablePercent", toS.nSatz, 2)
	ENDPROC

	PROTECTED PROCEDURE SchreibeProdukt
		    LPARAMETERS toZeile, toP
		    LOCAL loG, loK, lnK, loN, loW
		    loG = This.AddEl(toZeile, "ram:SpecifiedTradeProduct")
		    = This.AddText(loG, "ram:ID", toP.cProduktkennung)
		    loW = This.AddText(loG, "ram:GlobalID", toP.cGlobaleKennung)
		    IF This.TextVorhanden(toP.cGlobalesSchema)
		        = This.Attribut(loW, "schemeID", This.CodeNormal(toP.cGlobalesSchema))
		    ENDIF
		    = This.AddText(loG, "ram:SellerAssignedID", toP.cVerkaeuferArtikelnummer)
		    = This.AddText(loG, "ram:BuyerAssignedID", toP.cKaeuferArtikelnummer)
		    = This.AddText(loG, "ram:IndustryAssignedID", toP.cBranchenkennung)
		    = This.AddText(loG, "ram:ModelID", toP.cModellkennung)
		    = This.AddText(loG, "ram:Name", toP.cName)
		    = This.AddText(loG, "ram:Description", toP.cBeschreibung)
		    FOR lnK = 1 TO toP.nChargen
		        = This.AddText(loG, "ram:BatchID", toP.aChargen[lnK].cWert)
		    ENDFOR
		    = This.AddText(loG, "ram:BrandName", toP.cMarke)
		    = This.AddText(loG, "ram:ModelName", toP.cModellname)
		    = This.SchreibeMerkmale(loG, toP)
		    = This.SchreibeKlassifikationen(loG, toP)
		    FOR lnK = 1 TO toP.nInstanzen
		        loK = toP.aInstanzen[lnK]
		        loN = This.AddEl(loG, "ram:IndividualTradeProductInstance")
		        = This.AddText(loN, "ram:BatchID", loK.cCharge)
		        = This.AddText(loN, "ram:SupplierAssignedSerialID", loK.cSeriennummer)
		    ENDFOR
		    IF This.TextVorhanden(toP.cUrsprungsland)
		        loN = This.AddEl(loG, "ram:OriginTradeCountry")
		        = This.AddText(loN, "ram:ID", This.CodeNormal(toP.cUrsprungsland))
		    ENDIF
		    = This.SchreibePartei(loG, "ram:ManufacturerTradeParty", toP.oHersteller)
		    FOR lnK = 1 TO toP.nProduktreferenzen
		        = This.SchreibeProduktreferenz(loG, toP.aProduktreferenzen[lnK])
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibeProduktreferenz
		    LPARAMETERS toG, toR
		    LOCAL loN, lnK, loK, loW
		    loN = This.AddEl(toG, "ram:IncludedReferencedProduct")
		    = This.AddText(loN, "ram:ID", toR.cNummer)
		    FOR lnK = 1 TO toR.nGlobaleKennungen
		        loK = toR.aGlobaleKennungen[lnK]
		        loW = This.AddText(loN, "ram:GlobalID", loK.cWert)
		        IF This.TextVorhanden(loK.cSchema)
		            = This.Attribut(loW, "schemeID", This.CodeNormal(loK.cSchema))
		        ENDIF
		    ENDFOR
		    = This.AddText(loN, "ram:SellerAssignedID", toR.cVerkaeuferArtikelnummer)
		    = This.AddText(loN, "ram:BuyerAssignedID", toR.cKaeuferArtikelnummer)
		    = This.AddText(loN, "ram:IndustryAssignedID", toR.cBranchenkennung)
		    = This.AddText(loN, "ram:Name", toR.cName)
		    = This.AddText(loN, "ram:Description", toR.cBeschreibung)
		    IF NOT ISNULL(toR.nMenge)
		        loW = This.AddZahl(loN, "ram:UnitQuantity", toR.nMenge, 4)
		        IF This.TextVorhanden(toR.cEinheit)
		            = This.Attribut(loW, "unitCode", This.CodeNormal(toR.cEinheit))
		        ENDIF
		    ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibeReferenz
		LPARAMETERS toParent, tcName, toReferenz
		LOCAL loGruppe, loDatum, loWert
		IF ISNULL(toReferenz)
			RETURN
		ENDIF
		loGruppe = This.AddEl(toParent, tcName)
		= This.AddText(loGruppe, "ram:IssuerAssignedID", toReferenz.cNummer)
		= This.AddText(loGruppe, "ram:LineID", toReferenz.cZeile)
		= This.AddText(loGruppe, "ram:TypeCode", This.CodeNormal(toReferenz.cTyp))
		= This.AddText(loGruppe, "ram:ReferenceTypeCode", This.CodeNormal(toReferenz.cReferenzart))
		IF VARTYPE(toReferenz.dDatum) = "D" AND NOT EMPTY(toReferenz.dDatum)
			loDatum = This.AddEl(loGruppe, "ram:FormattedIssueDateTime")
			loWert = This.AddEl(loDatum, "qdt:DateTimeString", This.Datum(toReferenz.dDatum))
			= This.Attribut(loWert, "format", "102")
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibeSkonto
		LPARAMETERS toG, toB
		LOCAL loS, loM
		IF NOT toB.HatSkonto()
		    RETURN
		ENDIF
		loS = This.AddEl(toG, "ram:ApplicableTradePaymentDiscountTerms")
		= This.AddDatum(loS, "ram:BasisDateTime", toB.dSkontoBasisdatum)
		loM = This.AddZahl(loS, "ram:BasisPeriodMeasure", toB.nSkontoTage, 4)
		IF VARTYPE(loM) = "O" AND This.TextVorhanden(toB.cSkontoEinheit)
		    = This.Attribut(loM, "unitCode", This.CodeNormal(toB.cSkontoEinheit))
		ENDIF
		= This.AddZahl(loS, "ram:BasisAmount", toB.nSkontoBasis, 2)
		= This.AddZahl(loS, "ram:CalculationPercent", toB.nSkontoProzent, 2)
		= This.AddZahl(loS, "ram:ActualDiscountAmount", toB.nSkontoBetrag, 2)
	ENDPROC

	PROTECTED PROCEDURE SchreibeSteuerkennung
		LPARAMETERS toPartei, tcWert, tcSchema
		LOCAL loGruppe, loId
		IF This.TextVorhanden(tcWert)
		    loGruppe = This.AddEl(toPartei, "ram:SpecifiedTaxRegistration")
		    loId = This.AddText(loGruppe, "ram:ID", tcWert)
		    = This.Attribut(loId, "schemeID", tcSchema)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibeSteuerkurs
		LPARAMETERS toAbrechnung, toRechnung
		LOCAL loK, loD, loW
		IF NOT (This.TextVorhanden(toRechnung.cSteuerkursQuelle) OR This.TextVorhanden(toRechnung.cSteuerkursZiel) OR ;
		    NOT ISNULL(toRechnung.nSteuerkurs) OR This.TextVorhanden(toRechnung.cSteuerkursdatum) OR ;
		    NOT (This.CodeNormal(toRechnung.cSteuerkursformat) == "102"))
		    RETURN
		ENDIF
		loK = This.AddEl(toAbrechnung, "ram:TaxApplicableTradeCurrencyExchange")
		= This.AddText(loK, "ram:SourceCurrencyCode", This.CodeNormal(toRechnung.cSteuerkursQuelle))
		= This.AddText(loK, "ram:TargetCurrencyCode", This.CodeNormal(toRechnung.cSteuerkursZiel))
		= This.AddZahl(loK, "ram:ConversionRate", toRechnung.nSteuerkurs, 8)
		IF This.TextVorhanden(toRechnung.cSteuerkursdatum)
		    loD = This.AddEl(loK, "ram:ConversionRateDateTime")
		    loW = This.AddEl(loD, "udt:DateTimeString", This.CodeNormal(toRechnung.cSteuerkursdatum))
		    = This.Attribut(loW, "format", This.CodeNormal(toRechnung.cSteuerkursformat))
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibeSummen
		LPARAMETERS toAbrechnung, toRechnung
		LOCAL loSummen, loSteuer
		loSummen = This.AddEl(toAbrechnung, "ram:SpecifiedTradeSettlementHeaderMonetarySummation")
		= This.AddZahl(loSummen, "ram:LineTotalAmount", toRechnung.nSummePositionen, 2)
		= This.AddZahl(loSummen, "ram:ChargeTotalAmount", toRechnung.nZuschlagSumme, 2)
		= This.AddZahl(loSummen, "ram:AllowanceTotalAmount", toRechnung.nNachlassSumme, 2)
		= This.AddZahl(loSummen, "ram:TaxBasisTotalAmount", toRechnung.nNetto, 2)
		loSteuer = This.AddZahl(loSummen, "ram:TaxTotalAmount", toRechnung.nSteuer, 2)
		= This.Attribut(loSteuer, "currencyID", This.CodeNormal(toRechnung.cWaehrung))
		IF NOT ISNULL(toRechnung.nSteuerInSteuerwaehrung)
			loSteuer = This.AddZahl(loSummen, "ram:TaxTotalAmount", toRechnung.nSteuerInSteuerwaehrung, 2)
			= This.Attribut(loSteuer, "currencyID", This.CodeNormal(toRechnung.cSteuerwaehrung))
		ENDIF
		= This.AddZahl(loSummen, "ram:RoundingAmount", toRechnung.nRundung, 2)
		= This.AddZahl(loSummen, "ram:GrandTotalAmount", toRechnung.nBrutto, 2)
		= This.AddZahl(loSummen, "ram:TotalPrepaidAmount", toRechnung.nVorauszahlungSumme, 2)
		= This.AddZahl(loSummen, "ram:DuePayableAmount", toRechnung.nZahlbetrag, 2)
	ENDPROC

	PROTECTED PROCEDURE SchreibeTransaktion
		LPARAMETERS toRoot, toRechnung
		LOCAL loTransaktion, loGruppe, loEreignis, lnPosition
		loTransaktion = This.AddEl(toRoot, "rsm:SupplyChainTradeTransaction")
		FOR lnPosition = 1 TO toRechnung.nPositionen
			= This.SchreibePosition(loTransaktion, toRechnung.aPositionen[lnPosition], toRechnung.cProfil)
		ENDFOR
		loGruppe = This.AddEl(loTransaktion, "ram:ApplicableHeaderTradeAgreement")
		= This.AddText(loGruppe, "ram:BuyerReference", toRechnung.cKaeuferReferenz)
		= This.SchreibePartei(loGruppe, "ram:SellerTradeParty", toRechnung.oVerkaeufer)
		= This.SchreibePartei(loGruppe, "ram:BuyerTradeParty", toRechnung.oKaeufer)
		= This.SchreibePartei(loGruppe, "ram:SalesAgentTradeParty", toRechnung.oVerkaufsagent)
		= This.SchreibePartei(loGruppe, "ram:BuyerTaxRepresentativeTradeParty", toRechnung.oKaeuferSteuervertreter)
		= This.SchreibePartei(loGruppe, "ram:SellerTaxRepresentativeTradeParty", toRechnung.oVerkaeuferSteuervertreter)
		= This.SchreibePartei(loGruppe, "ram:ProductEndUserTradeParty", toRechnung.oEndnutzer)
		= This.SchreibeKopfbezuege(loGruppe, toRechnung)
		= This.SchreibeKopflieferung(loTransaktion, toRechnung)
		= This.SchreibeAbrechnung(loTransaktion, toRechnung)
	ENDPROC

	PROTECTED PROCEDURE SchreibeVerzug
		LPARAMETERS toG, toB
		LOCAL loS, loM
		IF NOT toB.HatVerzug()
		    RETURN
		ENDIF
		loS = This.AddEl(toG, "ram:ApplicableTradePaymentPenaltyTerms")
		= This.AddDatum(loS, "ram:BasisDateTime", toB.dVerzugBasisdatum)
		loM = This.AddZahl(loS, "ram:BasisPeriodMeasure", toB.nVerzugTage, 4)
		IF VARTYPE(loM) = "O" AND This.TextVorhanden(toB.cVerzugEinheit)
		    = This.Attribut(loM, "unitCode", This.CodeNormal(toB.cVerzugEinheit))
		ENDIF
		= This.AddZahl(loS, "ram:BasisAmount", toB.nVerzugBasis, 2)
		= This.AddZahl(loS, "ram:CalculationPercent", toB.nVerzugProzent, 2)
		= This.AddZahl(loS, "ram:ActualPenaltyAmount", toB.nVerzugBetrag, 2)
	ENDPROC

	PROTECTED PROCEDURE SchreibeVorausdatum
		LPARAMETERS toParent, tcName, tuDatum, tcFormat
		LOCAL loG, loD
		IF NOT This.TextVorhanden(tuDatum)
			RETURN
		ENDIF
		loG = This.AddEl(toParent, tcName)
		loD = This.AddText(loG, "qdt:DateTimeString", This.CodeNormal(tuDatum))
		= This.Attribut(loD, "format", This.CodeNormal(tcFormat))
	ENDPROC

	PROTECTED PROCEDURE SchreibeVorauszahlungen
		    LPARAMETERS toAbrechnung, toRechnung
		    LOCAL lnV, lnS, loV, loS, loG, loT, loR
		    FOR lnV = 1 TO toRechnung.nVorauszahlungen
		        loV = toRechnung.aVorauszahlungen[lnV]
		        loG = This.AddEl(toAbrechnung, "ram:SpecifiedAdvancePayment")
		        = This.AddZahl(loG, "ram:PaidAmount", loV.nBetrag, 2)
		        = This.SchreibeVorausdatum(loG, "ram:FormattedReceivedDateTime", loV.cEmpfangsdatum, loV.cEmpfangsformat)
		        FOR lnS = 1 TO loV.nSteuern
		            loS = loV.aSteuern[lnS]
		            loT = This.AddEl(loG, "ram:IncludedTradeTax")
		            = This.AddZahl(loT, "ram:CalculatedAmount", loS.nBetrag, 2)
		            = This.AddText(loT, "ram:TypeCode", This.CodeNormal(loS.cTyp))
		            = This.AddText(loT, "ram:ExemptionReason", loS.cBefreiungsgrund)
		            = This.AddText(loT, "ram:CategoryCode", This.CodeNormal(loS.cKategorie))
		            = This.AddText(loT, "ram:ExemptionReasonCode", This.CodeNormal(loS.cBefreiungscode))
		            = This.AddZahl(loT, "ram:RateApplicablePercent", loS.nSatz, 2)
		        ENDFOR
		        IF This.TextVorhanden(loV.cRechnungsnummer) OR This.TextVorhanden(loV.cRechnungstyp) OR This.TextVorhanden(loV.cRechnungsdatum)
		            loR = This.AddEl(loG, "ram:InvoiceSpecifiedReferencedDocument")
		            = This.AddText(loR, "ram:IssuerAssignedID", loV.cRechnungsnummer)
		            = This.AddText(loR, "ram:TypeCode", This.CodeNormal(loV.cRechnungstyp))
		            = This.SchreibeVorausdatum(loR, "ram:FormattedIssueDateTime", loV.cRechnungsdatum, loV.cRechnungsformat)
		        ENDIF
		    ENDFOR
	ENDPROC

	PROTECTED PROCEDURE SchreibeZahlung
		LPARAMETERS toAbrechnung, toRechnung
		LOCAL loZahlung, loKonto, loKarte, loBank, llKonto, llKarte, llSchuldner
		llKonto = This.TextVorhanden(toRechnung.cIban) OR This.TextVorhanden(toRechnung.cKontoinhaber) OR ;
			This.TextVorhanden(toRechnung.cKontonummer)
		llKarte = This.TextVorhanden(toRechnung.cKartennummer) OR This.TextVorhanden(toRechnung.cKarteninhaber)
		llSchuldner = This.TextVorhanden(toRechnung.cSchuldnerIban) OR This.TextVorhanden(toRechnung.cSchuldnerKontoinhaber)
		IF NOT (This.TextVorhanden(toRechnung.cZahlungsart) OR This.TextVorhanden(toRechnung.cZahlungsinfo) OR ;
			llKonto OR llKarte OR llSchuldner OR This.TextVorhanden(toRechnung.cBic) OR This.TextVorhanden(toRechnung.cSchuldnerBic))
			RETURN
		ENDIF
		loZahlung = This.AddEl(toAbrechnung, "ram:SpecifiedTradeSettlementPaymentMeans")
		= This.AddText(loZahlung, "ram:TypeCode", This.CodeNormal(toRechnung.cZahlungsart))
		= This.AddText(loZahlung, "ram:Information", toRechnung.cZahlungsinfo)
		IF llKarte
			loKarte = This.AddEl(loZahlung, "ram:ApplicableTradeSettlementFinancialCard")
			= This.AddText(loKarte, "ram:ID", toRechnung.cKartennummer)
			= This.AddText(loKarte, "ram:CardholderName", toRechnung.cKarteninhaber)
		ENDIF
		IF llSchuldner
			loKonto = This.AddEl(loZahlung, "ram:PayerPartyDebtorFinancialAccount")
			= This.AddText(loKonto, "ram:IBANID", toRechnung.cSchuldnerIban)
			= This.AddText(loKonto, "ram:AccountName", toRechnung.cSchuldnerKontoinhaber)
		ENDIF
		IF llKonto
			loKonto = This.AddEl(loZahlung, "ram:PayeePartyCreditorFinancialAccount")
			= This.AddText(loKonto, "ram:IBANID", toRechnung.cIban)
			= This.AddText(loKonto, "ram:AccountName", toRechnung.cKontoinhaber)
			= This.AddText(loKonto, "ram:ProprietaryID", toRechnung.cKontonummer)
		ENDIF
		IF This.TextVorhanden(toRechnung.cSchuldnerBic)
			loBank = This.AddEl(loZahlung, "ram:PayerSpecifiedDebtorFinancialInstitution")
			= This.AddText(loBank, "ram:BICID", toRechnung.cSchuldnerBic)
		ENDIF
		IF This.TextVorhanden(toRechnung.cBic)
			loBank = This.AddEl(loZahlung, "ram:PayeeSpecifiedCreditorFinancialInstitution")
			= This.AddText(loBank, "ram:BICID", toRechnung.cBic)
		ENDIF
	ENDPROC

	PROTECTED PROCEDURE SchreibeZahlungsbedingungen
		LPARAMETERS toA, toF
		LOCAL loG, lnB, loB, lcText
		lcText = toF.ZahlungsText()
		IF This.TextVorhanden(lcText) OR (VARTYPE(toF.dFaelligkeit) = "D" AND NOT EMPTY(toF.dFaelligkeit)) OR This.TextVorhanden(toF.cMandatsreferenz)
		    loG = This.AddEl(toA, "ram:SpecifiedTradePaymentTerms")
		    = This.AddText(loG, "ram:Description", lcText)
		    = This.AddDatum(loG, "ram:DueDateDateTime", toF.dFaelligkeit)
		    = This.AddText(loG, "ram:DirectDebitMandateID", toF.cMandatsreferenz)
		ENDIF
		FOR lnB = 1 TO toF.nZahlungsbedingungen
		    loB = toF.aZahlungsbedingungen[lnB]
		    IF toF.cProfil # "EXTENDED" AND toF.SkontoBedingung(loB)
		        LOOP
		    ENDIF
		    loG = This.AddEl(toA, "ram:SpecifiedTradePaymentTerms")
		    = This.AddText(loG, "ram:Description", loB.Beschreibung(toF.cProfil, toF.cWaehrung))
		    = This.AddDatum(loG, "ram:DueDateDateTime", loB.dFaelligkeit)
		    = This.AddText(loG, "ram:DirectDebitMandateID", loB.cMandatsreferenz)
		    = This.AddZahl(loG, "ram:PartialPaymentAmount", loB.nTeilzahlung, 2)
		    = This.SchreibeVerzug(loG, loB)
		    IF toF.cProfil == "EXTENDED"
		        = This.SchreibeSkonto(loG, loB)
		    ENDIF
		    = This.SchreibePartei(loG, "ram:PayeeTradeParty", loB.oZahlungsempfaenger)
		ENDFOR
	ENDPROC

	PROCEDURE Speichern
		LPARAMETERS toDom, tcDatei
		LOCAL lcDatei, lcOrdner, lcTemp, llOk
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		IF VARTYPE(tcDatei) # "C" OR EMPTY(tcDatei)
			RETURN This.Fehler("FX-TECH-04", "Der Name der Zieldatei fehlt.")
		ENDIF
		lcDatei = This.ZielPfad(tcDatei)
		IF This.lTechnischerFehler OR EMPTY(lcDatei)
			RETURN .F.
		ENDIF
		lcOrdner = JUSTPATH(lcDatei)
		IF NOT DIRECTORY(lcOrdner)
			RETURN This.Fehler("FX-TECH-04", "Der Zielordner fehlt: {1}", lcOrdner)
		ENDIF
		lcTemp = This.TempDatei(lcOrdner)
		IF This.lTechnischerFehler OR EMPTY(lcTemp)
			RETURN .F.
		ENDIF
		llOk = This.DomSpeichern(toDom, lcTemp)
		IF llOk AND NOT This.lTechnischerFehler
			llOk = This.ZielErsetzen(lcTemp, lcDatei)
		ENDIF
		IF NOT llOk OR This.lTechnischerFehler
			= This.TempLoeschen(lcTemp)
			RETURN .F.
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE TempDatei
		LPARAMETERS tcOrdner
		LOCAL lcPuffer, lnErgebnis
		DECLARE INTEGER GetTempFileNameA IN kernel32 AS fxTempDatei STRING, STRING, INTEGER, STRING @
		IF This.lTechnischerFehler
			RETURN ""
		ENDIF
		lcPuffer = SPACE(260)
		lnErgebnis = fxTempDatei(tcOrdner, "fxf", 0, @lcPuffer)
		IF This.lTechnischerFehler OR lnErgebnis = 0
			= This.Fehler("FX-TECH-04", "Tempdatei im Zielordner kann nicht angelegt werden: {1}", tcOrdner)
			RETURN ""
		ENDIF
		RETURN LEFT(lcPuffer, AT(CHR(0), lcPuffer) - 1)
	ENDPROC

	PROTECTED PROCEDURE TempLoeschen
		LPARAMETERS tcTemp
		* Ausschliesslich die von diesem Aufruf reservierte Datei entfernen.
		IF FILE(tcTemp)
			ERASE (tcTemp)
		ENDIF
		RETURN NOT FILE(tcTemp)
	ENDPROC

	PROTECTED PROCEDURE TextVorhanden
		LPARAMETERS tuWert
		IF NOT INLIST(VARTYPE(tuWert), "C", "M")
			RETURN .F.
		ENDIF
		RETURN NOT EMPTY(CHRTRAN(tuWert, " " + CHR(9) + CHR(10) + CHR(13), ""))
	ENDPROC

	PROCEDURE Zahl
		LPARAMETERS tnWert, tnStellen
		IF PCOUNT() < 2
			tnStellen = 2
		ENDIF
		RETURN CHRTRAN(ALLTRIM(STR(ROUND(tnWert, tnStellen), 40, tnStellen)), SET("POINT"), ".")
	ENDPROC

	PROTECTED PROCEDURE ZielErsetzen
		LPARAMETERS tcTemp, tcDatei
		LOCAL lnErgebnis, lnFehler
		DECLARE INTEGER MoveFileExA IN kernel32 AS fxZielErsetzen STRING, STRING, INTEGER
		DECLARE INTEGER GetLastError IN kernel32 AS fxDateiFehler
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		* Gleicher Ordner: ein Rename mit REPLACE_EXISTING und WRITE_THROUGH.
		lnErgebnis = fxZielErsetzen(tcTemp, tcDatei, 9)
		IF This.lTechnischerFehler
			RETURN .F.
		ENDIF
		IF lnErgebnis = 0
			lnFehler = fxDateiFehler()
			RETURN This.Fehler("FX-TECH-04", "Zieldatei l{ae}sst sich nicht ersetzen: {1} (Windows {2}).", ;
				tcDatei, ALLTRIM(STR(lnFehler)))
		ENDIF
		RETURN .T.
	ENDPROC

	PROTECTED PROCEDURE ZielPfad
		LPARAMETERS tcDatei
		LOCAL lcName
		lcName = CHRTRAN(ALLTRIM(tcDatei), "/", "\")
		DO CASE
		CASE LEFT(lcName, 2) == "\\" OR SUBSTR(lcName, 2, 2) == ":\"
			RETURN lcName
		CASE SUBSTR(lcName, 2, 1) == ":"
			= This.Fehler("FX-TECH-04", "Laufwerksrelative Zieldateinamen sind nicht erlaubt: {1}", lcName)
			RETURN ""
		CASE LEFT(lcName, 1) == "\"
			RETURN SYS(5) + lcName
		ENDCASE
		RETURN ADDBS(SYS(5) + SYS(2003)) + lcName
	ENDPROC

ENDDEFINE

DEFINE CLASS fxzahlungsbedingung AS fxbasis OF "foxferd.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: beschreibung
		*m: destroy
		*m: dezimal
		*m: hatskonto
		*m: hatverzug
		*m: init
		*m: skontotext
		*m: zielsetzen
		*p: cbeschreibung		&& BT-20 Freitext der Zahlungsbedingung
		*p: cmandatsreferenz		&& BT-89 Mandatsreferenz dieser Bedingung
		*p: cskontoeinheit		&& BT-X-284 Einheit des Zeitraums
		*p: cverzugeinheit		&& BT-X-278 Einheit des Zeitraums
		*p: dfaelligkeit		&& BT-9 Faelligkeitsdatum, natives Datum mit Format 102
		*p: dskontobasisdatum		&& BT-X-282 Basisdatum mit Format 102, nur EXTENDED
		*p: dverzugbasisdatum		&& BT-X-276 Basisdatum mit Format 102, nur EXTENDED
		*p: nskontobasis		&& BT-X-285 Expliziter Basisbetrag
		*p: nskontobetrag		&& BT-X-287 Expliziter Betrag
		*p: nskontoprozent		&& BT-X-286 Prozentsatz
		*p: nskontotage		&& BT-X-283 Zeitraum als Masszahl
		*p: nteilzahlung		&& BT-X-275 Expliziter Teilzahlungsbetrag, nur EXTENDED
		*p: nverzugbasis		&& BT-X-279 Expliziter Basisbetrag
		*p: nverzugbetrag		&& BT-X-281 Expliziter Betrag
		*p: nverzugprozent		&& BT-X-280 Prozentsatz
		*p: nverzugtage		&& BT-X-277 Zeitraum als Masszahl
		*p: ozahlungsempfaenger		&& BG-X-77 Zahlungsempfaenger dieser Bedingung, eigene fxPartei, nur EXTENDED
	*</DefinedPropArrayMethod>

	*<PropValue>
		cbeschreibung = 
		cmandatsreferenz = 
		cskontoeinheit = 
		cverzugeinheit = 
		dfaelligkeit = {}
		dskontobasisdatum = {}
		dverzugbasisdatum = {}
		Name = "fxZahlungsbedingung"
		nskontobasis = .NULL.
		nskontobetrag = .NULL.
		nskontoprozent = .NULL.
		nskontotage = .NULL.
		nteilzahlung = .NULL.
		nverzugbasis = .NULL.
		nverzugbetrag = .NULL.
		nverzugprozent = .NULL.
		nverzugtage = .NULL.
		ozahlungsempfaenger = .NULL.
	*</PropValue>
	
	PROCEDURE Beschreibung
		LPARAMETERS tcProfil, tcWaehrung
		LOCAL lcText, lcSkonto
		lcText = ""
		IF INLIST(VARTYPE(This.cBeschreibung), "C", "M")
		    lcText = This.cBeschreibung
		ENDIF
		lcSkonto = This.SkontoText(tcProfil, tcWaehrung)
		IF NOT EMPTY(lcSkonto)
		    IF NOT EMPTY(lcText) AND RIGHT(lcText, 1) # CHR(10)
		        lcText = lcText + CHR(10)
		    ENDIF
		    lcText = lcText + lcSkonto
		ENDIF
		RETURN lcText
	ENDPROC

	PROCEDURE Destroy
		This.oZahlungsempfaenger = .NULL.
	ENDPROC

	PROTECTED PROCEDURE Dezimal
		LPARAMETERS tnWert
		RETURN CHRTRAN(ALLTRIM(STR(ROUND(tnWert, 2), 40, 2)), SET("POINT"), ".")
	ENDPROC

	PROCEDURE HatSkonto
		LOCAL llEinheit
		llEinheit = .F.
		IF INLIST(VARTYPE(This.cSkontoEinheit), "C", "M")
			llEinheit = NOT EMPTY(CHRTRAN(This.cSkontoEinheit, " " + CHR(9) + CHR(10) + CHR(13), ""))
		ENDIF
		RETURN NOT EMPTY(This.dSkontoBasisdatum) OR NOT ISNULL(This.nSkontoTage) OR ;
		    llEinheit OR NOT ISNULL(This.nSkontoBasis) OR ;
		    NOT ISNULL(This.nSkontoProzent) OR NOT ISNULL(This.nSkontoBetrag)
	ENDPROC

	PROCEDURE HatVerzug
		LOCAL llEinheit
		llEinheit = .F.
		IF INLIST(VARTYPE(This.cVerzugEinheit), "C", "M")
			llEinheit = NOT EMPTY(CHRTRAN(This.cVerzugEinheit, " " + CHR(9) + CHR(10) + CHR(13), ""))
		ENDIF
		RETURN NOT EMPTY(This.dVerzugBasisdatum) OR NOT ISNULL(This.nVerzugTage) OR ;
		    llEinheit OR NOT ISNULL(This.nVerzugBasis) OR ;
		    NOT ISNULL(This.nVerzugProzent) OR NOT ISNULL(This.nVerzugBetrag)
	ENDPROC

	PROCEDURE Init
		This.oZahlungsempfaenger = CREATEOBJECT("fxPartei")
		RETURN VARTYPE(This.oZahlungsempfaenger) = "O"
	ENDPROC

	PROCEDURE SkontoText
		LPARAMETERS tcProfil, tcWaehrung
		LOCAL lcTage, lcProzent, lcBasis, lcText
		IF tcProfil == "EXTENDED" OR NOT INLIST(VARTYPE(This.nSkontoTage), "N", "Y") OR ;
		    NOT INLIST(VARTYPE(This.nSkontoProzent), "N", "Y")
		    RETURN ""
		ENDIF
		lcTage = ALLTRIM(STR(This.nSkontoTage, 40, 0))
		lcProzent = This.Dezimal(This.nSkontoProzent)
		lcBasis = ""
		IF INLIST(VARTYPE(This.nSkontoBasis), "N", "Y")
		    lcBasis = This.Dezimal(This.nSkontoBasis)
		ENDIF
		IF tcProfil == "XRECHNUNG-CII"
		    lcText = "#SKONTO#TAGE=" + lcTage + "#PROZENT=" + lcProzent + "#"
		    IF NOT EMPTY(lcBasis)
		        lcText = lcText + "BASISBETRAG=" + lcBasis + "#"
		    ENDIF
		    RETURN lcText + CHR(10)
		ENDIF
		lcText = "Skonto " + lcProzent + " % bei Zahlung innerhalb von " + lcTage + IIF(This.nSkontoTage = 1, " Tag", " Tagen")
		IF NOT EMPTY(lcBasis)
		    IF NOT INLIST(VARTYPE(tcWaehrung), "C", "M")
		        tcWaehrung = ""
		    ENDIF
		    tcWaehrung = ALLTRIM(CHRTRAN(tcWaehrung, CHR(9) + CHR(10) + CHR(13), "   "))
		    lcText = lcText + "; Basisbetrag " + lcBasis + " " + tcWaehrung
		ENDIF
		RETURN lcText + "."
	ENDPROC

	PROCEDURE ZielSetzen
		LPARAMETERS tcAlias, tnSession, tcDatei
		LOCAL llOk
		llOk = DODEFAULT(tcAlias, tnSession, tcDatei)
		IF llOk AND VARTYPE(This.oZahlungsempfaenger) = "O"
		    llOk = This.oZahlungsempfaenger.ZielSetzen(tcAlias, tnSession, tcDatei)
		ENDIF
		RETURN llOk
	ENDPROC

ENDDEFINE

DEFINE CLASS fxzeitraum AS fxbasis OF "foxferd.vcx" 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*p: cbeschreibung		&& BT-X-264 Beschreibung der Abrechnungsperiode, nur EXTENDED
		*p: danfang		&& BT-134 / BT-73 Anfang der Abrechnungsperiode
		*p: dende		&& BT-135 / BT-74 Ende der Abrechnungsperiode
	*</DefinedPropArrayMethod>

	*<PropValue>
		cbeschreibung = 
		danfang = {}
		dende = {}
		Name = "fxzeitraum"
	*</PropValue>

ENDDEFINE
