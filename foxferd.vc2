		This.aAbrechnungsaenderungen[1] = .NULL.
		This.aKontierungen[1] = .NULL.
		This.aSteuersummen[1] = .NULL.
		This.aNotizen[1] = .NULL.
		This.aMerkmale[1] = .NULL.
		This.aKlassifikationen[1] = .NULL.
		This.aInstanzen[1] = .NULL.
		This.aChargen[1] = .NULL.
		This.aProduktreferenzen[1] = .NULL.
		This.oHersteller = CREATEOBJECT("fxPartei")
		This.aPreisaenderungen[1] = .NULL.
		This.oPreissteuer = CREATEOBJECT("fxPreissteuer")
		This.aAnhaenge[1] = .NULL.
		This.aEndkundenbestellungen[1] = .NULL.
		This.oVerkaeufer = CREATEOBJECT("fxPartei")
		This.oEndlieferempfaenger = CREATEOBJECT("fxPartei")
		This.oLieferempfaenger = CREATEOBJECT("fxPartei")
	ENDPROC

